  "reviews": {
   "summary": "AQBLACKLABSUB roses bredt som et velbygget, fleksibelt og pålideligt subwooferkabel, der giver ren og uafbrudt signaloverførsel. Mange brugere oplever klar, fyldig og dybere bas, og flere bemærker en tydelig forbedring sammenlignet med enklere kabler; nogle har også fjernet brum fra subwooferen. Enkelte synes, at kablet er dyrt, og et jordkabel var for kort, men installation, tilslutning og byggekvalitet får stor ros.",
   "headlines": {
    "clearer, deeper and more powerful bass": {
     "sentimentAnalysis": "Anmeldelserne beskriver en klar, varm og fyldig bas, og flere brugere oplever dybere bas eller en markant forbedring i forhold til simple kabler.",
     "simpleTitle": "Klarere, dybere og kraftigere bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "8d32498c-5c04-4fab-a989-0375776a8d5d"
    },
    "solid, flexible and well-finished construction": {
     "sentimentAnalysis": "Kablet beskrives ofte som flot, holdbart, fleksibelt og omhyggeligt udført med stik, der sidder sikkert, samt praktiske markeringer til installationen.",
     "simpleTitle": "Solid, fleksibel og flot udførelse",
     "bias": "positive",
     "key": "build",
     "groupId": "4f71efa2-766b-49f6-8cd6-a2d9bee927a1"
    },
    "reliable, interference-free signal transfer": {
     "sentimentAnalysis": "Brugerne rapporterer konsekvent om ren forbindelse uden forstyrrelser og roser især fjernelsen af subwooferbrum samt den enkle installation.",
     "simpleTitle": "Pålidelig og støjfri signaloverførsel",
     "bias": "positive",
     "key": "connection",
     "groupId": "d6208d41-7fbc-4973-9557-a260f63e7fd4"
    },
    "premium pricing divides value perceptions": {
     "sentimentAnalysis": "Meningerne er delte: Nogle synes, at kablet giver god værdi for kvaliteten, mens andre mener, at prisen er for høj, især sammenlignet med billigere alternativer.",
     "simpleTitle": "Premiumprisen deler vurderingen af værdien",
     "bias": "meh",
     "key": "value",
     "groupId": "9ad4ad83-3d73-4fa8-a8d0-4abc0335bd61"
    }
   },
