  "reviews": {
   "summary": "AQBOXERSUB får stor ros for ren signaloverførsel i høj kvalitet til subwoofere med en kontant bas, stærk dynamik og tydelige forbedringer sammenlignet med standardkabler. Kablet kan også fjerne brum fra subwooferen, selv om den høje pris bliver bemærket. Samlet set giver AQBOXERSUB en omsluttende og kraftfuld opgradering af subwoofersystemer.",
   "headlines": {
    "cleaner, deeper and louder bass": {
     "sentimentAnalysis": "Kablet roses for at levere renere, dybere og kraftigere bas samt stærkere dynamik fra subwooferen.",
     "simpleTitle": "Renere, dybere og højere bas",
     "bias": "positive",
     "key": "bass-impact",
     "groupId": "7db4760b-70f9-442d-b000-666357e8df26"
    },
    "clear improvement over basic cables": {
     "sentimentAnalysis": "Kablet siges at gøre en mærkbar forskel sammenlignet med standard- eller introduktionskabler.",
     "simpleTitle": "Tydelig forbedring i forhold til standardkabler",
     "bias": "positive",
     "key": "audible-upgrade",
     "groupId": "7db4760b-70f9-442d-b000-666357e8df26"
    },
    "high-quality signal transmission": {
     "sentimentAnalysis": "Kablet værdsættes for at overføre forstærkersignalet til subwooferne med høj kvalitet, mange detaljer og dynamisk kraft.",
     "simpleTitle": "Signaler i høj kvalitet",
     "bias": "positive",
     "key": "transmission",
     "groupId": "7db4760b-70f9-442d-b000-666357e8df26"
