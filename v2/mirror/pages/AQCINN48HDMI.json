  "reviews": {
   "summary": "AQCINN48HDMI giver en markant forbedring af billede og lyd med skarpe, medrivende billeder, dybere bas samt renere og mere dynamisk lyd. HDMI 2.1- og eARC-understøttelse gør kablet særligt velegnet til moderne tv, spillekonsoller og hjemmebiografer. Den høje byggekvalitet og ydeevne bliver værdsat, selv om det stive kabel og den høje pris dæmper begejstringen lidt.",
   "headlines": {
    "sharper picture and cleaner, more immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver synligt skarpere billeder og renere, mere detaljeret lyd end med tidligere kabler eller standardkabler.",
     "simpleTitle": "Skarpere billede og renere, mere medrivende lyd",
     "bias": "positive",
     "key": "picture_sound",
     "groupId": "32e6fc71-5b42-49ea-b4d5-cda092d5dbf1"
    },
    "very stiff and difficult to route": {
     "sentimentAnalysis": "Gentagne anmeldelser fremhæver den store stivhed, som gør bøjninger og skjult kabelføring vanskelig.",
     "simpleTitle": "Meget stift og svært at føre",
     "bias": "negative",
     "key": "cable_flexibility",
     "groupId": "45193c87-8f24-4d3b-8eb5-bfc8e62ce473"
    },
    "premium price, usually seen as worthwhile": {
     "sentimentAnalysis": "Trods den høje pris anser flere anmeldelser kablet for pengene værd eller som god værdi i forhold til ydeevnen.",
     "simpleTitle": "Høj pris, som regel pengene værd",
     "bias": "positive",
     "key": "price_value",
     "groupId": "2040112c-cf05-4c50-a7a0-02fd8514c195"
    },
    "price feels excessive for digital signal transfer": {
     "sentimentAnalysis": "Nogle anmeldelser finder kablet dyrt og stiller spørgsmål ved, om ydeevnen retfærdiggør merprisen i forhold til billigere alternativer.",
     "simpleTitle": "Prisen virker høj for digital signaloverførsel",
     "bias": "negative",
     "key": "price_value",
     "groupId": "2040112c-cf05-4c50-a7a0-02fd8514c195"
    },
    "deeper bass and greater dynamics": {
     "sentimentAnalysis": "Kablet tilskrives mere fylde i bassen samt en mere dynamisk og musikalsk engagerende gengivelse.",
     "simpleTitle": "Dybere bas og større dynamik",
     "bias": "positive",
     "key": "picture_sound",
     "groupId": "32e6fc71-5b42-49ea-b4d5-cda092d5dbf1"
    }
   },
