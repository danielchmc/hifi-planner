  "reviews": {
   "summary": "AQCINN48HDMI leverer et imponerende skarpt og levende billede samt varm, ren og dynamisk lyd med tydelige forbedringer i forhold til standardkabler. HDMI 2.1-ydeevnen og den stabile signaloverførsel gør kablet særligt attraktivt til moderne hjemmebio- og gaming-systemer. Den førsteklasses konstruktion føles solid, men det meget stive kabel og den høje pris kan gøre installationen mindre praktisk.",
   "headlines": {
    "sharper, more vivid picture": {
     "sentimentAnalysis": "Kablet roses gentagne gange for et skarpere, renere og mere levende billede med dybere farver.",
     "simpleTitle": "Skarpere og mere levende billede",
     "bias": "positive",
     "key": "picture",
     "groupId": "54c09d6b-4eac-4e60-904a-bf1c74e280d9"
    },
    "cleaner, deeper and more dynamic sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver hørbare forbedringer i klarhed, basdybde og dynamik, så lyden bliver renere og mere medrivende.",
     "simpleTitle": "Renere, dybere og mere dynamisk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "d6197c6f-aa9f-4415-aa1b-4daafa020716"
    },
    "very stiff and difficult to route": {
     "sentimentAnalysis": "Kablets stivhed er den mest gennemgående kritik og gør bøjninger, håndtering og skjult installation vanskelig.",
     "simpleTitle": "Meget stift og svært at føre",
     "bias": "negative",
     "key": "stiffness",
     "groupId": "2bcbe5dd-a12d-4fbc-a4ba-f8145e98ba0a"
    },
    "premium price limits the value": {
     "sentimentAnalysis": "Flere anmeldelser betragter kablet som dyrt, selv om den fremragende ydeevne eller tydelige forbedringer anerkendes.",
     "simpleTitle": "Den høje pris begrænser værdien",
     "bias": "negative",
     "key": "value",
     "groupId": "bee03cc7-2a47-4182-bfa8-cf1d7ce7e54d"
    }
   },
