  "reviews": {
   "summary": "AQCINN48HDMI leverer et levende og skarpt billede samt en varm, slagkraftig og renere lyd med tydelige forbedringer i forhold til standardkabler. HDMI 2.1-ydelse, stabil signaloverførsel og solid byggekvalitet gør kablet særligt attraktivt til moderne hjemmebio og gaming. De største ulemper er den markant stive konstruktion og den høje pris, men helhedsindtrykket er fortsat meget positivt.",
   "headlines": {
    "richer, more dynamic sound": {
     "sentimentAnalysis": "Anmeldelserne roser en renere, mere detaljeret og dynamisk lyd med dybere bas og forbedret eARC-ydeevne.",
     "simpleTitle": "Fyldigere og mere dynamisk lyd",
     "bias": "positive",
     "key": "audio_quality",
     "groupId": "43c1ea70-74fe-441c-ab98-9f1608cd8e6a"
    },
    "sharper, cleaner picture": {
     "sentimentAnalysis": "Anmeldelserne beskriver et synligt skarpere, renere og mere farverigt billede end med tidligere kabler eller standardkabler.",
     "simpleTitle": "Skarpere og renere billede",
     "bias": "positive",
     "key": "picture_quality",
     "groupId": "cf996516-ef1c-4198-82f1-22d95226fa85"
    },
    "very stiff and difficult to route": {
     "sentimentAnalysis": "Flere anmeldelser beskriver kablet som usædvanligt stift, svært at bøje og vanskeligt at skjule eller få plads til.",
     "simpleTitle": "Meget stift og svært at føre",
     "bias": "negative",
     "key": "cable_flexibility",
     "groupId": "d29cfe07-9f4b-4860-8816-0d30b780b973"
    },
    "premium price, but strong value when performance matters": {
     "sentimentAnalysis": "Anmeldelserne peger konsekvent på en høj pris, men er delte om, hvorvidt de synlige forbedringer fuldt ud retfærdiggør merprisen.",
     "simpleTitle": "Høj pris, men god værdi ved høje krav",
     "bias": "meh",
     "key": "price_value",
     "groupId": "ac5e3665-b53f-40fd-87db-c0154cb296de"
    },
    "supports demanding HDMI 2.1 use": {
     "sentimentAnalysis": "Anmeldelserne fremhæver fuld HDMI 2.1-understøttelse, høj hastighed og god egnethed til moderne gaming-enheder.",
     "simpleTitle": "Understøtter krævende HDMI 2.1-brug",
     "bias": "positive",
     "key": "hdmi_performance",
     "groupId": "6fb111e6-0053-41be-a713-3af4650e7b6b"
    }
   },
