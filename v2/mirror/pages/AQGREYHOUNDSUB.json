  "reviews": {
   "summary": "AQGREYHOUNDSUB er et meget effektivt subwooferkabel, der leverer ren, defineret og punchy bas og integrerer sig problemfrit med forskellige anlæg. Den slanke og diskrete konstruktion gør det særligt nemt at føre og skjule kablet. Samlet set tilbyder kablet fremragende værdi og pålidelig ydeevne i hverdagen, selv om en længere installation var forbundet med brum i subwooferen.",
   "headlines": {
    "clean and defined bass": {
     "sentimentAnalysis": "Kablet roses for transparent, defineret og meget vellydende basgengivelse.",
     "simpleTitle": "Ren og defineret bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "b36b61b7-4f8d-4771-8d2e-1548e7ccb5dd"
    },
    "reliable plug-and-play connection": {
     "sentimentAnalysis": "Kablet betragtes som en enkel og passende løsning, der pålideligt udfører sin forbindelsesfunktion i flere opsætninger.",
     "simpleTitle": "Pålidelig plug-and-play-tilslutning",
     "bias": "positive",
     "key": "compatibility",
     "groupId": "7db148b3-97ea-4f2c-bde8-24c9a3b08d7b"
    },
    "slim and easy to hide": {
     "sentimentAnalysis": "Den tynde konstruktion gør det nemt at føre kablet diskret rundt i rummet eller bag paneler.",
     "simpleTitle": "Tyndt og nemt at skjule",
     "bias": "positive",
     "key": "design",
     "groupId": "7fc642fe-3a2c-428a-a24c-bfd27a738011"
    },
    "effective subwoofer integration": {
     "sentimentAnalysis": "Kablet aflaster hovedhøjttalerne og integrerer subwooferen effektivt som en stærk, supplerende del af anlægget.",
     "simpleTitle": "Effektiv subwooferintegration",
     "bias": "positive",
     "key": "sound",
     "groupId": "b36b61b7-4f8d-4771-8d2e-1548e7ccb5dd"
    }
   },
