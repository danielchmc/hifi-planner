  "reviews": {
   "summary": "AQGREYHOUNDSUB er et særdeles effektivt subwooferkabel, der leverer ren, præcis og punchy bas og fungerer problemfrit med mange forskellige højttalere og forstærkere. Det slanke og diskrete design gør installation og skjult kabelføring meget nem. Fremragende værdi for pengene og pålidelig hverdagsydelse præger tilbagemeldingerne, selv om lange kabeltræk kan give brum i enkelte opsætninger.",
   "headlines": {
    "clean, defined and powerful bass": {
     "sentimentAnalysis": "Kablet roses gentagne gange for ren, præcis og punchy lyd samt fremragende basintegration.",
     "simpleTitle": "Ren, præcis og kraftfuld bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "b8dbf619-f3cd-4d29-acf6-36f0e27a958d"
    },
    "reliable plug-and-play connection": {
     "sentimentAnalysis": "Anmeldelserne beskriver samstemmende et ukompliceret kabel, der passer til kompatible systemer og uden besvær klarer subwooferforbindelsen.",
     "simpleTitle": "Pålidelig plug-and-play-forbindelse",
     "bias": "positive",
     "key": "compatibility",
     "groupId": "221eb68c-c952-471b-bbfd-d953e87738f4"
    },
    "slim and easy to hide": {
     "sentimentAnalysis": "Den tynde konstruktion opleves som meget praktisk til kabelføring rundt i rummet og skjult montering bag paneler eller i kabelkanaler.",
     "simpleTitle": "Slankt og nemt at skjule",
     "bias": "positive",
     "key": "installation",
     "groupId": "a718a671-6faf-4231-9618-4c7d5d9659c7"
