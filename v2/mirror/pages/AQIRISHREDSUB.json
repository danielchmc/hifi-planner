  "reviews": {
   "summary": "AQIRISHREDSUB får stor ros som et velbygget og fleksibelt subwooferkabel med pålidelig ydeevne i hverdagen. Anmeldelserne beskriver fyldigere, renere, mere punchy og mere medrivende bas med tydeligt forbedret effekt fra subwooferen i flere anlæg. Værdien for pengene fremhæves ofte, selv om AudioQuest-tillægget af nogle købere vurderes som dyrt.",
   "headlines": {
    "fuller, clearer and more powerful bass": {
     "sentimentAnalysis": "Kablet forbindes gentagne gange med fyldigere, renere, kraftigere og mere effektfuld subwooferlyd.",
     "simpleTitle": "Fyldigere, klarere og kraftigere bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "dd779df2-dba2-4772-a009-1e6290acc02f"
    },
    "reliable performance and good cable quality": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent kablet som vellavet, pålideligt og fuldt funktionelt.",
     "simpleTitle": "Pålidelig funktion og god kabelkvalitet",
     "bias": "positive",
     "key": "quality",
     "groupId": "548520fd-48b4-4c70-8095-796f35a8b288"
    },
    "easy to install and use": {
     "sentimentAnalysis": "Den fleksible konstruktion og de praktiske stik gør installationen nem, også på trang plads.",
     "simpleTitle": "Nem at installere og bruge",
     "bias": "positive",
     "key": "installation",
     "groupId": "87dfbd5f-4e84-4604-bf89-38448b6d01a5"
    },
    "good value for the performance": {
     "sentimentAnalysis": "Flere anmeldelser vurderer kablet som et godt køb i forhold til den leverede ydelse.",
     "simpleTitle": "God værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "218fe634-3853-49ee-a8ad-80ff90201cc2"
    }
