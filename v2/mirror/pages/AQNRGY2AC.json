  "reviews": {
   "summary": "AQ NRG-Y2 roses for solid kvalitet, flot udførelse og effektiv afskærmning. Kablet kan give en subtil, men hørbar forbedring med lidt mere lydstyrke, ro og dynamik i anlægget. Den fleksible håndtering og gode pasform tæller positivt, selv om kablet kan opleves som tykt eller stift, og den lydmæssige opgradering ikke er dramatisk.",
   "headlines": {
    "high-quality construction and attractive finish": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent kablet som vellavet, flot og velegnet til lydudstyr.",
     "simpleTitle": "Høj kvalitet og flot udførelse",
     "bias": "positive",
     "key": "build_quality",
     "groupId": "36deec9f-9454-4610-bab8-d926f79583c9"
    },
    "subtle but audible improvements in calmness and dynamics": {
     "sentimentAnalysis": "Kablet forbindes med en lidt højere, roligere og mere dynamisk gengivelse og giver dermed en tydeligt hørbar, men behersket forbedring.",
     "simpleTitle": "Subtile, men hørbare forbedringer i ro og dynamik",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "090d0de9-aa64-49e4-ac56-556a01a955b9"
    },
    "sound upgrade remains subtle rather than dramatic": {
     "sentimentAnalysis": "Den lydmæssige ændring værdsættes, men beskrives som begrænset uden en overvældende dag-og-nat-forvandling.",
     "simpleTitle": "Lydforbedringen er subtil frem for dramatisk",
     "bias": "negative",
     "key": "sound_quality",
     "groupId": "090d0de9-aa64-49e4-ac56-556a01a955b9"
