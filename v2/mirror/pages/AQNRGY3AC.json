  "reviews": {
   "summary": "AQNRGY3AC roses bredt for en renere, mere detaljeret og dynamisk lyd med et dybere, bredere og mere medrivende lydbillede. Strammere bas, en roligere baggrund og større musikalsk klarhed gør kablet til en markant opgradering i mange anlæg. Den solide konstruktion og gode afskærmning giver tillid, selv om kablet kan være stift, og enkelte lyttere ikke hørte nogen tydelig forskel.",
   "headlines": {
    "cleaner, more detailed sound": {
     "sentimentAnalysis": "Kablet forbindes gentagne gange med en klarere, renere og mere detaljeret lyd end standard- eller ældre strømkabler.",
     "simpleTitle": "Renere, mere detaljeret lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "47566d38-5dd2-447a-b3aa-3f19339cbe34"
    },
    "solid construction and shielding": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent kablets kvalitet, robuste konstruktion, egnethed til high-end-anlæg og afskærmning.",
     "simpleTitle": "Solid konstruktion og afskærmning",
     "bias": "positive",
     "key": "build-quality",
     "groupId": "17eea9f3-ae5c-41cf-bca7-a0372317ed8d"
    },
    "wider, deeper and more dynamic presentation": {
     "sentimentAnalysis": "Flere anmeldelser beskriver et bredere og dybere lydbillede, større dynamik, bedre baskontrol og en mere rummelig og medrivende gengivelse.",
     "simpleTitle": "Bredere, dybere og mere dynamisk gengivelse",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "47566d38-5dd2-447a-b3aa-3f19339cbe34"
    },
    "audible improvement is not universal": {
     "sentimentAnalysis": "Nogle lyttere kunne ikke tydeligt høre en forbedring i forhold til en eksisterende strømrenser, det originale kabel eller et ældre kabel.",
     "simpleTitle": "Den hørbare forbedring er ikke entydig",
     "bias": "negative",
     "key": "sound-quality",
     "groupId": "47566d38-5dd2-447a-b3aa-3f19339cbe34"
    }
   },
