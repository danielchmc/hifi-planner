  "reviews": {
   "summary": "AQNRGY3AC roses bredt som et velbygget strømkabel, der kan give renere, roligere, mere dynamisk og rummelig lyd med strammere bas og flere detaljer. Flere anmeldelser beskriver en tydeligt hørbar opgradering i forhold til standardkabler, mens en mindre gruppe ikke hører nogen eller kun ringe forskel. Den største praktiske ulempe er stivheden, mens afskærmning, konstruktion og værdi for pengene får ros.",
   "headlines": {
    "cleaner, more dynamic sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en klarere, renere og mere dynamisk lyd efter tilslutning af kablet.",
     "simpleTitle": "Renere, mere dynamisk lyd",
     "bias": "positive",
     "key": "clean-dynamic-sound",
     "groupId": "58341091-6c5d-4b70-9b54-a120c7d9c1e7"
    },
    "tighter bass and greater detail": {
     "sentimentAnalysis": "Anmeldelserne roser bedre basrækkevidde eller -kontrol samt flere musikalske detaljer.",
     "simpleTitle": "Strammere bas og flere detaljer",
     "bias": "positive",
     "key": "bass-detail",
     "groupId": "58341091-6c5d-4b70-9b54-a120c7d9c1e7"
    },
    "wider, deeper and more immersive presentation": {
     "sentimentAnalysis": "Lydbilledet beskrives som bredere, dybere og mere rummeligt med en stærkere følelse af indlevelse.",
     "simpleTitle": "Bredere, dybere og mere rummelig gengivelse",
     "bias": "positive",
     "key": "spacious-presentation",
     "groupId": "58341091-6c5d-4b70-9b54-a120c7d9c1e7"
    },
    "no clearly audible improvement for some systems": {
     "sentimentAnalysis": "Nogle anmeldelser udtrykker tvivl eller rapporterer ingen mærkbar opgradering sammenlignet med et eksisterende eller standardkabel.",
     "simpleTitle": "Ingen tydelig hørbar forbedring i nogle anlæg",
     "bias": "negative",
     "key": "limited-audible-difference",
     "groupId": "58341091-6c5d-4b70-9b54-a120c7d9c1e7"
    },
    "stiff construction": {
     "sentimentAnalysis": "Flere anmeldelser bemærker, at kablet er forholdsvis stift, selv om en anden anmeldelse beskriver det som blødere end en anden model.",
     "simpleTitle": "Stiv konstruktion",
     "bias": "negative",
