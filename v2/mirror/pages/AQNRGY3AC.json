  "reviews": {
   "summary": "AQ NRG-Y3-strømkabler roses bredt for en renere, roligere og mere detaljeret lyd med mere punch i bassen, større dynamik samt et bredere og dybere lydbillede. Den solide byggekvalitet, gode afskærmning og egnethed til avancerede lydanlæg øger attraktiviteten, mens værdi for pengene ofte vurderes positivt. Et mindretal hører kun lille eller ingen lydmæssig forskel, og kablet kan være mærkbart stift, men den samlede vurdering er meget begejstret.",
   "headlines": {
    "cleaner, more dynamic sound": {
     "sentimentAnalysis": "Kablet forbindes gentagne gange med renere, mere detaljeret, roligere og mere dynamisk lyd.",
     "simpleTitle": "Renere og mere dynamisk lyd",
     "bias": "positive",
     "key": "cleaner-more-dynamic-sound",
     "groupId": "86383e23-53ca-4645-86d7-ebe41b403e87"
    },
    "solid, well-constructed cable": {
     "sentimentAnalysis": "Byggekvaliteten vurderes konsekvent som robust, pålidelig og egnet til avanceret udstyr.",
     "simpleTitle": "Solidt og velkonstrueret kabel",
     "bias": "positive",
     "key": "solid-construction",
     "groupId": "b9ed8e55-89c6-4588-9af4-d518307550c9"
    },
    "no clear audible improvement for some systems": {
     "sentimentAnalysis": "Flere anmeldelser beskriver usikkerhed eller ingen umiddelbart hørbar forbedring sammenlignet med eksisterende kabler.",
     "simpleTitle": "Ingen tydelig hørbar forbedring i visse anlæg",
     "bias": "negative",
     "key": "no-clear-audible-improvement",
     "groupId": "86383e23-53ca-4645-86d7-ebe41b403e87"
    },
    "broader, deeper and more spacious presentation": {
     "sentimentAnalysis": "Gengivelsen beskrives som bredere, dybere og mere rummelig med større indlevelse.",
     "simpleTitle": "Bredere, dybere og mere rummelig gengivelse",
     "bias": "positive",
     "key": "broader-deeper-soundstage",
     "groupId": "86383e23-53ca-4645-86d7-ebe41b403e87"
    },
    "good shielding reduces unwanted noise": {
     "sentimentAnalysis": "Afskærmningen roses for at understøtte renere lyd og reducere støj.",
     "simpleTitle": "God afskærmning reducerer uønsket støj",
     "bias": "positive",
     "key": "effective-shielding",
