  "reviews": {
   "summary": "AQPEARL48HDMI leverer en stabil, hurtig forbindelse i høj kvalitet med et klart billede og en varm, detaljeret lyd. Den solide konstruktion, pålidelige signaloverførsel og brede kompatibilitet gør kablet velegnet til TV, eARC, soundbarer, gaming og hi-fi-anlæg. Den høje pris og en vis stivhed er de største forbehold, men den samlede vurdering er meget positiv.",
   "headlines": {
    "reliable signal and connection": {
     "sentimentAnalysis": "Stabil signaloverførsel, hurtig kommunikation og løsning af udfald eller lydforsinkelser nævnes gentagne gange som styrker.",
     "simpleTitle": "Pålideligt signal og stabil forbindelse",
     "bias": "positive",
     "key": "reliable_signal",
     "groupId": "e7d65b92-ad69-45be-b34e-bca02dc28f03"
    },
    "clear picture and engaging sound": {
     "sentimentAnalysis": "Billedkvaliteten beskrives ofte som skarp og levende, mens lyden roses for at være klar, varm, detaljeret og mærkbart forbedret i nogle anlæg.",
     "simpleTitle": "Klart billede og engagerende lyd",
     "bias": "positive",
     "key": "av_quality",
     "groupId": "8f85766d-7bbd-43cd-88bb-145809dcc977"
    },
    "premium quality comes at a premium price": {
     "sentimentAnalysis": "Flere anmeldelser synes, at kablet er dyrt eller svært at retfærdiggøre frem for almindelige alternativer, selv om konstruktion og ydeevne anerkendes.",
     "simpleTitle": "Premiumkvalitet koster ekstra",
     "bias": "negative",
     "key": "value_concern",
     "groupId": "f81bc79f-4155-4904-a4ad-173bde732fee"
    },
    "sturdy construction can make routing difficult": {
     "sentimentAnalysis": "Kablet opleves gentagne gange som solidt og godt fremstillet, men stivheden kan gøre pæn kabelføring bag udstyr vanskelig.",
     "simpleTitle": "Solid konstruktion kan gøre kabeltrækning vanskelig",
     "bias": "negative",
     "key": "stiffness",
     "groupId": "8ce4ccce-049f-4fbd-8d2f-aacf2f950a4d"
    }
   },
