    },
    "more open, dynamic and immersive presentation": {
     "sentimentAnalysis": "Netfilteret forbindes med et større, mere åbent og mere energisk lydbillede, som gør musikken mere engagerende.",
     "simpleTitle": "Mere åben, dynamisk og omsluttende gengivelse",
     "bias": "positive",
     "key": "open-dynamic",
