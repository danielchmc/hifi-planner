  "reviews": {
   "summary": "AQ PowerQuest 707X giver en markant opgradering med renere, roligere og mere stabil lyd i både hi-fi- og hjemmebiografsystemer. Gengivelsen bliver mere åben, detaljeret og omsluttende med mere punch i bassen, stærkere dynamik og større præcision. En førsteklasses investering med varm, kontrolleret og engagerende musikalitet, selv om systemmatchning kan påvirke diskantens karakter.",
   "headlines": {
    "cleaner, clearer and more detailed sound": {
     "sentimentAnalysis": "Filteret roses gentagne gange for at gøre gengivelsen klarere, renere, mere åben og mere detaljeret.",
     "simpleTitle": "Renere, klarere og mere detaljeret lyd",
     "bias": "positive",
     "key": "sound-clarity",
     "groupId": "10fd4382-9f32-494c-88c9-444d4e5d1b61"
    },
    "calmer, more stable and more dynamic presentation": {
     "sentimentAnalysis": "Flere anmeldelser beskriver en roligere, mere stabil og mere kontrolleret lyd med bedre dynamik og et mere afslappet musikalsk flow.",
     "simpleTitle": "Roligere, mere stabil og mere dynamisk gengivelse",
     "bias": "positive",
     "key": "sound-control",
     "groupId": "10fd4382-9f32-494c-88c9-444d4e5d1b61"
    },
    "more powerful and precise bass": {
     "sentimentAnalysis": "Bassen får ifølge anmeldelserne mere styrke, punch og præcision, mens resterende forvrængning reduceres, men ikke altid forsvinder helt.",
     "simpleTitle": "Kraftigere og mere præcis bas",
