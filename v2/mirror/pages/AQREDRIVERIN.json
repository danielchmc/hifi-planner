  "reviews": {
   "summary": "AQ Red River leverer en varm, klar og punchy lyd med imponerende detaljer og en stærkt medrivende gengivelse. Flere sammenligninger beskriver en markant forbedring i forhold til billigere eller ældre signalkabler, mens kablet forbliver transparent og diskret i signalvejen. Den førsteklasses konstruktion og den gennemgående høje tilfredshed gør AQ Red River til en stærk anbefaling trods en vis usikkerhed om værdien uden bredere sammenligninger i prisklassen.",
   "headlines": {
    "major upgrade over cheaper or older cables": {
     "sentimentAnalysis": "Sammenligninger beskriver konsekvent en markant lydmæssig forbedring i forhold til billigere eller ældre signalkabler.",
     "simpleTitle": "Markant opgradering i forhold til billigere eller ældre kabler",
     "bias": "positive",
     "key": "upgrade-over-cheaper-cables",
     "groupId": "865f3c81-d61d-414d-8a69-dcc5a6bc4a54"
    },
    "clear, detailed and revealing sound": {
     "sentimentAnalysis": "Kablet roses for ren, klar gengivelse, der afslører musikalske detaljer, som tidligere ikke blev hørt.",
     "simpleTitle": "Klar, detaljeret og afslørende lyd",
     "bias": "positive",
     "key": "clear-detailed-sound",
     "groupId": "865f3c81-d61d-414d-8a69-dcc5a6bc4a54"
    },
    "high-quality construction": {
     "sentimentAnalysis": "Både korte og detaljerede kommentarer beskriver kablet som vellavet og af høj kvalitet.",
     "simpleTitle": "Høj kvalitet i konstruktionen",
     "bias": "positive",
     "key": "high-quality-construction",
     "groupId": "573311d9-0eed-4a05-971b-2f12fdd91908"
    },
    "transparent and unobtrusive in the signal path": {
     "sentimentAnalysis": "Kablet værdsættes for at overføre signalet troværdigt uden at tilføre en hørbar egenkarakter.",
     "simpleTitle": "Transparent og diskret i signalvejen",
     "bias": "positive",
     "key": "transparent-signal-path",
     "groupId": "865f3c81-d61d-414d-8a69-dcc5a6bc4a54"
    },
    "limited comparison with other cables": {
     "sentimentAnalysis": "De positive lydindtryk nuanceres af manglende sammenligninger med et bredere udvalg af kabler i samme prisklasse.",
