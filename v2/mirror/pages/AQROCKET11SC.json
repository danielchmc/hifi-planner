  "reviews": {
   "summary": "AQ Rocket 11 roses bredt som et velbygget, fleksibelt og prisvenligt højttalerkabel, der leverer en klar, afbalanceret og dynamisk lyd. Mange anmeldelser beskriver hørbare forbedringer i forhold til simple kabler, blandt andet strammere bas, blødere diskant, større klarhed, bredere lydbillede og flere musikalske detaljer. Installationen er som regel enkel, især med færdigmonterede bananstik, men det tykke kabel kan være svært at skjule, og forberedelse eller bi-wiring kan føles mindre intuitivt for nogle.",
   "headlines": {
    "clear, balanced and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en klar og afbalanceret gengivelse med præcis placering, mange detaljer og en rummelig lydbillede.",
     "simpleTitle": "Klar, afbalanceret og rummelig lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "de702995-da59-4586-a322-9679026a29b4"
    },
    "audible upgrade with tighter bass and smoother highs": {
     "sentimentAnalysis": "Flere anmeldelser oplever en tydelig forbedring i forhold til simple kabler, især med strammere bas, blødere diskant og større klarhed.",
     "simpleTitle": "Hørbar opgradering med strammere bas og blødere diskant",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "de702995-da59-4586-a322-9679026a29b4"
    },
    "strong value for the price": {
     "sentimentAnalysis": "Anmeldelserne beskriver ofte kablet som et kvalitetskøb, hvor lyd og udførelse står mål med prisen.",
     "simpleTitle": "Meget for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "7d687fbb-9e10-4f32-88ab-7ee9e9ccafb3"
    },
    "solid, neatly finished construction": {
     "sentimentAnalysis": "Kablet værdsættes gentagne gange for robuste materialer, professionel finish og en holdbar fornemmelse.",
     "simpleTitle": "Solid og flot udførelse",
     "bias": "positive",
     "key": "build-quality",
     "groupId": "08db9442-1c93-44b2-9f2e-7b790e888781"
    },
    "easy to install and use with banana plugs": {
     "sentimentAnalysis": "Forberedte eller terminerede kabler gør tilslutningen hurtig og ukompliceret for mange brugere.",
     "simpleTitle": "Nem installation med bananstik",
     "bias": "positive",
     "key": "installation",
     "groupId": "3182a1fc-b62a-4610-b7bc-8f62c9a6810a"
    },
    "bi-wiring is convenient and effective": {
     "sentimentAnalysis": "Kablet er nemt at dele og velegnet til bi-wiring, og flere anmeldelser forbinder opsætningen med bedre lyd.",
     "simpleTitle": "Bi-wiring er praktisk og effektivt",
     "bias": "positive",
     "key": "bi-wiring",
     "groupId": "d70bd43f-d645-41a3-b326-a7972f9a190b"
    },
