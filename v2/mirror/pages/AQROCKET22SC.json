  "reviews": {
   "summary": "AQROCKET22SC leverer en varm, kraftfuld og mere omsluttende lyd med forbedrede detaljer, bedre bas og større rumfornemmelse i flere anlæg. Bygge- og kabelkvaliteten roses bredt, mens bi-wire-designet anses for effektivt og velegnet til kompatible opsætninger. Den høje pris kritiseres, og nogle tests antyder, at den hørbare forbedring kan være begrænset eller overdrevet.",
   "headlines": {
    "clearer, fuller and more spacious sound": {
     "sentimentAnalysis": "Kablet roses gentagne gange for en rigere, mere detaljeret, kraftfuld og rummelig gengivelse.",
     "simpleTitle": "Klarere, fyldigere og mere rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "25a91d07-1247-4e9b-9e70-63d7977b6e13"
    },
    "premium pricing is hard to justify": {
     "sentimentAnalysis": "Flere anmeldelser betragter kablet som dyrt, uden at den høje pris konsekvent modsvares af en tydelig hørbar fordel.",
     "simpleTitle": "Premiumprisen er svær at retfærdiggøre",
     "bias": "negative",
     "key": "price",
     "groupId": "c2bd3924-984e-4a78-9d5c-4b75df024641"
    },
    "strong overall cable quality": {
     "sentimentAnalysis": "Kablet beskrives konsekvent som godt, fremragende og meget anbefalelsesværdigt med hensyn til den samlede kvalitet.",
     "simpleTitle": "Høj overordnet kabelkvalitet",
     "bias": "positive",
     "key": "quality",
     "groupId": "0fc710d3-189f-45a0-b4de-95933d06a5ac"
    },
    "helpful and attentive retailer service": {
     "sentimentAnalysis": "Butikspersonalet roses for at være hjælpsomt, venligt og for at yde praktisk hjælp med opsætningen.",
