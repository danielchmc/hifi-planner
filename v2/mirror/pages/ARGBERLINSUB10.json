  "reviews": {
   "summary": "ARGBERLINSUB10 tilføjer varm, punchy og præcis dybbas, så allerede gode anlæg lyder mere immersive og komplette. Den dybe bas er hurtig, kraftig når det er nødvendigt og særligt effektiv til musik og i mindre rum, samtidig med at integrationen er fleksibel og betjeningen enkel. Lejlighedsvis brummen eller “blob”-lyde er den primære kritik, men byggekvalitet og værdi vurderes samlet set meget positivt.",
   "headlines": {
    "deep, powerful and precise bass": {
     "sentimentAnalysis": "Anmeldelserne roser subwooferen for at tilføre dyb, kraftig, præcis og hurtig bas, der løfter eksisterende anlæg.",
     "simpleTitle": "Dyb, kraftig og præcis bas",
     "bias": "positive",
     "key": "deep-powerful-precise-bass",
     "groupId": "1e6b8008-3d56-48d7-ad2e-6aaa5b119bdb"
    },
    "simple and flexible integration": {
     "sentimentAnalysis": "Anmeldelserne beskriver enkel betjening og nyttige justeringsmuligheder til integration i et anlæg.",
