  "reviews": {
   "summary": "ARGBERLINSUB10 leverer varm, punchy og præcis bas, der tilføjer dybde og gennemslagskraft til et allerede kapabelt hi-fi-system, især i de laveste oktaver. Ydelsen i mindre rum, den hurtige respons og de fleksible indstillinger for delay eller kabinettype gør subwooferen nem at integrere og meget tilfredsstillende til både musik og film. Lejlighedsvis uforklarlig brummen eller “blob”-lyde forhindrer en helt fejlfri vurdering, men pris og basgengivelse er fremragende.",
   "headlines": {
    "deep, fast and precise bass": {
     "sentimentAnalysis": "Subwooferen roses for sin dybe rækkevidde, hurtige respons, præcise gengivelse og kraftige output, når det behøves.",
     "simpleTitle": "Dyb, hurtig og præcis bas",
     "bias": "positive",
     "key": "deep-fast-and-precise-bass",
     "groupId": "e242b660-a093-4a9c-8530-507403da1206"
    },
    "a major upgrade to the overall system": {
     "sentimentAnalysis": "Den ekstra energi i de dybe frekvenser løfter allerede gode anlæg markant og bringer basgengivelsen op i en højere klasse.",
     "simpleTitle": "En markant opgradering af hele anlægget",
     "bias": "positive",
     "key": "system-upgrade",
     "groupId": "e242b660-a093-4a9c-8530-507403da1206"
    },
    "intermittent humming or blob sounds": {
     "sentimentAnalysis": "To anmeldelser rapporterer om lejlighedsvise uønskede lyde, herunder brummen og blob-lignende lyde, hvor ét problem stadig er uløst.",
     "simpleTitle": "Lejlighedsvis brummen eller blob-lyde",
     "bias": "negative",
