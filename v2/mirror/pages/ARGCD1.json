  "reviews": {
   "summary": "ARGCD1 roses bredt som en velbygget, kompakt og letbetjent cd-afspiller med varm, detaljeret og åben lyd. Afspilleren fungerer især godt sammen med Argon- og Bluesound-systemer og får cd-samlinger til at føles friske og engagerende igen. Små forbehold er manglende genoptagelse ved det sidst afspillede nummer og lejlighedsvis hørbar summen, men den samlede tilfredshed er meget høj.",
   "headlines": {
    "detailed, open and enjoyable sound": {
     "sentimentAnalysis": "Lyden beskrives som detaljeret, åben og af høj kvalitet og er især fornøjelig sammen med passende højttalere og forstærkning.",
     "simpleTitle": "Detaljeret, åben og behagelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "9f771a5b-c040-491d-ba4a-0a161277a06d"
    },
    "strong compatibility with matching systems": {
     "sentimentAnalysis": "Cd-afspilleren beskrives gentagne gange som et harmonisk supplement til Argon-, Bluesound- og andre relaterede lydkomponenter.",
     "simpleTitle": "God kompatibilitet med matchende systemer",
     "bias": "positive",
     "key": "system",
     "groupId": "84cfd105-019b-4bc2-a02d-240659464af9"
    },
    "compact, attractive design": {
     "sentimentAnalysis": "Afspilleren værdsættes for sin kompakte størrelse, flotte udseende og nemme integration i et større lydsystem.",
     "simpleTitle": "Kompakt og flot design",
     "bias": "positive",
     "key": "design",
     "groupId": "d24ca902-b1ac-44dc-977c-c480278879c0"
