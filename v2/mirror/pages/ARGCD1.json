  "reviews": {
   "summary": "ARGCD1 er en kompakt og brugervenlig cd-afspiller, der leverer varm, detaljeret og åben lyd. Byggekvalitet, design og systemkompatibilitet bliver i høj grad værdsat, med dynamisk og medrivende afspilning sammen med Argon og andet lydudstyr. En mindre ulempe er lejlighedsvis mekanisk støj og manglende genoptagelse af afspilningen efter slukning.",
   "headlines": {
    "detailed, open and enjoyable sound": {
     "sentimentAnalysis": "Lyden roses som detaljeret, åben, af høj kvalitet og behagelig i tilsluttede systemer.",
     "simpleTitle": "Detaljeret, åben og behagelig lyd",
     "bias": "positive",
     "key": "detailed_open_sound",
     "groupId": "a45a3915-bfa5-42d7-bf97-04f614cff720"
    },
    "works well with other audio systems": {
     "sentimentAnalysis": "Afspilleren ses som et stærkt supplement til Bluesound, Argon-højttalere og Argon-forstærkere.",
     "simpleTitle": "Fungerer godt med andre lydsystemer",
     "bias": "positive",
     "key": "system_pairing",
     "groupId": "f50aef4e-a5bc-4876-b667-e645fddc3149"
    },
    "compact and well made": {
     "sentimentAnalysis": "Det kompakte format, det flotte design og den solide udførelse bliver værdsat.",
     "simpleTitle": "Kompakt og velbygget",
