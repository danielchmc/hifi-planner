  "reviews": {
   "summary": "ARGCL1BANANAX-bananstikkene leverer varm, ren og pålidelig forbindelse med imponerende nem montering og en pæn, praktisk finish. Den solide metalkonstruktion, gode klemning og kompatibilitet med forskellige kabeltykkelser gør opsætningen af højttalere enkel og elegant. Fremragende værdi og stabil ydeevne opvejes kun lidt af enkelte bekymringer om skrøbelige skruehoveder og en højere pris.",
   "headlines": {
    "simple, tool-free installation": {
     "sentimentAnalysis": "Monteringen beskrives gentagne gange som nem, hurtig og praktisk, også uden lodning.",
     "simpleTitle": "Enkel montering uden lodning",
     "bias": "positive",
     "key": "easy installation",
     "groupId": "39ad2455-083e-449a-8a96-ff8696904077"
    },
    "solid, attractive construction": {
     "sentimentAnalysis": "Anmeldelserne roser stikkene for at være solide, flot udført, attraktive og af høj kvalitet.",
     "simpleTitle": "Solid og flot konstruktion",
     "bias": "positive",
     "key": "solid build",
     "groupId": "52c68539-412a-4611-a32b-a93d4c23de37"
    },
    "secure, clean connections": {
     "sentimentAnalysis": "Forbindelserne opleves som sikre, pæne, nemme at sætte i og fri for knas.",
     "simpleTitle": "Sikre og rene forbindelser",
     "bias": "positive",
     "key": "secure connection",
