  "displayBookDemo": true,
  "reviews": {
   "summary": "Argon Forte A4 MK2 roses bredt for varm, klar, fyldig og overraskende rummelig lyd fra et kompakt aktivhøjttalersystem. Nem opsætning, alsidige tilslutninger og god værdi gør dem populære til tv, computer og musik, ofte som et bedre alternativ til soundbars. Bassen imponerer generelt størrelsen taget i betragtning, men flere savner dybere bas eller mere kontrol, mens enkelte nævner brum, Bluetooth-begrænsninger eller andre betjeningsproblemer.",
   "headlines": {
    "strong value compared with soundbars and larger systems": {
     "sentimentAnalysis": "Mange købere synes, at lydkvalitet, funktioner og kompakt aktivdesign er usædvanligt gode til prisen og ofte overgår soundbars.",
     "simpleTitle": "Stor værdi sammenlignet med soundbars og større anlæg",
     "bias": "positive",
     "key": "value",
     "groupId": "c15c7f62-2775-454c-abb2-6c62ae892566"
    },
    "easy setup and flexible connections": {
     "sentimentAnalysis": "Systemet roses gentagne gange for enkel opsætning og nyttige HDMI-, phono-, optiske, RCA- og Bluetooth-tilslutninger.",
     "simpleTitle": "Nem opsætning og fleksible tilslutninger",
     "bias": "positive",
     "key": "setup_connectivity",
     "groupId": "2383772a-8488-42e2-a473-c0aeb655231c"
    },
    "clear, powerful sound from a small cabinet": {
     "sentimentAnalysis": "Lytterne beskriver gennemgående lyden som klar, detaljeret, afbalanceret og overraskende kraftfuld i forhold til størrelsen.",
     "simpleTitle": "Klar og kraftfuld lyd fra et lille kabinet",
