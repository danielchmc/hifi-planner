  "displayBookDemo": true,
  "reviews": {
   "summary": "Argon FORTE A55 MK2 leverer varm, klar og medrivende lyd med god stereoseparation, punchy bas og imponerende detaljer i forhold til prisen. Det elegante kabinet, den indbyggede forstærker og den nemme opsætning gør højttalerne særligt attraktive til musik og tv. Basdybde, fjernbetjeningens reaktion, forbindelsesstabilitet og manglende tonekontrol kritiseres af nogle, mens en subwoofer af mange opfattes som et supplement snarere end en nødvendighed.",
   "headlines": {
    "warm, clear and detailed sound": {
     "sentimentAnalysis": "Anmeldelserne roser gennemgående den klare, afbalancerede, varme og detaljerede gengivelse samt den gode separation og rene lyd ved høj lydstyrke.",
     "simpleTitle": "Varm, klar og detaljeret lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "666d46f3-b66d-4a8c-b351-34968886c143"
    },
    "deep, punchy bass, with subwoofer support for extra depth": {
     "sentimentAnalysis": "Mange anmeldelser beskriver bassen som fyldig, kraftfuld og imponerende dyb; flere ejere tilføjer en subwoofer for endnu mere basdybde.",
     "simpleTitle": "Dyb og punchy bas, med ekstra dybde fra subwoofer",
     "bias": "positive",
     "key": "bass",
     "groupId": "20d6819c-1b14-4e0b-89f6-21c6055dc693"
    },
    "remote and connection behaviour can be inconsistent": {
     "sentimentAnalysis": "Flere anmeldelser nævner langsom eller svag fjernbetjening, lejlighedsvise problemer med kildeparring og ustabil tv- eller forbindelsesfunktion.",
     "simpleTitle": "Fjernbetjening og forbindelser kan være ustabile",
     "bias": "negative",
     "key": "setup-usability",
     "groupId": "8fcffff1-241b-41c4-908f-fb3b1e2d866a"
    },
    "exceptional value for the price": {
     "sentimentAnalysis": "Anmeldelserne beskriver gentagne gange lyd, funktioner og ydelse som usædvanligt stærke til prisen.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "54b34aa5-43ea-4081-9eab-511180a9793b"
    },
    "elegant furniture-like design": {
     "sentimentAnalysis": "Anmeldelserne roser ofte det stilfulde og elegante design, der passer godt ind i stuen.",
     "simpleTitle": "Elegant design som et møbel",
     "bias": "positive",
     "key": "design",
     "groupId": "79ecb7ae-705d-4382-947d-0a8e4a0b7931"
    },
    "simple active-speaker setup": {
     "sentimentAnalysis": "Ejerne sætter pris på den indbyggede forstærker, plug-and-play-betjeningen og det mindre behov for separate komponenter.",
     "simpleTitle": "Nem opsætning som aktive højttalere",
     "bias": "positive",
     "key": "setup-usability",
     "groupId": "8fcffff1-241b-41c4-908f-fb3b1e2d866a"
    },
    "bass depth can fall short without a subwoofer": {
     "sentimentAnalysis": "En mindre del af anmeldelserne savner dybere bas eller mere fysisk tryk og anbefaler en god subwoofer.",
     "simpleTitle": "Basdybden kan være utilstrækkelig uden subwoofer",
     "bias": "negative",
     "key": "bass",
     "groupId": "20d6819c-1b14-4e0b-89f6-21c6055dc693"
    }
   },
   "grouping": {
