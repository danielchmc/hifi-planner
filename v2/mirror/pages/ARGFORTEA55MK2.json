  "displayBookDemo": true,
  "reviews": {
   "summary": "Argon FORTE A55 MK2 leverer en usædvanligt klar, detaljeret og rummelig lyd med et stærkt stereoperspektiv, imponerende bas og ren gengivelse ved høj lydstyrke. Det elegante gulvhøjttalerdesign, den indbyggede forstærker og den enkle opsætning gør højttalerne til et overbevisende alternativ til en soundbar eller et traditionelt hi-fi-anlæg. En subwoofer kan give endnu mere dybde til basentusiaster, mens en langsom fjernbetjening, lejlighedsvise forbindelsesproblemer og begrænsede muligheder for tonekontrol er de største ulemper.",
   "headlines": {
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne fremhæver konsekvent den klare, varme, velafbalancerede og detaljerede lyd med overbevisende stereobredde til både musik og tv.",
     "simpleTitle": "Klar, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "2e7a3aad-377a-4da9-9646-0f45bd2ebe15"
    },
    "remote control and connection quirks": {
     "sentimentAnalysis": "Et mindretal af anmeldelserne nævner langsom eller svag fjernbetjening, upålidelig parring eller kildeskift samt lejlighedsvise problemer med at tænde sammen med tv'et.",
     "simpleTitle": "Udfordringer med fjernbetjening og forbindelser",
     "bias": "negative",
     "key": "usability",
     "groupId": "ed28b870-157d-41c3-b843-78c5aea34187"
    },
    "powerful bass, with subwoofer recommended for extra depth": {
     "sentimentAnalysis": "Mange anmeldelser beskriver en kraftig, dyb og rumfyldende bas; flere ejere tilføjer en subwoofer for endnu mere tyngde i de dybe frekvenser.",
     "simpleTitle": "Kraftig bas, subwoofer anbefales for mere dybde",
     "bias": "positive",
     "key": "bass",
     "groupId": "ad4ee691-a110-4bac-a4cf-0df909819362"
    },
    "elegant design and furniture-friendly appearance": {
     "sentimentAnalysis": "Højttalerne værdsættes bredt for et stilfuldt og solidt design, der er attraktivt nok til at indgå som en del af indretningen.",
     "simpleTitle": "Elegant design og møbelvenligt udtryk",
     "bias": "positive",
     "key": "design",
     "groupId": "b78b98e4-0eb4-49cd-8913-5706a0f8d519"
    },
    "simple active-speaker setup": {
     "sentimentAnalysis": "Den indbyggede forstærker, de nyttige tilslutninger og plug-and-play-betjeningen roses gentagne gange som et praktisk alternativ til en separat forstærker.",
     "simpleTitle": "Enkel opsætning af aktive højttalere",
     "bias": "positive",
     "key": "usability",
     "groupId": "ed28b870-157d-41c3-b843-78c5aea34187"
    },
    "insufficient bass without a subwoofer": {
     "sentimentAnalysis": "Flere basorienterede lyttere synes, at de dybeste frekvenser ikke rækker, og anser en god subwoofer for nødvendig for fuld effekt.",
     "simpleTitle": "Til tider for lidt bas uden subwoofer",
     "bias": "negative",
     "key": "bass",
     "groupId": "ad4ee691-a110-4bac-a4cf-0df909819362"
    }
   },
   "grouping": {
    "2e7a3aad-377a-4da9-9646-0f45bd2ebe15": {
     "title": "Lydkvalitet",
