  "displayBookDemo": true,
  "reviews": {
   "summary": "Argon FORTE A55 MK2 roses bredt for varm, klar og detaljeret lyd, stærkt stereoperspektiv, dyb og kontant bas samt høj lydstyrke uden forvrængning. Det elegante design, den indbyggede forstærker og de enkle tilslutningsmuligheder gør højttalerne til et attraktivt alternativ til en soundbar eller et traditionelt hi-fi-anlæg. Nogle lyttere savner endnu dybere bas eller bedre mulighed for at justere mellemtonen, mens fjernbetjeningens reaktion, kildeskift og automatisk tv-tænding lejlighedsvis skuffer.",
   "headlines": {
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en ren, varm, velafbalanceret og meget detaljeret gengivelse med overbevisende stereodybde og ingen hørbar forvrængning ved høj lydstyrke.",
     "simpleTitle": "Klar, detaljeret og omsluttende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "042f232e-fcb6-475c-b1b4-2de9f0ff0174"
    },
    "powerful bass, with some listeners adding a subwoofer": {
     "sentimentAnalysis": "De fleste kommentarer roser bassens punch, dybde og fyldige virkning i rummet, mens flere bemærker, at en subwoofer giver ekstra dybbas uden at være nødvendig.",
     "simpleTitle": "Kraftig bas, men nogle lyttere tilføjer en subwoofer",
     "bias": "positive",
     "key": "bass",
     "groupId": "c2aa1231-1a7f-4b44-8b4a-f0a3ec43861f"
    },
    "some listeners want more bass or midrange adjustment": {
     "sentimentAnalysis": "Et mindretal af anmeldelserne oplever, at bassen ikke går dybt nok, eller at mellemtonen ikke kan justeres tilstrækkeligt; problemet løses ofte med en subwoofer eller equalizer.",
     "simpleTitle": "Nogle lyttere savner mere bas eller justering af mellemtonen",
     "bias": "negative",
     "key": "bass",
     "groupId": "c2aa1231-1a7f-4b44-8b4a-f0a3ec43861f"
    },
    "elegant furniture-like design": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent højttalerne som stilfulde, elegante og nemme at integrere i hjemmet.",
     "simpleTitle": "Elegant, møbellignende design",
     "bias": "positive",
     "key": "design",
     "groupId": "e26d70c8-0882-4e2a-aac7-bbe7e4ffad68"
    },
    "simple active-speaker setup": {
     "sentimentAnalysis": "Den indbyggede forstærker, de nyttige indgange og den enkle opsætning værdsættes gentagne gange som et praktisk alternativ til separate hi-fi-komponenter.",
     "simpleTitle": "Enkel opsætning med aktive højttalere",
     "bias": "positive",
     "key": "usability",
     "groupId": "e759659a-0add-4284-8d0d-5c328a405c5f"
    },
    "remote and TV-control behaviour can be unreliable": {
     "sentimentAnalysis": "Flere anmeldelser nævner forsinket eller svag reaktion fra fjernbetjeningen, upålidelig parring eller kildeskift samt lejlighedsvise problemer med automatisk tv-tænding.",
     "simpleTitle": "Fjernbetjening og tv-styring kan være ustabil",
     "bias": "negative",
     "key": "usability",
     "groupId": "e759659a-0add-4284-8d0d-5c328a405c5f"
    }
   },
