  "displayBookDemo": true,
  "reviews": {
   "summary": "ARGFORUS4WX leverer en bemærkelsesværdig klar, detaljeret og fyldig lyd i forhold til den kompakte størrelse og fungerer især godt som vægmonterede surround- eller ekstrahøjttalere. Det slanke, attraktive design og den nemme montering gør højttalerne meget praktiske til diskret placering. Pris-kvalitetsforholdet er fremragende, selv om dyb bas og skala er begrænset ved brug som primære musikhøjttalere uden subwoofer.",
   "headlines": {
    "clear, full and detailed sound": {
     "sentimentAnalysis": "Højttalerne roses gentagne gange for en klar, ren, fyldig og detaljeret lyd, som er særligt imponerende i forhold til den lille størrelse.",
     "simpleTitle": "Klar, fyldig og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "ecc6477a-d3dd-45be-a184-4b6f43e682b6"
    },
    "strong performance for surround and secondary systems": {
     "sentimentAnalysis": "De kompakte højttalere vurderes gennemgående som meget effektive som bag-, surround- eller ekstrahøjttalere og supplerer eksisterende systemer godt.",
     "simpleTitle": "Stærk ydelse til surround- og ekstrasystemer",
     "bias": "positive",
     "key": "surround_use",
     "groupId": "a144178d-a4b2-4713-88fa-4decdfbfcc90"
    },
    "slim design and easy wall mounting": {
     "sentimentAnalysis": "Det slanke udseende, de kompakte mål og den enkle vægmontering fremhæves gentagne gange som praktiske og attraktive.",
     "simpleTitle": "Slankt design og nem vægmontering",
     "bias": "positive",
     "key": "design_installation",
     "groupId": "c1c4be46-7754-4dfa-9fbb-c5a7832e2bff"
    },
    "limited depth for main music use": {
     "sentimentAnalysis": "Det kompakte kabinet leverer mindre dyb og storslået musikgengivelse som hovedhøjttaler, især uden en subwoofer.",
     "simpleTitle": "Begrænset dybde til musik som hovedhøjttaler",
     "bias": "negative",
     "key": "sound",
     "groupId": "ecc6477a-d3dd-45be-a184-4b6f43e682b6"
    }
   },
