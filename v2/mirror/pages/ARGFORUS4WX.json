  "displayBookDemo": true,
  "reviews": {
   "summary": "ARGFORUS4WX leverer en imponerende klar, detaljeret og fyldig lyd for så kompakte væghøjttalere med varm, slagkraftig og omsluttende gengivelse i surround-, TV- og sekundære rum. Det slanke design, den nemme vægmontering og den gode værdi gør højttalerne særligt attraktive, hvor pladsen er begrænset. Basdybden er begrænset til krævende musik som fronthøjttalere, men en subwoofer eller større fuldtoneshøjttalere kan afhjælpe begrænsningen.",
   "headlines": {
    "clear, detailed and full sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver lyden som klar, ren, detaljeret, fyldig og overraskende kraftfuld i forhold til den kompakte størrelse.",
     "simpleTitle": "Klar, detaljeret og fyldig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "a8d3e3e1-9ec7-4608-99e3-d247d06d368e"
    },
    "effective surround and secondary-room speakers": {
     "sentimentAnalysis": "Anmeldelserne roser højttalerne til surroundkanaler, udfyldning af akustiske huller og brug i køkkener og andre sekundære rum.",
     "simpleTitle": "Effektive surround- og sekundære højttalere",
     "bias": "positive",
     "key": "surround",
     "groupId": "23352508-f7f4-42f4-aaaa-22990c43f711"
    },
    "slim, attractive and easy to mount": {
     "sentimentAnalysis": "Anmeldelserne fremhæver det slanke udseende, den diskrete placering på væggen og den nemme montering.",
     "simpleTitle": "Slankt, flot og nemt at montere",
     "bias": "positive",
     "key": "design",
     "groupId": "bfaaf79d-1890-4e89-a6e0-dbefa848835d"
    },
    "strong value for the price": {
     "sentimentAnalysis": "Anmeldelserne vurderer konsekvent højttalerne som et godt eller fremragende køb, især i forhold til lydkvaliteten og den kompakte størrelse.",
     "simpleTitle": "God værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "412cf67b-4c5e-46b8-87b3-4c4159a050bf"
    },
    "limited depth for main-speaker music": {
     "sentimentAnalysis": "Anmeldelserne vurderer højttalerne som velegnede til tale og surround, men savner den dybde, som større fronthøjttalere giver.",
     "simpleTitle": "Begrænset dybde til musik som fronthøjttaler",
     "bias": "negative",
     "key": "sound",
     "groupId": "a8d3e3e1-9ec7-4608-99e3-d247d06d368e"
    }
   },
