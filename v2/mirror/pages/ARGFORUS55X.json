  "displayBookDemo": true,
  "reviews": {
   "summary": "Argon Audio FORUS 55 leverer en varm, kraftfuld og bemærkelsesværdigt detaljeret lyd med imponerende balance i hele frekvensområdet. En stærk bas, klare mellemtoner og behagelige diskanttoner skaber en omsluttende oplevelse til musik, tv og film, mens det kompakte gulvhøjttalerdesign passer til mindre rum. Fremragende værdi, elegant design og bred forstærkerkompatibilitet gør FORUS 55 til en varm anbefaling, mens en subwoofer kun er nødvendig for de dybeste bastoner.",
   "headlines": {
    "exceptional value for the price": {
     "sentimentAnalysis": "Anmeldelserne beskriver gentagne gange lydkvaliteten som langt bedre, end prisen antyder, med stor værdi sammenlignet med dyrere alternativer.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "72b6e277-ae90-4b6a-b6a9-8dc62deda4ce"
    },
    "elegant, compact design": {
     "sentimentAnalysis": "Højttalerne roses ofte for elegant design, attraktive overflader, solid konstruktion og en størrelse, der passer til mindre rum.",
     "simpleTitle": "Elegant, kompakt design",
     "bias": "positive",
     "key": "design",
     "groupId": "b3f76c21-dc5f-4983-9bbe-ff80fa2cc655"
    },
    "warm, detailed and balanced sound": {
     "sentimentAnalysis": "Anmeldelserne roser en naturlig, klar, detaljeret og velafbalanceret gengivelse med overbevisende dynamik i hele frekvensområdet.",
     "simpleTitle": "Varm, detaljeret og velafbalanceret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "1e5e2ff0-5498-4a80-b91f-138bfbdf568b"
    },
    "strong bass, with optional subwoofer depth": {
     "sentimentAnalysis": "De fleste kommentarer om bassen beskriver god fylde, kraft og udstrækning; flere finder højttalerne tilstrækkelige alene, mens andre tilføjer en subwoofer til de dybeste frekvenser.",
     "simpleTitle": "Kraftig bas med valgfri subwoofer-dybde",
     "bias": "positive",
     "key": "bass",
     "groupId": "8feea407-5797-410e-85ed-d232bc529516"
    },
    "bass can sound too prominent or thin": {
     "sentimentAnalysis": "Et lille mindretal oplever begrænsninger i basbalancen, fra for dominerende til relativt tynd bas afhængigt af rum, placering og forventninger.",
     "simpleTitle": "Bassen kan virke for dominerende eller tynd",
     "bias": "negative",
     "key": "bass",
     "groupId": "8feea407-5797-410e-85ed-d232bc529516"
    }
   },
