  "displayBookDemo": true,
  "reviews": {
   "summary": "Argon Audio FORUS 55 leverer en varm, detaljeret og begejstrende lyd med et stærkt forhold mellem pris og kvalitet. Det kompakte gulvhøjttalerdesign passer også i mindre rum og giver stadig en fyldig bas, klare mellemtoner og en omsluttende lyd ved både lav og høj lydstyrke. Bassen får generelt ros, men en subwoofer eller omhyggelig placering kan være relevant for meget dyb eller præcis bas.",
   "headlines": {
    "excellent value for money": {
     "sentimentAnalysis": "Højttalerne vurderes bredt til at overgå prisen og levere overbevisende hi-fi-ydelse uden et stort budget.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "excellent-value",
     "groupId": "179a1324-1649-40e2-882e-b2289a8e887c"
    },
    "powerful bass from a compact speaker": {
     "sentimentAnalysis": "Bassen roses som fyldig, glat, kraftfuld og overraskende stærk i forhold til højttalernes relativt kompakte størrelse.",
     "simpleTitle": "Kraftig bas fra en kompakt højttaler",
     "bias": "positive",
     "key": "powerful-bass",
     "groupId": "c478fffb-9366-4ab3-b6ad-a381507f4125"
    },
    "compact and attractive design": {
     "sentimentAnalysis": "Det kompakte kabinet, det attraktive udseende og den nemme placering i stuer fremhæves gentagne gange som designfordele.",
     "simpleTitle": "Kompakt og attraktivt design",
     "bias": "positive",
     "key": "compact-attractive-design",
     "groupId": "01da7336-1394-490b-90d7-4cbdb73abad2"
    },
    "warm, detailed and natural sound": {
     "sentimentAnalysis": "Lyden beskrives gentagne gange som varm, afbalanceret, naturlig, klar og meget detaljeret i hele frekvensområdet.",
     "simpleTitle": "Varm, detaljeret og naturlig lyd",
     "bias": "positive",
     "key": "warm-detailed-sound",
     "groupId": "c478fffb-9366-4ab3-b6ad-a381507f4125"
    },
    "deep bass may need a subwoofer": {
     "sentimentAnalysis": "Flere lyttere nyder bassen, men anbefaler en subwoofer til de dybeste frekvenser eller en mere fyldig basgengivelse.",
     "simpleTitle": "Dyb bas kan kræve en subwoofer",
     "bias": "negative",
     "key": "subwoofer-depth",
     "groupId": "c478fffb-9366-4ab3-b6ad-a381507f4125"
    },
    "some listeners find the midrange imprecise": {
     "sentimentAnalysis": "Et mindre mindretal beskriver for fremtrædende bas, afdæmpede diskanttoner og en upræcis mellemtone i forhold til forventningerne.",
     "simpleTitle": "Nogle lyttere oplever mellemtonen som upræcis",
     "bias": "negative",
     "key": "midrange-precision",
     "groupId": "c478fffb-9366-4ab3-b6ad-a381507f4125"
    }
   },
