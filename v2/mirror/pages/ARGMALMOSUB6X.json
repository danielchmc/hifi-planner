  "displayBookDemo": true,
  "reviews": {
   "summary": "Malmö SUB 6 er en imponerende kompakt subwoofer, der tilfører varme, punchy og overraskende kraftige basfrekvenser til små og mellemstore anlæg. Musik, film og TV får et fyldigere og mere omsluttende lydbillede, mens det kompakte kabinet nemt integreres med reolhøjttalere og aktive systemer. Det gode pris-kvalitetsforhold og den enkle justering fremhæves ofte, selv om den dybeste bas og finjusteringen ikke tilfredsstiller alle.",
   "headlines": {
    "outstanding value for money": {
     "sentimentAnalysis": "Malmö SUB 6 opfattes bredt som en prisvenlig måde at tilføre et eksisterende anlæg markant mere bas på.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "3820d539-1e40-471b-9d85-d170ef417f36"
    },
    "surprisingly powerful, full-bodied bass": {
     "sentimentAnalysis": "Subwooferen roses gentagne gange for dyb, kontant og rumfyldende bas trods det lille kabinet.",
     "simpleTitle": "Overraskende kraftig og fyldig bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "6982b218-b3b8-4eaf-81dd-b5b3edf611f2"
    },
    "easy to integrate and tune": {
     "sentimentAnalysis": "Betjening og integration opleves generelt som enkel, så niveau og delefrekvens kan tilpasses rum og højttalere.",
     "simpleTitle": "Nem at integrere og justere",
     "bias": "positive",
     "key": "adjustment",
     "groupId": "760b10c1-0c21-4eb4-9191-7d36a4bf88c1"
    },
    "clear, tight and musical integration": {
     "sentimentAnalysis": "Flere anmeldelser beskriver bassen som klar, kontrolleret, varm og musikalsk frem for buldrende.",
     "simpleTitle": "Klar, stram og musikalsk gengivelse",
     "bias": "positive",
     "key": "sound",
     "groupId": "6982b218-b3b8-4eaf-81dd-b5b3edf611f2"
    },
    "deepest bass is limited": {
     "sentimentAnalysis": "En mindre del bemærker, at subwooferen ikke går så dybt eller lyder så detaljeret som større eller dyrere alternativer.",
     "simpleTitle": "Begrænset dybbas",
     "bias": "negative",
     "key": "sound",
     "groupId": "6982b218-b3b8-4eaf-81dd-b5b3edf611f2"
    }
   },
