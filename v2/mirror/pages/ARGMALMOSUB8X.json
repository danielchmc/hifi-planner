  "displayBookDemo": true,
  "reviews": {
   "summary": "Argon Malmö SUB 8 roses bredt for at tilføre dyb, varm, kontrolleret og rumfyldende bas til musik, film og TV. De kompakte mål, det flotte design, den nemme integration med mange højttalersystemer og den stærke værdi gør subwooferen til en populær opgradering, især i små og mellemstore rum. Enkelte nævner brummen, automatisk standby samt udfordringer med placering eller niveaujustering, mens bassen i større rum eller ved krævende filmbrug kan opleves som for beskeden.",
   "headlines": {
    "strong value for the price": {
     "sentimentAnalysis": "Kombinationen af ydelse, kompakt størrelse og pris vurderes gentagne gange som fremragende.",
     "simpleTitle": "Stærk værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "f793d984-1bec-4d42-aa76-80469f6eae21"
    },
    "deep, warm and controlled bass": {
     "sentimentAnalysis": "Bassen beskrives gentagne gange som dyb, varm, ren, præcis og velkontrolleret.",
     "simpleTitle": "Dyb, varm og kontrolleret bas",
     "bias": "positive",
     "key": "bass",
     "groupId": "a4c17e7d-1ff9-46e0-95c6-b00783d042dc"
    },
    "a major upgrade for music, film and TV": {
     "sentimentAnalysis": "Subwooferen tilfører mærkbart mere dybde, fylde og indlevelse til både musik og hjemmebio.",
     "simpleTitle": "En stor opgradering til musik, film og TV",
     "bias": "positive",
     "key": "bass",
     "groupId": "a4c17e7d-1ff9-46e0-95c6-b00783d042dc"
    },
    "compact and easy to place": {
     "sentimentAnalysis": "Det kompakte kabinet passer godt i små og mellemstore rum og opleves som flot og nemt at placere.",
     "simpleTitle": "Kompakt og nem at placere",
     "bias": "positive",
     "key": "size_design",
     "groupId": "618c3f46-5b62-4451-85dd-42102e1305b1"
