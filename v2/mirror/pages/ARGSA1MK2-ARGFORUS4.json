       },
       "compact design with ample power": {
        "sentimentAnalysis": "Det lille format, det diskrete udseende og den store kraft fremhæves gentagne gange som klare styrker, især hvor pladsen er begrænset.",
        "simpleTitle": "Kompakt design med masser af kraft",
        "bias": "positive",
        "key": "compact-design",
        "groupId": "637f3374-b8d1-4e41-b775-fa98762f9a2b"
       },
       "hdmi ARC makes TV audio effortless": {
        "sentimentAnalysis": "HDMI ARC værdsættes for enkel TV-tilslutning, automatisk tænd/sluk og praktisk lydstyring via TV-fjernbetjeningen.",
        "simpleTitle": "HDMI ARC gør TV-lyd nemt",
        "bias": "positive",
        "key": "tv-audio",
        "groupId": "2217260f-e2d8-49a2-9ec1-313ce904c5a2"
