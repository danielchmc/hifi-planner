  "displayBookDemo": true,
  "reviews": {
   "summary": "ARGON SOLO bringer moderne streamingmuligheder til ældre hi-fi-anlæg til en imponerende lav pris. Varm, klar og dynamisk lyd med gode detaljer og et åbent, medrivende lydbillede bliver fremhævet igen og igen og overgår ofte simple Bluetooth-streamere og ældre indbyggede løsninger. Opsætning og trådløs stabilitet kan af og til være frustrerende, mens Ethernet, Tidal Connect, display og egen app mangler; samlet set gør lydkvaliteten og prisen SOLO til en særdeles attraktiv opgradering.",
   "headlines": {
    "wireless dropouts and reconnects": {
     "sentimentAnalysis": "En tydelig minoritet oplever Wi-Fi- eller AirPlay-udfald, mistet kontakt og lejlighedsvis behov for at afbryde strømmen.",
     "simpleTitle": "Trådløse udfald og genforbindelser",
     "bias": "negative",
     "key": "reliability",
     "groupId": "842678a3-d389-48c0-9e7a-feb316c789ce"
    },
    "warm, detailed and open sound": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, åbne og detaljerede lyd med kraftfuld bas og god separation.",
     "simpleTitle": "Varm, detaljeret og åben lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "1137c783-4431-4499-ac1e-af303f27326f"
    },
    "a strong upgrade for older systems": {
     "sentimentAnalysis": "Solo’en værdsættes igen og igen for at tilføre moderne streaming til ældre forstærkere og højttalere uden at udskifte anlægget.",
     "simpleTitle": "En stærk opgradering til ældre anlæg",
     "bias": "positive",
     "key": "compatibility",
     "groupId": "128d6067-559e-4a65-aff4-0a680f3424ea"
    },
    "simple installation and everyday control": {
     "sentimentAnalysis": "Mange anmeldelser beskriver en hurtig og enkel opsætning samt praktisk betjening via velkendte telefonapps.",
     "simpleTitle": "Nem opsætning og betjening",
     "bias": "positive",
     "key": "setup",
     "groupId": "98b94961-1028-4602-a5be-6dca43644d4e"
    },
    "missing Ethernet and dedicated app": {
     "sentimentAnalysis": "Nogle anmeldelser kritiserer manglen på Ethernet, Tidal Connect, display, fjernbetjening og egen app, hvilket begrænser selvstændighed og fleksibilitet.",
     "simpleTitle": "Manglende Ethernet og egen app",
     "bias": "negative",
     "key": "compatibility",
     "groupId": "128d6067-559e-4a65-aff4-0a680f3424ea"
    }
