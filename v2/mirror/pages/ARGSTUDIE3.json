  "displayBookDemo": true,
  "reviews": {
   "summary": "ARGON AUDIO STUDIE3 leverer en bemærkelsesværdig klar, balanceret og dynamisk lyd fra et kompakt desktopdesign. Varm, slagkraftig bas, præcise højder og et medrivende stereobillede gør musik, film og spil til en stor fornøjelse, mens alsidige tilslutninger og solid konstruktion giver høj praktisk værdi. Mindre irritationsmomenter er manglen på en fysisk volumenkontrol, følsom USB-C-kabelkompatibilitet og en til tider upraktisk automatisk tændingsfunktion.",
   "headlines": {
    "clear, balanced and dynamic sound": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, balancerede, detaljerede og dynamiske gengivelse, især de præcise højder og den musikalske lyd.",
     "simpleTitle": "Klar, balanceret og dynamisk lyd",
     "bias": "positive",
     "key": "clear-balanced-sound",
     "groupId": "b9bd43c2-79cd-4c55-9719-a9633123aeec"
    },
    "premium construction and compact styling": {
     "sentimentAnalysis": "Anmeldelserne beskriver højttalerne som solidt byggede, stabile, attraktive og ideelle til skriveborde eller små rum.",
     "simpleTitle": "Førsteklasses konstruktion og kompakt design",
     "bias": "positive",
     "key": "premium-compact-design",
     "groupId": "7094df77-df7a-4e3d-b720-502de2b26995"
    },
    "surprisingly strong bass from a compact speaker": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den overraskende kraftige og slagkraftige bas i forhold til størrelsen, og nogle finder en subwoofer unødvendig.",
     "simpleTitle": "Overraskende kraftig bas fra en kompakt højttaler",
     "bias": "positive",
     "key": "strong-bass",
     "groupId": "b9bd43c2-79cd-4c55-9719-a9633123aeec"
    },
    "versatile connections and useful sound controls": {
     "sentimentAnalysis": "Anmeldelserne værdsætter de mange tilslutningsmuligheder, fjernbetjeningen samt justerbar bas, diskant og lydtilstande.",
     "simpleTitle": "Alsidige tilslutninger og praktiske lydindstillinger",
     "bias": "positive",
     "key": "versatile-controls",
     "groupId": "3990250f-f4e1-4d0b-a026-fc0d84e2c5c4"
    },
    "bass can feel limited": {
     "sentimentAnalysis": "Et mindretal af anmeldelserne oplever bassen som begrænset, især i betragtning af det kompakte kabinet, trods de overvejende positive basindtryk.",
     "simpleTitle": "Bassen kan virke begrænset",
     "bias": "negative",
     "key": "limited-bass",
     "groupId": "b9bd43c2-79cd-4c55-9719-a9633123aeec"
    },
    "lack of a physical volume control": {
     "sentimentAnalysis": "Den manglende volumeknap på højttaleren gør regulering af lydstyrken mindre bekvem for nogle skrivebordsbrugere.",
     "simpleTitle": "Mangel på fysisk volumenkontrol",
     "bias": "negative",
     "key": "no-volume-knob",
     "groupId": "3990250f-f4e1-4d0b-a026-fc0d84e2c5c4"
    },
    "auto-on behavior can be inconvenient": {
     "sentimentAnalysis": "Nogle anmeldelser kritiserer den langsomme eller upraktiske automatiske aktivering samt manglen på mulighed for at deaktivere den helt.",
     "simpleTitle": "Automatisk tænding kan være upraktisk",
     "bias": "negative",
     "key": "auto-on-issues",
     "groupId": "3990250f-f4e1-4d0b-a026-fc0d84e2c5c4"
    }
   },
