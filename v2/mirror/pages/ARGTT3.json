  "displayBookDemo": true,
  "reviews": {
   "summary": "Argon TT-3 bliver generelt betragtet som en stilfuld, solid og prisvenlig manuel pladespiller. Den varme, klare og detaljerede lyd giver nyt liv til gamle vinylplader, især efter en opgradering med en Ortofon-nål. Den enkle betjening og muligheden for opgraderinger er store styrker, mens manglen på automatisk løft og stop ved pladens slutning er den tydeligste kritik; opsætningen kan også kræve lidt omhu.",
   "headlines": {
    "warm, detailed sound brings old vinyl to life": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent den varme, klare, detaljerede og medrivende gengivelse og beskriver ofte markante forbedringer i forhold til ældre pladespillere og digitale kilder.",
     "simpleTitle": "Varm og detaljeret lyd giver gamle plader nyt liv",
     "bias": "positive",
     "key": "sound_warm_detailed",
     "groupId": "1127cfde-229c-41a6-b6bd-f475ab57af7f"
    },
    "automatic end-of-record stop is missing": {
     "sentimentAnalysis": "Det fuldt manuelle design accepteres af nogle ejere, men kritiseres gentagne gange, fordi tallerkenen fortsætter med at dreje, og tonearmen skal føres tilbage manuelt efter afspilning.",
     "simpleTitle": "Automatisk stop ved pladens slutning mangler",
     "bias": "negative",
     "key": "automation_missing",
     "groupId": "bed8c79c-4a0f-4043-ad50-8a1f667f9fcb"
    },
    "stylus upgrades noticeably improve performance": {
     "sentimentAnalysis": "Ejerne værdsætter den udskiftelige pickup og nål, og Ortofon-opgraderinger beskrives ofte som en forbedring af klarhed, detaljer, dynamik og musikalitet.",
     "simpleTitle": "Opgradering af nålen forbedrer lyden mærkbart",
     "bias": "positive",
     "key": "upgrade_stylus",
     "groupId": "9647699a-e5b9-4dae-b649-64c8f80f5e18"
    },
    "excellent value with a straightforward feature set": {
     "sentimentAnalysis": "TT-3 beskrives gentagne gange som prisvenlig, ærlig og meget kompetent til prisen, hvor minimalismen ses som en bevidst styrke.",
     "simpleTitle": "Fremragende værdi med en enkel funktionalitet",
     "bias": "positive",
     "key": "value_simple",
     "groupId": "5deb0c82-d767-4cdd-8c09-033ad00e0d47"
    },
    "stylish, solid and minimalist construction": {
     "sentimentAnalysis": "Det rene, moderne udtryk og den solide konstruktion fremhæves ofte, og pladespilleren roses både som funktionel og som et kvalitetsmøbel.",
     "simpleTitle": "Stilren, solid og minimalistisk konstruktion",
     "bias": "positive",
     "key": "design_solid",
     "groupId": "2f86be7c-5848-410f-be8a-37e4dd8014c4"
    }
   },
