  "displayBookDemo": true,
  "reviews": {
   "summary": "Argon TT-3 er en stilfuld, solid og meget musikalsk pladespiller med varm, detaljeret og punchy lyd til en attraktiv pris. Den enkle manuelle betjening, brede systemkompatibilitet og nemme opgraderingsmuligheder gør TT-3 særligt attraktiv for nye vinyllyttere og dem, der vender tilbage til vinyl. Den største indvending er manglen på automatisk løft og stop ved pladens slutning, mens opsætningen kan kræve lidt omhu.",
   "headlines": {
    "warm, detailed and powerful sound": {
     "sentimentAnalysis": "Lyden beskrives gentagne gange som varm, klar, detaljeret, dynamisk og fornøjelig og giver ofte ældre plader nyt liv.",
     "simpleTitle": "Varm, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "01b338a0-9e61-4c27-8d3b-c1834b518ec8"
    },
    "easy to use and good value for money": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent TT-3 som en prisvenlig, kompetent og brugervenlig indgang til vinyl med stor værdi for pengene.",
     "simpleTitle": "Nem betjening og god værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "4b353e1d-f29a-4abf-87f2-ed634c5854b2"
    },
    "flexible cartridge and stylus upgrades": {
