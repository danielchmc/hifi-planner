  "reviews": {
   "summary": "Argon TT-4 MK2 roses bredt for sin varme, detaljerede og medrivende lyd, solide byggekvalitet, attraktive minimalistiske design og gode værdi for pengene. Ortofon 2M Blue-pickuppen og den indbyggede RIAA-forforstærker fremhæves ofte og gør afspilleren nem at integrere i forskellige anlæg. Den mest gennemgående kritik er manglen på automatisk start/stop eller løft af tonearmen, mens opsætningen kræver lidt omhu. Den varme, slagkraftige og detaljerige gengivelse giver gamle plader nyt liv.",
   "headlines": {
    "stylish, solid construction": {
     "sentimentAnalysis": "Anmeldelserne beskriver ofte pladespilleren som attraktiv, minimalistisk, velbygget, stabil og så flot, at den pynter i rummet.",
     "simpleTitle": "Stilfuld og solid konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "50881957-8c21-4602-87af-a7c6ab4229b2"
    },
    "missing automatic end-of-record stop": {
     "sentimentAnalysis": "Mange ejere ser manglen på automatisk stop eller løft af tonearmen som den tydeligste brugsmæssige ulempe, fordi pladen fortsætter med at dreje og kræver opsyn.",
     "simpleTitle": "Manglende automatisk stop ved pladeslut",
     "bias": "negative",
     "key": "autostop",
     "groupId": "b155b962-6d1c-4eda-b289-3ed6a892eee7"
    },
    "warm, detailed and immersive sound": {
     "sentimentAnalysis": "Pladespilleren roses gentagne gange for varm, klar, dyb, dynamisk og meget detaljeret gengivelse, der afslører nye nuancer i velkendte plader.",
     "simpleTitle": "Varm, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "22252b26-ce17-4492-b374-8bbe97c66ff6"
    },
    "excellent Ortofon 2M Blue cartridge": {
     "sentimentAnalysis": "Den medfølgende Ortofon 2M Blue-pickup ses som en vigtig årsag til den præcise, detaljerede og levende lyd, og muligheden for opgradering værdsættes også.",
     "simpleTitle": "Fremragende Ortofon 2M Blue-pickup",
     "bias": "positive",
     "key": "sound",
     "groupId": "22252b26-ce17-4492-b374-8bbe97c66ff6"
    },
    "setup is straightforward with guidance": {
     "sentimentAnalysis": "Tydelige vejledninger, videoer og hjælp i butikken gør opsætning og daglig betjening overskuelig for både begyndere og erfarne brugere.",
     "simpleTitle": "Enkel opsætning med vejledning",
     "bias": "positive",
     "key": "setup",
     "groupId": "c082e142-7c6b-4e20-a9f4-89302da7817b"
    }
   },
