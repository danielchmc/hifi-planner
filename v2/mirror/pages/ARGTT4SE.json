  "displayBookDemo": true,
  "reviews": {
   "summary": "ARGON TT-4 SE leverer varm, detaljeret og dynamisk vinylgengivelse med et imponerende stereoperspektiv, kontant bas og fremragende klarhed. Ortofon 2M Bronze-pickuppen, den solide konstruktion og det elegante design gør pladespilleren til en markant opgradering og et stærkt køb i prisklassen. Den manuelle betjening og en til tider krævende opsætning er de væsentligste forbehold, men lytteoplevelsen får samlet set stor ros.",
   "headlines": {
    "elegant, solid construction": {
     "sentimentAnalysis": "Anmeldelserne fremhæver konsekvent den eksklusive finish, det attraktive minimalistiske design, den solide konstruktion og det iøjnefaldende udtryk.",
     "simpleTitle": "Elegant og solid konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "b736b62f-9d09-413e-819a-a4f07c8c19ed"
    },
    "warm, detailed and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, varme og detaljerede gengivelse, den kraftige bas, den gode stereoadskillelse og den rummelige lydscene.",
     "simpleTitle": "Varm, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "4f935b83-2bd2-40ab-a048-e87209342c26"
    },
    "a major upgrade for vinyl collections": {
     "sentimentAnalysis": "Flere anmeldelser beskriver TT-4 SE som en markant forbedring i forhold til ældre eller billigere pladespillere, der afslører hidtil uhørte detaljer og giver gamle plader nyt liv.",
     "simpleTitle": "En stor opgradering af pladesamlingen",
     "bias": "positive",
     "key": "sound",
     "groupId": "4f935b83-2bd2-40ab-a048-e87209342c26"
    },
    "ortofon Bronze adds refinement and value": {
     "sentimentAnalysis": "Den medfølgende Ortofon 2M Bronze-pickup fremhæves gentagne gange for flere detaljer, bedre dynamik og høj samlet værdi, mens den indbyggede RIAA også får ros.",
     "simpleTitle": "Ortofon Bronze giver bedre lyd og værdi",
     "bias": "positive",
     "key": "cartridge",
     "groupId": "3dea4b7c-6b3a-43c8-aa82-4c0490d23c12"
    },
    "manual operation and setup can take patience": {
     "sentimentAnalysis": "Nogle anmeldelser finder justering af tonearm, jordforbindelse og manuel betjening mere krævende end forventet, mens enkelte savner automatiske armfunktioner.",
     "simpleTitle": "Manuel betjening og opsætning kræver tålmodighed",
     "bias": "negative",
     "key": "setup",
     "groupId": "5a509036-5bc3-4448-9ead-54fc420580c8"
    }
   },
