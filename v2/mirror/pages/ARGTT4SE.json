  "displayBookDemo": true,
  "reviews": {
   "summary": "ARGON TT-4 SE roses bredt for et eksklusivt udseende samt en varm, klar, detaljeret og dynamisk lyd. Den medfølgende Ortofon 2M Bronze-pickup er et stort højdepunkt, som afslører nye detaljer og giver gamle vinylplader nyt liv, mens byggekvalitet og værdi generelt vurderes stærkt i prisklassen. Manuel opsætning og manglen på automatisk tonearmsfunktion kræver lidt tilvænning, og enkelte anmeldelser nævner følsomhed over for stød, forvrængning eller brum, men den samlede vurdering er meget begejstret og anbefaler pladespilleren varmt.",
   "headlines": {
    "premium design and solid construction": {
     "sentimentAnalysis": "Pladespilleren roses ofte som et elegant og robust midtpunkt med flot finish og materialer, der understreger det eksklusive udtryk.",
     "simpleTitle": "Eksklusivt design og solid konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "1b9bc28b-4902-4a17-88c4-73841fac84c9"
    },
    "warm, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en varm, ren, detaljeret og dynamisk gengivelse med god stereoadskillelse og rumlig dybde.",
     "simpleTitle": "Varm, detaljeret og fordybende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "cd079420-29d5-42be-b7c7-29f5cb246ce3"
    },
    "the Ortofon 2M Bronze reveals new detail": {
     "sentimentAnalysis": "Bronze-pickuppen får gentagne gange æren for at hente flere detaljer, dynamik og mere liv ud af pladerne, så opgraderingen fra billigere pickupper tydeligt kan høres.",
     "simpleTitle": "Ortofon 2M Bronze afslører nye detaljer",
     "bias": "positive",
     "key": "sound",
     "groupId": "cd079420-29d5-42be-b7c7-29f5cb246ce3"
    },
    "excellent value for the included Bronze cartridge": {
     "sentimentAnalysis": "Pakken anses for dyr, men pengene værd, fordi den medfølgende 2M Bronze-pickup og den samlede Ausstattung giver usædvanligt meget for pengene.",
     "simpleTitle": "Fremragende værdi med den medfølgende Bronze-pickup",
     "bias": "positive",
     "key": "value",
     "groupId": "0a212bc5-d253-4c7e-bc54-7586e8406137"
    },
    "manual operation and setup can require patience": {
     "sentimentAnalysis": "Flere anmeldelser bemærker, at balancering af tonearmen, tilslutning af jordledningen eller overgangen til fuld manuel betjening er mindre bekvem end forventet.",
     "simpleTitle": "Manuel betjening og opsætning kan kræve tålmodighed",
     "bias": "negative",
     "key": "setup",
     "groupId": "bd3ea5dd-28b6-45a3-991e-4901d406be96"
    }
   },
