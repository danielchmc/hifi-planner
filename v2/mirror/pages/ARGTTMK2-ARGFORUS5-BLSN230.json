        "sentimentAnalysis": "Anmeldelserne roser konsekvent den varme, klare, detaljerede og overraskende kraftfulde lyd, ofte også ved TV-brug.",
        "simpleTitle": "Varm, klar og kraftfuld lyd",
        "bias": "positive",
        "key": "sound",
        "groupId": "5c0ba60b-e42e-408b-a300-8d0aa9b54d80"
       },
       "reliable Spotify and multiroom streaming": {
        "sentimentAnalysis": "Spotify Connect, internetradio, AirPlay og integration med andre Bluesound-enheder fremhæves ofte som styrker.",
        "simpleTitle": "Stabil Spotify- og multiroom-streaming",
        "bias": "positive",
        "key": "streaming",
        "groupId": "ee8571f2-5f11-46b1-975b-fa0c4d4ff279"
