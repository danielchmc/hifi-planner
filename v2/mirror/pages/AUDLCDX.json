  "reviews": {
   "summary": "Audeze LCD-X leverer en usædvanligt klar, detaljeret og omsluttende lyd med dyb, kontrolleret bas, naturlige mellemtoner og præcis placering. Den åbne gengivelse fungerer især godt med højopløselige indspilninger, klassisk musik og mixning, mens EQ kan finjustere den allerede stærke tuning. Fremragende komfort, byggekvalitet og tilbehør opvejer den betydelige vægt, og den samlede ydelse anses generelt for at være prisen værd.",
   "headlines": {
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne roser samstemmigt LCD-X for en usædvanligt klar, detaljeret, naturlig og omsluttende gengivelse med præcis placering og studiokvalitet.",
     "simpleTitle": "Klar, detaljeret og omsluttende lyd",
     "bias": "positive",
     "key": "sound_clarity",
     "groupId": "2f1e284f-1dae-46ab-b957-df81814c04b7"
    },
    "deep, controlled and punchy bass": {
     "sentimentAnalysis": "Bassen beskrives gentagne gange som dyb, fyldig og meget detaljeret uden at blive overdrevet eller påtrængende.",
     "simpleTitle": "Dyb, kontrolleret og fyldig bas",
     "bias": "positive",
     "key": "sound_bass",
     "groupId": "2f1e284f-1dae-46ab-b957-df81814c04b7"
    },
    "eq can refine the presentation": {
     "sentimentAnalysis": "Flere anmeldelser oplever LCD-X som usædvanligt velegnet til EQ, der kan frigøre hovedtelefonens fulde potentiale eller dæmpe lejlighedsvis skarphed i diskanten.",
     "simpleTitle": "EQ kan finjustere gengivelsen",
     "bias": "positive",
     "key": "eq_refinement",
     "groupId": "692b9b70-386b-4ad9-a488-c35d795cf497"
    },
    "heavy but comfortable for long sessions": {
     "sentimentAnalysis": "Den betydelige vægt nævnes, men store puder, god plads til ørerne og en sikker pasform gør lange lytte-sessioner komfortable for mange brugere.",
     "simpleTitle": "Tung, men komfortabel til lange sessioner",
     "bias": "positive",
     "key": "comfort_tradeoff",
     "groupId": "168bdac2-60f9-4b2b-a745-14a6df7f8b29"
    },
    "premium construction and useful accessories": {
     "sentimentAnalysis": "Hovedtelefonerne roses for meget god forarbejdning, matchede enheder, et kabel i høj kvalitet og praktisk premium-tilbehør inklusive et etui.",
     "simpleTitle": "Førsteklasses konstruktion og praktisk tilbehør",
     "bias": "positive",
     "key": "build_accessories",
     "groupId": "733a128e-76ed-472e-bf7e-ec918b4a99a2"
    }
   },
