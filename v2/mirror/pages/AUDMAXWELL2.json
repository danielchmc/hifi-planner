  "reviews": {
   "summary": "AUDMAXWELL2 leverer varm, klar og omsluttende lyd til musik, film og konsolspil og giver især trådløst en stærk oplevelse. Komfort ved lange sessioner, nemt EQ-skift og bred platformunderstøttelse giver betydelig værdi. Den tunge konstruktion, besværlige opsætning, lejlighedsvise knitren uden lyd og mindre overbevisende surround- eller musikgengivelse gør den høje pris sværere at forsvare til visse formål.",
   "headlines": {
    "clear, powerful and immersive sound": {
     "sentimentAnalysis": "Lyden roses bredt som klar, kraftfuld og en markant forbedring i forhold til tidligere headsets, især til musik og film.",
     "simpleTitle": "Klar, kraftfuld og omsluttende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "1c3e02d2-1f3a-42d3-9fa5-d5f7eadd391b"
    },
    "strong choice for console gaming": {
     "sentimentAnalysis": "Konsolspil får begejstret ros, og headsettet vurderes som særligt velegnet til PlayStation og Xbox.",
     "simpleTitle": "Stærkt valg til konsolspil",
     "bias": "positive",
     "key": "gaming",
     "groupId": "11ce498c-b20d-4637-b24f-3082d9271626"
    },
    "surround and music performance can disappoint": {
     "sentimentAnalysis": "Surround mangler den ønskede lydspredning, mens musikgengivelsen beskrives som skuffende i forhold til prisen.",
     "simpleTitle": "Surround- og musikgengivelsen kan skuffe",
     "bias": "negative",
     "key": "sound",
     "groupId": "1c3e02d2-1f3a-42d3-9fa5-d5f7eadd391b"
    },
    "comfortable for long sessions": {
     "sentimentAnalysis": "Komforten er god nok til længere tids brug, selv om den betydelige vægt bemærkes.",
     "simpleTitle": "Komfortabelt til lange sessioner",
     "bias": "positive",
     "key": "comfort",
     "groupId": "2a7c42e2-6184-47de-a294-a98f83f28be6"
    },
    "setup takes effort but works well": {
     "sentimentAnalysis": "Den indledende opsætning opleves som vanskelig, men det fungerende resultat og de fleksible EQ-funktioner gør besværet umagen værd.",
     "simpleTitle": "Opsætningen kræver arbejde, men fungerer godt",
     "bias": "meh",
     "key": "setup",
     "groupId": "43e5e402-2429-4b30-915d-1600ceb19981"
    }
