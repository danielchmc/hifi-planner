  "reviews": {
   "summary": "AUDMAXWELL2 leverer en varm, klar og omsluttende lyd og præsterer især godt til musik, film og konsolspil. Fleksible EQ-muligheder og en kompetent mikrofon giver alsidighed til gaming, mens komforten generelt er god under lange sessioner. Surroundplacering, softwareopsætning, vægt og værdi for pengene får blandede vurderinger, da premiumprisen ikke er fuldt ud berettiget til alle formål.",
   "headlines": {
    "strong gaming performance across consoles": {
     "sentimentAnalysis": "Headsettet opfattes som et fremragende gamingvalg med god konsolunderstøttelse, forbedret lydbillede og bedre mikrofon.",
     "simpleTitle": "Stærk gaming-ydeevne på konsoller",
     "bias": "positive",
     "key": "gaming",
     "groupId": "282f975d-bf2c-4827-810f-e7af25bd96fe"
    },
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Lyden roses som usædvanligt klar, kraftfuld og omsluttende til musik, film og spil.",
     "simpleTitle": "Klar, detaljeret og omsluttende lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "503fff6f-5551-45ab-92cf-27a1b1e4ab84"
    },
    "gaming surround is weaker than expected": {
     "sentimentAnalysis": "Musik og generel lydkvalitet er stærk, men surroundspredning og musikgengivelse lever ikke konsekvent op til premiumforventningerne.",
     "simpleTitle": "Gaming-surround er svagere end forventet",
     "bias": "negative",
     "key": "sound-quality",
     "groupId": "503fff6f-5551-45ab-92cf-27a1b1e4ab84"
