        "bias": "positive",
        "key": "features",
        "groupId": "6f564b2a-4156-4129-9594-8b07a54144d7"
       },
       "dynamic home-cinema performance": {
        "sentimentAnalysis": "Receiveren roses for kraftfuld og dynamisk filmlyd, tydeligere dialog og bedre kontrol over effekterne efter kalibrering.",
