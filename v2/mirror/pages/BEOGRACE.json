  "reviews": {
   "summary": "BEOGRACE leverer en førsteklasses high-end-oplevelse med varm, slagkraftig og meget detaljeret lyd, et stort og omsluttende lydbillede samt en fremragende balance mellem bas, mellemtone og diskant. Stærk ANC, en fremragende transparenstilstand og alsidige funktioner gør øretelefonerne imponerende til rejser, sport, gaming og hverdagslytning. Den luksuriøse konstruktion og det brede funktionsudvalg retfærdiggør premium-positioneringen, selv om prisen er høj, og etuiets batteri kan tømmes hurtigt i standby.",
   "headlines": {
    "rich, spacious and highly detailed sound": {
     "sentimentAnalysis": "Anmeldelserne roser lyden som high-end, fantastisk og usædvanligt detaljeret med en stor scene samt afbalanceret bas, mellemtone og diskant.",
     "simpleTitle": "Fyldig, rummelig og meget detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "729ccb6e-55af-46a6-b83e-6d0efe38fc52"
    },
    "effective ANC with exceptional transparency": {
     "sentimentAnalysis": "ANC opfattes som effektiv, mens transparenstilstanden roses for en naturlig gengivelse og tydeligt hørbare samtaler og trafiklyde.",
     "simpleTitle": "Effektiv ANC med fremragende transparens",
     "bias": "positive",
     "key": "noise-control",
     "groupId": "8b2b470b-dcd0-44b0-ade2-aeab7545c807"
    },
    "premium materials and luxurious construction": {
     "sentimentAnalysis": "Øretelefonerne forbindes konsekvent med attraktivt design, eksklusive materialer og fremragende byggekvalitet.",
     "simpleTitle": "Eksklusive materialer og luksuriøs konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "2c3d6037-f62e-47a3-9abb-34a0393729d1"
    },
    "premium pricing is justified by the feature set": {
     "sentimentAnalysis": "Selv om prisen beskrives som høj eller ekstravagant, vurderes den samlede værdi som pengene værd på grund af lyd, konstruktion og alsidighed.",
     "simpleTitle": "Premiumprisen retfærdiggøres af funktionerne",
     "bias": "positive",
     "key": "price",
