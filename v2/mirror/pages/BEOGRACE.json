  "reviews": {
   "summary": "BEOGRACE leverer en førsteklasses og medrivende lytteoplevelse med varm, kraftfuld og meget detaljeret lyd, imponerende støjkontrol, luksuriøs konstruktion og alsidige funktioner. Øretelefonerne roses som yderst kompetente allroundere til musik, rejser, sport og gaming. Den ekstravagante pris og det hurtigt afladede batteri i etuiet er de største forbehold, men den samlede vurdering er stadig meget begejstret.",
   "headlines": {
    "rich, spacious and well-balanced sound": {
     "sentimentAnalysis": "Anmeldelserne roser en detaljeret, kraftfuld og medrivende gengivelse med stor lydboble, præcis placering af instrumenter samt afbalanceret bas, mellemtone og diskant.",
     "simpleTitle": "Fyldig, rummelig og velafbalanceret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "9b46e29e-ff34-4c98-bd01-1db5d14476c0"
    },
    "premium materials and construction": {
     "sentimentAnalysis": "Luksuriøse materialer, et flot udseende og førsteklasses forarbejdning understreger premiumkarakteren.",
     "simpleTitle": "Eksklusive materialer og konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "bcdaad49-0b4a-46a8-b860-703eed143732"
    },
    "effective ANC and exceptional transparency mode": {
     "sentimentAnalysis": "ANC'en opleves som effektiv på rejser og under pendling, mens transparenstilstanden er naturlig nok til samtaler og opmærksomhed på trafikken omkring en.",
     "simpleTitle": "Effektiv ANC og fremragende transparenstilstand",
     "bias": "positive",
     "key": "noise-control",
     "groupId": "be7d5366-c1b3-4981-94cd-33608d6b663c"
