  "reviews": {
   "summary": "BLSCB130 er en alsidig hub, der er nem at installere, og som forbinder pladespillere, cd-afspillere og tv-lyd med et Bluesound-system og giver fleksibel trådløs placering. Lyden beskrives generelt som klar, behagelig og overraskende god med problemfri, punchy gengivelse, når netværket er stabilt. Wi-fi-forbindelse og appens driftssikkerhed kan dog lejlighedsvis svække den ellers varme og medrivende lytteoplevelse.",
   "headlines": {
    "easy setup and straightforward operation": {
     "sentimentAnalysis": "Opsætningen roses gentagne gange som hurtig, enkel, plug-and-play og nem at bruge, selv om den i ét tilfælde var uklar i starten.",
     "simpleTitle": "Nem opsætning og enkel betjening",
     "bias": "positive",
     "key": "setup",
     "groupId": "61303b89-61fb-4700-86b2-30a3177d7134"
    },
    "flexible integration of turntables, CD players and TV audio": {
     "sentimentAnalysis": "Hubben værdsættes for at forbinde analoge kilder og tv-lyd med Bluesound-udstyr, især når kilde og højttalere står i forskellige rum.",
     "simpleTitle": "Fleksibel integration af pladespillere, cd-afspillere og tv-lyd",
     "bias": "positive",
     "key": "integration",
     "groupId": "a8e98b8e-0113-4bfe-86be-c724f0bcdc29"
    },
    "clear and enjoyable sound": {
     "sentimentAnalysis": "Lyden roses ofte som fri for forvrængning, behagelig og overraskende god med en tilfredsstillende lytteoplevelse.",
     "simpleTitle": "Klar og behagelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "ba30bc1c-304e-4e70-8172-392fab187e14"
    },
    "stable network connection is important": {
     "sentimentAnalysis": "Wi-fi-udsving kan påvirke lydkvaliteten og driften; en kablet Ethernet-forbindelse beskrives som mere stabil, mens ustabile forbindelser kan forhindre, at afspillere bliver fundet.",
     "simpleTitle": "En stabil netværksforbindelse er vigtig",
     "bias": "negative",
     "key": "network",
     "groupId": "0acf4750-651a-46fe-a1ce-e17b4ad4f87e"
    },
    "app experience is inconsistent": {
     "sentimentAnalysis": "Appen kritiseres for upålidelig afspillerregistrering, lejlighedsvise nulstillinger samt et design og en brugervenlighed, der kan forbedres.",
     "simpleTitle": "Appen fungerer ikke altid stabilt",
     "bias": "negative",
     "key": "network",
     "groupId": "0acf4750-651a-46fe-a1ce-e17b4ad4f87e"
    }
