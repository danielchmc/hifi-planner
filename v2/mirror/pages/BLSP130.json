  "displayBookDemo": true,
  "reviews": {
   "summary": "BLSP130 leverer en imponerende varm, fyldig og detaljeret lyd fra det kompakte kabinet samt en medrivende stereo- og multiroom-oplevelse ved sammenkobling med andet Bluesound-udstyr. Den nemme app-betjening, alsidige streaming og gode værdi gør den til et fremragende valg til køkken, soveværelse og mindre rum. Stabiliteten på Wi-Fi og softwaren er de største forbehold, da der lejlighedsvis opstår forbindelsesudfald, parringsproblemer og fejl, som ofte kan løses med en omhyggelig netværksopsætning eller kablet Ethernet.",
   "headlines": {
    "wireless connection and software can be unreliable": {
     "sentimentAnalysis": "Flere anmeldelser rapporterer om Wi-Fi-udfald, parringsfejl, softwareproblemer i stereo og gentagen opsætning, selv om netværksforholdene nogle gange bidrager.",
     "simpleTitle": "Trådløs forbindelse og software kan være ustabil",
     "bias": "negative",
     "key": "connectivity",
     "groupId": "c463f4d6-ffcb-475c-8c47-c8b04974cc51"
    },
    "full, clear sound from a compact speaker": {
     "sentimentAnalysis": "Anmeldelserne roser gennemgående den usædvanligt fyldige, klare og detaljerede lyd i forhold til størrelsen.",
     "simpleTitle": "Fyldig og klar lyd fra en kompakt højttaler",
     "bias": "positive",
     "key": "sound",
     "groupId": "f25e3513-1b84-4080-9c5f-c286f4b5cfb1"
    },
    "easy app control and versatile streaming": {
     "sentimentAnalysis": "Mange anmeldelser fremhæver enkel betjening, praktiske forvalgsknapper og pålidelig adgang til radio, musiktjenester og tilsluttede kilder.",
     "simpleTitle": "Nem app-betjening og alsidig streaming",
     "bias": "positive",
     "key": "usability",
     "groupId": "ede6f5d1-ef8a-4531-b639-d65d01c961db"
    },
    "stereo pairing creates a spacious, immersive presentation": {
     "sentimentAnalysis": "Parrede højttalere beskrives som et bredt stereoperspektiv, en medrivende oplevelse og problemfri afspilning i hele hjemmet.",
     "simpleTitle": "Stereoparring skaber en rummelig og medrivende lyd",
     "bias": "positive",
     "key": "integration",
     "groupId": "bd6173e1-8233-43ac-b9b4-548649082cc6"
    },
    "bass is limited and the sound can become thin": {
     "sentimentAnalysis": "Et mindretal af anmeldelserne nævner begrænset dybbas, en tynd klangbalance eller svag gengivelse ved lav lydstyrke trods et generelt positivt indtryk.",
     "simpleTitle": "Bassen er begrænset, og lyden kan virke tynd",
     "bias": "negative",
     "key": "sound",
     "groupId": "f25e3513-1b84-4080-9c5f-c286f4b5cfb1"
    }
   },
