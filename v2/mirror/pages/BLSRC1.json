  "reviews": {
   "summary": "BLSRC1 betragtes generelt som en praktisk og responsiv fjernbetjening, der gør Bluesound- og NAD-systemer nemmere at betjene uden at finde telefonen frem. Forudindstillede knapper, enkel betjening, kompakt konstruktion og god ergonomi bliver ofte fremhævet, især til radiostationer og playlister. De største forbehold gælder merprisen, infrarød betjening med begrænset sigtelinje, lejlighedsvise opsætningsproblemer, begrænsede funktioner og varierende batterilevetid.",
   "headlines": {
    "easy operation without a phone": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent fjernbetjeningen som et praktisk alternativ til BluOS-appen, især når telefonen ikke er i nærheden.",
     "simpleTitle": "Nem betjening uden telefon",
     "bias": "positive",
     "key": "ease",
     "groupId": "b4727418-c5e2-4bc7-944c-f0542c69529b"
    },
    "quick access to presets and playlists": {
     "sentimentAnalysis": "Programmerbare knapper giver hurtig direkte adgang til radiostationer, playlister, musiktjenester og andre ofte brugte kilder.",
     "simpleTitle": "Hurtig adgang til forudindstillinger og playlister",
     "bias": "positive",
     "key": "presets",
     "groupId": "af935b6f-6210-4aa8-b2f8-2ac60819db40"
    },
    "compact, comfortable build": {
     "sentimentAnalysis": "Fjernbetjeningen roses ofte for sin kompakte størrelse, solide konstruktion, flotte design og gode greb.",
     "simpleTitle": "Kompakt og behagelig konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "9f78075b-9753-4b49-b9be-ffb66ae69cb8"
    },
    "infrared aiming can be restrictive": {
     "sentimentAnalysis": "Flere anmeldelser nævner, at infrarød betjening kræver direkte sigtning og muligvis ikke virker gennem skabslåger, mens andre oplever god dækning i rummet.",
     "simpleTitle": "Infrarød betjening kræver præcis sigtning",
     "bias": "negative",
     "key": "performance",
     "groupId": "caadff23-60c2-4332-ba15-59dd42e7ec86"
    }
   },
