  "reviews": {
   "summary": "BLSRC1 er en praktisk og solidt bygget fjernbetjening, der gør den daglige betjening af Bluesound- og NAD-enheder hurtigere og mere behagelig end brug af en telefon. Knapperne til gemte radiostationer, playlister og andre kilder er særligt nyttige, og det kompakte design ligger godt i hånden. De største ulemper er den relativt høje pris, de mere begrænsede funktioner sammenlignet med appen og behovet for at rette det infrarøde signal præcist i nogle opsætninger.",
   "headlines": {
    "presets make radio and playlists instantly accessible": {
     "sentimentAnalysis": "Programmerbare knapper giver hurtig og praktisk adgang til favoritstationer, playlister og kilder uden appen.",
     "simpleTitle": "Forudindstillinger giver hurtig adgang til radio og playlister",
     "bias": "positive",
     "key": "preset-access",
     "groupId": "6a83a598-9fbe-4d4f-9287-f6489d9f4fdb"
    },
    "a convenient alternative to the app": {
     "sentimentAnalysis": "Fjernbetjeningen værdsættes bredt som et hurtigere, enklere og mere tilgængeligt alternativ til mobilappen.",
     "simpleTitle": "Et praktisk alternativ til appen",
     "bias": "positive",
     "key": "app-free-control",
     "groupId": "fa50a49e-da35-4fbe-a547-c387334e6abe"
    },
    "compact, attractive and comfortable to hold": {
     "sentimentAnalysis": "Det kompakte format, det flotte udseende og den solide konstruktion fremhæves gentagne gange.",
     "simpleTitle": "Kompakt, flot og behagelig at holde",
     "bias": "positive",
     "key": "handheld-design",
     "groupId": "a3fc8ec9-d7aa-4d5d-b99f-a411551d0d61"
    },
    "the price feels too high": {
     "sentimentAnalysis": "Flere anmeldelser finder fjernbetjeningen nyttig, men for dyr, især fordi appen kan udføre mange af de samme funktioner.",
     "simpleTitle": "Prisen føles for høj",
     "bias": "negative",
     "key": "high-price",
     "groupId": "f9d4307f-0ae9-40aa-b8f1-2a2281ecaa24"
    },
    "infrared aiming can be restrictive": {
     "sentimentAnalysis": "Den infrarøde betjening virker, men kravet om direkte sigtning og begrænsninger gennem skabslåger opleves som upraktisk.",
     "simpleTitle": "Infrarød betjening kan være begrænsende",
     "bias": "negative",
     "key": "infrared-limitations",
     "groupId": "fa50a49e-da35-4fbe-a547-c387334e6abe"
    }
