     "groupId": "47a91a6b-1c5b-4d31-b6d4-46141202f02d"
    },
    "small and easy to carry": {
     "sentimentAnalysis": "Det kompakte format værdsættes for at være handy, transportabelt og velegnet til mange formål.",
     "simpleTitle": "Lille og nem at tage med",
     "bias": "positive",
     "key": "portability",
