  "reviews": {
   "summary": "BOA5 leverer en bemærkelsesværdig fyldig, varm og kraftfuld lyd med punchy bas, tydelige detaljer og en omsluttende gengivelse fra det kompakte kabinet. Det elegante design i høj kvalitet og den fleksible trådløse brug gør højttaleren særligt attraktiv både inde og ude. Batteriydelse og software er de største svagheder, hvor svingende batteritid, strømforbrug i standby og begrænset offline-betjening skuffer i et ellers fremragende produkt.",
   "headlines": {
    "rich, powerful sound with impressive bass and clarity": {
     "sentimentAnalysis": "Lyden roses bredt som kraftfuld, fyldig og klar, især i betragtning af den kompakte størrelse.",
     "simpleTitle": "Fyldig og kraftfuld lyd med imponerende bas og klarhed",
     "bias": "positive",
     "key": "sound",
     "groupId": "4e076b78-a208-426d-9fec-b3dd52d50f3f"
    },
    "elegant, premium design": {
     "sentimentAnalysis": "Udseendet beskrives konsekvent som smukt, eksklusivt og velegnet som en del af indretningen.",
     "simpleTitle": "Elegant design i høj kvalitet",
     "bias": "positive",
     "key": "design",
     "groupId": "1dc9ce6c-fc53-4758-bc8d-424aebb6840d"
    },
    "battery life falls short of expectations": {
     "sentimentAnalysis": "Flere anmeldelser rapporterer kortere batteritid end forventet, hurtigt kapacitetstab eller stort strømforbrug i standby.",
     "simpleTitle": "Batteritiden lever ikke op til forventningerne",
     "bias": "negative",
     "key": "battery",
     "groupId": "055b5f1e-d8dd-4d5a-a246-a159dab913c0"
    },
    "app and network dependence limits control": {
     "sentimentAnalysis": "Softwarefejl, krav om netværk og dårligt synlige betjeningselementer gør nogle funktioner unødigt vanskelige.",
     "simpleTitle": "Afhængighed af app og netværk begrænser betjeningen",
     "bias": "negative",
     "key": "software",
     "groupId": "9cb99b90-c93f-4dbb-9111-d04b77386d3a"
    },
    "wireless charging adds useful flexibility": {
     "sentimentAnalysis": "Trådløs opladning værdsættes som en praktisk funktion, der øger mobilitet og brugervenlighed.",
     "simpleTitle": "Trådløs opladning giver ekstra fleksibilitet",
     "bias": "positive",
     "key": "battery",
     "groupId": "055b5f1e-d8dd-4d5a-a246-a159dab913c0"
    },
    "top controls are hard to see in low light": {
     "sentimentAnalysis": "Symboler og knapper på toppen kan være svære at finde eller identificere, især i svagt lys.",
     "simpleTitle": "Betjeningen på toppen er svær at se i svagt lys",
     "bias": "negative",
     "key": "software",
     "groupId": "9cb99b90-c93f-4dbb-9111-d04b77386d3a"
    }
   },
