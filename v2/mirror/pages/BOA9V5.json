  "displayBookDemo": true,
  "reviews": {
   "summary": "B&O A9 leverer en varm, præcis, medrivende og basrig lytteoplevelse med et markant design og stor følelsesmæssig gennemslagskraft. Trådløs opsætning og app-forbindelse kan være frustrerende på grund af AirPlay-udfald, konfigurationsproblemer og begrænsninger på antallet af enheder. Trods disse software- og netværksproblemer vækker højttaleren stor begejstring og føles værd at beholde.",
   "headlines": {
    "rich, immersive sound with powerful bass": {
     "sentimentAnalysis": "Lyden beskrives som smuk, præcis, følelsesladet, medrivende og basrig og skaber en stærk atmosfære.",
     "simpleTitle": "Fyldig, medrivende lyd med kraftig bas",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "42a84817-2ed1-4f86-8c31-81407355160c"
    },
    "wireless and app setup can be troublesome": {
     "sentimentAnalysis": "AirPlay-udfald, begrænset hjælp til fejlfinding og en appgrænse på to enheder gør opsætning og daglig forbindelse mindre pålidelig.",
     "simpleTitle": "Trådløs opsætning og appkonfiguration kan være besværlig",
     "bias": "negative",
     "key": "app-connectivity",
     "groupId": "0d734f8d-5ca5-48b9-8b0e-02aaf11589e8"
    }
   },
