  "reviews": {
   "summary": "Beolit 20 roses bredt for varm, fyldig og medrivende lyd med overraskende dyb, kraftfuld bas og god detaljegrad for en transportabel højttaler. Det elegante design, den solide konstruktion, mobiliteten og den praktiske trådløse opladning gør højttaleren alsidig både inde, ude og på terrassen. Batteritid og Bluetooth fungerer generelt godt, selv om enkelte anmeldelser nævner begrænset lydstyrke, forbindelsesproblemer, lang opladningstid eller manglende Wi-Fi/AirPlay; helhedsindtrykket er meget begejstret.",
   "headlines": {
    "warm, rich sound with deep and punchy bass": {
     "sentimentAnalysis": "Anmeldelserne beskriver gennemgående en varm og fyldig gengivelse med dyb bas, godt tryk og imponerende skala for størrelsen.",
     "simpleTitle": "Varm og fyldig lyd med dyb og kraftfuld bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "f9f5cd86-287d-4005-bdcd-a97ba77f6f4e"
    },
    "clear detail and room-filling, wide sound": {
     "sentimentAnalysis": "Anmeldelserne fremhæver klare diskanttoner, gode detaljer, bred spredning og en medrivende gengivelse, der fylder rum og udendørsarealer.",
     "simpleTitle": "Klar detaljegrad og rummelig, fyldig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "f9f5cd86-287d-4005-bdcd-a97ba77f6f4e"
    },
    "elegant, sturdy and easy to place in the home": {
     "sentimentAnalysis": "Højttaleren roses gentagne gange for et attraktivt, raffineret og solidt design, der kan stå fremme som en del af indretningen.",
     "simpleTitle": "Elegant, robust design til hjemmet",
     "bias": "positive",
     "key": "design",
     "groupId": "2f3f8011-e383-4956-b8af-4462d21b9337"
    },
    "convenient Bluetooth, app and wireless charging features": {
     "sentimentAnalysis": "Bluetooth-parring, appstyring, stereoparring og trådløs telefonopladning opleves som nyttige og praktiske funktioner.",
     "simpleTitle": "Praktiske Bluetooth-, app- og trådløse opladningsfunktioner",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "6be91914-325f-41b3-a54a-e68206991f37"
    },
    "long battery life supports outdoor use": {
     "sentimentAnalysis": "De fleste batterirelaterede kommentarer beskriver pålidelig eller lang afspilning, som gør højttaleren velegnet til have, terrasse, fester og rejser.",
     "simpleTitle": "Lang batteritid til udendørs brug",
     "bias": "positive",
     "key": "battery",
     "groupId": "cc3b87a7-f33a-4062-b038-351c3b9d1006"
    },
    "pairing and wireless features have limitations": {
     "sentimentAnalysis": "Nogle anmeldelser nævner udfald i lyden, manglende mulighed for at forbinde flere enheder eller fravær af Wi-Fi og AirPlay.",
     "simpleTitle": "Begrænsninger ved parring og trådløse funktioner",
     "bias": "negative",
     "key": "connectivity",
     "groupId": "6be91914-325f-41b3-a54a-e68206991f37"
    },
    "bass can overpower the highs indoors": {
     "sentimentAnalysis": "En mindre del af anmeldelserne oplever den basrige tuning som mindre klar indendørs og nævner lejlighedsvis manglende klarhed eller slagkraft.",
     "simpleTitle": "Bassen kan overdøve diskanten indendørs",
     "bias": "negative",
     "key": "sound",
     "groupId": "f9f5cd86-287d-4005-bdcd-a97ba77f6f4e"
    },
    "battery life is shorter than expected for some users": {
     "sentimentAnalysis": "Nogle anmeldelser oplever kortere batteritid end ønsket, og én nævner også, at trådløs telefonopladning reducerer den resterende strøm.",
     "simpleTitle": "Batteritiden er kortere end forventet for nogle",
     "bias": "negative",
     "key": "battery",
     "groupId": "cc3b87a7-f33a-4062-b038-351c3b9d1006"
    }
   },
