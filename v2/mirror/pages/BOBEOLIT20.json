  "reviews": {
   "summary": "Beolit 20 roses bredt for sin varme, fyldige og kraftfulde lyd med dyb bas, klare detaljer og imponerende rumfylde for en transportabel højttaler. Det elegante design, den solide byggekvalitet, mobiliteten og den praktiske trådløse opladning af telefoner gør produktet særligt alsidigt både inde og ude. Batteritid og betjening vurderes generelt positivt, selv om enkelte anmeldelser nævner begrænset maksimal lydstyrke, lejlighedsvise forbindelsesproblemer, manglende Wi-Fi eller AirPlay og en forholdsvis høj pris.",
   "headlines": {
    "warm, rich sound with deep, punchy bass": {
     "sentimentAnalysis": "Anmeldelserne beskriver gennemgående en fyldig, varm og basrig gengivelse, som er særligt imponerende i forhold til højttalerens størrelse og velegnet til elektronisk musik og udendørs brug.",
     "simpleTitle": "Varm, fyldig lyd med dyb og kraftfuld bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "cf968e8e-c66f-4196-b94d-447c7d4f8bad"
    },
    "wireless phone charging is a useful bonus": {
     "sentimentAnalysis": "Den integrerede ladeplade fremhæves ofte som en praktisk og effektiv funktion, der giver ekstra værdi i hverdagen.",
     "simpleTitle": "Trådløs telefonopladning er en praktisk bonus",
     "bias": "positive",
     "key": "wireless-charging",
     "groupId": "b07f9a0b-e019-4f64-bd64-34a195717092"
    },
    "clear detail and spacious, room-filling presentation": {
     "sentimentAnalysis": "Højttaleren roses gentagne gange for detaljeopløsning, balance mellem klarhed og bas samt en bred lydspredning, der kan fylde et rum eller et stort udendørsområde.",
     "simpleTitle": "Klare detaljer og rummelig, fyldig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "cf968e8e-c66f-4196-b94d-447c7d4f8bad"
    },
    "elegant, premium design and solid construction": {
     "sentimentAnalysis": "Anmeldelserne værdsætter det raffinerede B&O-design, det diskrete udtryk og den betryggende byggekvalitet; højttaleren beskrives ofte som flot nok til at stå fremme.",
     "simpleTitle": "Elegant premiumdesign og solid konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "0fd964b0-8da3-4606-8979-bde544ffee5c"
    },
    "easy Bluetooth connection and app control": {
     "sentimentAnalysis": "Flere anmeldelser finder Bluetooth-opsætning, daglig betjening og lydjustering via app enkel og effektiv.",
     "simpleTitle": "Nem Bluetooth-forbindelse og appstyring",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "07209c5c-3cc0-47fa-b868-0f3be59ccd3d"
    },
    "maximum volume and treble clarity can fall short": {
     "sentimentAnalysis": "Et mindretal af anmeldelserne oplever lyden som mindre kraftfuld end forventet; nogle nævner for lav lydstyrke eller bas, der lejlighedsvis overdøver diskanten indendørs.",
     "simpleTitle": "Maksimal lydstyrke og diskantklarhed kan skuffe",
     "bias": "negative",
     "key": "sound",
     "groupId": "cf968e8e-c66f-4196-b94d-447c7d4f8bad"
    },
    "pairing with multiple devices can be problematic": {
     "sentimentAnalysis": "Nogle ejere rapporterer afbrydelser eller begrænsninger ved parring af flere enheder, blandt andet problemer med at skifte mellem telefon og tablet eller forbinde to højttalere.",
     "simpleTitle": "Parring med flere enheder kan give problemer",
     "bias": "negative",
     "key": "connectivity",
     "groupId": "07209c5c-3cc0-47fa-b868-0f3be59ccd3d"
    }
   },
