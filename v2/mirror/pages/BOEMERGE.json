  "reviews": {
   "summary": "BOEMERGE leverer en imponerende fyldig, kraftfuld og omsluttende lyd fra en bemærkelsesværdigt lille og elegant højttaler. Det raffinerede design, det kompakte format og den solide byggekvalitet passer ind i ethvert hjem, mens appen og stereoparring giver ekstra fleksibilitet. Den dybeste bas er noget begrænset, og kompatibiliteten med YouTube Music kan være ufuldstændig, men den samlede kvalitet og brugervenlighed gør BOEMERGE til et eksklusivt og meget tilfredsstillende køb.",
   "headlines": {
    "elegant, compact and well-built": {
     "sentimentAnalysis": "Det elegante udtryk, den lille størrelse og den solide konstruktion fremhæves gentagne gange som lette at integrere i hjemmet.",
     "simpleTitle": "Elegant, kompakt og solidt bygget",
     "bias": "positive",
     "key": "design",
     "groupId": "1b55d3f4-995b-43b8-b0a0-9faa59ba1a3a"
    },
    "surprisingly powerful, detailed sound": {
     "sentimentAnalysis": "Højttaleren leverer en klar, fyldig og overraskende kraftfuld lyd trods den lille størrelse og kan fylde et rum med lyd.",
     "simpleTitle": "Overraskende kraftfuld og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "26316d57-f2ff-41e3-8e9c-af97827c49c5"
    },
    "limited deepest bass": {
     "sentimentAnalysis": "Den samlede lyd er stærk, men de dybeste basfrekvenser gengives ikke fuldt ud.",
     "simpleTitle": "Begrænset dybeste bas",
     "bias": "negative",
     "key": "sound",
     "groupId": "26316d57-f2ff-41e3-8e9c-af97827c49c5"
    },
    "stereo pairing adds fuller sound": {
     "sentimentAnalysis": "Brug af to højttalere i stereotilstand forbindes med en fyldigere lytteoplevelse.",
     "simpleTitle": "Stereoparring giver fyldigere lyd",
     "bias": "positive",
     "key": "stereo",
     "groupId": "73b14f03-eabd-4552-b84e-6cc2716677ba"
    }
   },
