  "reviews": {
   "summary": "BOEXPLORE roses bredt for varm, slagkraftig og overraskende omsluttende lyd fra et kompakt, stilfuldt og robust kabinet. Den er nem at tage med, enkel at betjene, solidt bygget og har god batteritid, hvilket gør den særligt velegnet til udendørs brug, rejser og hverdagslytning. Et mindretal synes, at lyden er for flad, mørk, skarp eller svag til prisen, mens automatiske forbindelser, begrænset app-kompatibilitet og enkelte opsætningsdetaljer begrænser fleksibiliteten.",
   "headlines": {
    "surprisingly rich sound for a compact speaker": {
     "sentimentAnalysis": "Det kompakte kabinet leverer varm, kraftfuld og overraskende fyldig lyd, som ofte overgår forventningerne til størrelsen.",
     "simpleTitle": "Overraskende fyldig lyd fra en kompakt højttaler",
     "bias": "positive",
     "key": "sound",
     "groupId": "48a2bd19-7c48-456b-b2a6-ece52347bf3b"
    },
    "simple controls and quick Bluetooth pairing": {
     "sentimentAnalysis": "Den enkle betjening og den pålidelige, hurtige parring gør højttaleren tilgængelig for mange brugere.",
     "simpleTitle": "Enkel betjening og hurtig Bluetooth-parring",
     "bias": "positive",
     "key": "usability",
     "groupId": "0bd476d7-fee7-4f19-adec-5596d0315e6b"
    },
    "some listeners find the sound too flat or weak": {
     "sentimentAnalysis": "En mindre gruppe kommentarer beskriver gengivelsen som flad, mørk, skarp eller for svag i forhold til pris eller forventninger.",
     "simpleTitle": "Nogle synes, at lyden er for flad eller svag",
     "bias": "negative",
     "key": "sound",
     "groupId": "48a2bd19-7c48-456b-b2a6-ece52347bf3b"
    },
    "stylish and exceptionally solid construction": {
     "sentimentAnalysis": "Det karakteristiske udseende, den eksklusive finish og den robuste konstruktion fremhæves gentagne gange, herunder modstandsdygtighed over for fald og regn.",
     "simpleTitle": "Stilfuldt og særdeles solidt design",
     "bias": "positive",
     "key": "design",
     "groupId": "b3451b59-d479-46db-8e94-7602290c82aa"
    },
    "easy to carry and ideal outdoors": {
     "sentimentAnalysis": "Det kompakte format gør højttaleren praktisk til ferie, camping, have, sport og andre aktiviteter væk fra hjemmet.",
     "simpleTitle": "Nem at tage med og ideel udendørs",
     "bias": "positive",
     "key": "portability",
     "groupId": "205a09cc-7cd8-4565-84a1-c9ad99c74397"
    },
    "long-lasting battery supports extended listening": {
     "sentimentAnalysis": "Batteritiden vurderes generelt som god nok til udendørs brug og længere tids hverdagslytning.",
     "simpleTitle": "Lang batteritid til langvarig lytning",
     "bias": "positive",
     "key": "battery",
     "groupId": "997b8241-6b8a-4634-a636-c21af0799227"
    },
    "balanced bass and adjustable sound": {
     "sentimentAnalysis": "Den brede, kontrollerede bas og muligheden for at tilpasse klangbalancen via appen bliver værdsat.",
     "simpleTitle": "Balanceret bas og justerbar lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "48a2bd19-7c48-456b-b2a6-ece52347bf3b"
    },
    "automatic connections can cause sharing conflicts": {
     "sentimentAnalysis": "Automatisk genforbindelse og flere samtidige enheder kan give afbrydelser, når flere deler højttaleren.",
     "simpleTitle": "Automatiske forbindelser kan give problemer ved deling",
     "bias": "negative",
     "key": "usability",
     "groupId": "0bd476d7-fee7-4f19-adec-5596d0315e6b"
    }
   },
