     "bias": "positive",
     "key": "sound",
     "groupId": "ed050fb3-9a22-4a96-a05b-3d70b187332f"
    },
    "luxurious materials and design": {
     "sentimentAnalysis": "Eksklusiv konstruktion, luksuriøs haptik, flot design og materialer af høj kvalitet fremhæves gentagne gange som styrker.",
     "simpleTitle": "Eksklusive materialer og design",
     "bias": "positive",
     "key": "design",
     "groupId": "d8f81687-1a13-4403-816b-f97ae8aefd06"
    },
    "strong noise cancellation": {
     "sentimentAnalysis": "Flere anmeldelser beskriver støjreduktionen som meget god, fremragende eller uovertruffen som supplement til den stærke lytteoplevelse.",
