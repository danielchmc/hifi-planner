  "reviews": {
   "summary": "BOH100 leverer en enestående klar, detaljeret og omsluttende lyd med fyldig bas og en velafbalanceret gengivelse. Eksklusive materialer, luksuriøst design og gennemtænkte, intuitive betjeningselementer får hovedtelefonerne til at føles helt særlige, mens ANC og tilslutning generelt imponerer. Batteritid og størrelsen på ørepuderne er de væsentligste kritikpunkter, og den høje pris skaber forventninger, som ikke fuldt ud indfries for alle lyttere.",
   "headlines": {
    "clear, detailed and richly balanced sound": {
     "sentimentAnalysis": "Anmeldelserne fremhæver konsekvent den klare, detaljerede, afbalancerede og omsluttende lyd med fyldig bas og mange musikalske detaljer.",
     "simpleTitle": "Klar, detaljeret og fyldigt afbalanceret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "7a3a8e56-9c03-4589-adb2-18f1d4883087"
    },
    "luxurious, high-quality construction": {
     "sentimentAnalysis": "Anmeldelserne fremhæver gentagne gange eksklusive materialer, luksuriøs fornemmelse, flot design og fremragende byggekvalitet.",
     "simpleTitle": "Luksuriøs konstruktion i høj kvalitet",
     "bias": "positive",
     "key": "design",
     "groupId": "6069902c-dfc0-4ba5-adc1-13d22e7ec5e7"
    },
    "intuitive controls and easy connectivity": {
     "sentimentAnalysis": "Anmeldelserne roser den enkle Bluetooth-parring, intuitive betjening, nyttige app og mange tilpasningsmuligheder.",
     "simpleTitle": "Intuitiv betjening og enkel tilslutning",
     "bias": "positive",
     "key": "usability",
     "groupId": "3472c78b-b728-4f04-8dae-8b2712df3676"
    },
    "strong noise cancellation": {
     "sentimentAnalysis": "Flere anmeldelser beskriver ANC som meget god, fremragende eller uovertruffen.",
     "simpleTitle": "Effektiv støjreduktion",
     "bias": "positive",
     "key": "anc",
     "groupId": "731546e7-a712-479f-90d6-9e5a79bfe1e5"
    },
    "comfortable fit for some, small earcups for others": {
     "sentimentAnalysis": "Pasformen vurderes forskelligt: Nogle finder hovedtelefonerne komfortable, mens en anden synes, ørepuderne er for små.",
     "simpleTitle": "Komfortabel pasform for nogle, små ørepuder for andre",
     "bias": "meh",
     "key": "comfort",
     "groupId": "96a57fa4-6199-4e88-b3ae-610f594a9d3f"
    },
    "anc could be stronger": {
     "sentimentAnalysis": "Et mindretal af anmeldelserne oplever ANC som svagere end forventet eller ikke helt så stærk som hos konkurrenterne.",
