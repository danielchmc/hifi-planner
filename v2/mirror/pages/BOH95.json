  "reviews": {
   "summary": "BOH95 leverer en luksuriøs premium-lytteoplevelse med varm, detaljeret og rummelig lyd, kontrolleret bas, fremragende materialer og høj komfort over længere tid. Batteritid, mobilitet og støjreduktion bliver også ofte fremhævet positivt, mens appen og den intuitive betjening giver ekstra fleksibilitet. Den høje pris nævnes ofte, men trods enkelte kritiske bemærkninger om lydstyrke, ANC eller pasform er den samlede vurdering overvældende positiv.",
   "headlines": {
    "warm, detailed and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne roser en klar, afbalanceret, meget detaljeret og rummelig gengivelse med stærk musikalitet.",
     "simpleTitle": "Varm, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound_warm_detailed",
     "groupId": "ae4e6b3e-4edc-4707-aec1-b00e0fce99b6"
    },
    "premium materials and craftsmanship": {
     "sentimentAnalysis": "Hovedtelefonerne roses gentagne gange for eksklusive materialer, flot design og omhyggelig forarbejdning.",
     "simpleTitle": "Eksklusive materialer og forarbejdning",
     "bias": "positive",
     "key": "design_premium",
     "groupId": "455b025c-c531-4950-b5e6-062b5784e01b"
    },
    "comfortable for long listening sessions": {
     "sentimentAnalysis": "Flere anmeldelser beskriver en behagelig pasform, der også fungerer godt ved mange timers brug.",
     "simpleTitle": "Behagelige ved lange lytteperioder",
     "bias": "positive",
     "key": "comfort_long_sessions",
     "groupId": "03d2a71f-8aeb-49bf-9fbd-b48a608c467f"
    },
    "rich, controlled and punchy bass": {
     "sentimentAnalysis": "Bassen beskrives som fyldig, kontrolleret og kraftfuld og supplerer de klare diskanttoner og den detaljerede gengivelse.",
     "simpleTitle": "Fyldig, kontrolleret og energisk bas",
     "bias": "positive",
     "key": "sound_bass",
     "groupId": "ae4e6b3e-4edc-4707-aec1-b00e0fce99b6"
    },
    "effective noise cancellation for travel": {
     "sentimentAnalysis": "Anmeldelserne beskriver ANC som effektiv nok til kraftig afskærmning, især på rejser.",
     "simpleTitle": "Effektiv støjreduktion på rejser",
     "bias": "positive",
     "key": "noise_effective",
     "groupId": "c257d7bd-e8af-4252-94d7-f70d060d594c"
    },
    "long-lasting battery": {
     "sentimentAnalysis": "Batterikapacitet og lang afspilningstid bliver konsekvent fremhævet som store styrker.",
     "simpleTitle": "Lang batteritid",
     "bias": "positive",
     "key": "battery_long",
     "groupId": "b8df0610-8136-434d-84c6-2c0e3f1ae5de"
    },
    "some listeners find the sound too quiet or lacking punch": {
     "sentimentAnalysis": "Et lille mindretal kritiserer den maksimale lydstyrke eller savner mere kraft i gengivelsen.",
     "simpleTitle": "Nogle lyttere oplever lyden som for lav eller uden nok punch",
     "bias": "negative",
     "key": "sound_volume_punch",
     "groupId": "ae4e6b3e-4edc-4707-aec1-b00e0fce99b6"
    }
