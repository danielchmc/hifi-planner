        "groupId": "fc999c79-b481-4eee-9b97-49e4afd16a91"
       },
       "speech and dialogue are exceptionally clear": {
        "sentimentAnalysis": "Centerhøjttaleren roses gentagne gange for at gengive tale og filmdialog klart, detaljeret og letforståeligt.",
        "simpleTitle": "Tale og dialog gengives særdeles tydeligt",
        "bias": "positive",
        "key": "dialogue",
        "groupId": "05b2a69f-aabd-4df1-9f93-37a3a5121f4c"
