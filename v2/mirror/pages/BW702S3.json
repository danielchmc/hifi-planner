  "displayBookDemo": true,
  "reviews": {
   "summary": "BW702S3 leverer en usædvanligt klar, detaljeret og naturlig gengivelse med stram bas, stærk dynamik og et omsluttende lydbillede. Raffineret diskant, tydelig mellemtone og en tro gengivelse afslører både musikalske nuancer og optagekvalitet, mens den elegante udførelse gør et stærkt visuelt indtryk. Kraftig forstærkning kan frigive endnu mere ydelse, men højttalerne er allerede et særdeles engagerende og alsidigt løft til musik og film.",
   "headlines": {
    "clear, detailed and natural sound": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent den krystalklare, meget detaljerede, naturlige og troværdige gengivelse.",
     "simpleTitle": "Klar, detaljeret og naturlig lyd",
     "bias": "positive",
     "key": "clear-detailed-sound",
     "groupId": "d625b471-666f-4cf1-931a-8a2cf2f94400"
    },
    "tight bass and impressive dynamics": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den kontrollerede bas, den levende dynamik og den hurtige, præcise transientgengivelse.",
     "simpleTitle": "Stram bas og imponerende dynamik",
     "bias": "positive",
     "key": "bass-dynamics",
     "groupId": "d625b471-666f-4cf1-931a-8a2cf2f94400"
    },
    "elegant, well-built appearance": {
     "sentimentAnalysis": "Anmeldelserne roser gentagne gange højttalerne som smukke møbler med fremragende finish og byggekvalitet.",
     "simpleTitle": "Elegant og solid udførelse",
     "bias": "positive",
     "key": "elegant-build",
     "groupId": "cb4602b4-9f51-404d-8c9e-99d767ccdbf8"
    },
    "amplification reveals further potential": {
     "sentimentAnalysis": "Højttalerne fungerer meget godt med flere forstærkere, mens anmeldelserne antyder, at kraftigere eller bedre matchet forstærkning kan hente endnu mere ydelse frem.",
     "simpleTitle": "Forstærkning frigiver yderligere potentiale",
     "bias": "positive",
     "key": "amplifier-potential",
     "groupId": "3564c216-26ef-4566-bd08-17731c06787b"
    },
    "a substantial but worthwhile investment": {
     "sentimentAnalysis": "Prisen anerkendes som høj, men ydeevnen og den langsigtede glæde vurderes bredt til at retfærdiggøre investeringen.",
     "simpleTitle": "En stor, men givende investering",
     "bias": "positive",
     "key": "worthwhile-investment",
     "groupId": "d86e8700-0029-4419-8e60-691fbacada9e"
    },
    "a slightly lean, analytical balance": {
     "sentimentAnalysis": "Et mindretal oplever gengivelsen som mindre varm og kunne ønske sig fyldigere bas, selv om den nuværende balance anses for tilstrækkelig.",
     "simpleTitle": "En lidt slank og analytisk klangbalance",
     "bias": "negative",
     "key": "analytical-balance",
     "groupId": "d625b471-666f-4cf1-931a-8a2cf2f94400"
    }
   },
