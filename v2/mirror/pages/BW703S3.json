  "reviews": {
   "summary": "Bowers & Wilkins 703 S3 leverer en begejstrende og meget detaljeret gengivelse med varm, slagkraftig bas, klare diskanttoner og et omsluttende lydbillede. Raffineret mellemtonedefinition, naturlige vokaler og høj opløsning får krævende musik til at virke rummelig og engagerende. Elegant design og solid konstruktion fuldender en særdeles tilfredsstillende højttalerpakke, selv om nogle anlæg kan have gavn af omhyggelig matching eller en subwoofer.",
   "headlines": {
    "elegant design and sturdy construction": {
     "sentimentAnalysis": "Højttalerne roses gentagne gange for attraktivt design, eksklusive overflader og robust konstruktion.",
     "simpleTitle": "Elegant design og solid konstruktion",
     "bias": "positive",
     "key": "design_build",
     "groupId": "6107e7d6-0bdd-4a29-a90e-947b94aa2efc"
    },
    "highly detailed and clear sound": {
     "sentimentAnalysis": "Anmeldelserne fremhæver konsekvent den fremragende detaljegrad, klarhed, naturlighed og opløsning.",
     "simpleTitle": "Meget detaljeret og klar lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "aaa1dcf9-4cdc-4c7b-9c1d-d4c6ddc8d715"
    },
    "wide and immersive soundstage": {
     "sentimentAnalysis": "Den lagdelte, multidimensionelle gengivelse og det brede stereoperspektiv fremhæves gentagne gange som store styrker.",
     "simpleTitle": "Bredt og omsluttende lydbillede",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "aaa1dcf9-4cdc-4c7b-9c1d-d4c6ddc8d715"
    },
    "controlled, full-bodied bass": {
     "sentimentAnalysis": "Flere anmeldelser beskriver bassen som kraftfuld, stram, dyb og velkontrolleret uden at blive overdreven.",
     "simpleTitle": "Kontrolleret og fyldig bas",
     "bias": "positive",
     "key": "bass_balance",
     "groupId": "3739e19f-eea9-4c97-8fd3-3198a0e8aab7"
    },
    "helpful customer service and advice": {
     "sentimentAnalysis": "Kundeservice, produktrådgivning, installationshjælp og tydelig kommunikation får positiv feedback.",
     "simpleTitle": "Hjælpsom kundeservice og rådgivning",
     "bias": "positive",
     "key": "service_support",
     "groupId": "8894f3d9-5001-43db-8365-2ebc370dea13"
    },
    "treble and bass can feel unbalanced": {
     "sentimentAnalysis": "Nogle anlæg afslører en for fremtrædende diskant eller bas, som kræver dæmpning, omhyggelig matching eller støtte fra en subwoofer.",
     "simpleTitle": "Diskant og bas kan virke ubalanceret",
     "bias": "negative",
     "key": "bass_balance",
     "groupId": "3739e19f-eea9-4c97-8fd3-3198a0e8aab7"
    }
   },
