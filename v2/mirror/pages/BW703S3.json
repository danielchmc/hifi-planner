  "reviews": {
   "summary": "BW703S3 leverer en begejstrende, meget detaljeret og rummelig lyd med ren mellemtone, naturlig klarhed, stram bas og imponerende diskant. De elegante og solidt byggede gulvhøjttalere giver et bredt, omsluttende lydbillede og fremragende musikalsk opløsning, især til vokaler, akustiske optagelser og klassisk musik. Et lille mindretal synes, at diskanten er for fremtrædende, og at bassen er utilstrækkelig uden en subwoofer; korrekt placering og forstærkermatch kan skabe den ønskede balance.",
   "headlines": {
    "elegant and solid construction": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent det attraktive udseende, finishen og den solide konstruktion.",
     "simpleTitle": "Elegant og solid konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "c90a067e-fbcc-429f-833b-29cd502f3cbd"
    },
    "highly detailed, clear and natural sound": {
     "sentimentAnalysis": "Anmeldelserne roser den usædvanligt detaljerede, klare, nuancerede og naturlige gengivelse.",
     "simpleTitle": "Meget detaljeret, klar og naturlig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "4cf06878-c16a-488e-8e4b-0d0578a8f525"
    },
    "wide, immersive soundstage": {
     "sentimentAnalysis": "Højttalerne roses gentagne gange for en rummelig, lagdelt og tredimensionel gengivelse.",
     "simpleTitle": "Bredt og omsluttende lydbillede",
     "bias": "positive",
     "key": "sound",
     "groupId": "4cf06878-c16a-488e-8e4b-0d0578a8f525"
    },
    "balanced, punchy bass": {
     "sentimentAnalysis": "Flere anmeldelser beskriver bassen som kraftfuld, kontrolleret og velafbalanceret frem for overdreven.",
     "simpleTitle": "Balanceret og stram bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "4cf06878-c16a-488e-8e4b-0d0578a8f525"
    },
    "helpful and knowledgeable service": {
     "sentimentAnalysis": "Kundeservicen roses for ekspertise, klare svar og støtte ved køb og installation.",
     "simpleTitle": "Hjælpsom og kompetent service",
     "bias": "positive",
     "key": "service",
     "groupId": "3b5f5d22-7394-423f-be13-0f520a5c748e"
    },
    "treble can be too prominent and bass may need a subwoofer": {
     "sentimentAnalysis": "Kritikken fremhæver lys diskant, begrænset dybbas og mindre centrerede vokaler i nogle opsætninger.",
