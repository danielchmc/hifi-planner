  "displayBookDemo": true,
  "reviews": {
   "summary": "B&W 705S3 leverer en usædvanligt klar, varm og medrivende gengivelse med luftig diskant, præcis placering, livagtige mellemtoner og overraskende punchy bas for en kompakt højttaler. Detaljegrad, separation og rumlighed roses gentagne gange og får musikken til at føles levende, åben og engagerende. Omhyggeligt valg af forstærker, placering og rumforhold er vigtigt, mens nogle lyttere finder diskanten for fremtrædende og anbefaler en subwoofer i større rum.",
   "headlines": {
    "surprisingly powerful and controlled bass": {
     "sentimentAnalysis": "Flere anmeldelser beskriver dyb, punchy eller overraskende fyldig bas, som ofte overgår forventningerne til kabinettets størrelse.",
     "simpleTitle": "Overraskende kraftfuld og kontrolleret bas",
     "bias": "positive",
     "key": "bass_strength",
     "groupId": "c5026b17-c7fa-4784-877d-83c76a8ec2df"
    },
    "clear, detailed and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne roser enestående klarhed, præcision, detaljegrad, separation og rumlig gengivelse.",
     "simpleTitle": "Klar, detaljeret og rumlig lyd",
     "bias": "positive",
     "key": "sound_detail",
     "groupId": "32e41283-71e1-4bc8-9c31-fefe098812bb"
    },
    "placement and amplification make a major difference": {
     "sentimentAnalysis": "Anmeldelserne understreger samstemmende omhyggelig placering og passende forstærkning for den bedste rumlighed og kontrol.",
     "simpleTitle": "Placering og forstærkervalg gør en stor forskel",
     "bias": "meh",
     "key": "setup_matching",
     "groupId": "e76cc20e-9284-4321-b4ee-eb69b0363df4"
    },
    "subwoofer recommended in larger rooms": {
     "sentimentAnalysis": "Nogle anmeldelser oplever begrænset bas i større rum eller en markant forbedring med subwoofer.",
     "simpleTitle": "Subwoofer anbefales i større rum",
     "bias": "negative",
     "key": "subwoofer_need",
     "groupId": "c5026b17-c7fa-4784-877d-83c76a8ec2df"
    },
    "bright treble can expose harsh recordings": {
     "sentimentAnalysis": "To anmeldelser bemærker, at den meget afslørende diskant kan virke fremtrædende eller afsløre fejl i optagelser.",
     "simpleTitle": "Lys diskant kan afsløre hårde optagelser",
     "bias": "negative",
     "key": "treble_brightness",
     "groupId": "32e41283-71e1-4bc8-9c31-fefe098812bb"
    }
   },
