  "displayBookDemo": true,
  "reviews": {
   "summary": "BW706S3 leverer en usædvanligt klar, detaljeret og velafbalanceret lyd fra et kompakt kabinet med tydelige vokaler, omsluttende stereoperspektiv og stærk gengivelse af både musik og film. Højttalerne bliver rundere og mere naturlige efter tilspilning, og en kraftig forstærker hjælper dem med at yde deres bedste. Bassen er generelt ren og kontrolleret, men flere lyttere ønsker en subwoofer for mere dybde og punch, især ved højere lydstyrke eller krævende musik.",
   "headlines": {
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, præcise, detaljerede og rummelige gengivelse med særligt tydelig vokal og instrumenter.",
     "simpleTitle": "Klar, detaljeret og omsluttende lyd",
     "bias": "positive",
     "key": "sound-detail",
     "groupId": "96030609-5185-4f69-9cd5-d6674269f1b7"
    },
    "deep bass often benefits from a subwoofer": {
     "sentimentAnalysis": "Flere anmeldelser synes, at bassen er for lidt dyb, tør eller tilbageholdende, og anbefaler en subwoofer for mere fylde i bunden.",
     "simpleTitle": "Dyb bas får ofte hjælp af en subwoofer",
     "bias": "negative",
     "key": "subwoofer-depth",
     "groupId": "c7f1b4b8-64d6-41af-9bab-dfb90395722b"
    },
    "balanced, full-range sound without a mandatory subwoofer": {
     "sentimentAnalysis": "Andre anmeldelser beskriver bassen som god, fyldig og tilstrækkelig alene, især i mindre rum eller ved moderate lydstyrker.",
     "simpleTitle": "Balanceret fuldtonelyd uden nødvendig subwoofer",
     "bias": "positive",
     "key": "full-range-bass",
     "groupId": "c7f1b4b8-64d6-41af-9bab-dfb90395722b"
    },
    "sound improves and bass opens up after run-in": {
     "sentimentAnalysis": "Flere lyttere oplever, at højttalerne bliver mere naturlige efter timers eller ugers brug, især når bassen bliver rundere.",
     "simpleTitle": "Lyden forbedres efter tilspilning",
     "bias": "positive",
     "key": "run-in-improvement",
     "groupId": "a2edb991-68f3-4f75-92a8-720abbaf6610"
    },
    "compact and attractive design": {
     "sentimentAnalysis": "Anmeldelserne værdsætter de kompakte mål, det flotte udseende og egnetheden til mindre rum.",
     "simpleTitle": "Kompakt og flot design",
     "bias": "positive",
     "key": "compact-design",
     "groupId": "80b3295a-999d-44db-a100-19837f7ddb2f"
    }
   },
