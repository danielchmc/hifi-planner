  "displayBookDemo": true,
  "reviews": {
   "summary": "BW707S3 leverer en bemærkelsesværdig klar, detaljeret og musikalsk lyd for en kompakt højttaler med en åben, varm og medrivende gengivelse. Bassen er overraskende fyldig og velkontrolleret i forhold til størrelsen, selv om en subwoofer kan tilføre endnu mere dybde. Den elegante udførelse, den fyldige rumgengivelse og den fremragende klarhed gør højttaleren særligt attraktiv i mindre rum og til fokuseret lytning.",
   "headlines": {
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Gengivelsen roses gentagne gange for klarhed, detaljer, renhed og en rummelig, musikalsk karakter.",
     "simpleTitle": "Klar, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "f12146a3-d28a-4e49-8cf0-fea1c8e6ddd7"
    },
    "surprisingly full and powerful bass": {
     "sentimentAnalysis": "Flere anmeldelser oplever bassen som usædvanligt dyb, fyldig og tilfredsstillende i forhold til det kompakte kabinet.",
     "simpleTitle": "Overraskende fyldig og kraftig bas",
     "bias": "positive",
     "key": "bass",
     "groupId": "7ed28de0-5d34-45aa-b4db-983dd0b95165"
    },
    "subwoofer adds deeper full-range weight": {
     "sentimentAnalysis": "Nogle anmeldelser anser en subwoofer for nyttig eller nødvendig til dybere bas, mens andre oplever tilfredsstillende bas uden.",
     "simpleTitle": "En subwoofer tilfører mere dybde",
     "bias": "negative",
     "key": "bass",
     "groupId": "7ed28de0-5d34-45aa-b4db-983dd0b95165"
    },
    "compact size suits smaller rooms": {
     "sentimentAnalysis": "Det kompakte kabinet værdsættes gentagne gange for at levere fyldig lyd i små lytterum.",
     "simpleTitle": "Kompakt størrelse passer til mindre rum",
     "bias": "positive",
     "key": "sound",
     "groupId": "f12146a3-d28a-4e49-8cf0-fea1c8e6ddd7"
    },
    "elegant, attractive construction": {
     "sentimentAnalysis": "Højttalerne beskrives konsekvent som elegante, slanke, smukke og veludførte.",
     "simpleTitle": "Elegant og attraktiv udførelse",
