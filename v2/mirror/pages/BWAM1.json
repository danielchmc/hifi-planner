  "displayBookDemo": true,
  "reviews": {
   "summary": "BWAM1 leverer en varm, klar og detaljeret lyd med imponerende fylde og god spredning for en kompakt udendørshøjttaler. Den solide konstruktion, vejrbestandigheden og de fleksible monteringsmuligheder gør den velegnet til terrasser, haver, swimmingpools og surroundopsætninger. Bassen kan virke lidt slank i det fri, og højttalerne kan tage skade ved for hård belastning, men den samlede værdi og musikoplevelse er fremragende.",
   "headlines": {
    "rich, clear and immersive sound": {
     "sentimentAnalysis": "Lyden roses bredt for at være klar, detaljeret, fyldig og velafbalanceret med en omsluttende gengivelse på større udendørsarealer.",
     "simpleTitle": "Fyldig, klar og omsluttende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "9e337647-4eea-44b6-8783-a2148ba34885"
    },
    "punchy bass and ample volume": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver en tilfredsstillende bas, stærk dynamik, festegnet lydstyrke og tilstrækkeligt bastryk uden subwoofer.",
     "simpleTitle": "Kontant bas og rigelig lydstyrke",
     "bias": "positive",
     "key": "sound",
     "groupId": "9e337647-4eea-44b6-8783-a2148ba34885"
    },
    "easy, flexible mounting": {
     "sentimentAnalysis": "Beslagssystemet opfattes som smart, solidt og praktisk og gør montering og fleksibel placering enkel.",
     "simpleTitle": "Nem og fleksibel montering",
     "bias": "positive",
     "key": "mounting",
     "groupId": "7035b691-7b8d-43e9-b7d9-1871210f963b"
    },
    "built for outdoor listening": {
     "sentimentAnalysis": "Anmeldelserne roser det lukkede kabinet, vejrbestandigheden og evnen til at fylde terrasser, haver og poolområder med god lyd.",
     "simpleTitle": "Skabt til udendørs lytning",
     "bias": "positive",
     "key": "outdoor",
     "groupId": "7eab5bc7-9202-4264-b1e4-fc42877f75e9"
    },
    "bass can sound thin in open air": {
     "sentimentAnalysis": "Placering i det fri kan reducere den oplevede bas og give en tyndere bund trods ellers god lyd.",
     "simpleTitle": "Bassen kan virke tynd i det fri",
     "bias": "negative",
     "key": "sound",
     "groupId": "9e337647-4eea-44b6-8783-a2148ba34885"
    }
   },
