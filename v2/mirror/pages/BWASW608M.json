  "reviews": {
   "summary": "BWASW608M roses bredt som en kompakt, men kraftfuld subwoofer, der leverer dyb, kontant og præcis bas, som tilfører varme, fylde og indlevelse til musik, tv og film. Den nemme placering og de fleksible indstillingsmuligheder gør subwooferen til et stærkt match til reolhøjttalere og kompakte anlæg, især i små og mellemstore rum. Enkelte anmeldelser nævner udfordringer med opsætning, forsinket automatisk aktivering eller tekniske problemer, men det samlede indtryk er meget positivt.",
   "headlines": {
    "a subtle upgrade for music, TV and film": {
     "sentimentAnalysis": "Subwooferen roses gentagne gange for at udfylde de dybe frekvenser naturligt og diskret, så stereo-, tv- og surroundlyd bliver fyldigere og mere medrivende.",
     "simpleTitle": "En diskret opgradering til musik, tv og film",
     "bias": "positive",
     "key": "bass",
     "groupId": "a5fce271-0722-49d2-b631-5eb0a32a6f85"
    },
    "flexible controls help tailor the sound": {
     "sentimentAnalysis": "Flere anmeldelser værdsætter de mange indstillingsmuligheder, som gør det muligt at tilpasse basniveau og integration til forskellige højttalere, rum og lyttepræferencer.",
     "simpleTitle": "Fleksible indstillinger gør det nemt at tilpasse lyden",
     "bias": "positive",
     "key": "adjustment",
     "groupId": "da642857-0bd2-4948-b2cb-06c14ec87d26"
    },
    "deep, punchy bass from a compact cabinet": {
     "sentimentAnalysis": "Anmeldelserne beskriver samstemmende bassen som dyb, kraftfuld, stram, hurtig og præcis, hvilket er særligt imponerende i forhold til den kompakte størrelse.",
     "simpleTitle": "Dyb og kontant bas fra et kompakt kabinet",
     "bias": "positive",
     "key": "bass",
     "groupId": "a5fce271-0722-49d2-b631-5eb0a32a6f85"
    },
    "compact design makes placement easy": {
     "sentimentAnalysis": "Det kompakte format værdsættes ofte, fordi subwooferen kan placeres diskret i rum, hvor en større model ville være upraktisk.",
     "simpleTitle": "Det kompakte design gør placeringen nem",
     "bias": "positive",
     "key": "compact",
     "groupId": "a2aaa669-4b68-47b0-98af-2132846c7092"
    },
    "setup can require careful fine-tuning": {
     "sentimentAnalysis": "Enkelte anmeldelser finder integrationen vanskelig og rapporterer, at forkert justering kan give en hul eller brummende lyd.",
     "simpleTitle": "Opsætningen kan kræve omhyggelig finjustering",
     "bias": "negative",
     "key": "adjustment",
     "groupId": "da642857-0bd2-4948-b2cb-06c14ec87d26"
    }
   },
