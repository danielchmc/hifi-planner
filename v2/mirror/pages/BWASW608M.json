  "reviews": {
   "summary": "BWASW608M roses bredt som en kompakt, imponerende dyb, stram og musikalsk subwoofer. Den tilfører varm, slagkraftig og omsluttende bas til reolhøjttalere, tv samt stereo- og surroundanlæg uden at virke dominerende, mens de fleksible indstillinger og den nemme placering gør integrationen praktisk. Enkelte anmeldelser nævner udfordringer med opsætningen, et aktiveringsproblem ved lav lydstyrke og en rapporteret fejl, men helhedsindtrykket er meget positivt.",
   "headlines": {
    "complements speakers and TV systems effectively": {
     "sentimentAnalysis": "Anmeldelserne beskriver vellykket samspil med reolhøjttalere, soundbarer, tv samt stereo- og surroundanlæg.",
     "simpleTitle": "Komplementerer højttalere og tv-systemer effektivt",
     "bias": "positive",
     "key": "system_integration",
     "groupId": "b7db1be0-3161-4be0-a6f6-0110b7dbf658"
    },
    "deep, tight and powerful bass": {
     "sentimentAnalysis": "Anmeldelserne beskriver bassen som dyb, slagkraftig, præcis, hurtig og overraskende kraftfuld for subwooferens størrelse.",
     "simpleTitle": "Dyb, stram og kraftfuld bas",
     "bias": "positive",
     "key": "bass_sound",
     "groupId": "3986423e-a55e-4489-98a7-81687d151c07"
    },
    "compact enough for easy placement": {
     "sentimentAnalysis": "Det lille kabinet værdsættes gentagne gange for at passe diskret ind i rummet og give fleksible placeringsmuligheder.",
     "simpleTitle": "Kompakt nok til nem placering",
     "bias": "positive",
     "key": "compact_placement",
     "groupId": "56fd61d5-cb13-4bdc-a0c7-ad34285b0960"
    },
    "flexible adjustment improves integration": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver nyttige kontroller, nem niveaujustering og muligheden for at tilpasse bassen til højttalere, rum og musik.",
     "simpleTitle": "Fleksible indstillinger letter integrationen",
     "bias": "positive",
     "key": "adjustment",
     "groupId": "6410a557-0e01-487e-998c-38908ebb0bee"
    },
    "a warm and unobtrusive upgrade": {
     "sentimentAnalysis": "Subwooferen roses for at tilføre fyldigere, varmere og mere omsluttende bas, samtidig med at den forbliver kontrolleret og diskret.",
     "simpleTitle": "En varm og diskret opgradering",
     "bias": "positive",
     "key": "bass_sound",
     "groupId": "3986423e-a55e-4489-98a7-81687d151c07"
    },
    "initial setup can be demanding": {
     "sentimentAnalysis": "Nogle anmeldelser siger, at det tager tid at finde de rigtige indstillinger, og at forkert justering kan give en hul eller buldrende lyd.",
     "simpleTitle": "Den første opsætning kan være krævende",
     "bias": "negative",
     "key": "adjustment",
     "groupId": "6410a557-0e01-487e-998c-38908ebb0bee"
    }
   },
