     "key": "system-integration",
     "groupId": "da13729d-ecf4-4c5c-921b-0b8591c1bc21"
    },
    "strong immersion for films and music": {
     "sentimentAnalysis": "Subwooferen tilfører biografisk effekt og en fyldigere musikoplevelse, især med kraftfulde dybeffekter i film.",
     "simpleTitle": "Stærk indlevelse til film og musik",
     "bias": "positive",
     "key": "sound-quality",
