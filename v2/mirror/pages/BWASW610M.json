  "reviews": {
   "summary": "B&W ASW610 leverer varm, punchy og præcis bas med imponerende kraft for sin kompakte størrelse. Subwooferen integrerer sig især godt med B&W- og andre højttalersystemer og tilfører dybde til både musik og film uden at blive buldrende, når den er korrekt indstillet. De fleksible justeringsmuligheder, den stærke ydelse ved både lav og høj lydstyrke samt den fyldige bas gør ASW610 til et meget tilfredsstillende valg, selv om enkelte anmeldelser nævner den høje pris, lejlighedsvis støj eller behovet for omhyggelig opsætning.",
   "headlines": {
    "warm, powerful and precise bass": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent bassen som stram, kontrolleret, varm, dyb, musikalsk og kraftfuld frem for løs eller buldrende.",
     "simpleTitle": "Varm, kraftfuld og præcis bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "f30a4022-e892-4c3a-bae4-1a4b02bf22ed"
    },
    "a convincing upgrade for music and film": {
     "sentimentAnalysis": "Subwooferen tilfører biografisk effekt og større musikalitet med tilstrækkeligt overskud til både afdæmpet lytning og energisk afspilning.",
     "simpleTitle": "En overbevisende opgradering til musik og film",
     "bias": "positive",
     "key": "sound",
     "groupId": "f30a4022-e892-4c3a-bae4-1a4b02bf22ed"
    },
    "seamless matching with speaker systems": {
     "sentimentAnalysis": "ASW610 roses gentagne gange som et naturligt supplement til B&W- og andre højttalersystemer, der forbedrer sammenhængen og basområdet.",
     "simpleTitle": "Problemfri integration med højttalersystemer",
     "bias": "positive",
     "key": "integration",
     "groupId": "dd3a88e9-9276-4b7d-9d1d-512609482c8b"
    },
    "compact design with room-filling output": {
     "sentimentAnalysis": "Det kompakte kabinet opleves som overraskende kraftfuldt og egnet til både mindre og større rum.",
     "simpleTitle": "Kompakt design med fyldig lyd",
     "bias": "positive",
     "key": "size",
     "groupId": "fcc00b8f-b100-4b5c-b361-8622107d12ea"
    },
    "careful adjustment is important": {
     "sentimentAnalysis": "Flere anmeldelser viser, at placering og indstilling afgør, om den kraftige bas forbliver afbalanceret eller bliver dominerende.",
     "simpleTitle": "Omhyggelig indstilling er vigtig",
     "bias": "negative",
     "key": "adjustment",
     "groupId": "2af3c4d7-205b-4192-bb11-6d9e687f98fc"
    }
