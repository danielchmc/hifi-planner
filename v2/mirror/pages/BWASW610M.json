     "bias": "positive",
     "key": "sound-quality",
     "groupId": "c6450117-c26f-4c57-9922-363a29f39baf"
    },
    "seamless speaker matching": {
     "sentimentAnalysis": "ASW610 roses ofte for at falde naturligt ind sammen med B&W- og andre højttalersystemer.",
     "simpleTitle": "Problemfri tilpasning til højttalere",
