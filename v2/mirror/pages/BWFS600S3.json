  "reviews": {
   "summary": "BWFS600S3-stativerne leverer en varm, kraftfuld og mærkbart mere omsluttende lydgengivelse, og flere ejere oplever en tydelig forbedring af lyden. Den solide konstruktion, den fremragende stabilitet efter sandfyldning og det enkle, elegante design gør stativerne til et stærkt visuelt og praktisk match til B&W-højttalere. Den nemme montering og kompatibiliteten med højttalerne roses bredt, men indbygget kabelstyring mangler.",
   "headlines": {
    "elegant design matches B&W speakers": {
     "sentimentAnalysis": "Stativerne roses bredt for deres attraktive, minimalistiske udseende og tætte visuelle og fysiske pasform til B&W-højttalere.",
     "simpleTitle": "Elegant design passer til B&W-højttalere",
     "bias": "positive",
     "key": "design_fit",
     "groupId": "649810f9-e26e-4466-9678-e1e6699caee0"
    },
    "sand filling greatly boosts stability": {
     "sentimentAnalysis": "Sandfyldning anbefales gentagne gange som en effektiv måde at tilføre vægt og skabe en meget sikker og stabil platform.",
     "simpleTitle": "Sandfyldning øger stabiliteten markant",
     "bias": "positive",
     "key": "stability",
     "groupId": "86c8d335-0d9e-4aa4-b87b-405359ec8407"
    },
    "simple assembly and secure mounting": {
     "sentimentAnalysis": "Monteringen beskrives som enkel, mens passende fastgørelse og sikker montering giver højttaleropsætningen tryghed og stabilitet.",
     "simpleTitle": "Nem montering og sikker fastgørelse",
     "bias": "positive",
     "key": "assembly",
     "groupId": "b8144bb1-0bf5-4614-88b6-7e3cf64ccb97"
    },
    "clear improvement in sound": {
     "sentimentAnalysis": "Stativerne får æren for at forbedre højttalerlyden med kraftig bas og en luftig, rummelig gengivelse.",
     "simpleTitle": "Tydelig forbedring af lyden",
     "bias": "positive",
     "key": "sound",
     "groupId": "8f5806b8-a632-43e2-804a-3487321e6e81"
    },
    "built-in cable management is missing": {
     "sentimentAnalysis": "Manglen på dedikeret kabelføring er en tydelig designmangel, som får ejere til at bore eller skabe deres egen kabelløsning.",
     "simpleTitle": "Indbygget kabelstyring mangler",
     "bias": "negative",
     "key": "cable_management",
     "groupId": "492bb1c0-4803-4e9b-b97b-a8845fd4b2d3"
    }
   },
