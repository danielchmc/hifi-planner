  "reviews": {
   "summary": "BWFS700S3-stativerne roses bredt for deres elegante design og flotte match med B&W-højttalere. Den solide konstruktion, de attraktive overflader og det gennemførte udtryk får stativerne til at føles som en vigtig del af systemet. Den største anke er den høje pris, mens kompatibilitet og detaljer omkring fyldning kræver lidt opmærksomhed.",
   "headlines": {
    "elegant design complements B&W speakers": {
     "sentimentAnalysis": "Stativerne beskrives gentagne gange som smukke, stilfulde, eksklusive og velegnede til B&W-højttalere.",
     "simpleTitle": "Elegant design komplimenterer B&W-højttalere",
     "bias": "positive",
     "key": "design",
     "groupId": "8ace1594-28fc-4e22-90f7-587e0961b257"
    },
    "premium pricing": {
     "sentimentAnalysis": "Flere anmeldelser vurderer stativerne som dyre eller mindre prisvenlige på trods af det flotte design.",
     "simpleTitle": "Høj premiumpris",
     "bias": "negative",
     "key": "price",
     "groupId": "b5220139-1493-4c85-91c3-b507a0613bd5"
    },
    "broad compatibility with B&W models": {
     "sentimentAnalysis": "Stativerne opfattes som udviklet specifikt til B&W-højttalere og egnede til flere modeller, blandt andet 705 S3 og 606 S3.",
     "simpleTitle": "Bred kompatibilitet med B&W-modeller",
     "bias": "positive",
     "key": "compatibility",
     "groupId": "323c66f2-c6e6-48ec-bd54-54cf7357b763"
    },
    "strong and well-finished construction": {
     "sentimentAnalysis": "De positive kommentarer fremhæver stabilitet, god kvalitet og flot finish.",
     "simpleTitle": "Solid og veludført konstruktion",
     "bias": "positive",
     "key": "build",
     "groupId": "cb170ac5-d8df-4072-9e05-daf7031700d4"
    },
    "some mounting limitations": {
     "sentimentAnalysis": "Monteringen er ikke lige enkel på alle modeller: Ældre 700 S2-højttalere kan kræve tape, mens én skrue kan være nok til 606 S3-højttalere.",
     "simpleTitle": "Visse begrænsninger ved montering",
