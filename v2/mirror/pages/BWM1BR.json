  "reviews": {
   "summary": "BWM1BR-højttalerne roses bredt for en klar, detaljeret, kraftfuld og varm lyd fra et kompakt og stilfuldt kabinet. Højttalerne fungerer især godt i stereo-, surround- og hjemmebiografopsætninger og passer flot ind i rummet og indretningen. På grund af det lille kabinet anbefaler flere anmeldelser en subwoofer for dybere, fyldigere og kraftigere bas.",
   "headlines": {
    "clear, detailed and powerful sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver lyden som klar, ren, detaljeret, kraftfuld og overraskende fyldig i forhold til størrelsen.",
     "simpleTitle": "Klar, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "060ca123-f04f-4d11-bce0-34242492b434"
    },
    "compact and stylish design": {
     "sentimentAnalysis": "Anmeldelserne roser det lille format, det attraktive design og det diskrete udseende, som gør højttalerne nemme at integrere i hjemmet.",
     "simpleTitle": "Kompakt og stilfuldt design",
     "bias": "positive",
     "key": "compact-design",
     "groupId": "4a26a13f-8330-49c2-a9ed-3f3e41a1f5bf"
    },
    "effective surround and home-cinema speakers": {
     "sentimentAnalysis": "Anmeldelserne vurderer højttalerne som effektive bag-, satellit- og surroundkanaler, der forbedrer tv-dialoger og fuldender flerkanalssystemer.",
     "simpleTitle": "Velegnede surround- og hjemmebiografhøjttalere",
     "bias": "positive",
     "key": "surround-use",
     "groupId": "33eeb99a-508f-445a-987a-e66e3a8e9891"
    },
    "a subwoofer adds essential low-end depth": {
     "sentimentAnalysis": "De kompakte kabinetter beskrives gentagne gange som afhængige af en subwoofer for dybere bas, mere kraft og bedre balance; én anmeldelse oplever lyden uden subwoofer som tynd og dåseagtig.",
     "simpleTitle": "En subwoofer giver vigtig dybde i bassen",
     "bias": "negative",
     "key": "subwoofer-bass",
     "groupId": "2720526b-e56f-4c98-970e-d24b0db3fe77"
    },
    "warm and full sound": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver en varm, robust og velafbalanceret gengivelse, der fylder rummet til både musik og film.",
     "simpleTitle": "Varm og fyldig lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "060ca123-f04f-4d11-bce0-34242492b434"
    }
   },
