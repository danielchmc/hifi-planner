  "reviews": {
   "summary": "BWPI6 leverer en særdeles klar, detaljeret og medrivende lyd med fyldig bas, god komfort og generelt effektiv støjreduktion. Premiumlyden og den attraktive pris bliver ofte fremhævet, hvilket gør øretelefonerne til et stærkt valg i hverdagen. Forbindelse, batteritid, touch-betjening og den begrænsede app er tilbagevendende svagheder, og nogle oplever også opladningsproblemer eller udfald i den ene øretelefon.",
   "headlines": {
    "the app and controls feel limited": {
     "sentimentAnalysis": "Appen beskrives gentagne gange som sparsom, reklamepræget og begrænset med hensyn til equalizer, lokalisering og tilpasning af betjeningen; touch-styringen kan også være ustabil.",
     "simpleTitle": "App og betjening føles begrænset",
     "bias": "negative",
     "key": "app_controls",
     "groupId": "6066e9bf-ca80-4c22-938f-c654ceca201a"
    },
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Lyden beskrives gentagne gange som klar, detaljeret, velafbalanceret, rummelig og fyldig med kraftig eller kontrolleret bas.",
     "simpleTitle": "Klar, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "6b4cd7cb-fa11-4f00-b6cf-f6bb00745243"
    },
    "comfortable, secure fit": {
     "sentimentAnalysis": "De fleste kommentarer roser den komfortable og stabile pasform ved længere tids brug, sport og mindre ører.",
     "simpleTitle": "Komfortabel og sikker pasform",
     "bias": "positive",
     "key": "fit",
     "groupId": "216a1aa1-16a1-44dd-8c1c-0263a27ec936"
    },
    "effective everyday noise cancellation": {
     "sentimentAnalysis": "Støjreduktionen roses ofte for at forbedre lytteoplevelsen på farten, i fly, udendørs og i støjende omgivelser.",
     "simpleTitle": "Effektiv støjreduktion i hverdagen",
     "bias": "positive",
     "key": "anc",
     "groupId": "9c331499-7cd3-4e61-9871-ef5d895d3acf"
    },
    "connection can be unreliable": {
     "sentimentAnalysis": "Flere ejere oplever problemer med parring, udfald, interferens, begrænset rækkevidde eller at kun den ene øretelefon forbinder.",
     "simpleTitle": "Forbindelsen kan være ustabil",
     "bias": "negative",
     "key": "connectivity",
     "groupId": "2e81427c-3798-4b3a-a35a-fdece5f345d9"
    },
    "battery performance is inconsistent": {
     "sentimentAnalysis": "Nogle ejere rapporterer kortere batteritid end angivet, afladning i etuiet eller opladningsfejl, selv om andre finder batteritiden tilstrækkelig.",
     "simpleTitle": "Batteriydelsen er svingende",
     "bias": "negative",
     "key": "battery",
     "groupId": "1fdc2da7-574b-4379-8664-ba51d9f5dac0"
    }
   },
