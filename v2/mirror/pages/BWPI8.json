  "displayBookDemo": true,
  "reviews": {
   "summary": "B&W Pi8 leverer en enestående, varm og meget detaljeret lytteoplevelse med kraftfuld bas, klare mellemtoner, sprøde diskanttoner og et imponerende bredt, omsluttende lydbillede. Komfort og pasform roses generelt, blandt andet takket være flere størrelser ørepropper, mens det eksklusive design og transmitteretuiet giver ekstra alsidighed. Forbindelse, mikrofoner, appstyring og støjreduktion er mindre stabile end den fremragende lyd, så den høje pris giver mest mening for musikfokuserede brugere.",
   "headlines": {
    "exceptional, detailed sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent en rummelig, klar, raffineret og meget detaljeret gengivelse, ofte med kraftig bas og overbevisende instrumentadskillelse.",
     "simpleTitle": "Enestående detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "d12af940-5312-43bf-a5c2-70c49a6379ed"
    },
    "microphones struggle during calls": {
     "sentimentAnalysis": "Opkaldskvaliteten er den hyppigst nævnte svaghed: Modtageren hører ofte stemmen for lavt, fjernt, dæmpet, metallisk eller overdøvet af baggrundsstøj.",
     "simpleTitle": "Mikrofonerne kæmper under opkald",
     "bias": "negative",
     "key": "calls",
     "groupId": "af3d9f5f-dfd6-4e00-8b35-512c45a3d24e"
    },
    "bluetooth can be unreliable": {
     "sentimentAnalysis": "En betydelig del af anmeldelserne rapporterer forsinkelser ved parring, udfald, forbindelse til kun én øreprop eller afspilning, selv efter at propperne er lagt i etuiet.",
     "simpleTitle": "Bluetooth kan være ustabilt",
     "bias": "negative",
     "key": "connectivity",
     "groupId": "60e6aebb-436d-4976-9edf-d9c421f75464"
    },
    "noise cancellation is weaker than the sound": {
     "sentimentAnalysis": "Mange anmeldelser vurderer ANC som middelmådig eller svag sammenlignet med Sony, Bose, AirPods og nogle billigere alternativer, især i blæst og støjende omgivelser.",
     "simpleTitle": "Støjreduktionen er svagere end lyden",
     "bias": "negative",
     "key": "noise_cancellation",
     "groupId": "e224c7ca-bb65-468d-bd61-cae7cdfe9d0e"
    },
    "comfortable, secure fit": {
     "sentimentAnalysis": "De fleste kommentarer roser den komfortable og stabile pasform ved lang tids lytning, gang og træning; de forskellige ørepropper hjælper forskellige ører.",
     "simpleTitle": "Komfortabel og sikker pasform",
     "bias": "positive",
     "key": "comfort",
     "groupId": "1da05f35-0f7a-41cc-8937-191e04b502c6"
    }
   },
