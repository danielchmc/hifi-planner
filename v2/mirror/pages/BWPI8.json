  "displayBookDemo": true,
  "reviews": {
   "summary": "B&W Pi8 leverer en enestående, varm og meget detaljeret lyd med stor, immersiv lydscene, kontrolleret bas og fremragende instrumentadskillelse. Komfort og pasform er generelt stærke, mens transmitteretuiet, det eksklusive design og den nyttige app er ekstra plusser. Støjreduktion, mikrofoner, touchkontroller, batterivisning og Bluetooth-stabilitet er dog tilbagevendende svagheder.",
   "headlines": {
    "microphones are poor for calls": {
     "sentimentAnalysis": "Samtalepartnere oplever ofte en lav, dumpet eller forvrænget stemme, så Pi8 egner sig langt bedre til musik end til krævende telefon- eller Teams-samtaler.",
     "simpleTitle": "Svage mikrofoner til samtaler",
     "bias": "negative",
     "key": "calls",
     "groupId": "11fcfe7b-ddd7-46a1-8150-65da48540618"
    },
    "comfortable and secure fit": {
     "sentimentAnalysis": "De fleste ejere beskriver en komfortabel og stabil pasform til lang tids lytning og bevægelse, selv om øreform og ørepropper af og til giver problemer.",
     "simpleTitle": "Komfortabel og sikker pasform",
     "bias": "positive",
     "key": "fit",
     "groupId": "c5d8fdd4-c1a0-47aa-a7a6-0b811948a93e"
    },
    "exceptional, detailed and immersive sound": {
     "sentimentAnalysis": "Varm, rummelig og meget detaljeret lyd med kontrolleret bas, klare højder og imponerende adskillelse er den største styrke.",
     "simpleTitle": "Enestående, detaljeret og immersiv lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "577ec772-28b8-46d6-9fdb-71a74a5a1906"
    },
    "noise cancellation is often weaker than expected": {
     "sentimentAnalysis": "Mange ejere synes, at ANC kun er middelmådig eller svagere end hos Sony, Bose, Jabra og Sennheiser, især i vind og travle omgivelser.",
     "simpleTitle": "Støjreduktionen er ofte svagere end forventet",
     "bias": "negative",
     "key": "anc",
     "groupId": "db598da4-2dde-4180-8986-4f61632471fe"
    }
   },
