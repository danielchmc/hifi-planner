  "bundleRelations": [],
  "displayBookDemo": true,
  "reviews": {
   "summary": "Bowers & Wilkins PX7 S2e roses bredt for varm, detaljeret og naturlig lyd med kontrolleret bas, klare diskanttoner og en medrivende gengivelse. Komfort, førsteklasses konstruktion, lang batteritid og praktiske fysiske knapper gør hovedtelefonerne behagelige ved lang tids brug og til god værdi for pengene. Støjreduktionen fungerer godt i hverdagen og på rejser, men vurderes ofte som svagere end de bedste alternativer fra Sony, Bose og Apple; appen og multipoint-forbindelsen kritiseres også lejlighedsvis.",
   "headlines": {
    "useful ANC, but not class-leading": {
     "sentimentAnalysis": "Støjreduktionen dæmper konstante baggrundslyde effektivt for mange, især i tog og fly, men stemmer, vind, lavfrekvente vibrationer og travle omgivelser kan stadig høres; flere vurderer konkurrenternes systemer højere.",
     "simpleTitle": "Nyttig støjreduktion, men ikke i topklasse",
     "bias": "negative",
     "key": "anc",
     "groupId": "205353e9-d30a-4795-b84e-d4e1cc4c85cf"
    },
    "warm, detailed and highly musical sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver gennemgående en varm, klar, detaljeret og naturlig gengivelse med god instrumentseparation, tilfredsstillende bas og klare diskanttoner.",
     "simpleTitle": "Varm, detaljeret og meget musikalsk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "8bc2b478-2905-4b14-8467-9e30cc886f10"
    },
    "comfortable for long listening": {
     "sentimentAnalysis": "De fleste anmeldelser roser de bløde ørepuder, den afbalancerede pasform og komforten i flere timer, men nogle synes, at hovedtelefonerne er tunge, varme eller stramme, især med briller eller store ører.",
     "simpleTitle": "Behagelige ved lang tids brug",
     "bias": "positive",
     "key": "comfort",
     "groupId": "406b6f7e-f19b-4d8d-9b59-c6b66c1e6720"
    }
   },
