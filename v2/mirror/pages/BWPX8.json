  "reviews": {
   "summary": "B&W PX8 leverer en førsteklasses, varm og meget detaljeret lytteoplevelse med punchy bas, klare mellemtoner, luftige diskanttoner og en imponerende rumfornemmelse. Luksuriøse materialer, solid konstruktion og god komfort ved lang tids brug understreger premium-indtrykket. Støjreduktionen er generelt effektiv, men ikke altid på niveau med Sony eller Bose, og den begrænsede app-EQ, multipoint, lejlighedsvis ANC-støj og den høje pris nævnes som svagheder.",
   "headlines": {
    "warm, detailed and immersive sound": {
     "sentimentAnalysis": "PX8 roses gentagne gange for en varm, afbalanceret og højopløst gengivelse med punchy, kontrolleret bas, klare mellemtoner, luftig diskant, god separation og stor rumfornemmelse.",
     "simpleTitle": "Varm, detaljeret og omsluttende lyd",
     "bias": "positive",
     "key": "sound_warm_detailed",
     "groupId": "c5caaa87-ad13-4ef6-835c-41bf1a50b138"
    },
    "comfortable premium construction": {
     "sentimentAnalysis": "Læder-aluminium-konstruktionen, det elegante design og de bløde ørepuder beskrives som usædvanligt luksuriøse, holdbare og komfortable ved lang tids brug.",
     "simpleTitle": "Komfortabel premiumkonstruktion",
     "bias": "positive",
     "key": "build_comfort",
     "groupId": "554e2269-826f-496f-84e4-ac2d5e8d6616"
    },
    "noise cancellation works well but trails the best rivals": {
     "sentimentAnalysis": "ANC fungerer godt på rejser og mod almindelig baggrundsstøj, men sammenligninger vurderer ofte Sony, Bose eller Apple som bedre, især mod vind, stemmer og uventet elektronisk støj.",
     "simpleTitle": "God støjreduktion, men ikke klassens bedste",
     "bias": "negative",
     "key": "anc_comparison",
     "groupId": "1e4dc2da-02b8-4381-98e1-975bd6737255"
    },
    "limited app EQ and unreliable multipoint": {
     "sentimentAnalysis": "Appen er overskuelig og funktionel, men EQ’en med kun to bånd virker begrænset, og flere brugere oplever besværlig parring, multipoint-skift eller en uhensigtsmæssig enhedsprioritet.",
     "simpleTitle": "Begrænset EQ og ustabil multipoint",
     "bias": "negative",
     "key": "app_connectivity",
     "groupId": "c5caaa87-ad13-4ef6-835c-41bf1a50b138"
    }
   },
