  "reviews": {
   "summary": "Bowers & Wilkins PX8 S2 leverer en varm, slagkraftig og medrivende lytteoplevelse med fremragende detaljer, rummelighed og dyb, kontrolleret bas. Eksklusive materialer, flot design og generelt god komfort understøtter premiumindtrykket, især ved lange musiksessioner. Støjreduktion, forbindelsen og den høje pris er de største forbehold, men den musikalske præstation er fortsat den klare grund til at vælge modellen.",
   "headlines": {
    "comfortable premium construction for long sessions": {
     "sentimentAnalysis": "Anmeldelserne beskriver ofte hovedtelefonerne som lette, komfortable i timevis og usædvanligt velbyggede, hvor læder og metal giver en eksklusiv fornemmelse.",
     "simpleTitle": "Komfortabel premiumkonstruktion til lange sessioner",
     "bias": "positive",
     "key": "comfort_premium",
     "groupId": "8a6d92b8-edc5-4131-8f71-1cdcd5dffb6e"
    },
    "noise cancellation is useful but below the best": {
     "sentimentAnalysis": "Mange anmeldere finder ANC tilstrækkelig på kontorer, i tog eller fly, men svagere end hos Sony, Bose eller Apple i krævende omgivelser, især udendørs og i vind.",
     "simpleTitle": "Støjreduktionen er nyttig, men ikke blandt de bedste",
     "bias": "negative",
     "key": "anc_mixed",
     "groupId": "a9d7db71-4ba3-43a8-ac19-28ecb89c712a"
    },
    "warm, spacious sound with deep and controlled bass": {
     "sentimentAnalysis": "Anmelderne roser den livlige, musikalske gengivelse, den gode separation, den dybe bas og de mange detaljer.",
     "simpleTitle": "Varm og rummelig lyd med dyb, kontrolleret bas",
     "bias": "positive",
     "key": "sound_warm_spacious",
     "groupId": "2064790a-9ac0-469e-adbe-06695f686fee"
    }
   },
