  "bundleRelations": [],
  "displayBookDemo": true,
  "reviews": {
   "summary": "BWZEPPELING5 leverer en varm, klar, kraftfuld og omsluttende lyd med overraskende dyb og velkontrolleret bas for et kompakt enkeltstående højttalersystem. Det elegante, skulpturelle design, den kompakte størrelse og den nemme app-betjening gør højttaleren særligt attraktiv til køkkener, kontorer og mindre rum. Wi-Fi- og app-forbindelsen er lejlighedsvis ustabil, og den høje vægt, manglen på LAN-tilslutning og fjernbetjening er praktiske ulemper, men lydkvalitet og design gør samlet set Zeppelin Pro til et særdeles tilfredsstillende valg.",
   "headlines": {
    "elegant, distinctive design": {
     "sentimentAnalysis": "Zeppelinens skulpturelle og iøjnefaldende udseende værdsættes bredt som et dekorativt element og ikke blot som et højttalerkabinet.",
     "simpleTitle": "Elegant og særpræget design",
     "bias": "positive",
     "key": "design",
     "groupId": "3f52b68c-cd7c-4994-99b3-7883790bc12f"
    },
    "simple app and speaker control": {
     "sentimentAnalysis": "Den enkle betjening og den velfungerende app gør opsætning og daglig brug nem.",
     "simpleTitle": "Nem app- og højttalerbetjening",
     "bias": "positive",
     "key": "usability",
     "groupId": "cf42b953-40b3-4de4-8687-7eb1d181545c"
    },
    "clear, powerful sound with deep bass": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, fyldige og kraftfulde gengivelse, især den dybe og velafstemte bas.",
     "simpleTitle": "Klar og kraftfuld lyd med dyb bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "919a393b-79a2-4883-b7c6-30c65175a680"
    },
    "outstanding sound for a compact speaker": {
     "sentimentAnalysis": "Det kompakte kabinet beskrives gentagne gange som leverandør af en usædvanligt fyldig, imponerende lyd i høj kvalitet.",
     "simpleTitle": "Fremragende lyd fra en kompakt højttaler",
     "bias": "positive",
     "key": "sound",
     "groupId": "919a393b-79a2-4883-b7c6-30c65175a680"
    },
    "wi-Fi and app connections can drop": {
