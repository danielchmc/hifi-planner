  "reviews": {
   "summary": "Disse skumørepropper kan give mange brugere en sikker og behagelig pasform, bedre tætning og en mere intens, dynamisk lytteoplevelse. Kompatibiliteten varierer meget afhængigt af øreform og øretelefonmodel, og nogle oplever, at propperne glider ud, føles ubehagelige eller ikke forbedrer noget i forhold til originalerne. Holdbarhed og rengøringsvejledning er svage punkter trods flere begejstrede meldinger om bedre pasform og lyd.",
   "headlines": {
    "more secure and comfortable fit": {
     "sentimentAnalysis": "Flere brugere beskriver en sikker, stabil og behagelig pasform, også under bevægelse.",
     "simpleTitle": "Sikrere og mere behagelig pasform",
     "bias": "positive",
     "key": "fit",
     "groupId": "6a4c84ea-b044-450d-acbe-b77c8213b93f"
    },
    "fit can be loose or uncomfortable": {
     "sentimentAnalysis": "Flere brugere oplever, at propperne glider ud, tilpasser sig dårligt eller er ubehagelige, hvilket viser varierende kompatibilitet med forskellige øreformer.",
     "simpleTitle": "Pasformen kan være løs eller ubehagelig",
     "bias": "negative",
     "key": "fit",
     "groupId": "6a4c84ea-b044-450d-acbe-b77c8213b93f"
    },
    "improved, more immersive sound": {
     "sentimentAnalysis": "Brugere roser den fremragende og markant forbedrede lyd og synes, resultatet er særligt imponerende.",
     "simpleTitle": "Forbedret og mere omsluttende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "937b96fc-9682-4e64-be77-e8bfb7b801c1"
    },
    "limited improvement over original tips": {
     "sentimentAnalysis": "Nogle brugere oplever ingen bedre tætning eller synes, at originalpropperne passer bedre til kabinettet.",
     "simpleTitle": "Begrænset forbedring i forhold til originalpropperne",
     "bias": "negative",
     "key": "seal",
