  "reviews": {
   "summary": "Comply-skumpropper giver som regel en sikker og behagelig pasform, bedre tætning og en mere omsluttende, fyldig lyd end standardpropper. Kompatibilitet og størrelse kan dog variere, og nogle brugere oplever, at propperne glider ud, er ubehagelige eller isolerer dårligere. De største ulemper er den høje pris, den korte levetid og skum, der let samler snavs eller løsner sig fra kernen.",
   "headlines": {
    "secure, comfortable fit and strong sealing": {
     "sentimentAnalysis": "Skumpropperne roses bredt for bedre stabilitet, komfort og passiv isolering.",
     "simpleTitle": "Sikker, behagelig pasform og god tætning",
     "bias": "positive",
     "key": "fit-seal",
     "groupId": "1d1d99fc-2310-4238-a521-ad7ec98aaa18"
    },
    "fit and sizing can be inconsistent": {
     "sentimentAnalysis": "Nogle brugere oplever, at propperne glider ud, er for bløde, er ubehagelige i mindre øregange eller isolerer dårligere end standardpropperne.",
     "simpleTitle": "Pasform og størrelse kan variere",
     "bias": "negative",
     "key": "fit-seal",
     "groupId": "1d1d99fc-2310-4238-a521-ad7ec98aaa18"
    },
    "foam wears out or separates too quickly": {
     "sentimentAnalysis": "Flere anmeldelser beskriver kort levetid, snavs, revner eller skum, der løsner sig fra gummikernen.",
     "simpleTitle": "Skummet slides for hurtigt eller løsner sig",
     "bias": "negative",
     "key": "durability",
     "groupId": "b3b1b941-3f9f-4953-b641-11c0a995fc6d"
    },
    "high price weakens the value": {
     "sentimentAnalysis": "Købet opfattes som dyrt, og nogle brugere mener ikke, at ydeevnen står mål med prisen.",
     "simpleTitle": "Den høje pris svækker værdien",
     "bias": "negative",
