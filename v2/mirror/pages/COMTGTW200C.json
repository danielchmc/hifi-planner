  "reviews": {
   "summary": "Disse skumpropper giver generelt en sikker og behagelig pasform med bedre tætning og stærkere passiv støjisolering, og de får ofte øretelefonerne til at lyde varmere, mere fyldige og mere detaljerede. Kompatibilitet og størrelse varierer dog, og nogle brugere oplever, at de glider ud, er ubehagelige eller giver dårligere lyd end originalerne. Den største ulempe er holdbarheden: Flere brugere synes, at propperne er dyre og hurtigt bliver klistrede, snavsede, slidte eller går i stykker.",
   "headlines": {
    "better sealing and a secure, comfortable fit": {
     "sentimentAnalysis": "Skumpropperne roses bredt for at give en tættere forsegling og en mere sikker og behagelig pasform, også ved længere tids brug.",
     "simpleTitle": "Bedre tætning og sikker, behagelig pasform",
     "bias": "positive",
     "key": "fit_seal_comfort",
     "groupId": "275cf471-c03d-4b20-a120-7494ddc6426b"
    },
    "high price weakens the value proposition": {
     "sentimentAnalysis": "Flere brugere synes, at prisen er for høj, især når pasform, ydeevne eller levetid ikke lever op til forventningerne.",
     "simpleTitle": "Den høje pris svækker værdien for pengene",
     "bias": "negative",
     "key": "value_price",
     "groupId": "019237c8-caa5-47e5-98ad-c8386d817d7f"
    },
    "some users experience slipping or poorer sound": {
     "sentimentAnalysis": "Pasformen fungerer ikke for alle: Nogle propper er for bløde eller små eller vanskelige at montere, hvilket giver glidning, dårligere isolering og ringere lyd.",
     "simpleTitle": "Nogle brugere oplever, at de glider ud eller giver dårligere lyd",
     "bias": "negative",
     "key": "fit_seal_comfort",
     "groupId": "275cf471-c03d-4b20-a120-7494ddc6426b"
    },
    "tips wear out or detach too quickly": {
     "sentimentAnalysis": "Flere anmeldelser beskriver kort levetid, hvor propperne bliver snavsede eller klistrede, revner i etuier eller løsner sig fra den indvendige kerne.",
     "simpleTitle": "Propperne slides eller løsner sig for hurtigt",
     "bias": "negative",
     "key": "durability",
     "groupId": "3ee7a45e-69ba-4c56-b468-5db194d23d56"
    },
    "sound becomes fuller and more detailed": {
     "sentimentAnalysis": "Den bedre tætning forbindes med kraftigere bas, et fyldigere lydbillede og flere detaljer end med originalpropperne.",
     "simpleTitle": "Lyden bliver fyldigere og mere detaljeret",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "0ef74dad-6799-4eed-b56b-c58b44d96ce5"
    }
   },
