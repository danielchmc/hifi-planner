  "reviews": {
   "summary": "Disse ørepropper kan give en tæt, behagelig pasform og en bedre forsegling, som giver varmere, mere kraftfuld bas og en mere omsluttende lytteoplevelse samt forbedrer lydisolering og ANC for mange brugere. Komfort og stabilitet roses ofte, når den rigtige størrelse er fundet. Pasformens pålidelighed, den store størrelse, kompatibilitet, voksophobning og holdbarhed er dog stadig væsentlige problemer.",
   "headlines": {
    "comfortable and secure once fitted": {
     "sentimentAnalysis": "Flere brugere beskriver en komfortabel og sikker pasform efter isætning, mindre ømhed i ørerne og næsten umærkelige øretelefoner.",
     "simpleTitle": "Komfortable og sikre ved korrekt pasform",
     "bias": "positive",
     "key": "comfortable_secure_fit",
     "groupId": "e267b3da-140e-47b7-9007-c3daee392cae"
    },
    "improved isolation and ANC": {
     "sentimentAnalysis": "Flere brugere roser den bedre lydafskærmning og markant forbedrede ANC, når propperne slutter tæt.",
     "simpleTitle": "Forbedret isolering og ANC",
     "bias": "positive",
     "key": "improved_isolation_anc",
     "groupId": "bd61f191-f092-4c34-95e2-63aa18bd03c3"
    },
    "large or inconsistent fit can be problematic": {
     "sentimentAnalysis": "Nogle brugere oplever for store propper, vanskelig placering, dårlig kompatibilitet eller en løs pasform, der forringer ydeevnen.",
     "simpleTitle": "Stor eller uensartet pasform kan give problemer",
     "bias": "negative",
     "key": "fit_size_issues",
     "groupId": "e267b3da-140e-47b7-9007-c3daee392cae"
    },
    "richer, more detailed sound": {
     "sentimentAnalysis": "En bedre forsegling forbindes med klarere gengivelse, mere detaljeret bas og generelt forbedret lyd fra øretelefonerne.",
     "simpleTitle": "Fyldigere og mere detaljeret lyd",
     "bias": "positive",
     "key": "richer_sound",
     "groupId": "023febda-66fd-4deb-952e-5a03068902a4"
    },
    "anc may fail with a poor match": {
     "sentimentAnalysis": "Dårlig kombination eller forsegling kan gøre støjreduktionen ineffektiv trods potentialet for forbedring.",
     "simpleTitle": "ANC kan svigte ved dårlig pasform",
     "bias": "negative",
     "key": "anc_fit_failure",
     "groupId": "bd61f191-f092-4c34-95e2-63aa18bd03c3"
    },
    "tips can deteriorate quickly": {
     "sentimentAnalysis": "Rapporterede problemer omfatter hurtigt tab af form, brud og tilstopning med ørevoks, hvilket rejser tvivl om den langsigtede værdi.",
     "simpleTitle": "Propperne kan hurtigt blive slidte",
     "bias": "negative",
     "key": "rapid_deterioration",
     "groupId": "b6f3428f-38a3-4cf1-80e7-9634750839b5"
    }
   },
