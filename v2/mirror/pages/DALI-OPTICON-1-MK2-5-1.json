     "reviews": {
      "summary": "DALI Opticon Vokal MK2 roses bredt som en kraftfuld, klar og medrivende centerhøjttaler, der bringer film og musik til live. Vokaler og dialoger forbliver meget tydelige under actionprægede scener, mens den varme, fyldige bas og åbne diskant skaber en rummelig og detaljeret gengivelse. Højttaleren passer især godt sammen med DALI-systemer, selv om enkelte nævner det store kabinet og den relativt høje pris.",
      "headlines": {
       "clear, full and immersive sound": {
        "sentimentAnalysis": "Anmeldelserne beskriver en fyldig, kraftfuld og detaljeret gengivelse med god bas og klar, åben diskant.",
        "simpleTitle": "Klar, fyldig og medrivende lyd",
        "bias": "positive",
        "key": "clear-full-immersive-sound",
        "groupId": "7de707e1-0923-4d0e-8eed-b95285673276"
       },
       "strong compatibility with DALI systems": {
        "sentimentAnalysis": "Centerhøjttaleren roses gentagne gange for at integrere naturligt med Opticon-, Rubicon- og andre DALI-systemer.",
        "simpleTitle": "Passer fremragende til DALI-systemer",
        "bias": "positive",
        "key": "dali-system-match",
        "groupId": "879d1c53-76a7-4f34-9bbb-2ea777cd742b"
       },
       "excellent dialogue intelligibility": {
        "sentimentAnalysis": "Dialoger og vokaler beskrives gentagne gange som klare, luftige og lette at følge, selv under høje lydeffekter.",
        "simpleTitle": "Fremragende dialogforståelse",
        "bias": "positive",
        "key": "dialogue-intelligibility",
        "groupId": "0e342f70-a00f-4463-8f0e-183628fe692a"
       },
       "good value despite a premium price": {
        "sentimentAnalysis": "Flere anmeldelser vurderer lydkvaliteten og forbedringen til hjemmebiograf som pengene værd.",
        "simpleTitle": "God værdi trods en høj pris",
        "bias": "positive",
        "key": "value-for-money",
        "groupId": "24307494-60fe-45ec-840b-fe4d4fbe2c9b"
       },
       "large cabinet can be demanding": {
        "sentimentAnalysis": "Det store kabinet ses som en fordel for ydelsen, men kan være mindre diskret eller lyde mindre ideelt i et møbel.",
        "simpleTitle": "Det store kabinet kan være krævende",
        "bias": "negative",
        "key": "large-cabinet",
        "groupId": "12c33953-1df8-4186-acf9-8cd0d90e9313"
       },
       "some treble sounds slightly pale": {
        "sentimentAnalysis": "De fleste anmeldelser roser diskanten, men klangkarakteren opleves ikke af alle som lige brillant.",
        "simpleTitle": "Diskanten virker lidt bleg",
        "bias": "negative",
        "key": "pale-treble",
        "groupId": "7de707e1-0923-4d0e-8eed-b95285673276"
       },
       "premium pricing is noticeable": {
        "sentimentAnalysis": "Positive vurderinger af værdien opvejes af kommentarer om, at højttaleren er dyr.",
        "simpleTitle": "Premiumprisen kan mærkes",
        "bias": "negative",
        "key": "premium-pricing",
        "groupId": "24307494-60fe-45ec-840b-fe4d4fbe2c9b"
       }
