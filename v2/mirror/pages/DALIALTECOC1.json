  "reviews": {
   "summary": "DALIALTECOC1 leverer en varm, fyldig og immersiv lyd, der tilfører overbevisende højde og rumfornemmelse til Dolby Atmos-, surround- og musikanlæg. Det kompakte, vinklede kabinet giver meget fleksible placeringsmuligheder samt nem væg- eller loftmontering og et flot design. Ydelsen er generelt fremragende til prisen, men niveauet kan virke beskedent uden omhyggelig kalibrering af forstærkeren, og de små højttalerterminaler er upraktiske.",
   "headlines": {
    "expansive, cinematic surround sound": {
     "sentimentAnalysis": "Højttalerne skaber et større, varmere og mere omsluttende lydbillede med overbevisende filmeffekter og bedre rumlig dybde.",
     "simpleTitle": "Stor, biograflignende surroundlyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "a51d4910-c8df-4526-8692-8d70b1115bd8"
    },
    "compact angled design simplifies placement": {
     "sentimentAnalysis": "Det lille, flotte og vinklede kabinet passer til trange rum og muliggør praktisk væg-, loft- eller forhøjet placering uden komplicerede beslag.",
     "simpleTitle": "Kompakt, vinklet design gør placeringen nem",
     "bias": "positive",
     "key": "design",
     "groupId": "806176ee-6575-49db-bf46-c3181fdb1b8c"
    },
    "strong value for Atmos upgrades": {
     "sentimentAnalysis": "Højttalerne vurderes som fornuftigt prissat og særligt effektive til at udvide et surroundanlæg med Atmos-højdekanaler.",
     "simpleTitle": "Stærk værdi til Atmos-opgraderinger",
     "bias": "positive",
     "key": "value",
     "groupId": "001918a7-e83f-4aa4-bf8f-3c36e26e9810"
    },
    "clear and musical reproduction": {
     "sentimentAnalysis": "Anmeldelserne roser den præcise, klare og fyldige gengivelse med tydelige stemmer, behagelig mellemtone samt god musik- og klassisk gengivelse.",
     "simpleTitle": "Klar og musikalsk gengivelse",
     "bias": "positive",
     "key": "sound",
     "groupId": "a51d4910-c8df-4526-8692-8d70b1115bd8"
    },
    "height effects can be subtle": {
     "sentimentAnalysis": "Nogle anlæg kræver justering af forstærkeren, og placeringen af højdeobjekter eller niveauet alene kan være begrænset sammenlignet med dedikerede loftshøjttalere.",
     "simpleTitle": "Højdeffekter kan være afdæmpede",
     "bias": "negative",
     "key": "atmos",
     "groupId": "c1b0ae8e-acd4-41cb-ad2b-953e01f5a34a"
    }
   },
