  "reviews": {
   "summary": "DALIBLUOSNPM2IX er en stærkt anbefalet opgradering til DALI Sound Hub-systemer med varm, energisk og detaljeret streaminglyd samt omfattende trådløse og multiroom-funktioner. BluOS-integration, tabsfri afspilning og fleksible tilslutningsmuligheder gør modulet til en central del af et moderne og immersivt setup. Første parring og lejlighedsvise forbindelsesudfald påvirker nogle installationer, mens manglende tonekontrol er en mærkbar begrænsning.",
   "headlines": {
    "broad streaming and system expansion": {
     "sentimentAnalysis": "Anmeldelserne værdsætter HDMI-integration, tabsfri streaming, multiroom- eller surround-udvidelse samt fleksible netværks-, Wi-Fi- og USB-muligheder.",
     "simpleTitle": "Omfattende streaming- og udvidelsesmuligheder",
     "bias": "positive",
     "key": "features",
     "groupId": "cbf0b791-729e-4526-98a6-b020f759ea12"
    },
    "clear, detailed streaming sound": {
     "sentimentAnalysis": "Anmeldelserne roser den fremragende, mærkbart forbedrede og velfungerende lyd, især ved streaming i høj opløsning.",
     "simpleTitle": "Klar og detaljeret streaminglyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "abfb3814-b56c-4914-be32-18c13dac731d"
    },
    "frequent connection dropouts": {
     "sentimentAnalysis": "Flere anmeldelser rapporterer ustabile forbindelser og udfald mellem højttalere og Sound Hub, selv om selve musikstreamingen kan være stabil.",
     "simpleTitle": "Hyppige forbindelsesudfald",
     "bias": "negative",
     "key": "connectivity",
     "groupId": "c047ec95-96a2-40b3-922e-76fa62a35cdf"
    },
    "no tone controls in the app": {
     "sentimentAnalysis": "Flere anmeldelser kritiserer manglen på equalizer- eller tonekontrol med Sound Hub og bestemte DALI-højttalere, og en anmeldelse bemærker, at begrænsningen ikke er tydeligt oplyst.",
     "simpleTitle": "Ingen tonekontrol i appen",
     "bias": "negative",
     "key": "features",
     "groupId": "cbf0b791-729e-4526-98a6-b020f759ea12"
    }
   },
