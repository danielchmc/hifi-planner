  "reviews": {
   "summary": "Modulet betragtes generelt som en uundværlig tilføjelse til DALI Sound Hub og leverer fleksibel streaming i høj kvalitet samt fremragende integration med aktive DALI-højttalere. Streamingydelse og lydkvalitet roses som klar, detaljeret, varm og omsluttende, hvor tabsfri og højopløst afspilning især fremhæves. Forbindelsen kan give problemer under opsætning eller brug med højttalerne, mens manglen på tonekontrol er en tilbagevendende begrænsning; efter opsætning fungerer systemet som regel problemfrit og meget tilfredsstillende.",
   "headlines": {
    "essential, flexible streaming integration": {
     "sentimentAnalysis": "Modulet kaldes gentagne gange et must-have til DALI Sound Hub og tilbyder mange streamingmuligheder, trådløs styring, multiroom-potentiale samt praktiske netværks- og USB-tilslutninger.",
     "simpleTitle": "Uundværlig, fleksibel streamingintegration",
     "bias": "positive",
     "key": "streaming_integration",
     "groupId": "358c55f5-ce02-49ff-9d72-5411ab674a9d"
    },
    "rich, high-resolution sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en tilfredsstillende, fremragende og mærkbart forbedret lyd, især ved streaming i høj opløsning.",
     "simpleTitle": "Fyldig lyd i høj opløsning",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "b9e11be3-b5ec-49c9-802e-a861b60d9ae7"
    },
    "unreliable connections": {
     "sentimentAnalysis": "Flere anmeldelser rapporterer om forbindelsesudfald eller vanskelig førstegangsopsætning, selv om en fuld nulstilling kan genskabe stabil drift.",
     "simpleTitle": "Ustabile forbindelser",
     "bias": "negative",
     "key": "connection_issues",
     "groupId": "dc6b7c11-808a-46c0-825b-f69afbf909b5"
    },
    "no tone controls": {
     "sentimentAnalysis": "Manglen på equalizer eller tonejustering i BluOS-appen kritiseres gentagne gange, især i kombinationen af DALI Sound Hub og Rubicon 8C.",
     "simpleTitle": "Ingen tonekontrol",
     "bias": "negative",
     "key": "missing_tone_controls",
     "groupId": "99cbeb82-7472-4240-a8cc-af328c169698"
    }
