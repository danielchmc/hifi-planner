  "reviews": {
   "summary": "DALI GARDIAN OW6 leverer varm, klar og slagkraftig lyd til udendørs brug fra et kompakt kabinet med imponerende kraft, balance og dyb bas. Monteringen er generelt enkel og veldokumenteret, men vægbeslaget har begrænsede muligheder for vinkeljustering og kræver et valg mellem vandret og lodret placering. Det elegante design og den høje generelle tilfredshed gør højttalerne til et attraktivt valg til terrasser og haver.",
   "headlines": {
    "clear, powerful and balanced outdoor sound": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent den klare, kraftfulde, veldefinerede og balancerede lyd udendørs.",
     "simpleTitle": "Klar, kraftfuld og balanceret lyd udendørs",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "c46d0510-fe21-4447-9cda-9ad2592b3cd9"
    },
    "simple installation with clear instructions": {
     "sentimentAnalysis": "Monteringen beskrives som ligetil og understøttes af nyttige, tydelige instruktioner.",
     "simpleTitle": "Enkel montering med tydelige instruktioner",
     "bias": "positive",
     "key": "installation-mounting",
     "groupId": "b2969669-2aa4-4f99-b89f-f4d89ee67524"
    },
    "strong bass and depth": {
     "sentimentAnalysis": "Højttalerne leverer bemærkelsesværdigt dyb og kraftfuld bas samt overbevisende musikalsk dybde udendørs.",
     "simpleTitle": "Kraftfuld bas og dybde",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "c46d0510-fe21-4447-9cda-9ad2592b3cd9"
    },
    "limited bracket angle adjustment": {
     "sentimentAnalysis": "Monteringssystemet begrænser fleksibiliteten ved placering, især ved justering af både vandrette og lodrette vinkler.",
