  "bundleRelations": [],
  "displayBookDemo": true,
  "reviews": {
   "summary": "DALI IO-12 leverer en usædvanligt varm, klar, detaljeret og medrivende lyd med imponerende lagdeling, rumfornemmelse og dynamik på tværs af musikgenrer. De store ørekopper giver mange lyttere fremragende komfort under lange sessioner, mens afspilning via kabel, USB og Bluetooth er på et meget højt niveau. De største kompromiser er kun middelmådig støjreduktion, et stort og til tider tungt design, begrænsede app-baserede lydindstillinger og en høj pris.",
   "headlines": {
    "detailed, spacious and highly musical sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent en klar, naturlig og meget detaljeret gengivelse med god instrumentseparation, dybde og rumfornemmelse.",
     "simpleTitle": "Detaljeret, rummelig og musikalsk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "64a869e3-1a7c-4043-b1bf-751616d7f6f9"
    },
    "excellent comfort for long listening sessions": {
     "sentimentAnalysis": "Store ørekopper og blød polstring roses gentagne gange for at passe til store ører og forblive behagelige i timevis.",
     "simpleTitle": "Fremragende komfort til lange lytte-sessioner",
     "bias": "positive",
     "key": "comfort",
     "groupId": "33be2cd9-9c90-4b42-9ffd-20c0ddd6de73"
    },
    "simple controls and broad wired and wireless support": {
     "sentimentAnalysis": "Anmeldelserne roser den intuitive betjening på hovedtelefonen, hurtig parring, stærk Bluetooth-ydeevne og fremragende gengivelse via USB eller kabel uden behov for en app.",
     "simpleTitle": "Enkel betjening og alsidig kablet og trådløs brug",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "91a00eba-680e-491e-b12b-d785deb837e7"
    },
    "headband and weight can reduce comfort": {
     "sentimentAnalysis": "Nogle ejere finder den tunge konstruktion eller den sparsomt polstrede hovedbøjle ukomfortabel, mens andre oplever, at pasformen bliver for løs under bevægelse.",
     "simpleTitle": "Hovedbøjle og vægt kan påvirke komforten",
     "bias": "negative",
     "key": "comfort",
     "groupId": "33be2cd9-9c90-4b42-9ffd-20c0ddd6de73"
    },
    "large design limits travel and active use": {
     "sentimentAnalysis": "Hovedtelefonerne vurderes generelt som bedre til hjemmebrug end træning eller rejser på grund af størrelse, vægt, etui og følsomhed over for bevægelse eller sved.",
     "simpleTitle": "Det store design begrænser rejser og aktiv brug",
     "bias": "negative",
     "key": "portability",
     "groupId": "17f2e579-784e-4d29-b75d-d26face044b5"
    },
    "anc is good but behind leading competitors": {
     "sentimentAnalysis": "Støjreduktionen vurderes som funktionel og til tider god, men flere sammenligninger placerer Apple, Sony eller Bose klart foran.",
     "simpleTitle": "ANC er god, men halter efter de bedste konkurrenter",
     "bias": "negative",
     "key": "anc",
     "groupId": "c6083f34-ab19-481e-8854-cf3186dc7b0c"
    }
   },
