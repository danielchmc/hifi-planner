  "displayBookDemo": true,
  "reviews": {
   "summary": "DALI IO6 leverer en varm, klar og meget detaljeret lyd med en afbalanceret gengivelse, kontrolleret bas og et rummeligt stereobillede. Komfort, byggekvalitet, batteritid og fysiske knapper får generelt ros, hvilket gør hovedtelefonerne velegnede til lang tids lytning og rejser. Støjreduktionen er nyttig mod konstant baggrundsstøj, men vurderes ofte som mindre effektiv i vind eller sammenlignet med de bedste alternativer; enkelte nævner elektronisk støj i venstre kanal samt problemer med pasform eller holdbarhed.",
   "headlines": {
    "warm, balanced and highly detailed sound": {
     "sentimentAnalysis": "Anmeldelserne roser en naturlig, neutral og rummelig gengivelse med høj klarhed, mange detaljer og velkontrolleret bas.",
     "simpleTitle": "Varm, afbalanceret og meget detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "af51196f-2aca-4988-8f2e-ee1799f5e41d"
    },
    "comfortable for long listening": {
     "sentimentAnalysis": "Bløde puder, sikker pasform og lavt tryk beskrives ofte som komfortable ved længere tids brug.",
     "simpleTitle": "Komfortable ved lang tids lytning",
     "bias": "positive",
     "key": "comfort",
     "groupId": "eeecf6db-e392-454f-a70f-c94b7801f86a"
    },
    "noise cancellation works best with steady noise": {
     "sentimentAnalysis": "ANC roses for at reducere monoton eller trafikrelateret støj og for at være let at slå til og fra.",
     "simpleTitle": "Støjreduktionen fungerer bedst mod konstant støj",
     "bias": "positive",
     "key": "anc",
     "groupId": "b1766d03-c2c8-4416-8f98-5f25874f8f1d"
    },
    "anc is limited with wind and some external sounds": {
     "sentimentAnalysis": "Flere anmeldelser beskriver en lille forskel mellem ANC-tilstandene eller utilstrækkelig dæmpning af vind, tale og højfrekvent støj.",
     "simpleTitle": "ANC er begrænset ved vind og visse udefrakommende lyde",
     "bias": "negative",
     "key": "anc",
     "groupId": "b1766d03-c2c8-4416-8f98-5f25874f8f1d"
    },
    "long-lasting battery": {
     "sentimentAnalysis": "Batteritiden beskrives gentagne gange som fremragende, og nogle brugere oplader kun ugentligt eller hver anden uge.",
     "simpleTitle": "Lang batteritid",
     "bias": "positive",
     "key": "battery",
     "groupId": "87777d84-7e89-496d-a948-0725121f2fc4"
    },
    "simple physical controls": {
     "sentimentAnalysis": "Fysiske knapper og enkel betjening værdsættes som intuitiv og pålidelig, mens skift mellem Bluetooth og kabel generelt er praktisk.",
     "simpleTitle": "Enkel fysisk betjening",
     "bias": "positive",
     "key": "handling",
     "groupId": "fc183ea5-4fe8-4c63-83d6-cb8be5909ce9"
    },
    "bass can feel too restrained": {
     "sentimentAnalysis": "Nogle lyttere ønsker mere bastryk eller oplever gengivelsen som lidt flad ved basrig musik, selv om den kontrollerede bas ofte værdsættes.",
     "simpleTitle": "Bassen kan virke for tilbageholden",
     "bias": "negative",
     "key": "sound",
     "groupId": "af51196f-2aca-4988-8f2e-ee1799f5e41d"
    }
   },
