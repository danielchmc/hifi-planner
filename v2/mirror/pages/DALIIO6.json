  "displayBookDemo": true,
  "reviews": {
   "summary": "DALI IO6 leverer en varm, velafbalanceret og meget detaljeret lyd med punchy, velkontrolleret bas, klare diskanttoner og en imponerende rumfornemmelse. Komfortable knapper, lang batteritid og solid konstruktion gør hovedtelefonerne velegnede til lange lytteoplevelser og rejser. Støjreduktionen er nyttig mod ensartet baggrundsstøj, men mindre overbevisende mod stemmer og vind, mens vægt, pasform og lejlighedsvis elektronikstøj er de største forbehold.",
   "headlines": {
    "warm, balanced and highly detailed sound": {
     "sentimentAnalysis": "Anmeldelserne fremhæver konsekvent den naturlige, neutrale og rummelige gengivelse med høj klarhed, opløsning og musikalske detaljer på tværs af mange genrer.",
     "simpleTitle": "Varm, afbalanceret og meget detaljeret lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "33f2093f-c37d-44a6-914f-2fbba33737ce"
    },
    "controlled bass rather than boomy bass": {
     "sentimentAnalysis": "Mange lyttere værdsætter den fyldige, disciplinerede bas, selv om flere basorienterede lyttere synes, at den dybeste bas eller det samlede tryk er lidt tilbageholdende.",
     "simpleTitle": "Kontrolleret bas frem for buldrende bas",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "33f2093f-c37d-44a6-914f-2fbba33737ce"
    },
    "comfortable for long listening": {
     "sentimentAnalysis": "Bløde puder, en sikker pasform og rummelige ørekopper roses ofte for langvarig komfort.",
     "simpleTitle": "Komfortable ved lang tids lytning",
     "bias": "positive",
     "key": "comfort_fit",
     "groupId": "276738fc-8e7e-4951-bb61-c64ed60f04fa"
    },
    "long-lasting battery life": {
     "sentimentAnalysis": "Batteritiden beskrives gentagne gange som fremragende med sjælden opladning og nyttig oplæsning af batteristatus.",
     "simpleTitle": "Lang batteritid",
     "bias": "positive",
     "key": "battery",
     "groupId": "dfb03a87-bf56-44fb-9152-c9ebfef1b113"
    },
    "noise cancellation is useful but inconsistent": {
     "sentimentAnalysis": "Nogle anmeldelser beskriver effektiv dæmpning af ensartet støj, mens andre oplever ringe forskel eller svag effekt mod tale og vind.",
     "simpleTitle": "Støjreduktionen er nyttig, men ujævn",
     "bias": "meh",
     "key": "noise_cancellation",
     "groupId": "c6747643-90e0-4e2e-9a2a-8af9da19142e"
    }
   },
