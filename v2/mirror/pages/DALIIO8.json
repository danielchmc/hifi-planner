  "displayBookDemo": true,
  "reviews": {
   "summary": "DALI IO8 roses bredt for sin varme, afbalancerede, detaljerede og rummelige lyd, som fungerer fremragende til mange musikgenrer. Komfort, byggekvalitet, enkle fysiske knapper og lang batteritid er også klare styrker, mens den effektive støjreduktion gør hovedtelefonerne velegnede til rejser og daglig lytning. Tilbagevendende forbehold er de runde ørekopper, som er for små til nogle ører, en lidt tung pasform, ustabil Bluetooth-rækkevidde eller parring samt en pris, som nogle købere synes er høj.",
   "headlines": {
    "warm, balanced and highly detailed sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver gennemgående gengivelsen som ren, afbalanceret, varm, kontrolleret og meget opløst med overbevisende bas og diskant.",
     "simpleTitle": "Varm, afbalanceret og meget detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "889095a4-f3f8-4270-ae68-8a4188581596"
    },
    "wide, immersive soundstage": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver en usædvanligt bred, adskilt og omsluttende gengivelse, der placerer instrumenterne omkring lytteren.",
     "simpleTitle": "Bred og omsluttende lydscene",
     "bias": "positive",
     "key": "sound",
     "groupId": "889095a4-f3f8-4270-ae68-8a4188581596"
    },
    "earcups and weight can limit comfort": {
     "sentimentAnalysis": "Flere anmeldelser nævner små runde ørekopper, tryk, at de glider eller en mærkbar vægt, især ved større ører eller lang tids brug.",
     "simpleTitle": "Ørekopper og vægt kan begrænse komforten",
     "bias": "negative",
     "key": "comfort",
     "groupId": "d964c600-5a19-4f56-9fcb-e53294624ec0"
    },
    "effective noise cancellation": {
     "sentimentAnalysis": "Støjreduktionen beskrives gentagne gange som kraftig, effektiv på fly og i offentlig transport samt konkurrencedygtig med førende alternativer.",
     "simpleTitle": "Effektiv støjreduktion",
     "bias": "positive",
     "key": "noise",
     "groupId": "75451821-7c16-45ce-8a33-1e1bbc64152d"
    },
    "comfortable for long listening": {
     "sentimentAnalysis": "Mange ejere finder hovedtelefonerne komfortable og velegnede til lange sessioner, flyrejser og hele arbejdsdage.",
     "simpleTitle": "Komfortable ved lang tids lytning",
