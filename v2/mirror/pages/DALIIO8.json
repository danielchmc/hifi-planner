  "displayBookDemo": true,
  "reviews": {
   "summary": "DALI IO-8 leverer en usædvanligt detaljeret, varm og afbalanceret lyd med et rummeligt, medrivende lydbillede, kontrolleret bas og stor klarhed til mange musiktyper. Komfort, byggekvalitet, enkle fysiske knapper og effektiv støjreduktion bliver ofte rost, mens nogle lyttere synes, at de runde ørekopper er små, hovedtelefonerne tunge eller pasformen mindre sikker end ønsket. Bluetooths stabilitet og rækkevidde får lejlighedsvis kritik, men det samlede indtryk er en eksklusiv, meget musikalsk og overbevisende hovedtelefon.",
   "headlines": {
    "simple app-free physical controls": {
     "sentimentAnalysis": "Anmeldelserne værdsætter den intuitive betjening uden app, og de fysiske knapper anses for praktiske og pålidelige.",
     "simpleTitle": "Enkel fysisk betjening uden app",
     "bias": "positive",
     "key": "connectivity_controls",
     "groupId": "014bce8e-9ecb-451c-85e7-49ef35cb064e"
    },
    "warm, detailed and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent en varm, afbalanceret og meget detaljeret gengivelse med bred, medrivende scene og kontrolleret bas.",
     "simpleTitle": "Varm, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "e8683890-f294-438c-81aa-13ec7b22a18d"
    },
    "circular earcups can feel small": {
     "sentimentAnalysis": "Flere lyttere oplever, at de runde ørekopper eller puder er for små til større ører, og nogle foretrækker derfor pasformen på IO-12.",
     "simpleTitle": "Runde ørekopper kan føles små",
     "bias": "negative",
     "key": "comfort_fit",
     "groupId": "5ad9a074-f061-4ef9-998b-d48b6635c42b"
    },
    "effective noise cancellation for travel": {
     "sentimentAnalysis": "Støjreduktionen beskrives gentagne gange som effektiv i fly, busser og kontorer, mens den passive isolering giver yderligere dæmpning.",
     "simpleTitle": "Effektiv støjreduktion på farten",
     "bias": "positive",
     "key": "noise_cancellation",
     "groupId": "aa4e0ec9-435c-43d0-9c88-5631e3a2b2b1"
    },
    "comfortable for extended listening": {
     "sentimentAnalysis": "Flere anmeldelser beskriver hovedtelefonerne som komfortable og velegnede til lange sessioner, flyrejser eller hele arbejdsdage.",
     "simpleTitle": "Komfortable ved lang tids brug",
     "bias": "positive",
     "key": "comfort_fit",
     "groupId": "5ad9a074-f061-4ef9-998b-d48b6635c42b"
    },
    "bluetooth range and pairing can be unreliable": {
     "sentimentAnalysis": "Flere anmeldelser nævner ustabil parring, begrænset rækkevidde, udfald eller forbindelsesproblemer, især når man bevæger sig væk fra kilden.",
     "simpleTitle": "Bluetooth-rækkevidde og parring kan være ustabil",
     "bias": "negative",
     "key": "bluetooth",
     "groupId": "014bce8e-9ecb-451c-85e7-49ef35cb064e"
    },
    "long-lasting battery": {
     "sentimentAnalysis": "Batteritiden roses som lang og tilstrækkelig til lange flyrejser og daglig brug.",
     "simpleTitle": "Lang batteritid",
     "bias": "positive",
     "key": "battery_life",
     "groupId": "42ba957e-542b-40e0-a1b4-0d9a32fce6e5"
    }
