     "parentProductCode": "DALIKATCHG2",
     "reviews": {
      "summary": "DALI KATCH G2 leverer en imponerende varm, klar og detaljeret lyd fra et kompakt og elegant kabinet med afbalanceret bas, tydelig diskant og et usædvanligt rummeligt lydbillede. Lang batteritid, enkel Bluetooth-betjening, solid konstruktion og nem transport gør højttaleren til en fremragende ledsager i hverdagen og på rejser. Begrænset dybbas, begrænsninger ved høj lydstyrke, manglende USB-C-opladning og forsinkelse ved stereoparring er de vigtigste svagheder, mens de fleste anmeldelser finder premiumprisen rimelig i forhold til ydelsen.",
      "headlines": {
       "elegant and highly portable": {
        "sentimentAnalysis": "Slankt design, gode materialer og en håndterbar størrelse gør højttaleren attraktiv i hjemmet og praktisk på rejser, selv om enkelte nævner vægten eller små detaljer.",
        "simpleTitle": "Elegant og let at transportere",
        "bias": "positive",
        "key": "design_portability",
        "groupId": "aa07c691-8843-4f26-93df-55b5ac8a1d62"
       },
       "warm, clear and detailed sound": {
        "sentimentAnalysis": "Det dominerende indtryk er en afbalanceret, naturlig og meget detaljeret gengivelse med klar diskant, overbevisende bas og stor opløsning for en kompakt Bluetooth-højttaler.",
        "simpleTitle": "Varm, klar og detaljeret lyd",
        "bias": "positive",
        "key": "sound",
        "groupId": "567daf8d-1328-4a82-8915-9e4ce905eef1"
       },
       "long-lasting battery": {
        "sentimentAnalysis": "Batteritiden roses gentagne gange som usædvanligt lang, og flere anmeldelser nævner omkring 30 timers afspilning eller fremragende egnethed til rejser.",
        "simpleTitle": "Lang batteritid",
        "bias": "positive",
        "key": "battery",
        "groupId": "88762cb8-7516-4f19-96df-7202feb95deb"
       },
       "easy Bluetooth connection and operation": {
        "sentimentAnalysis": "Bluetooth-forbindelsen beskrives generelt som stabil, hurtig og ukompliceret, mens enkel betjening gør daglig brug nem.",
        "simpleTitle": "Nem Bluetooth-forbindelse og betjening",
        "bias": "positive",
        "key": "connectivity",
        "groupId": "fb99e3d2-ddd8-4ede-9bc9-510731d98966"
       },
       "bass lacks deep impact": {
        "sentimentAnalysis": "De kompakte mål begrænser dybbas og festtryk, men bassen er stadig kontrolleret og tilstrækkelig til de fleste formål.",
        "simpleTitle": "Bassen mangler dybde",
        "bias": "negative",
        "key": "sound",
        "groupId": "567daf8d-1328-4a82-8915-9e4ce905eef1"
       }
      },
