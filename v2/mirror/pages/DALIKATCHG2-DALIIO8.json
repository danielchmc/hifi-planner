     "parentProductCode": "DALIKATCHG2",
     "reviews": {
      "summary": "DALI KATCH G2 roses bredt for varm, klar, detaljeret og overraskende rummelig lyd fra en kompakt og flot bygget transportabel højttaler. Lang batteritid, enkel betjening, stabil Bluetooth og god mobilitet øger attraktiviteten, mens stereoparring kan skabe en endnu mere omsluttende gengivelse. Begrænset dybbas, mindre kontrol ved høj lydstyrke, manglende indbygget USB-C-opladning og en høj pris er de tydeligste begrænsninger.",
      "headlines": {
       "slim, attractive and easy to carry": {
        "sentimentAnalysis": "Det slanke format, den fine finish og den praktiske størrelse gør højttaleren attraktiv til hjemmet, rejser, ferier og udendørs brug.",
        "simpleTitle": "Slankt, attraktivt og nemt at tage med",
        "bias": "positive",
        "key": "slim-portable-design",
        "groupId": "64956db6-cb72-40d8-b288-6bf5f104dbc2"
       },
       "warm, clear and detailed sound": {
        "sentimentAnalysis": "Anmeldelserne beskriver gennemgående en ren, afbalanceret, varm og meget detaljeret gengivelse, der lyder langt større end kabinettet.",
        "simpleTitle": "Varm, klar og detaljeret lyd",
        "bias": "positive",
        "key": "warm-clear-detailed-sound",
        "groupId": "e0d9f040-830b-4bb5-8f8a-3e3bf97f8c75"
       },
       "long-lasting battery": {
        "sentimentAnalysis": "Batteritiden beskrives gentagne gange som fremragende, og flere anmeldelser fremhæver heldagsbrug eller omkring 30 timers afspilning.",
        "simpleTitle": "Lang batteritid",
        "bias": "positive",
        "key": "long-battery-life",
        "groupId": "f9ec1596-7bca-4bd2-8265-e50a50dac7fe"
       },
       "bluetooth is generally easy and stable": {
        "sentimentAnalysis": "De fleste tilslutningsanmeldelser roser den hurtige, stabile og ukomplicerede Bluetooth-parring til hverdagsbrug.",
        "simpleTitle": "Bluetooth er generelt nemt og stabilt",
        "bias": "positive",
        "key": "reliable-bluetooth",
        "groupId": "cb94c219-efd1-46a7-b91a-26ef4346dbba"
       },
       "deep bass is limited by the compact cabinet": {
        "sentimentAnalysis": "Flere anmeldelser oplever bassen som præcis og behagelig, men mindre dyb eller kraftfuld end fra større højttalere, især ved festniveauer.",
        "simpleTitle": "Den dybe bas begrænses af det kompakte kabinet",
        "bias": "negative",
        "key": "limited-deep-bass",
        "groupId": "e0d9f040-830b-4bb5-8f8a-3e3bf97f8c75"
       }
      },
