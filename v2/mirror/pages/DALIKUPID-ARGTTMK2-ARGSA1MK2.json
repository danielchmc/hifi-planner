     "reviews": {
      "summary": "DALIKUPID leverer imponerende, varm og detaljeret lyd fra et kompakt kabinet med en overraskende stor og slagkraftig gengivelse. Klare diskanttoner, præcis placering og en velafbalanceret musikalitet gør højttalerne meget fornøjelige til musik, TV og skrivebordsbrug, især i mindre rum. Bassen er overraskende fyldig i forhold til størrelsen, men kan mangle dybde for krævende lyttere, mens det flotte design og den fremragende værdi gør pakken særligt attraktiv.",
      "headlines": {
       "compact, attractive and easy to place": {
        "sentimentAnalysis": "Det kompakte format, den flotte finish og farveudvalget gør højttalerne nemme at integrere i små rum og forskellige opsætninger.",
        "simpleTitle": "Kompakt, flot og nem at placere",
        "bias": "positive",
        "key": "design",
        "groupId": "c5d65337-3ebb-46d8-9c59-0e8fdc82a9fe"
       },
       "excellent value for money": {
        "sentimentAnalysis": "Anmeldelserne beskriver konsekvent lyd, konstruktion og design som fremragende eller meget konkurrencedygtigt til prisen.",
        "simpleTitle": "Fremragende værdi for pengene",
        "bias": "positive",
        "key": "value",
        "groupId": "326910d7-94f0-4d7f-b9de-e2c86c2d6ed7"
       },
       "clear, detailed and spacious sound": {
        "sentimentAnalysis": "Anmeldelserne roser klarhed, detaljer, bred lydscene og tydelig instrumentadskillelse til musik og film.",
        "simpleTitle": "Klar, detaljeret og rummelig lyd",
        "bias": "positive",
        "key": "sound",
        "groupId": "72421637-d059-4cf7-ab58-468151b6d52b"
       },
       "surprisingly full bass for the size": {
        "sentimentAnalysis": "Mange anmeldelser oplever bunden som varm, fyldig og usædvanligt kapabel for så kompakt en højttaler.",
        "simpleTitle": "Overraskende fyldig bas i forhold til størrelsen",
        "bias": "positive",
        "key": "bass",
        "groupId": "faa71cd0-b46f-445e-862c-4ca5cf9250fe"
       },
       "limited deep bass without a subwoofer": {
        "sentimentAnalysis": "Nogle anmeldelser bemærker, at kompakte kabinetter ikke leverer dyb, rumfyldende bas og har gavn af en subwoofer.",
        "simpleTitle": "Begrænset dybbas uden subwoofer",
        "bias": "negative",
        "key": "bass",
        "groupId": "faa71cd0-b46f-445e-862c-4ca5cf9250fe"
       }
