  "reviews": {
   "summary": "DALIMENUETSE leverer en usædvanligt klar, detaljeret og medrivende lyd fra et imponerende kompakt kabinet med varm klang, stærk dynamik og et stort lydbillede. Bassen er imponerende i forhold til størrelsen og kan sagtens tilfredsstille uden subwoofer, mens lyttere, der ønsker mere fylde eller slagkraft i bunden, kan få glæde af vægmontering eller en subwoofer. Det flotte design og den høje finish fuldender det meget positive helhedsindtryk.",
   "headlines": {
    "beautiful, premium-looking finish": {
     "sentimentAnalysis": "Højttalerne beundres konsekvent for deres attraktive udseende, elegante design og fremragende finish.",
     "simpleTitle": "Flot finish med et eksklusivt udtryk",
     "bias": "positive",
     "key": "design",
     "groupId": "377282d6-8ea3-4a03-a353-0fad0bf12c46"
    },
    "clear, detailed and dynamic sound": {
     "sentimentAnalysis": "Højttalerne roses gentagne gange for en klar, åben, detaljeret og dynamisk lyd med varme og et stort lydbillede.",
     "simpleTitle": "Klar, detaljeret og dynamisk lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "ae435e61-3d1b-4701-8132-a062d033e532"
    },
    "remarkably big sound from a small speaker": {
     "sentimentAnalysis": "De kompakte kabinetter beskrives som overraskende kraftfulde med en fyldig og rumfyldende lyd.",
     "simpleTitle": "Imponerende stor lyd fra en lille højttaler",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "ae435e61-3d1b-4701-8132-a062d033e532"
    },
    "bass can satisfy without a subwoofer": {
     "sentimentAnalysis": "Flere anmeldelser finder bunden tilstrækkeligt fyldig og kontrolleret uden subwoofer, især i mindre rum.",
     "simpleTitle": "Bassen kan tilfredsstille uden subwoofer",
     "bias": "positive",
     "key": "bass",
     "groupId": "f032a59e-c7f2-4c3e-b26c-b0e5a808f445"
    },
    "extra bass may require a subwoofer": {
     "sentimentAnalysis": "Nogle lyttere oplever bassen som slank eller uden tilstrækkeligt punch og anbefaler en subwoofer for dybere og fyldigere bas.",
     "simpleTitle": "Mere bas kan kræve en subwoofer",
     "bias": "negative",
     "key": "bass",
     "groupId": "f032a59e-c7f2-4c3e-b26c-b0e5a808f445"
    }
   },
