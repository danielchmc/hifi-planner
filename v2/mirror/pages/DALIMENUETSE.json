  "displayBookDemo": true,
  "reviews": {
   "summary": "DALIMENUETSE leverer en usædvanligt klar, detaljeret og medrivende lyd fra et bemærkelsesværdigt kompakt kabinet. Den varme, slagkraftige og dynamiske gengivelse får stor ros, og bassen overbeviser i mange rum, mens nogle lyttere supplerer med en subwoofer eller vægmontering for et fyldigere fundament. Elegante overflader og fremragende musikalitet gør disse små højttalere til et eksklusivt og meget givende valg.",
   "headlines": {
    "clear, detailed and dynamic sound": {
     "sentimentAnalysis": "Højttalerne får gentagne gange ros for en åben, klar, detaljeret, varm, kraftfuld og dynamisk gengivelse.",
     "simpleTitle": "Klar, detaljeret og dynamisk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "72211550-8b65-47bd-9479-5178247de2f4"
    },
    "elegant, premium-looking finish": {
     "sentimentAnalysis": "Udseende, finish og design får gennemgående ros, blandt andet for attraktive farver, valnøddedetaljer og et eksklusivt udtryk.",
     "simpleTitle": "Elegant finish i premiumklasse",
     "bias": "positive",
     "key": "design",
     "groupId": "a5d622c4-0717-4a64-a1d7-64376f65987d"
    },
    "full bass without a subwoofer in many rooms": {
     "sentimentAnalysis": "Flere anmeldelser oplever bassen som tilstrækkeligt fyldig og kontrolleret uden subwoofer, især i mindre rum eller ved passende placering.",
     "simpleTitle": "Fyldig bas uden subwoofer i mange rum",
     "bias": "positive",
     "key": "bass",
     "groupId": "d58622f8-6ca9-4c90-ba85-7b8ee0d24e64"
    },
    "small cabinets deliver surprisingly large sound": {
     "sentimentAnalysis": "De kompakte højttalere beskrives gentagne gange som leverandører af en lyd, der er langt større end de fysiske mål antyder.",
     "simpleTitle": "Små kabinetter leverer overraskende stor lyd",
     "bias": "positive",
     "key": "compactness",
     "groupId": "89082cbf-aec7-4f85-8df0-f54bbc9a3463"
    },
    "some listeners want more low-end punch": {
     "sentimentAnalysis": "Nogle anmeldelser beskriver bassen som tynd eller uden tilstrækkeligt punch og anbefaler en subwoofer, mens vægmontering forbedrer bassen i ét setup.",
     "simpleTitle": "Nogle lyttere ønsker mere punch i bassen",
     "bias": "negative",
     "key": "bass",
     "groupId": "d58622f8-6ca9-4c90-ba85-7b8ee0d24e64"
    }
   },
