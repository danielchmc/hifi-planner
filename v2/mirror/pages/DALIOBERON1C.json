  "reviews": {
   "summary": "DALI Oberon 1C roses bredt for varm, klar, detaljeret og medrivende lyd fra et kompakt kabinet samt overraskende kraftig bas og godt tryk. Den nemme installation og kabelfri komfort gør højttalerne særligt attraktive til TV og mindre rum. Basbalancen kan afhænge af placeringen, og lejlighedsvise forbindelsesudfald samt begrænset finopløsning kan skuffe nogle lyttere.",
   "headlines": {
    "warm, clear and detailed sound": {
     "sentimentAnalysis": "Højttalerne leverer en varm, klar og meget opløst gengivelse med god detaljegrad.",
     "simpleTitle": "Varm, klar og detaljeret lyd",
     "bias": "positive",
     "key": "warm-clear-detailed-sound",
     "groupId": "eeb9c30a-bc67-4684-ab1c-d801d2a2fb20"
    },
    "surprisingly powerful bass from a compact cabinet": {
     "sentimentAnalysis": "De kompakte højttalere leverer imponerende dybde, slagkraft og tryk i bassen i forhold til størrelsen.",
     "simpleTitle": "Overraskende kraftig bas fra et kompakt kabinet",
     "bias": "positive",
     "key": "powerful-compact-bass",
