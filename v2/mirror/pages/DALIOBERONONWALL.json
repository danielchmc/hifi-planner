  "reviews": {
   "summary": "DALI Oberon On-Wall roses bredt for en klar, detaljeret og overraskende fyldig lyd fra det slanke og attraktive vægkabinet. Højttalerne fungerer især godt som diskrete surround-, bag- eller højdehøjttalere og er nemme at integrere i kompakte rum og hjemmebiografer. Bassen er imponerende i forhold til størrelsen, selv om flere anmeldelser anbefaler en subwoofer for dybere effekt, mens et lille mindretal synes, at lyden er for svag eller mangler finhed.",
   "headlines": {
    "clear, detailed and full sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver gentagne gange lyden som klar, detaljeret, fyldig og overraskende kraftfuld for en kompakt væghøjttaler.",
     "simpleTitle": "Klar, detaljeret og fyldig lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "b6e27355-e5f7-440e-a2ae-7648deaf1213"
    },
    "slim, attractive and discreet on the wall": {
     "sentimentAnalysis": "Det slanke kabinet, det flotte design og den diskrete vægplacering roses gentagne gange, især hvor pladsen er begrænset.",
     "simpleTitle": "Slank, flot og diskret på væggen",
     "bias": "positive",
     "key": "design-and-placement",
     "groupId": "ec811ee2-df72-44d8-b48f-49fcbdb1a892"
    },
    "excellent for surround and home cinema": {
     "sentimentAnalysis": "Anmeldelserne finder konsekvent højttalerne velegnede som bag-, side- eller højttalere i højden samt til kompakte hjemmebiografer.",
     "simpleTitle": "Fremragende til surround og hjemmebio",
     "bias": "positive",
     "key": "surround-and-home-cinema",
     "groupId": "558602ef-85b0-460e-bd59-d7fd5bd6d815"
    },
    "a subwoofer adds deeper bass": {
     "sentimentAnalysis": "Flere anmeldelser beskriver bassen som brugbar eller overraskende god, men en subwoofer forbedrer de dybeste frekvenser og slagkraften.",
     "simpleTitle": "En subwoofer giver dybere bas",
     "bias": "meh",
     "key": "bass-response",
     "groupId": "1100c9fd-d5f6-486b-abfb-e694717f8cbd"
    },
    "sound can lack refinement or volume": {
     "sentimentAnalysis": "To anmeldelser beskriver tydelige svagheder som dæmpet vokal, skarp diskant og utilstrækkelig lydstyrke.",
     "simpleTitle": "Lyden kan mangle finhed eller lydstyrke",
     "bias": "negative",
     "key": "sound-quality",
     "groupId": "b6e27355-e5f7-440e-a2ae-7648deaf1213"
    }
   },
