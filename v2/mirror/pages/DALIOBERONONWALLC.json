  "reviews": {
   "summary": "DALIOBERONONWALLC leverer en bemærkelsesværdig varm, naturlig og rummelig lyd fra et slankt og diskret vægdesign. De kompakte højttalere skaber et imponerende lydbillede og fungerer især godt som surround- eller pladsbesparende højttalere med enkel SoundHub-tilslutning. Ved musikafspilning kan der dog mangle opløsning og fylde, mens de korte strømkabler gentagne gange nævnes som en praktisk ulempe.",
   "headlines": {
    "rich, natural sound from a compact speaker": {
     "sentimentAnalysis": "Anmeldelserne roser gennemgående den imponerende, behagelige, naturlige og fyldige lyd trods den kompakte størrelse.",
     "simpleTitle": "Fyldig, naturlig lyd fra en kompakt højttaler",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "72d076fd-78ae-4ed1-959a-d1e9f62483c8"
    },
    "slim and discreet wall-friendly design": {
     "sentimentAnalysis": "De slanke mål, det diskrete udseende og den nemme vægintegration værdsættes gentagne gange, når plads og rummets æstetik er vigtig.",
     "simpleTitle": "Slankt og diskret vægdesign",
     "bias": "positive",
     "key": "design_size",
     "groupId": "877fb8f8-efe3-4a66-a829-6259b6f353d4"
    },
    "effective as surround speakers": {
     "sentimentAnalysis": "Højttalerne beskrives som fuldt ud i stand til at levere surroundeffekter og som et godt valg til diskrete hjemmebiografinstallationer.",
     "simpleTitle": "Overbevisende som surroundhøjttalere",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "72d076fd-78ae-4ed1-959a-d1e9f62483c8"
