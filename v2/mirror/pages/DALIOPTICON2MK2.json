  "displayBookDemo": true,
  "reviews": {
   "summary": "DALIOPTICON2MK2 leverer en varm, klar og meget detaljeret lyd med imponerende fylde og et rummeligt stereoperspektiv for en kompakt højttaler. Musik, film og tale får glæde af den dynamiske, transparente og medrivende gengivelse, mens bassen generelt er kraftig i forhold til størrelsen, men kan suppleres med en subwoofer for mere dybde. Kvalitet og pris er overvejende rost, selv om enkelte anmeldelser nævner begrænsede detaljer i diskanten, moderat basdybde eller bekymringer om kabinetfinishen.",
   "headlines": {
    "strong value and big sound from a small cabinet": {
     "sentimentAnalysis": "Anmeldelserne fremhæver ofte det kompakte format, den store lydscene og det overbevisende forhold mellem pris og ydelse.",
     "simpleTitle": "God værdi og stor lyd fra et lille kabinet",
     "bias": "positive",
     "key": "size_value",
     "groupId": "832cc25c-5d6c-417b-8426-5952aa527f38"
    },
    "warm, clear and detailed sound": {
     "sentimentAnalysis": "Anmeldelserne roser den afbalancerede, varme og transparente gengivelse med høj klarhed og mange detaljer i både musik og tale.",
     "simpleTitle": "Varm, klar og detaljeret lyd",
     "bias": "positive",
     "key": "warm_clear_detail",
     "groupId": "d24876a0-b83c-43cc-9364-10d3979d51e3"
    },
    "impressive bass for a compact speaker": {
     "sentimentAnalysis": "Mange anmeldelser oplever bassen som dyb, stram og overraskende kraftig i forhold til kabinettets størrelse; i mindre rum er den ofte tilstrækkelig uden subwoofer.",
     "simpleTitle": "Imponerende bas for en kompakt højttaler",
     "bias": "positive",
     "key": "compact_bass",
     "groupId": "27da3279-cbee-4f1c-a0d9-e560f5907092"
    },
    "a subwoofer can add deeper impact": {
     "sentimentAnalysis": "En mindre del af anmeldelserne bemærker, at det kompakte kabinet ikke kan matche større højttalere i den dybeste bas, og anbefaler en subwoofer for mere tyngde.",
     "simpleTitle": "En subwoofer kan give mere dybde",
     "bias": "negative",
     "key": "subwoofer_needed",
     "groupId": "27da3279-cbee-4f1c-a0d9-e560f5907092"
    },
    "treble can sound insufficiently defined": {
     "sentimentAnalysis": "Enkelte anmeldelser kritiserer diskanten for at være mindre klar eller detaljeret end hos andre højttalere, trods god bas og samlet lyd.",
     "simpleTitle": "Diskanten kan virke utilstrækkeligt defineret",
     "bias": "negative",
     "key": "treble_limitations",
     "groupId": "d24876a0-b83c-43cc-9364-10d3979d51e3"
    }
   },
