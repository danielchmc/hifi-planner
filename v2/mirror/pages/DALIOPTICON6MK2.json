  "displayBookDemo": true,
  "reviews": {
   "summary": "DALIOPTICON6MK2 leverer en meget engagerende, klar og detaljeret lyd med varm, rummelig gengivelse, stærk dynamik og overbevisende bas. Hybrid-diskanten roses for sprøde, luftige højder og tydelig detaljeopløsning, mens gulvhøjttalerne skaber en bred og omsluttende scene til både musik og film. Det fremragende pris/ydelsesforhold, det flotte design og den gode præstation ved både lav og høj lydstyrke gør højttalerne til en alsidig opgradering, selv om enkelte synes, at bassen er lidt fremtrædende eller savner mere mellemtone.",
   "headlines": {
    "warm, detailed and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver gennemgående en varm, klar og detaljeret gengivelse med bred scene og stærk musikalitet.",
     "simpleTitle": "Varm, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "b8a9ae35-274f-4090-8974-f8137df5efbf"
    },
    "powerful, controlled bass without a subwoofer": {
     "sentimentAnalysis": "Mange anmeldelser roser den fyldige, kontante og stramme bas og mener ofte, at en subwoofer ikke er nødvendig til musik og almindelige film.",
     "simpleTitle": "Kraftfuld, kontrolleret bas uden subwoofer",
     "bias": "positive",
     "key": "bass",
     "groupId": "4522657a-3bcc-4ecb-89f5-f245c376aebf"
    },
    "bass can be slightly prominent": {
     "sentimentAnalysis": "En mindre del af anmeldelserne oplever bassen som lidt fremtrædende, og en lytter savner mere mellemtone.",
     "simpleTitle": "Bassen kan være lidt fremtrædende",
     "bias": "negative",
