  "displayBookDemo": true,
  "reviews": {
   "summary": "DALI Opticon 6 MK2 leverer en varm, klar og meget detaljeret lyd med kontant bas, levende dynamik og et imponerende lydbillede. Højttalerne fungerer overbevisende til musik, film og surround, spiller behageligt ved både lav og høj lydstyrke og giver fremragende værdi for pengene. Det slanke design, den solide konstruktion og den nemme forstærkermatchning styrker helhedsindtrykket, selv om enkelte nævner basbalance, rumakustik eller de skarpe spikes som mindre ulemper.",
   "headlines": {
    "warm, clear and balanced sound": {
     "sentimentAnalysis": "Det dominerende indtryk er en musikalsk, varm og ren gengivelse, der forbliver afbalanceret uden at virke hård eller trættende.",
     "simpleTitle": "Varm, klar og afbalanceret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "56cf0d8e-8216-4da1-be91-75483015b86a"
    },
    "detailed, spacious and immersive presentation": {
     "sentimentAnalysis": "Hybrid-diskanten og de klare mellemtoner forbindes med fine detaljer, god instrumentadskillelse og en bred, dyb scene.",
     "simpleTitle": "Detaljeret, rummelig og omsluttende gengivelse",
     "bias": "positive",
     "key": "detail",
     "groupId": "dd999af8-61b3-4a05-95c7-4767913f1a1f"
    },
    "punchy bass without a subwoofer": {
     "sentimentAnalysis": "Bassen beskrives gentagne gange som fyldig, stram og rumfyldende, og mange systemer har ikke brug for en ekstra subwoofer.",
     "simpleTitle": "Kontant bas uden subwoofer",
     "bias": "positive",
     "key": "bass",
     "groupId": "55f55862-68c8-4c81-ad02-b2d8d332c694"
    },
    "attractive, slim and well built": {
     "sentimentAnalysis": "Det slanke kabinet, de flotte overflader og den solide konstruktion passer ifølge disse vurderinger godt ind i stuen.",
     "simpleTitle": "Flot, slankt og solidt bygget",
     "bias": "positive",
     "key": "design",
     "groupId": "7a8d6800-2851-4408-a513-d3bf86623d8c"
    },
    "exceptional value in the price range": {
     "sentimentAnalysis": "Opticon 6 MK2 vurderes ofte til at levere en ydelse, man normalt forbinder med markant dyrere gulvhøjttalere.",
     "simpleTitle": "Fremragende værdi i prisklassen",
     "bias": "positive",
     "key": "value",
     "groupId": "0f4ea9d9-b464-4477-b795-a5d4ed4b67df"
    },
    "bass can become excessive in some rooms": {
     "sentimentAnalysis": "Et mindretal oplever, at placering eller rumakustik kan gøre bassen for dominerende, buldrende eller mindre tilfredsstillende.",
     "simpleTitle": "Bassen kan blive for kraftig i visse rum",
     "bias": "negative",
     "key": "bass",
     "groupId": "55f55862-68c8-4c81-ad02-b2d8d332c694"
    }
   },
   "grouping": {
    "56cf0d8e-8216-4da1-be91-75483015b86a": {
     "title": "Lydkvalitet",
     "id": "56cf0d8e-8216-4da1-be91-75483015b86a",
     "references": [
