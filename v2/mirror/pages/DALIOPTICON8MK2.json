  "reviews": {
   "summary": "DALIOPTICON 8 MK2 leverer en usædvanligt rummelig, detaljeret og musikalsk hi-fi-gengivelse med varm, slagkraftig bas samt klare, åbne og præcise mellemtoner og diskant. Højttalerne er stadig engagerende ved lav lydstyrke og imponerer med musik, film og surroundsystemer. En kraftig forstærker og god plads anbefales, mens diskanten for nogle kan virke lidt for fremtrædende.",
   "headlines": {
    "open, detailed and musical sound": {
     "sentimentAnalysis": "Højttalerne roses for en åben, detaljeret, præcis og behagelig gengivelse, der fungerer godt med musik, film og surroundsystemer.",
     "simpleTitle": "Åben, detaljeret og musikalsk lyd",
     "bias": "positive",
     "key": "open-detailed-and-musical-sound",
     "groupId": "c7da3b2b-1a71-447e-b0e3-035f8b198c13"
    },
    "powerful, tight bass": {
     "sentimentAnalysis": "Bassen beskrives bredt som fyldig, kraftfuld, stram og tilfredsstillende og tilfører musik og filmlyd tyngde og slagkraft.",
     "simpleTitle": "Kraftig og stram bas",
     "bias": "positive",
     "key": "powerful-tight-bass",
     "groupId": "c3813d32-9fa4-4ad9-b83c-2838668662f6"
    },
    "a powerful amplifier is recommended": {
     "sentimentAnalysis": "De store højttalere kræver ifølge erfaringerne en del af forstærkeren og profiterer især ved højere lydstyrker af en kraftig model.",
     "simpleTitle": "En kraftig forstærker anbefales",
     "bias": "negative",
     "key": "powerful-amplifier-recommended",
