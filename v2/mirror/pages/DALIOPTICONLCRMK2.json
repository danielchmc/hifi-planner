  "displayBookDemo": true,
  "reviews": {
   "summary": "Disse slanke væghøjttalere leverer en varm, klar og rummelig lyd, der langt overgår forventningerne til den kompakte størrelse. Musik og hjemmebiograf nyder godt af præcis gengivelse, tydelige detaljer og en medrivende præsentation, mens en subwoofer giver dybere og mere kontant bas efter behov. Det elegante, vægvenlige design, den nemme montering og den gode værdi gør højttalerne særligt attraktive til mindre rum og surroundsystemer.",
   "headlines": {
    "spacious, clear and detailed sound": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent den klare, fyldige, rummelige og velafbalancerede lyd med gode detaljer og præcis gengivelse.",
     "simpleTitle": "Rummelig, klar og detaljeret lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "dbfb59a7-b8af-448e-81f3-2408b5d053e8"
    },
    "versatile for music and home cinema": {
     "sentimentAnalysis": "Højttalerne beskrives gentagne gange som velegnede til forskellige musikgenrer og som front-, center- eller baghøjttalere i surroundsystemer.",
     "simpleTitle": "Alsidige til musik og hjemmebiograf",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "dbfb59a7-b8af-448e-81f3-2408b5d053e8"
    },
    "slim, attractive wall-mounted design": {
     "sentimentAnalysis": "Anmeldelserne værdsætter det diskrete, flade udseende og muligheden for at få højttalerne til at passe flot ind på væggen, især hvor gulvpladsen er begrænset.",
     "simpleTitle": "Slankt og attraktivt vægdesign",
     "bias": "positive",
     "key": "design-installation",
     "groupId": "e8463cc4-ee24-4525-9eb4-265ee656593c"
    },
    "limited deep bass without a subwoofer": {
     "sentimentAnalysis": "Flere anmeldelser peger på, at basdybde eller punch er den største begrænsning, især i større rum, og anbefaler en subwoofer til de dybeste frekvenser.",
     "simpleTitle": "Begrænset dybbas uden subwoofer",
     "bias": "negative",
     "key": "bass",
     "groupId": "6603fba7-0632-4216-9bf5-9a21ae0bc7f3"
    },
    "easy to install in small spaces": {
     "sentimentAnalysis": "Det kompakte vægformat vurderes som praktisk i små rum, og installationshjælpen får også positiv omtale.",
     "simpleTitle": "Nem montering i små rum",
     "bias": "positive",
     "key": "design-installation",
     "groupId": "e8463cc4-ee24-4525-9eb4-265ee656593c"
    }
   },
