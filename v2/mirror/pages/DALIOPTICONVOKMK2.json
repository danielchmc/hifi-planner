  "displayBookDemo": true,
  "reviews": {
   "summary": "DALI Opticon Vokal MK2 roses bredt som en kraftfuld, klar og omsluttende centerhøjttaler. Varm, fyldig bas og mellemtone kombineres med en tydelig, åben diskant, som gør dialoger, vokaler, film og musik meget engagerende, mens samspillet med DALI- og andre surroundsystemer generelt er fremragende. Det store kabinet og den relativt høje pris er mindre ulemper, men den samlede lydkvalitet og opgraderingsmulighederne gør højttaleren stærkt anbefalelsesværdig.",
   "headlines": {
    "rich, powerful and clear sound": {
     "sentimentAnalysis": "Højttaleren leverer varm, fyldig og slagkraftig lyd med kraftig bas og mellemtone.",
     "simpleTitle": "Fyldig, kraftfuld og klar lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "baffb2cc-56cb-4d65-8fdb-56d946a87a10"
    },
    "open, detailed and brilliant treble": {
     "sentimentAnalysis": "Anmeldelserne fremhæver en luftig og åben gengivelse med levende detaljer og brillant diskant, som breder lyden ud over kabinettet.",
     "simpleTitle": "Åben, detaljeret og brillant diskant",
     "bias": "positive",
     "key": "sound",
     "groupId": "baffb2cc-56cb-4d65-8fdb-56d946a87a10"
    },
    "excellent match for surround systems": {
     "sentimentAnalysis": "Højttaleren integreres problemfrit med DALI- og andre surroundkomponenter, herunder flere Opticon- og Rubicon-systemer.",
     "simpleTitle": "Fremragende match til surroundsystemer",
     "bias": "positive",
     "key": "system-match",
     "groupId": "a621b72f-bf7a-4a17-9d94-800888b2981d"
    },
    "dialogue remains clear during action": {
     "sentimentAnalysis": "Centeren gengiver stemmer og filmdialoger klart, tydeligt og detaljeret, selv sammen med høje effekter.",
     "simpleTitle": "Dialoger forbliver klare under action",
     "bias": "positive",
     "key": "dialogue",
     "groupId": "8343bd3b-5fb4-43f0-a31d-9f156ec9df25"
    },
    "large enclosure can be demanding": {
     "sentimentAnalysis": "Det store kabinet giver fylde, men kan lyde bedre uden for lukkede møbler og kræver tilstrækkelig plads.",
     "simpleTitle": "Det store kabinet kan være krævende",
     "bias": "negative",
     "key": "design-size",
     "groupId": "20c25da3-f308-4b6c-aa8d-5f35d0f8dfef"
    }
