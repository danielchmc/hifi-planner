  "reviews": {
   "summary": "DALIRUBICONLCR leverer varm, krystalklar og omsluttende lyd med fremragende detaljer, dynamik og godt tryk. Den dybe, kontrollerede bas tilfredsstiller mange lyttere uden subwoofer, mens det enkle vægdesign giver et elegant udtryk og frigør gulvplads. I enkelte anlæg kan en subwoofer stadig være en fordel til de allerlaveste frekvenser.",
   "headlines": {
    "clear, refined and immersive presentation": {
     "sentimentAnalysis": "Lyden beskrives som krystalklar uden skarphed, dyb og omsluttende, og fungerer især godt i stereo-, surround- og hjemmebiografopsætninger.",
     "simpleTitle": "Klar, raffineret og omsluttende gengivelse",
     "bias": "positive",
     "key": "clear-refined-presentation",
     "groupId": "d18b1d4d-48fa-4c0f-8e7b-f7972939ee66"
    },
    "detailed, dynamic sound with plenty of punch": {
     "sentimentAnalysis": "Anmeldelserne roser de fine detaljer, den stærke dynamik og det energiske tryk.",
     "simpleTitle": "Detaljeret, dynamisk lyd med masser af tryk",
     "bias": "positive",
     "key": "detailed-dynamic-sound",
     "groupId": "d18b1d4d-48fa-4c0f-8e7b-f7972939ee66"
    },
    "powerful bass without always needing a subwoofer": {
     "sentimentAnalysis": "Flere anmeldelser finder bassen så fyldig og tilfredsstillende, at en subwoofer er unødvendig.",
     "simpleTitle": "Kraftig bas uden altid at behøve en subwoofer",
     "bias": "positive",
     "key": "subwoofer-free-bass",
     "groupId": "9933a34b-d876-4aa4-852b-1fa8da874048"
    },
    "the lowest bass may benefit from a subwoofer": {
     "sentimentAnalysis": "Nogle anlæg forventes især at få gavn af en subwoofer til de dybeste toner og den nederste oktav.",
     "simpleTitle": "Den dybeste bas kan have gavn af en subwoofer",
     "bias": "negative",
     "key": "deepest-bass-limit",
     "groupId": "9933a34b-d876-4aa4-852b-1fa8da874048"
    },
    "elegant wall-mounted design saves floor space": {
     "sentimentAnalysis": "Det slanke vægmonterede format roses for den flotte finish og for at frigøre gulvplads.",
     "simpleTitle": "Elegant vægdesign frigør gulvplads",
     "bias": "positive",
     "key": "wall-mounted-design",
     "groupId": "5f790a7c-6957-425f-bb16-2a2eeec6f294"
    }
   },
