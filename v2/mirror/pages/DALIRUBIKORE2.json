  "reviews": {
   "summary": "DALIRUBIKORE2 leverer en usædvanligt klar, detaljeret og musikalsk lyd for en kompakt standerhøjttaler med imponerende stor lydscene, varm mellemtone, silkeblød diskant og overraskende fyldig bas. Byggekvalitet og udseende roses bredt, og højttalerne fungerer godt med flere forstærkere samt i små og mellemstore rum. Bassen kan dog blive for dominerende eller mindre præcis afhængigt af placering og indspilning, og flere anmeldelser bemærker, at lyden forbedres efter tilspilning.",
   "headlines": {
    "clear detail and a spacious soundstage": {
     "sentimentAnalysis": "Anmeldelserne roser den krystalklare diskant, de mange fine detaljer, realistiske teksturer samt den brede og dybe stereolydscene.",
     "simpleTitle": "Klar detaljering og en stor lydscene",
     "bias": "positive",
     "key": "clarity_and_stage",
     "groupId": "469e6783-2a6b-4c27-8364-eabc204bc5c7"
    },
    "surprisingly full and controlled bass": {
     "sentimentAnalysis": "Det kompakte kabinet leverer dyb, kontant og veldefineret bas, som ofte lyder større end forventet.",
     "simpleTitle": "Overraskende fyldig og kontrolleret bas",
     "bias": "positive",
     "key": "capable_bass",
     "groupId": "b2c4865c-b97d-417e-b2bd-153a2c3eee4f"
    },
    "large, detailed sound from a compact speaker": {
     "sentimentAnalysis": "Højttalerne skaber konsekvent en fyldig, immersiv og meget musikalsk gengivelse, der overgår forventningerne til størrelsen.",
     "simpleTitle": "Stor og detaljeret lyd fra en kompakt højttaler",
     "bias": "positive",
     "key": "large_detailed_sound",
     "groupId": "b2416f2a-1d2a-43cd-85af-540af0ed0e80"
    },
    "warm, natural and non-fatiguing musicality": {
     "sentimentAnalysis": "Varme klangfarver, blød diskant og autentiske instrumentklange gør gengivelsen indbydende til lange lytteoplevelser.",
     "simpleTitle": "Varm, naturlig og behagelig musikalitet",
     "bias": "positive",
     "key": "musicality",
     "groupId": "b2416f2a-1d2a-43cd-85af-540af0ed0e80"
    },
    "bass balance depends on placement and taste": {
     "sentimentAnalysis": "Nogle lyttere oplever bassen som for dominerende, resonant eller ikke dyb nok, især tæt på en væg eller uden subwoofer.",
     "simpleTitle": "Basbalancen afhænger af placering og smag",
     "bias": "negative",
     "key": "bass_balance",
     "groupId": "b2c4865c-b97d-417e-b2bd-153a2c3eee4f"
    },
    "sound improves noticeably after break-in": {
     "sentimentAnalysis": "Flere anmeldelser beskriver en tydelig forbedring efter cirka 30-100 timers eller nogle ugers tilspilning.",
     "simpleTitle": "Lyden forbedres tydeligt efter tilspilning",
     "bias": "positive",
     "key": "break_in_improvement",
     "groupId": "ac40ea2d-b327-4540-947f-14e27f919939"
    }
   },
