  "reviews": {
   "summary": "DALIRUBIKORE2 leverer en usædvanligt klar, detaljeret og musikalsk gengivelse for en kompakt højttaler med et overraskende stort, åbent lydbillede, varm mellemtone og silkeblød diskant. Bassen roses generelt som dyb, livlig og velafbalanceret i forhold til kabinettets størrelse, selv om nogle lyttere synes, at den øvre bas er for fremtrædende eller ønsker mere dybde og kontur uden en subwoofer. Den fine finish, det attraktive design og den stærke værdi understøtter indtrykket af en kompakt high-end-højttaler, mens korrekt opsætning og tilspilning giver de bedste resultater.",
   "headlines": {
    "premium finish and attractive styling": {
     "sentimentAnalysis": "Kabinettet opleves generelt som velbygget, elegant og visuelt tiltalende og supplerer den stærke lydmæssige præstation.",
     "simpleTitle": "Eksklusiv finish og attraktivt design",
     "bias": "positive",
     "key": "design",
     "groupId": "06411234-7443-48d0-b978-9ceb87d457a3"
    },
    "detailed, clear and musical sound": {
     "sentimentAnalysis": "Højttalerne roses gentagne gange for en usædvanligt klar, detaljeret og nuanceret gengivelse med stor musikalitet og realisme.",
     "simpleTitle": "Detaljeret, klar og musikalsk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "639e584c-013e-4f44-92f3-dfb94edfb769"
    },
    "large, open sound from a compact cabinet": {
     "sentimentAnalysis": "Flere lyttere er imponerede over det usædvanligt store og rumfyldende lydbillede fra det kompakte kabinet.",
     "simpleTitle": "Stor, åben lyd fra et kompakt kabinet",
     "bias": "positive",
     "key": "compact",
     "groupId": "e8254a39-7e4d-4bed-9634-2a87689877dc"
    },
    "deep, lively and well-balanced bass": {
     "sentimentAnalysis": "Bassen beskrives ofte som overraskende dyb, hurtig, kontrolleret og passende til rummet og kabinettet.",
     "simpleTitle": "Dyb, livlig og velafbalanceret bas",
     "bias": "positive",
     "key": "bass",
     "groupId": "815c2c09-8915-49c8-8d84-281f18103aca"
    },
    "sound improves after break-in": {
     "sentimentAnalysis": "Flere ejere oplever en tydelig forbedring efter omkring 30 til 100 timer eller nogle ugers brug.",
     "simpleTitle": "Lyden forbedres efter tilspilning",
     "bias": "positive",
     "key": "breakin",
     "groupId": "b4ed63ee-81ce-426c-800f-9ee6118c710f"
    },
    "bass depth and definition can be limiting": {
     "sentimentAnalysis": "Nogle lyttere ønsker mere dybde i bunden eller strammere baskontrol, mens en anmeldelse oplever den øvre bas som for fremtrædende og resonant på visse indspilninger.",
     "simpleTitle": "Basdybde og -kontur kan være begrænset",
     "bias": "negative",
     "key": "bass",
     "groupId": "815c2c09-8915-49c8-8d84-281f18103aca"
    }
