  "reviews": {
   "summary": "DALI Rubikore 6 får stor ros for en varm, velafbalanceret og meget detaljeret lyd, der kombinerer dyb, kontrolleret bas med en åben og rummelig gengivelse. Den klare separation, den musikalske dynamik og den afslappede langtidslytning til både musik og film bliver især fremhævet. Den elegante udførelse, det flotte design og den stærke ydelse til prisen gør højttalerne til en overbevisende opgradering fra ældre DALI-modeller og konkurrerende produkter.",
   "headlines": {
    "open, spacious and highly detailed presentation": {
     "sentimentAnalysis": "Lydbilledet beskrives gentagne gange som bredt og åbent med høj detaljegrad, god lagdeling og tydelig instrumentseparation.",
     "simpleTitle": "Åben, rummelig og meget detaljeret gengivelse",
     "bias": "positive",
     "key": "detail",
     "groupId": "5994ea7a-f502-45cc-a4dd-b524a74cc897"
    },
    "warm, balanced and musical sound": {
     "sentimentAnalysis": "Højttalerne roses bredt for en varm, velafbalanceret, neutral og musikalsk gengivelse, der fungerer på tværs af genrer.",
     "simpleTitle": "Varm, velafbalanceret og musikalsk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "c0e7145a-f196-4214-9585-29de095ffdc8"
    },
    "deep, punchy and controlled bass": {
     "sentimentAnalysis": "Anmelderne beskriver bassen som dyb, ren og kontant, samtidig så velkontrolleret at mindre rum og mellemtonen ikke overvældes.",
     "simpleTitle": "Dyb, kontrolleret og punchy bas",
     "bias": "positive",
     "key": "bass",
     "groupId": "9a5dc4cd-4e78-4230-898c-59437578163d"
    },
    "elegant, attractive cabinet design": {
     "sentimentAnalysis": "Kabinetterne opleves konsekvent som flotte, elegante og velegnede til stuen, mens kvaliteten i udførelsen bemærkes med det samme.",
     "simpleTitle": "Elegant og flot kabinetdesign",
     "bias": "positive",
     "key": "design",
     "groupId": "632828c6-250e-4a76-a633-b8cd7f4dd001"
    },
