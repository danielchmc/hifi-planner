  "displayBookDemo": true,
  "reviews": {
   "summary": "DALIRUBIKORE8 leverer en varm, detaljeret og særdeles medrivende lyd med imponerende klarhed, punch og rumfornemmelse til både musik og film. Den kontrollerede bas, den store scene og de raffinerede højder gør højttalerne engagerende ved både moderate og høje niveauer, mens sammenligninger placerer dem tæt på langt dyrere modeller. Det elegante, stuevenlige design og den stærke værdi giver en gennemgående begejstret vurdering, dog med anbefaling om tålmodig tilspilning.",
   "headlines": {
    "detailed, expansive and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, detaljerede gengivelse, den brede scene og den medrivende musik- og filmoplevelse.",
     "simpleTitle": "Detaljeret, stor og medrivende lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "46b68342-b0e5-46da-8ccf-aacc3f2594c3"
    },
    "powerful, controlled bass": {
     "sentimentAnalysis": "Anmeldelserne fremhæver den dybe, kontante og velkontrollerede bas, som normalt gør en subwoofer overflødig.",
     "simpleTitle": "Kraftfuld, kontrolleret bas",
     "bias": "positive",
     "key": "bass",
     "groupId": "096ecaa5-e0a8-4ead-bab3-47d651653243"
    },
    "elegant, room-friendly construction": {
     "sentimentAnalysis": "Anmeldelserne værdsætter det flotte udseende, den eksklusive finish, kvaliteten og den stuevenlige størrelse.",
     "simpleTitle": "Elegant og stuevenligt design",
     "bias": "positive",
     "key": "design",
     "groupId": "2939dd14-a2e8-41fe-b13a-54150814114a"
    },
    "bass can feel restrained at low volume": {
     "sentimentAnalysis": "Ved visse lytteforhold virker den dybe bas mindre fyldig; en subwoofer kan tilføje mere dybde eller stramhed.",
     "simpleTitle": "Bassen kan virke afdæmpet ved lav lydstyrke",
     "bias": "negative",
     "key": "bass",
     "groupId": "096ecaa5-e0a8-4ead-bab3-47d651653243"
    },
    "patient break-in improves the sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en tydelig forbedring efter længere tilspilning, som belønner tålmodighed med en fyldigere lyd.",
     "simpleTitle": "Tålmodig tilspilning forbedrer lyden",
     "bias": "positive",
     "key": "break-in",
     "groupId": "77ccf3da-d6c2-44f3-bcb5-455d9480fbe4"
    }
   },
