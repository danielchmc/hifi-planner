  "reviews": {
   "summary": "DALIRUBIKOREONWALL roses bredt for sin varme, klare og detaljerede lyd, der giver en imponerende rummelig og omsluttende gengivelse trods vægmonteringen. Højttalerne fungerer fremragende til både musik og hjemmebio med en neutral, slagkraftig og fyldig lyd, der kan måle sig med fritstående modeller i samme prisklasse. Det elegante design, den pladsbesparende placering og den gode samlede værdi gør produktet særligt attraktivt, selv om vægbeslaget er besværligt, og prisen kan føles høj.",
   "headlines": {
    "warm, clear and detailed sound": {
     "sentimentAnalysis": "Lyden roses for at være varm, blød, klar og meget detaljeret og forbliver behagelig ved forskellige lydstyrker og musikgenrer.",
     "simpleTitle": "Varm, klar og detaljeret lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "dc86237f-a9cd-43c9-8dfa-5b98f43ca298"
    },
    "wide, immersive soundstage": {
     "sentimentAnalysis": "Højttalerne skaber en rumfyldende gengivelse med et bredt sweet spot og en størrelse, der overgår forventningerne til en væghængt model.",
     "simpleTitle": "Stor og omsluttende lydscene",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "dc86237f-a9cd-43c9-8dfa-5b98f43ca298"
    },
    "neutral and powerful performance": {
     "sentimentAnalysis": "Højttalerne beskrives som neutrale og slagkraftige med kraftig bas og god integration med en subwoofer.",
     "simpleTitle": "Neutral og kraftfuld gengivelse",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "dc86237f-a9cd-43c9-8dfa-5b98f43ca298"
