        "sentimentAnalysis": "Højttalerne tilfører en omsluttende surrounddimension og fungerer meget godt som baghøjttalere.",
        "simpleTitle": "Overbevisende og rummelig surroundgengivelse",
        "bias": "positive",
        "key": "surround",
        "groupId": "a3692cc0-b8d8-4171-b11c-30da157a2738"
       },
