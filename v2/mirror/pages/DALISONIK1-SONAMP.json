     "reviews": {
      "summary": "SONAMP roses bredt som en kompakt og kraftfuld forstærker, der bringer passive højttalere ind i Sonos-økosystemet med varm, fyldig og medrivende lyd. Opsætning, daglig betjening og tv-integration fungerer som regel problemfrit, mens det lille design passer diskret ind i moderne hjem. App-fejl, lejlighedsvise forbindelsesproblemer, manglende indgange, begrænsningen uden Bluetooth og den høje pris nævnes som ulemper, men den samlede ydeevne og fleksibilitet gør SONAMP til et stærkt anbefalet valg.",
      "headlines": {
       "easy setup and control": {
        "sentimentAnalysis": "Opsætning og daglig betjening opleves generelt som enkel, intuitiv og bekvem.",
        "simpleTitle": "Nem opsætning og betjening",
        "bias": "positive",
        "key": "setup",
        "groupId": "6ca89eb6-ca0b-454a-b637-6c2f44a71680"
       },
       "seamless Sonos ecosystem": {
        "sentimentAnalysis": "Forstærkeren værdsættes for at udvide Sonos-platformen til eksisterende passive højttalere og integrere problemfrit med andre Sonos-enheder.",
        "simpleTitle": "Problemfrit Sonos-økosystem",
        "bias": "positive",
        "key": "sonos",
        "groupId": "63adf694-02df-4f11-942e-85bf3ed028ec"
       },
       "excellent TV and surround integration": {
        "sentimentAnalysis": "HDMI-tv-forbindelse og surroundbrug roses for stærk lyd og praktisk, samlet betjening.",
        "simpleTitle": "Fremragende tv- og surroundintegration",
        "bias": "positive",
        "key": "tv",
        "groupId": "1397b3aa-9f01-43b7-a77d-ca0a41176b87"
       },
       "powerful, rich sound": {
        "sentimentAnalysis": "SONAMP beskrives gentagne gange som kraftfuld og fyldig med fremragende lyd gennem mange forskellige passive højttalere.",
        "simpleTitle": "Kraftfuld og fyldig lyd",
