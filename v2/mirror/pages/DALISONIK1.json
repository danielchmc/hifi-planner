  "displayBookDemo": true,
  "reviews": {
   "summary": "DALISONIK1 leverer varm, klar og detaljeret lyd fra et imponerende kompakt kabinet med et stort, omsluttende lydbillede og en kontant bas. Højttalerne fungerer især godt i små og mellemstore rum, som TV- eller musikhøjttalere og som surroundkanaler, mens en subwoofer kan tilføre ekstra dybde og fylde. Den solide kvalitet, det flotte design og den stærke værdi gør DALISONIK1 til en varm anbefaling, selv om større anlæg kan afsløre begrænsninger i den dybe bas.",
   "headlines": {
    "clear, detailed sound with a spacious presentation": {
     "sentimentAnalysis": "Anmeldelserne fremhæver fremragende klarhed, detaljegrad, naturlige stemmer og et stort, omsluttende lydbillede.",
     "simpleTitle": "Klar og detaljeret lyd med stor rumlighed",
     "bias": "positive",
     "key": "sound",
     "groupId": "496b4f2b-8123-4bba-819e-943699c4f15a"
    },
    "surprisingly powerful sound for a compact speaker": {
     "sentimentAnalysis": "De kompakte kabinetter leverer høj lydstyrke, fyldig lyd og imponerende bas i forhold til størrelsen, især i mindre rum.",
     "simpleTitle": "Overraskende kraftig lyd fra en kompakt højttaler",
     "bias": "positive",
     "key": "sound",
     "groupId": "496b4f2b-8123-4bba-819e-943699c4f15a"
    },
    "highly effective for surround and TV systems": {
     "sentimentAnalysis": "Anmeldelserne beskriver stærk ydelse som bag-, surround- eller TV-højttalere med kræfter nok til frontbrug i mindre opsætninger.",
     "simpleTitle": "Meget velegnet til surround- og TV-systemer",
     "bias": "positive",
     "key": "surround",
     "groupId": "8b0b39fb-fa3d-454d-9b33-8af872b9eeea"
    },
    "compact, discreet and easy to place": {
     "sentimentAnalysis": "Det kompakte kabinet roses gentagne gange for at være diskret, flot og nemt at placere i mindre rum.",
     "simpleTitle": "Kompakt, diskret og nem at placere",
     "bias": "positive",
     "key": "compact",
     "groupId": "a14b5dbf-b41a-48d3-8bfa-8d540a420f41"
    },
    "bass can lack the fullness of larger speakers": {
     "sentimentAnalysis": "To anmeldelser bemærker, at den rene bas mangler større højttaleres fylde; opgraderede delefiltre eller større højttalere forbedrer resultatet.",
     "simpleTitle": "Bassen kan mangle større højttaleres fylde",
     "bias": "negative",
     "key": "sound",
     "groupId": "496b4f2b-8123-4bba-819e-943699c4f15a"
    }
   },
   "grouping": {
    "496b4f2b-8123-4bba-819e-943699c4f15a": {
     "title": "Lydkvalitet",
