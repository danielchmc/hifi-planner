  "displayBookDemo": true,
  "reviews": {
   "summary": "DALISONIK3 leverer en usædvanligt klar, velafbalanceret og dynamisk hi-fi-lyd med varme detaljer, overbevisende stemmer og overraskende kraftig bas for en kompakt højttaler. Gengivelsen føles omsluttende og realistisk og fungerer især godt til musik, film og spil, samtidig med at den imponerer ved både lav og høj lydstyrke. Det elegante design, den gode byggekvalitet og den stærke værdi gør DALISONIK3 til et overbevisende valg, selv om større rum eller basorienterede lyttere stadig kan foretrække en subwoofer eller en mere omhyggelig placering.",
   "headlines": {
    "attractive, well-finished design": {
     "sentimentAnalysis": "Anmeldelserne roser højttalernes flotte udseende, gode finish og praktiske magnetiske frontgitre.",
     "simpleTitle": "Flot design og god finish",
     "bias": "positive",
     "key": "design",
     "groupId": "f1ed9d2c-956b-4d09-8a3c-694ed2b0f29d"
    },
    "clear, balanced and detailed sound": {
     "sentimentAnalysis": "Anmeldelserne roser den rene, klare, velafbalancerede, dynamiske og detaljerede gengivelse af musik og andre medier.",
     "simpleTitle": "Klar, velafbalanceret og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "3f33983b-53ba-43d9-8e30-a6019ce7a73d"
    },
    "excellent value for the price": {
     "sentimentAnalysis": "Anmeldelserne beskriver gentagne gange DALISONIK3 som usædvanligt kapabel og svær at slå i prisklassen.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "66a4140b-1dda-4192-b4f4-6c5d6cbfc2b4"
    },
    "powerful bass for a compact speaker": {
     "sentimentAnalysis": "Flere anmeldelser oplever bassen som fyldig, dyb og overraskende kraftig i forhold til størrelsen, og i mange rum er en subwoofer ikke nødvendig.",
     "simpleTitle": "Kraftig bas fra en kompakt højttaler",
     "bias": "positive",
     "key": "bass",
     "groupId": "80a05b56-b7c7-4102-9e1b-bcb00fb535f5"
    },
    "immersive soundstage and strong media performance": {
     "sentimentAnalysis": "Anmeldelserne beskriver en realistisk, bred og omsluttende gengivelse, der især fungerer godt til film, spil, tv og rumlig lytning.",
     "simpleTitle": "Omsluttende lydbillede og stærk mediegengivelse",
     "bias": "positive",
     "key": "sound",
     "groupId": "3f33983b-53ba-43d9-8e30-a6019ce7a73d"
    },
    "bass can lack ultimate depth": {
     "sentimentAnalysis": "Nogle anmeldelser bemærker, at de kompakte kabinetter ikke leverer den dybeste eller blødeste bas i større rum, hvilket kan føre til et ønske om en subwoofer.",
     "simpleTitle": "Bassen kan mangle den dybeste fylde",
     "bias": "negative",
     "key": "bass",
     "groupId": "80a05b56-b7c7-4102-9e1b-bcb00fb535f5"
    }
   },
   "grouping": {
    "3f33983b-53ba-43d9-8e30-a6019ce7a73d": {
     "title": "Lydkvalitet",
     "id": "3f33983b-53ba-43d9-8e30-a6019ce7a73d",
     "references": [
      "2d21bb93-f542-4ff9-9339-58272bc692df",
