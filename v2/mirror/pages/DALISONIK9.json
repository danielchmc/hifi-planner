  "displayBookDemo": true,
  "reviews": {
   "summary": "DALISONIK9 leverer en varm, kraftfuld og meget detaljeret lyd med klare højder, udtryksfuld mellemtone og dyb, kontant bas. Det brede, medrivende lydbillede og den tilgivende musikalske karakter fungerer fremragende på tværs af genrer, mens hybrid-diskanten bevarer finesse og god spredning. Den stærke værdi for pengene, høje lytteglæde og rumfyldende dynamik gør DALISONIK9 til en varm anbefaling, mens omhyggelig placering hjælper med at kontrollere lejlighedsvis boomy bas.",
   "headlines": {
    "clear, detailed and expressive sound": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent den rene, klare, detaljerede og højtopløste gengivelse i diskant, mellemtone og helhedsindtryk.",
     "simpleTitle": "Klar, detaljeret og udtryksfuld lyd",
     "bias": "positive",
     "key": "clear-detailed-sound",
     "groupId": "fe03ef33-2e85-43f7-a34a-7e6fab2fb847"
    },
    "excellent value for money": {
     "sentimentAnalysis": "Anmeldelserne beskriver gentagne gange DALISONIK9 som et fremragende køb, der kombinerer stor ydelse og finesse med en attraktiv pris.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "excellent-value",
     "groupId": "f105e1f1-6dc9-4936-9a39-47576460616b"
    },
    "deep, powerful bass without a subwoofer": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den stærke, dybe og rumfyldende bas, hvor et setup ikke kræver subwoofer, og en anden anmeldelse roser den ekstra basenhed.",
     "simpleTitle": "Dyb og kraftfuld bas uden subwoofer",
     "bias": "positive",
     "key": "powerful-bass",
     "groupId": "226507d4-a698-4213-93e5-3802fc623e6c"
    },
    "warm and versatile musical character": {
     "sentimentAnalysis": "Lyden beskrives som varm, fyldig og tilgivende og håndterer både energisk rock og velproducerede indspilninger med en engagerende, kontrolleret præsentation.",
     "simpleTitle": "Varm og alsidig musikalsk karakter",
     "bias": "positive",
     "key": "warm-versatile-sound",
     "groupId": "fe03ef33-2e85-43f7-a34a-7e6fab2fb847"
    },
    "wide, immersive soundstage and dispersion": {
     "sentimentAnalysis": "Hybrid-diskanten roses for fremragende højopløsning og bred spredning, som skaber et stort lytteområde ud over den centrale siddeplads.",
     "simpleTitle": "Bredt, medrivende lydbillede og spredning",
     "bias": "positive",
     "key": "wide-soundstage",
     "groupId": "fe03ef33-2e85-43f7-a34a-7e6fab2fb847"
    },
    "bass can become boomy in some rooms": {
     "sentimentAnalysis": "To anmeldelser bemærker, at bassen kan blive boomy afhængigt af rummet, og peger på placering og rumforhold som den sandsynlige årsag.",
