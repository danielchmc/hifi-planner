  "reviews": {
   "summary": "DALISONIKCINEMA leverer en varm, kontant og omsluttende hjemmebiografoplevelse med tydelige dialoger, mange detaljer og kraftfuld dynamik. Den sømløse integration med matchende DALI-højttalere skaber et sammenhængende system, mens det store kabinet kan kræve omhyggelig placering. Filmlyd får den største ros, og den flotte finish samt den gode værdi for pengene styrker helhedsindtrykket.",
   "headlines": {
    "warm, rich and dynamic sound": {
     "sentimentAnalysis": "Anmeldelserne roser den fyldige, varme, kraftfulde og detaljerede lyd med stærk dynamik.",
     "simpleTitle": "Varm, fyldig og dynamisk lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "ecd286ce-c362-4f04-8792-f270c9b7838d"
    },
    "especially effective for films": {
     "sentimentAnalysis": "Afspilning af film og serier beskrives gentagne gange som meget underholdende, kraftfuld og engagerende.",
     "simpleTitle": "Særligt stærk til film",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "ecd286ce-c362-4f04-8792-f270c9b7838d"
    },
    "clearer, more intelligible dialogue": {
     "sentimentAnalysis": "Anmeldelserne fremhæver usædvanligt klar og varm tale samt langt mindre utydelig dialog.",
     "simpleTitle": "Klarere og tydeligere dialog",
     "bias": "positive",
     "key": "dialogue-clarity",
     "groupId": "5aed5822-ca52-45fa-a6d4-59e943c0e2b8"
    },
    "blends seamlessly with matching speakers": {
     "sentimentAnalysis": "Matchende DALI-højttalere integreres ifølge anmeldelserne perfekt og skaber et sammenhængende hjemmebiografsystem.",
     "simpleTitle": "Sømløs sammenkobling med matchende højttalere",
     "bias": "positive",
     "key": "system-integration",
