  "reviews": {
   "summary": "DALISONIKONWALL leverer en varm, detaljeret og omsluttende lyd, der virker imponerende stor fra så kompakte væghøjttalere. Kontante mellemtoner, tydelige vokaler og en stærk surround-rumlighed gør højttalerne særdeles velegnede til musik og hjemmebio. Det slanke design og den fleksible vægplacering er store styrker, mens dybere bas får fordel af en subwoofer og omhyggelig systemtilpasning.",
   "headlines": {
    "remarkably large, detailed sound": {
     "sentimentAnalysis": "Højttalerne leverer en usædvanligt god, detaljeret og rummelig lyd i forhold til den kompakte størrelse.",
     "simpleTitle": "Imponerende stor og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "0d785de0-68b2-42d2-856c-f02861f35b81"
    },
    "effective and spacious surround performance": {
     "sentimentAnalysis": "Højttalerne tilfører en omsluttende surrounddimension og fungerer meget godt som baghøjttalere.",
     "simpleTitle": "Overbevisende og rummelig surroundgengivelse",
     "bias": "positive",
     "key": "surround",
     "groupId": "a3692cc0-b8d8-4171-b11c-30da157a2738"
    },
    "slim, space-saving wall design": {
     "sentimentAnalysis": "Slanke kabinetter, praktisk vægmontering og et rent udtryk passer til rum med begrænset dybde eller plads.",
     "simpleTitle": "Slankt og pladsbesparende vægdesign",
     "bias": "positive",
     "key": "design",
     "groupId": "d791559b-42b9-4dd5-8e49-d079d62e011a"
    },
    "clear and convincing vocal reproduction": {
     "sentimentAnalysis": "Vokaler gengives med en behagelig klarhed og mange detaljer.",
     "simpleTitle": "Klar og overbevisende gengivelse af vokaler",
     "bias": "positive",
     "key": "sound",
     "groupId": "0d785de0-68b2-42d2-856c-f02861f35b81"
    },
    "deep bass is limited without a subwoofer": {
     "sentimentAnalysis": "Kompakte kabinetter kan ikke matche større højttalere i den dybe bas, så en subwoofer er en nyttig tilføjelse.",
     "simpleTitle": "Den dybe bas er begrænset uden subwoofer",
     "bias": "negative",
     "key": "bass",
     "groupId": "1662b81f-faf6-41b2-b454-43cd87d923c8"
