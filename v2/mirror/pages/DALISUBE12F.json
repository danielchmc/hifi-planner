  "reviews": {
   "summary": "DALI SUB E-12 F leverer varm, dyb og slagkraftig bas, som giver film overbevisende effekt og musik større fylde og skala. Den kraftige ydelse forbliver i høj grad kontrolleret og kan justeres, hvilket gør subwooferen til en stærk opgradering af stereo- og surroundanlæg. Enkelte ejere oplever dog, at placering og kalibrering kræver omhu, og at den fyldige bas kan blive for meget i mindre hjem.",
   "headlines": {
    "a major upgrade for music and movies": {
     "sentimentAnalysis": "Ejerne beskriver fyldigere musik, mere omsluttende film og større skala i både stereo- og surroundgengivelse.",
     "simpleTitle": "En stor opgradering til musik og film",
     "bias": "positive",
     "key": "immersive-upgrade",
     "groupId": "979e9224-88e3-4c40-a56a-f786b3d92ff6"
    },
    "deep, powerful and controlled bass": {
     "sentimentAnalysis": "Anmeldelserne roser den dybe gengivelse, det kraftige tryk, præcisionen og den rene kontrol til både musik og film.",
     "simpleTitle": "Dyb, kraftfuld og kontrolleret bas",
     "bias": "positive",
     "key": "deep-bass",
     "groupId": "979e9224-88e3-4c40-a56a-f786b3d92ff6"
    },
    "careful placement and calibration are important": {
     "sentimentAnalysis": "Flere anmeldelser bemærker, at placering, rumakustik og kalibrering kan være krævende; enkelte oplever uønsket støj ved meget dyb bas.",
     "simpleTitle": "Omhyggelig placering og kalibrering er vigtig",
     "bias": "negative",
     "key": "placement-challenges",
     "groupId": "26761897-1ac8-4510-a21e-61d2bbb1e0ac"
