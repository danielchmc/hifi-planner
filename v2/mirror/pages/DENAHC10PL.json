  "displayBookDemo": true,
  "reviews": {
   "summary": "Denon PerL leverer en varm, detaljeret og slagkraftig lyd, der bliver særligt medrivende efter den individuelle høretilpasning. Den komfortable og sikre pasform fungerer fremragende for mange, også under træning, men det store design og valget af ørepropper gør pasformen vanskelig for andre. Den aktive støjreduktion er generelt effektiv, mens samtalekvalitet, touchbetjening og lejlighedsvise pasformsproblemer er de største forbehold.",
   "headlines": {
    "rich, detailed and powerful sound": {
     "sentimentAnalysis": "Lyden roses bredt for at være klar, fyldig, basrig og medrivende.",
     "simpleTitle": "Fyldig, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "970b3b37-2a56-4498-850b-93c6160f4273"
    },
    "secure and comfortable for many users": {
     "sentimentAnalysis": "Mange oplever en komfortabel og stabil pasform, der bliver siddende under gang, løb og anden træning.",
     "simpleTitle": "Komfortabel og sikker for mange",
     "bias": "positive",
     "key": "fit",
     "groupId": "7a64a837-51d0-4410-9df9-066e3da72ef7"
    },
    "personal calibration transforms the listening experience": {
     "sentimentAnalysis": "Høreprofilen og tilpasningen beskrives gentagne gange som en stor forbedring med mere klarhed, dybde og en mere medrivende gengivelse.",
     "simpleTitle": "Personlig tilpasning forvandler lytteoplevelsen",
     "bias": "positive",
     "key": "personalization",
     "groupId": "98c80b70-7fe0-41df-b73c-2e795cf7e57d"
    },
    "the large design and fit can be troublesome": {
     "sentimentAnalysis": "Flere brugere finder øretelefonerne klodsede eller svære at få til at sidde fast, og nogle oplever, at en øretelefon falder ud trods forskellige propper.",
     "simpleTitle": "Det store design og pasformen kan give problemer",
     "bias": "negative",
     "key": "fit",
     "groupId": "7a64a837-51d0-4410-9df9-066e3da72ef7"
    },
    "noise cancellation is effective in many environments": {
     "sentimentAnalysis": "Støjreduktionen roses for at lukke meget omgivelseslyd ude, mens social mode giver nyttig opmærksomhed på omgivelserne ved behov.",
     "simpleTitle": "Støjreduktionen virker effektivt i mange miljøer",
     "bias": "positive",
     "key": "anc",
     "groupId": "fb8e830b-7e06-418e-abe8-45b54487b4a3"
    },
    "noise cancellation can struggle with loud sounds": {
     "sentimentAnalysis": "Kritikken fokuserer på svagere isolering end forventet samt hørbare forstyrrelser og skarpe eller knitrende artefakter ved høje omgivelseslyde.",
     "simpleTitle": "Støjreduktionen kan have svært ved høje lyde",
     "bias": "negative",
     "key": "anc",
     "groupId": "fb8e830b-7e06-418e-abe8-45b54487b4a3"
    }
   },
