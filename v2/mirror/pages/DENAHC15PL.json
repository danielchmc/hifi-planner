  "displayBookDemo": true,
  "reviews": {
   "summary": "Denon PerL Pro leverer en usædvanligt detaljeret, rummelig og tilpasningsbar lyd med fyldig bas, klare stemmer og en medrivende gengivelse, der ofte kan måle sig med over-ear-hovedtelefoner. Den personlige lydprofil og den fleksible app er store styrker, mens komfort og pasform afhænger meget af de rigtige ørepropper og vinger. Støjreduktionen er nyttig, men vurderes forskelligt, og enkelte kritiserer batteritid, betjening og forbindelse.",
   "headlines": {
    "rich, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne fremhæver den klare, rummelige og meget detaljerede gengivelse samt den kraftige, kontrollerede bas.",
     "simpleTitle": "Fyldig, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "16be6c21-7d85-4909-a16e-b0ff57893bd9"
    },
    "secure fit is excellent once the right tips are found": {
     "sentimentAnalysis": "Mange anmeldelser beskriver en behagelig og sikker pasform til hverdag og sport efter afprøvning af propper og vinger.",
     "simpleTitle": "Sikkert hold med de rigtige ørepropper",
     "bias": "positive",
     "key": "fit",
     "groupId": "6d15c53c-f27d-4b13-8d2d-5f1ac587a22f"
    },
    "noise cancellation is useful but not class-leading": {
     "sentimentAnalysis": "Kritikken fokuserer på svagere end forventet støjreduktion, vindstøj og lydlækage ved dårlig pasform, især sammenlignet med premiumkonkurrenter.",
     "simpleTitle": "Støjreduktionen er nyttig, men ikke bedst i klassen",
     "bias": "negative",
     "key": "noise",
     "groupId": "ca2bc73a-8e27-4943-9753-0d5c453713d6"
    },
    "personalized hearing profiles make a major difference": {
     "sentimentAnalysis": "Høretesten og tilpasningen beskrives gentagne gange som produktets afgørende fordel, der giver mere klarhed, dybde og personlig tilpasning.",
     "simpleTitle": "Personlige lydprofiler gør en stor forskel",
     "bias": "positive",
     "key": "app",
     "groupId": "9f6998b9-9d04-497b-95f8-735f3ec08c21"
    }
   },
