  "displayBookDemo": true,
  "reviews": {
   "summary": "Disse øretelefoner leverer generelt en varm, klar og fyldig lyd med tilfredsstillende bas, god værdi for pengene og en behagelig pasform for mange ører. Støjreduktionen er den største svaghed, da den ofte føles mindre effektiv eller mindre justerbar end forventet, mens touch-betjeningen kan være for følsom og udløse uønskede pauser. Samlet set er kvaliteten imponerende til prisen, selv om pasform, forbindelse og pålidelighed i de enkelte øretelefoner kan variere.",
   "headlines": {
    "clear, rich and enjoyable sound": {
     "sentimentAnalysis": "Den varme, klare og detaljerede lyd bliver bredt rost, ligesom den fyldige bas og den gode værdi for pengene.",
     "simpleTitle": "Klar, fyldig og behagelig lyd",
     "bias": "positive",
     "key": "sound_positive",
     "groupId": "8470857a-6a25-4949-8e36-9f183029678b"
    },
    "comfortable and secure fit for many ears": {
     "sentimentAnalysis": "Flere kommentarer roser den behagelige og sikre pasform, også under motion og efter afprøvning af mange alternativer.",
     "simpleTitle": "Behagelig og sikkert fit for mange ører",
     "bias": "positive",
     "key": "fit_positive",
     "groupId": "abef023e-5913-4e40-a4de-292f46802396"
    },
    "touch controls are overly sensitive": {
     "sentimentAnalysis": "Utilsigtede berøringer fra hår, huer, pandebånd eller en simpel justering kan udløse pauser eller andre uønskede handlinger.",
     "simpleTitle": "Touch-betjeningen er for følsom",
     "bias": "negative",
     "key": "controls_negative",
     "groupId": "7246647d-f9e6-449b-85fc-a793388b9801"
    },
    "fit can be unstable for some ears": {
     "sentimentAnalysis": "Individuelle øreformer påvirker stabiliteten, og flere oplever, at øretelefonerne glider eller falder ud under bevægelse.",
     "simpleTitle": "Pasformen kan være ustabil for nogle ører",
     "bias": "negative",
     "key": "fit_negative",
     "groupId": "abef023e-5913-4e40-a4de-292f46802396"
    },
    "noise cancellation is weaker than expected": {
     "sentimentAnalysis": "Støjreduktionen beskrives gentagne gange som skuffende, ineffektiv eller vanskelig at indstille.",
     "simpleTitle": "Støjreduktionen er svagere end forventet",
     "bias": "negative",
     "key": "noise_negative",
     "groupId": "67dfe17a-15c7-4dd7-a904-c30d64c6760b"
    },
    "bass and fullness can feel lacking": {
     "sentimentAnalysis": "Nogle beskriver lyden som for lav, tynd eller uden tilstrækkelig bas og fylde.",
     "simpleTitle": "Bas og fylde kan mangle",
     "bias": "negative",
     "key": "sound_weakness",
     "groupId": "8470857a-6a25-4949-8e36-9f183029678b"
    }
   },
