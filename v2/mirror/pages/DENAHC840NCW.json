  "displayBookDemo": true,
  "reviews": {
   "summary": "Disse øretelefoner leverer en varm, klar og ofte fyldig lyd til en attraktiv pris, med særligt tilfredsstillende bas og detaljer i flere anmeldelser. Komfort og pasform er generelt god, men stabiliteten varierer betydeligt fra øre til øre, og nogle oplever, at øretelefonerne falder ud. Støjreduktion, touch-betjening og reaktionsevne får blandede vurderinger, mens lejlighedsvise problemer med opladning, forbindelse og følsomhed trækker ned i en ellers medrivende oplevelse.",
   "headlines": {
    "good fit for many ears": {
     "sentimentAnalysis": "Flere anmeldelser roser den komfortable eller sikre pasform, også under motion og efter afprøvning af forskellige alternativer.",
     "simpleTitle": "God pasform til mange ører",
     "bias": "positive",
     "key": "fit",
     "groupId": "e6e4e78d-86ef-45b1-8267-a7fbf06ab7d5"
    },
    "touch controls are overly sensitive": {
     "sentimentAnalysis": "Berøring med fingre, hår, tøj eller vejrforhold udløser utilsigtede pauser og aktiveringer, hvilket gør betjeningen frustrerende for flere brugere.",
     "simpleTitle": "Touch-betjeningen er for følsom",
     "bias": "negative",
     "key": "controls",
     "groupId": "016adfaa-0ca3-4fc5-93c3-ecc7d1315cdd"
    },
    "warm, detailed sound with strong bass": {
     "sentimentAnalysis": "Lyden roses gentagne gange som klar, detaljeret og særligt stærk i bassen med god værdi for pengene.",
     "simpleTitle": "Varm, detaljeret lyd med kraftig bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "14c72386-ca72-4534-bbc2-e2ce9cf87a5b"
    },
    "fit can be unstable": {
     "sentimentAnalysis": "Nogle brugere oplever en ufuldkommen pasform eller øretelefoner, der falder ud, især når de bøjer sig eller justerer dem.",
     "simpleTitle": "Pasformen kan være ustabil",
     "bias": "negative",
     "key": "fit",
     "groupId": "e6e4e78d-86ef-45b1-8267-a7fbf06ab7d5"
    },
    "noise cancellation is inconsistent": {
     "sentimentAnalysis": "Støjreduktionen opleves ofte som svagere eller mindre justerbar end forventet, selv om én anmeldelse kalder ANC fremragende.",
     "simpleTitle": "Støjreduktionen er varierende",
     "bias": "negative",
     "key": "noise_cancellation",
     "groupId": "d8ebae5d-fc56-4b65-81ad-9d9f952f138f"
    },
    "sound can lack fullness or bass": {
     "sentimentAnalysis": "En mindre del af anmeldelserne oplever lyden som tynd, for lav eller uden tilstrækkelig bas, mens én anmeldelse beskriver lyden som direkte dårlig.",
     "simpleTitle": "Lyden kan mangle fylde eller bas",
     "bias": "negative",
     "key": "sound",
     "groupId": "14c72386-ca72-4534-bbc2-e2ce9cf87a5b"
    },
    "intermittent reliability issues": {
     "sentimentAnalysis": "Forbindelsesrækkevidde, drift af én øretelefon og opladning beskrives forskelligt i anmeldelserne.",
     "simpleTitle": "Lejlighedsvise pålidelighedsproblemer",
     "bias": "negative",
     "key": "connectivity",
     "groupId": "9ca69de9-f8aa-4b8a-9c23-6e264cf1d538"
    }
   },
