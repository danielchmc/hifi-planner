     "bias": "positive",
     "key": "build",
     "groupId": "1bf99d88-2ce9-4d4b-b02e-59732fd202ff"
    },
    "warm, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne roser en fyldig, varm og meget detaljeret gengivelse med kraftig bas, klar lyd over hele frekvensområdet og en medrivende rumfornemmelse.",
     "simpleTitle": "Varm, detaljeret og medrivende lyd",
