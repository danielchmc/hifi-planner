  "reviews": {
   "summary": "Denon AH-D7200 roses bredt som en førsteklasses, smukt bygget lukket hovedtelefon med varm, fyldig, detaljeret og dynamisk lyd. Dybbas med punch, bløde højder og en usædvanligt rummelig gengivelse gør musikken medrivende og behagelig ved lange lytteøkter. Komforten er generelt god, selv om hovedbøjlen kan trykke på større eller mindre polstrede hoveder, og flere anmeldelser anbefaler tilspilning og en god hovedtelefonforstærker for den bedste ydelse.",
   "headlines": {
    "warm, detailed and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en varm, fyldig, velafbalanceret og rummelig gengivelse med stor detaljegrad.",
     "simpleTitle": "Varm, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "warm_detailed_sound",
     "groupId": "6902e126-cd9e-4297-a652-c75b3d60e1f0"
    },
    "punchy, deep bass without losing detail": {
     "sentimentAnalysis": "Bassen roses gentagne gange som dyb, ren og energisk, samtidig med at musikalske detaljer bevares.",
     "simpleTitle": "Punchy, dyb bas uden tab af detaljer",
     "bias": "positive",
     "key": "punchy_bass",
     "groupId": "6902e126-cd9e-4297-a652-c75b3d60e1f0"
    },
    "comfortable for extended listening": {
     "sentimentAnalysis": "Flere anmeldelser beskriver behagelig brug i flere timer eller under lange lytteøkter.",
     "simpleTitle": "Komfortabel ved lang tids lytning",
     "bias": "positive",
     "key": "long_term_comfort",
     "groupId": "c5790135-99e6-4955-a479-ab35c0c67907"
    },
    "premium materials and attractive design": {
     "sentimentAnalysis": "Hovedtelefonen roses konsekvent for solid konstruktion, luksuriøse materialer og et tidløst udtryk.",
     "simpleTitle": "Førsteklasses materialer og attraktivt design",
     "bias": "positive",
     "key": "premium_build",
     "groupId": "302db9e5-e74b-4077-ac2a-9cda1728b5c6"
    },
    "burn-in can improve the sound over time": {
     "sentimentAnalysis": "Flere ejere oplever, at gengivelsen blev mere behagelig, afbalanceret eller åben efter længere tilspilning.",
     "simpleTitle": "Tilspilning kan forbedre lyden over tid",
     "bias": "positive",
     "key": "burn_in_improvement",
     "groupId": "56d9bb91-9719-43bd-bf84-adbce93001d0"
    },
    "a good amplifier can reveal more performance": {
     "sentimentAnalysis": "Anmeldelser tyder på, at god forstærkning kan udvide lydbilledet, stramme bassen op og forbedre klarheden, især ved højere lydstyrke.",
     "simpleTitle": "En god forstærker kan frigøre mere ydelse",
     "bias": "positive",
     "key": "amplifier_scaling",
     "groupId": "56d9bb91-9719-43bd-bf84-adbce93001d0"
    },
    "some listeners find the treble too subdued or uneven": {
     "sentimentAnalysis": "To anmeldelser kritiserer en mørk eller ujævn diskant, i kontrast til andre lytteres præference for blødere højder.",
     "simpleTitle": "Nogle lyttere synes, at diskanten er for tilbagetrukket eller ujævn",
     "bias": "negative",
     "key": "treble_variation",
     "groupId": "6902e126-cd9e-4297-a652-c75b3d60e1f0"
    },
    "the headband can press on larger heads": {
     "sentimentAnalysis": "To anmeldelser peger på tryk fra hovedbøjlen som en komfortbegrænsning, især ved større hoveder eller lidt hårpolstring.",
     "simpleTitle": "Hovedbøjlen kan trykke på større hoveder",
     "bias": "negative",
     "key": "headband_pressure",
     "groupId": "c5790135-99e6-4955-a479-ab35c0c67907"
    }
   },
