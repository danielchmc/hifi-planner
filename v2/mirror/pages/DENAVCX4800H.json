  "displayBookDemo": true,
  "reviews": {
   "summary": "Denon AVC-X4800H roses bredt som en kraftfuld og alsidig AV-receiver, der leverer varm, detaljeret og omsluttende lyd til både musik og film. Den stærke forstærkning, fremragende surroundgengivelse, omfattende tilslutninger og gode rumkorrektionsmuligheder gør den til en markant opgradering fra ældre eller mindre kraftige modeller. Opsætningen er som regel overskuelig og enkel, men avanceret kalibrering kan kræve tålmodighed; Dirac Live koster ekstra, og enkelte kritiserer fjernbetjening, volumenkontrol, manglende tuner eller lejlighedsvise app- og kildeproblemer.",
   "headlines": {
    "warm, detailed sound for music and films": {
     "sentimentAnalysis": "Anmelderne beskriver gengivelsen som varm, kraftfuld, detaljeret, musikalsk og meget engagerende i både stereo og hjemmebiograf.",
     "simpleTitle": "Varm og detaljeret lyd til musik og film",
     "bias": "positive",
     "key": "sound",
     "groupId": "c32c9549-61a9-4c5b-b7fd-28b4a178b313"
    },
    "powerful amplification and immersive surround": {
     "sentimentAnalysis": "Receiveren roses gentagne gange for store effektreserver, bedre højttalerkontrol, kontant bas og overbevisende Dolby Atmos- eller multikanalslyd.",
     "simpleTitle": "Kraftig forstærkning og omsluttende surround",
     "bias": "positive",
     "key": "power",
     "groupId": "a10c4067-96d0-43ac-9fdb-e5d05b3eec34"
    },
