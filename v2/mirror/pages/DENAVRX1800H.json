    },
    "rich, spacious and powerful sound": {
     "sentimentAnalysis": "Anmeldelserne roser den detaljerede, levende og rummelige lyd samt den stærke surround-, Atmos- og basgengivelse.",
     "simpleTitle": "Fyldig, rummelig og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
