  "reviews": {
   "summary": "DENAVRX1800HDAB bliver generelt rost som en kraftfuld, alsidig og prisvenlig receiver med varm, detaljeret og omsluttende lyd til musik, tv og hjemmebio. Opsætningen er ofte enkel takket være den forbedrede assistent, appen og fjernbetjeningen, selv om de mange Audyssey- og konfigurationsmuligheder kan virke forvirrende og nogle gange kræver ekstra hjælp. Streaming, HDMI 2.1, multiroom-funktioner og udvidelsesmuligheder er klare fordele, mens DAB-modtagelse, software og enkelte tilslutningsdetaljer kan være ustabile.",
   "headlines": {
    "warm, detailed and powerful sound": {
     "sentimentAnalysis": "Musik, tv- og surroundlyd beskrives som klar, omsluttende og kraftfuld med tydelige forbedringer i forhold til ældre receivere.",
     "simpleTitle": "Varm, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "a8edcc0b-6ab6-4a9f-9d76-34e8517ef51f"
    },
    "installation is usually easy": {
     "sentimentAnalysis": "Opsætningsassistenten, vejledningen, appen og fjernbetjeningen gør installation og daglig betjening enkel for mange brugere.",
     "simpleTitle": "Opsætningen er som regel enkel",
     "bias": "positive",
     "key": "setup",
     "groupId": "90c35198-b0d9-4b7e-9314-3f02b64f5ee6"
    },
    "modern HDMI and streaming support": {
     "sentimentAnalysis": "Streamingtjenester, Spotify, HEOS, HDMI 2.1, 4K/120 Hz og multiroom-afspilning giver alsidig og fremtidssikret tilslutning.",
     "simpleTitle": "Moderne HDMI- og streamingunderstøttelse",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "e4d3ae26-7618-4f19-98e1-4ca8e2731b1b"
    },
    "many settings make setup complicated": {
     "sentimentAnalysis": "Selv om grundopsætningen kan være enkel, giver avanceret konfiguration, Audyssey-indmåling og mangelfuld trykt vejledning nogle brugere en indlæringskurve.",
     "simpleTitle": "Mange indstillinger gør opsætningen vanskeligere",
     "bias": "negative",
     "key": "setup",
     "groupId": "90c35198-b0d9-4b7e-9314-3f02b64f5ee6"
    },
    "dab reception depends on the antenna and location": {
     "sentimentAnalysis": "DAB fungerer godt i nogle installationer, men slet ikke i andre; en kraftigere antenne anbefales for bedre modtagelse.",
     "simpleTitle": "DAB-modtagelsen afhænger af antenne og placering",
     "bias": "meh",
     "key": "radio",
     "groupId": "4cc2fceb-c8d1-43a7-9f13-204d20185363"
    },
    "dialogue and level balancing can be difficult": {
     "sentimentAnalysis": "Nogle opsætninger kræver usædvanligt høj lydstyrke eller dynamikbehandling, mens filmdialoger kan være for lave og bassen svær at balancere.",
     "simpleTitle": "Dialoger og lydniveauer kan være svære at balancere",
     "bias": "negative",
     "key": "sound",
     "groupId": "a8edcc0b-6ab6-4a9f-9d76-34e8517ef51f"
    }
