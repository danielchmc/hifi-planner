     "bias": "positive",
     "key": "value_strong",
     "groupId": "8123f3ec-ff1e-405d-93e1-627f48a51c0b"
    },
    "clear, powerful sound for home cinema": {
     "sentimentAnalysis": "Medrivende surround, tydelige dialoger og kraftig bas gør receiveren særligt velegnet til hjemmebio.",
     "simpleTitle": "Klar og kraftfuld lyd til hjemmebio",
     "bias": "positive",
     "key": "sound_cinema",
     "groupId": "767dfab0-feee-4494-87af-34c539298a55"
    },
    "easy installation and operation": {
     "sentimentAnalysis": "En enkel opsætning, intuitiv betjening og nyttig kalibrering gør receiveren let at bruge for mange forskellige brugere.",
     "simpleTitle": "Nem opsætning og betjening",
     "bias": "positive",
     "key": "setup_easy",
