  "reviews": {
   "summary": "Denon DCD-1700NE roses bredt som en førsteklasses CD/SACD-afspiller med varm, detaljeret, dynamisk og omsluttende lyd, et støjsvagt drev og solid japansk konstruktion. SACD'er og almindelige CD'er får en rummelig og naturlig gengivelse med kontrolleret bas, klare mellemtoner og høj opløsning, især i et kapabelt anlæg. De vigtigste forbehold gælder den sparsomme tilslutning, den manglende eject-knap på fjernbetjeningen, små eller begrænsede displays samt enkelte upraktiske designvalg, men den samlede dom er meget begejstret.",
   "headlines": {
    "missing eject button on the remote": {
     "sentimentAnalysis": "Manglen på åbne/lukke-funktion på fjernbetjeningen er den mest gennemgående betjeningskritik.",
     "simpleTitle": "Manglende eject-knap på fjernbetjeningen",
     "bias": "negative",
     "key": "usability",
     "groupId": "5c472bf2-4371-4d5c-bc0e-2223934f9208"
    },
    "warm, detailed and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en fyldig og omsluttende gengivelse med stor lydboble, naturlige stemmer og mange detaljer.",
     "simpleTitle": "Varm, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "fb007fd8-4c60-4301-8604-eae7134c0e5c"
    },
    "strong bass, dynamics and resolution": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den velkontrollerede eller stramme bas, den kraftfulde dynamik og den forbedrede opløsning sammenlignet med ældre afspillere.",
     "simpleTitle": "Kontant bas, dynamik og opløsning",
     "bias": "positive",
     "key": "sound",
     "groupId": "fb007fd8-4c60-4301-8604-eae7134c0e5c"
    },
    "quiet, solid and premium construction": {
     "sentimentAnalysis": "Afspilleren beskrives gentagne gange som robust, velbygget og usædvanligt støjsvag i drift.",
     "simpleTitle": "Støjsvag, solid og førsteklasses konstruktion",
     "bias": "positive",
     "key": "build",
     "groupId": "4b417ffa-9f86-49e3-8c87-22255e69c100"
    },
    "limited connectivity and features": {
     "sentimentAnalysis": "Nogle ejere synes, at manglen på digitale indgange, USB, HDMI eller hovedtelefonudgang er sparsomt for prisen, mens andre passer den analoge fokusering.",
     "simpleTitle": "Begrænsede tilslutninger og funktioner",
     "bias": "negative",
     "key": "features",
     "groupId": "57f00e61-f318-4f42-8b21-2e421dc8ca5a"
    }
   },
