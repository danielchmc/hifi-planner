  "reviews": {
   "summary": "Denon DCD-1700NE roses bredt for sin varme, detaljerede, dynamiske og rummelige lyd fra både CD og SACD med stram bas, naturlige stemmer og høj opløsning. Den solide konstruktion, det støjsvage drev og den japanske kvalitetsbygning understøtter indtrykket af en langsigtet high-end-investering. De største indvendinger er den manglende eject-knap på fjernbetjeningen, begrænset digital tilslutning og enkelte særheder ved display og betjening, men den fremragende musikgengivelse er den klare hovedoplevelse.",
   "headlines": {
    "missing eject button and limited inputs": {
     "sentimentAnalysis": "Flere anmeldelser kritiserer den manglende åbn/luk-funktion på fjernbetjeningen og de få tilslutningsmuligheder, især fraværet af digitale, USB- og hovedtelefonudgange.",
     "simpleTitle": "Manglende eject-knap og få tilslutninger",
     "bias": "negative",
     "key": "controls",
     "groupId": "3bea0ea9-af88-4fa3-9157-8a62d746ae2c"
    },
    "warm, detailed and spacious sound": {
     "sentimentAnalysis": "Anmelderne roser den store, varme og meget detaljerede gengivelse med naturlige stemmer og stærk musikalsk tilstedeværelse.",
     "simpleTitle": "Varm, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "3758584f-89b2-4e8a-b591-b62469fe9f56"
    },
    "tight bass and powerful dynamics": {
     "sentimentAnalysis": "Basområdet beskrives som kontrolleret og fyldigt, mens dynamik, detaljer og kraft får optagelserne til at leve.",
     "simpleTitle": "Stram bas og kraftfuld dynamik",
     "bias": "positive",
     "key": "sound",
     "groupId": "3758584f-89b2-4e8a-b591-b62469fe9f56"
    },
    "solid, quiet construction": {
     "sentimentAnalysis": "Det tunge kabinet med premiumfornemmelse og det usædvanligt støjsvage drev fremhæves gentagne gange som store styrker.",
     "simpleTitle": "Solid og støjsvag konstruktion",
     "bias": "positive",
