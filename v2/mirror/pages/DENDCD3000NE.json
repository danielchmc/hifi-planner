  "reviews": {
   "summary": "Denon DCD-3000NE leverer en varm, detaljeret og medrivende lyd med særligt imponerende CD- og SACD-gengivelse. Den raffinerede, rolige gengivelse, den kraftige DAC og den usædvanligt solide konstruktion giver ægte high-end-fornemmelse. Premiumprisen anses generelt for berettiget, selv om en anmeldelse rapporterer en hørbar mekanisk summen under stille passager i begyndelsen af visse discs.",
   "headlines": {
    "detailed and refined sound": {
     "sentimentAnalysis": "Anmeldelserne roser den meget detaljerede, raffinerede, neutrale og rolige gengivelse med en oplevelse af større åbenhed og klarhed.",
     "simpleTitle": "Detaljeret og raffineret lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "8c1ccea7-5db3-41b2-99ac-20df8935d6fc"
    },
    "excellent CD and SACD playback": {
     "sentimentAnalysis": "CD- og SACD-afspilningen beskrives gentagne gange som kraftfuld, smuk og usædvanligt klar, og opskaleringen af Red Book-CD'er roses især.",
     "simpleTitle": "Fremragende CD- og SACD-afspilning",
     "bias": "positive",
     "key": "disc-playback",
     "groupId": "204e43bf-0b1a-456e-bd81-608e41709d86"
    },
    "high price justified by performance": {
     "sentimentAnalysis": "Trods den betydelige pris anses ydelse, lydkvalitet og konstruktion for mere end investeringen værd.",
     "simpleTitle": "Den høje pris berettiges af ydelsen",
     "bias": "positive",
     "key": "value",
     "groupId": "07bda46e-d8c6-4834-815e-11672d012fe8"
    },
    "exceptionally solid construction": {
     "sentimentAnalysis": "Det tunge metalchassis, de solide knapper og den smidige skuffemekanisme giver et eksklusivt og holdbart indtryk.",
     "simpleTitle": "Usædvanligt solid konstruktion",
     "bias": "positive",
