  "reviews": {
   "summary": "Denon DCD-3000NE roses bredt for sin varme, meget detaljerede og raffinerede lyd fra både CD og SACD samt fremragende opskalering og en meget kompetent DAC. Solid japansk konstruktion, førsteklasses materialer og smidig betjening understøtter high-end-indtrykket. Den høje pris anses generelt for rimelig, selv om én anmeldelse beskriver en uacceptabel brummen under stille passager i starten.",
   "headlines": {
    "detailed, refined and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver gengivelsen som fantastisk, raffineret, rolig, detaljeret, neutral og usædvanligt klar.",
     "simpleTitle": "Detaljeret, raffineret og immersiv lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "a3cf00cc-7357-4c5c-a15a-2d39b93dcdda"
    },
    "excellent CD and SACD playback": {
     "sentimentAnalysis": "Begge diskformater roses gentagne gange, hvor SACD beskrives som smuk og CD-afspilning som enestående.",
     "simpleTitle": "Fremragende CD- og SACD-afspilning",
     "bias": "positive",
     "key": "formats",
     "groupId": "ba34030f-5dd6-440c-bb08-6f8d0250dc54"
    },
    "premium price feels justified": {
     "sentimentAnalysis": "Trods den betydelige pris mener flere anmeldelser, at ydeevne og kvalitet er investeringen værd.",
     "simpleTitle": "Premiumprisen føles berettiget",
     "bias": "positive",
     "key": "value",
     "groupId": "1f6d55c2-1c70-44fb-b681-90d8f3b7ca1b"
    },
    "heavy, premium construction": {
     "sentimentAnalysis": "Afspilleren forbindes konsekvent med robust japansk teknik, tungt metal og betryggende solide knapper og mekanik.",
     "simpleTitle": "Tung og førsteklasses konstruktion",
     "bias": "positive",
     "key": "build",
     "groupId": "c182fed4-761f-4b35-8553-6f60fd5cad79"
    },
    "effective CD upscaling and strong DAC": {
     "sentimentAnalysis": "CD-opskalering siges at fjerne et slør fra musikken, mens den integrerede DAC anses for at være fremragende.",
     "simpleTitle": "Effektiv CD-opskalering og stærk DAC",
     "bias": "positive",
     "key": "sound",
     "groupId": "a3cf00cc-7357-4c5c-a15a-2d39b93dcdda"
    }
