  "reviews": {
   "summary": "Denon DCD-600NE roses bredt som en vellydende, driftssikker og prisvenlig cd-afspiller. Anmeldelserne fremhæver især den rene, detaljerede og naturlige lyd, den enkle betjening, den flotte konstruktion og den tydelige forbedring i forhold til ældre afspillere. Enkelte kritiserer det mørke eller begrænsede display, den langsomme indlæsning og den overfyldte fjernbetjening med manglende knapper.",
   "headlines": {
    "simple and convenient operation": {
     "sentimentAnalysis": "Afspilleren beskrives gentagne gange som nem at tilslutte, enkel at betjene og fri for unødvendige funktioner.",
     "simpleTitle": "Enkel og bekvem betjening",
     "bias": "positive",
     "key": "ease-of-use",
     "groupId": "f910b669-2809-4618-ac0f-ddd15a9407d7"
    },
    "strong value for the money": {
     "sentimentAnalysis": "DCD-600NE opfattes konsekvent som overkommelig, rimeligt prissat og usædvanligt kapabel i sin prisklasse.",
     "simpleTitle": "Stærk værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "e48b2e85-6b88-4671-81f0-ddbfb2554599"
    },
    "clean, detailed and natural sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver lyden som ren, klar, detaljeret, naturlig, transparent og behagelig og fremhæver ofte en tydelig forbedring i forhold til ældre cd-afspillere.",
     "simpleTitle": "Ren, detaljeret og naturlig lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "fa90f031-fd2c-4724-9bf4-349d83d2a3bd"
    },
    "attractive and solid construction": {
     "sentimentAnalysis": "Anmeldelserne roser det elegante udseende, den solide fornemmelse, den gode finish og den driftssikre konstruktion.",
     "simpleTitle": "Flot og solid konstruktion",
     "bias": "positive",
     "key": "design-build",
     "groupId": "a04969fa-3fd6-4b62-a636-b02f050e1cea"
    },
    "display and remote controls have limitations": {
     "sentimentAnalysis": "Flere anmeldelser kritiserer det mørke eller begrænsede display og nævner upraktiske fjernbetjeninger, blandt andet manglende skuffeknapper eller dårlig integration med andet Denon-udstyr.",
     "simpleTitle": "Begrænsninger ved display og fjernbetjening",
     "bias": "negative",
     "key": "ease-of-use",
     "groupId": "f910b669-2809-4618-ac0f-ddd15a9407d7"
    },
    "disc loading can be slow": {
     "sentimentAnalysis": "Enkelte anmeldelser nævner langsom åbning af skuffen eller cd-start, men problemet betragtes generelt som mindre.",
     "simpleTitle": "Indlæsning af cd'er kan være langsom",
     "bias": "negative",
     "key": "ease-of-use",
     "groupId": "f910b669-2809-4618-ac0f-ddd15a9407d7"
    }
   },
