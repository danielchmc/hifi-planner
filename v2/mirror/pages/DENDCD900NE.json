  "reviews": {
   "summary": "Denon DCD-900NE bliver bredt betragtet som en CD-afspiller med fremragende værdi for pengene og en klar, detaljeret, varm og dynamisk lyd, der ofte giver gamle CD-samlinger nyt liv. Enkel betjening, støjsvag afspilning, solid konstruktion og et design, der passer godt sammen med Denon-forstærkere, er gennemgående styrker, mens USB-afspilning giver ekstra fleksibilitet. Typiske kritikpunkter er det lille eller enkle display, langsom indlæsning af CD'er, manglende eject-knap på fjernbetjeningen samt lejlighedsvis kritik af fjernbetjening, skuffe eller begrænsede funktioner.",
   "headlines": {
    "clear, detailed and dynamic sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent en ren, transparent og musikalsk gengivelse med mange detaljer, god dynamik, kontrolleret bas og et godt stereoperspektiv. Flere sammenligninger viser, at afspilleren forbedrer ældre CD-afspillere og giver velkendte indspilninger nyt liv.",
     "simpleTitle": "Klar, detaljeret og dynamisk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "bd102620-17d1-4d8e-a693-bab23a632eae"
    },
    "simple operation and quiet playback": {
     "sentimentAnalysis": "Afspilleren beskrives gentagne gange som nem at tilslutte og betjene med et støjsvagt drev og pålidelig daglig funktion.",
     "simpleTitle": "Enkel betjening og støjsvag afspilning",
     "bias": "positive",
     "key": "operation",
     "groupId": "bbea6480-e6d6-41d3-8a1b-078e664edb11"
    },
    "useful USB high-resolution playback": {
     "sentimentAnalysis": "USB-afspilning roses for understøttelse af FLAC, MP3, WAV, DSD og hi-res-filer, selv om nogle anmeldelser nævner enkel navigation og begrænsning til FAT16/FAT32.",
     "simpleTitle": "Nyttig USB-afspilning i høj opløsning",
     "bias": "positive",
     "key": "usb",
     "groupId": "a64829bb-d864-482c-8ff5-fcc747cfb85d"
    },
    "small display and missing remote eject": {
     "sentimentAnalysis": "Flere anmeldelser synes, at displayet er for lille eller enkelt, og savner gentagne gange en eject-knap på fjernbetjeningen; langsom indlæsning og begrænset nummerstyring nævnes også.",
     "simpleTitle": "Lille display og manglende eject-knap",
     "bias": "negative",
     "key": "operation",
     "groupId": "bbea6480-e6d6-41d3-8a1b-078e664edb11"
    }
   },
