  "reviews": {
   "summary": "Denon DENDHTS218 roses bredt for varm, klar og overraskende kraftfuld lyd til en attraktiv pris samt en markant forbedring i forhold til TV’ets indbyggede højttalere. Dialoger, musik, film og sport får et fyldigere og mere rummeligt lydbillede, mens den nemme installation og subwoofer-udgangen giver ekstra fleksibilitet. Enkelte anmeldelser nævner lejlighedsvise forbindelses- eller opstartsproblemer, begrænset dybbas uden en ekstern subwoofer samt skuffende support ved et defekt HDMI-kabel.",
   "headlines": {
    "a major upgrade over TV sound": {
     "sentimentAnalysis": "Soundbaren gør TV-lyden markant klarere, fyldigere og mere behagelig end de indbyggede TV-højttalere.",
     "simpleTitle": "En markant forbedring i forhold til TV-lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "0df211d9-b1b9-473e-8fe3-089e6e0a753f"
    },
    "clear, spacious and powerful presentation": {
     "sentimentAnalysis": "Anmeldelserne fremhæver tydelig dialog, god spredning, stærk dynamik og en fyldig, omsluttende klangbalance til både film og musik.",
     "simpleTitle": "Klar, rummelig og kraftfuld lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "0df211d9-b1b9-473e-8fe3-089e6e0a753f"
    },
    "external subwoofer support adds flexibility": {
     "sentimentAnalysis": "Subwoofer-udgangen værdsættes, fordi eksisterende subwoofere kan genbruges, og lydplankens basgengivelse kan udvides.",
     "simpleTitle": "Understøttelse af ekstern subwoofer giver fleksibilitet",
     "bias": "positive",
     "key": "bass",
     "groupId": "39763f45-84d9-490e-a58b-b72b5c580169"
    },
    "occasional connection and startup issues": {
     "sentimentAnalysis": "Nogle brugere oplever, at soundbaren lejlighedsvis mister forbindelsen eller ikke tænder sammen med TV’et.",
     "simpleTitle": "Lejlighedsvise forbindelses- og opstartsproblemer",
     "bias": "negative",
     "key": "installation",
     "groupId": "54a51e5a-1ef5-482f-9dfc-4e25b2aa9a58"
    },
    "deepest bass is limited without a subwoofer": {
     "sentimentAnalysis": "Bassen er generelt til stede og tilfredsstillende, men de dybeste frekvenser matcher muligvis ikke et dedikeret surroundsystem eller en subwoofer.",
     "simpleTitle": "Den dybeste bas er begrænset uden subwoofer",
     "bias": "negative",
     "key": "bass",
     "groupId": "39763f45-84d9-490e-a58b-b72b5c580169"
    }
   },
