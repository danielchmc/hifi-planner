  "displayBookDemo": true,
  "reviews": {
   "summary": "Denon DNP-2000NE roses bredt som en førsteklasses og solidt bygget netværksafspiller og DAC med varm, detaljeret, rummelig og meget musikalsk lyd. Streaming, digitale indgange, HDMI ARC og den brede understøttelse af kilder gør enheden særdeles alsidig, mens stabil netværksdrift og enkel opsætning styrker helhedsindtrykket. HEOS-oplevelsen, det begrænsede display og enkelte manglende funktioner som Roon Ready og subwooferudgang gør, at produktet ikke er fejlfrit, men den samlede vurdering er særdeles begejstret.",
   "headlines": {
    "exceptional, spacious sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en markant opgradering med detaljeret, tredimensionel, klar og meget musikalsk lyd, især fra højopløselige kilder.",
     "simpleTitle": "Fremragende, rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "044e744d-2f80-4e6f-a62d-2c15a5589a20"
    },
    "simple setup and versatile sources": {
     "sentimentAnalysis": "Afspilleren værdsættes for enkel opsætning, stabil streaming, HDMI ARC, USB- og digitaltilslutninger, Bluetooth og bred kildekompatibilitet.",
     "simpleTitle": "Enkel opsætning og alsidige kilder",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "86c72601-e33e-4841-9aec-fa5f5b729ec9"
    },
    "heos and controls need refinement": {
     "sentimentAnalysis": "Flere anmeldelser oplever HEOS eller betjeningen på enheden som lidt besværlig, selv om appen og fjernbetjeningen fungerer godt efter tilvænning.",
     "simpleTitle": "HEOS og betjeningen kan forbedres",
     "bias": "negative",
     "key": "usability",
     "groupId": "3ce8da58-f4d4-4ddd-b7fa-63e6dc34d665"
    },
    "the display is dated and lacks album art": {
     "sentimentAnalysis": "Displayet er tydeligt og diskret, men flere anmeldelser kritiserer den lille, monokrome og ikke moderne visning samt manglende coverbilleder.",
     "simpleTitle": "Displayet virker forældet og mangler coverbilleder",
     "bias": "negative",
     "key": "display",
     "groupId": "1b2037ba-6b4f-40f6-8449-0b0375373161"
    },
    "solid, premium construction": {
     "sentimentAnalysis": "Anmeldelserne roser den høje vægt, det flotte Denon-design og den solide kvalitet, som passer godt ind i matchende anlæg.",
     "simpleTitle": "Solid og eksklusiv konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "5123ccdf-959a-4d02-998c-6b2ee356651f"
    }
   },
