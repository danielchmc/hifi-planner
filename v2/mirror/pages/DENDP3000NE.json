  "reviews": {
   "summary": "Denon DP-3000NE roses bredt som en førsteklasses pladespiller med smuk konstruktion, enestående rolig og stabil drift samt præcis udførelse. Vinylgengivelsen beskrives som varm, detaljeret, musikalsk og medrivende, især sammen med en god pickup, mens direct drive-systemet giver hurtig start og stop. Nem justering, fleksibilitet med pickupper og mulighed for opgradering giver ekstra værdi og gør investeringen attraktiv for krævende lyttere.",
   "headlines": {
    "premium construction and finish": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent pladespilleren for at være solid, elegant, præcis og særdeles veludført.",
     "simpleTitle": "Førsteklasses konstruktion og finish",
     "bias": "positive",
     "key": "build",
     "groupId": "7996490c-b59d-4d9c-ac90-5b61de46ed5f"
    },
    "detailed, full and musical sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en fyldigere, mere lagdelt, detaljeret og meget musikalsk vinylgengivelse.",
     "simpleTitle": "Detaljeret, fyldig og musikalsk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "692cc708-b951-4f5b-8f97-4aa00c14deb0"
    },
    "excellent sound with a suitable cartridge": {
     "sentimentAnalysis": "Flere anmeldelser forbinder den fremragende og sensationelle lyd med brugen af en god pickup.",
     "simpleTitle": "Fremragende lyd med en passende pickup",
     "bias": "positive",
     "key": "sound",
     "groupId": "692cc708-b951-4f5b-8f97-4aa00c14deb0"
