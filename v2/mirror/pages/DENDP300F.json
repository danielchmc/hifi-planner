  "reviews": {
   "summary": "Denon DP-300F roses bredt som en prisvenlig, flot og meget brugervenlig fuldautomatisk pladespiller. Lyden beskrives generelt som klar, afbalanceret og behagelig, især med en bedre pickup. Enkelte anmeldelser nævner en let plastagtig finish, faste eller korte kabler og følsom justering, men samlet leverer spilleren varm, fyldig og medrivende vinyllyd med stor bekvemmelighed og værdi for pengene.",
   "headlines": {
    "clear, enjoyable sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver typisk lyden som klar, afbalanceret, fyldig og behagelig, især efter opgradering af pickup.",
     "simpleTitle": "Klar og behagelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "d592016a-0cae-4e66-913a-fb1c5c7c4d2b"
    },
    "excellent value for the money": {
     "sentimentAnalysis": "Pladespilleren opfattes konsekvent som et stærkt køb til prisen med praktisk automatik, god lyd og solid hverdagsydelse.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "3147747a-0593-4ae8-9dc9-9777ee015556"
    },
    "automatic start and return are highly convenient": {
     "sentimentAnalysis": "Automatisk start, stop og retur af armen roses gentagne gange for at gøre afspilning nem og sikker, især for begyndere og familier.",
     "simpleTitle": "Automatisk start og retur er meget praktisk",
     "bias": "positive",
     "key": "automation",
     "groupId": "c9f4f550-da19-4e9b-ad37-d60bd46de3a9"
    },
    "easy installation and operation": {
     "sentimentAnalysis": "De fleste brugere finder montering, tilslutning og daglig betjening enkel, og vejledningen giver som regel tilstrækkelig hjælp.",
     "simpleTitle": "Nem opsætning og betjening",
     "bias": "positive",
     "key": "setup",
     "groupId": "8dd51ad2-0395-423d-be1e-6e79706167de"
    },
    "lightweight build and cable limitations": {
     "sentimentAnalysis": "En mindre del af anmeldelserne kritiserer den lette plastfornemmelse, faste eller korte lydkabler samt manglen på en armlås under transport.",
     "simpleTitle": "Let konstruktion og begrænsede kabler",
     "bias": "negative",
     "key": "design",
     "groupId": "a68fecfc-cee3-4354-b268-cbba7d78bda4"
    }
   },
