  "displayBookDemo": true,
  "reviews": {
   "summary": "DENDP400 roses bredt for varm, detaljeret og medrivende lyd, attraktivt design, nem opsætning og intuitiv betjening. Automatisk stop, afspilning ved 78 omdrejninger og fleksible tilslutningsmuligheder giver ekstra praktisk værdi, mens forholdet mellem pris og ydelse vurderes som fremragende. Det løse støvlåg og den begrænsede støvbeskyttelse kritiseres gentagne gange, og nogle lyttere anbefaler en bedre pickup eller en kraftigere RIAA-forforstærker for maksimal ydelse.",
   "headlines": {
    "easy assembly and intuitive operation": {
     "sentimentAnalysis": "Montering, justering af pickup og daglig betjening beskrives generelt som ligetil og brugervenlig.",
     "simpleTitle": "Nem montering og intuitiv betjening",
     "bias": "positive",
     "key": "setup_easy",
     "groupId": "048ce8c8-eef2-4c5e-8f56-aa4668ccad75"
    },
    "the dust cover leaves parts exposed": {
     "sentimentAnalysis": "Det løse, åbne låg kritiseres for at lade støv komme ned på pladetallerkenen og for ikke at give beskyttelsen fra et traditionelt fast låg.",
     "simpleTitle": "Støvlåget efterlader dele ubeskyttede",
     "bias": "negative",
     "key": "dust_protection",
     "groupId": "d6906081-d0c3-4232-b71d-d585c7e8625e"
    },
    "warm, rich and highly enjoyable sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver gengivelsen som varm, fyldig, rig og medrivende, så vinylsamlinger lyder mere engagerende og fornøjelige.",
     "simpleTitle": "Varm, fyldig og meget fornøjelig lyd",
     "bias": "positive",
     "key": "sound_warm",
     "groupId": "5a7f1db8-7858-4837-a505-b75137587466"
    },
    "stylish design that attracts attention": {
     "sentimentAnalysis": "Den usædvanlige form på støvlåget og det samlede design opleves ofte som attraktivt, moderne og velegnet til at stå fremme.",
     "simpleTitle": "Stilfuldt design, der tiltrækker opmærksomhed",
     "bias": "positive",
     "key": "design_style",
     "groupId": "d6906081-d0c3-4232-b71d-d585c7e8625e"
    },
    "upgrading the cartridge can improve performance": {
     "sentimentAnalysis": "Flere anmeldelser fortæller om eller anbefaler en pickup-opgradering med bedre klarhed og ydelse end den medfølgende pickup.",
     "simpleTitle": "En bedre pickup kan forbedre ydelsen",
     "bias": "positive",
     "key": "cartridge_upgrade",
     "groupId": "5a7f1db8-7858-4837-a505-b75137587466"
    },
    "automatic stop is a useful feature": {
     "sentimentAnalysis": "Automatisk stop fremhæves gentagne gange som praktisk og som en grund til at vælge pladespilleren.",
     "simpleTitle": "Automatisk stop er en nyttig funktion",
     "bias": "positive",
     "key": "auto_stop",
     "groupId": "de37e955-c9c7-42db-b9d1-84ab79f50002"
    }
   },
