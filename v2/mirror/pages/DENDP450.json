  "reviews": {
   "summary": "DENDP450 opfattes generelt som en velbygget, stilfuld og brugervenlig pladespiller med varm, klar og behagelig lyd. USB-optagelse samt automatisk lift- og stopfunktion giver ekstra komfort, selv om støvlåget kun beskytter delvist mod støv, og enkelte betjeningselementer kunne forbedres. Nogle brugere nævner også problemer med betjening af tonearmen, et for lavt USB-optageniveau eller mindre udfordringer med opsætning og software.",
   "headlines": {
    "warm, clear and enjoyable sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver lyden som god, fantastisk, ren og meget behagelig, også med ældre plader.",
     "simpleTitle": "Varm, klar og behagelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "3e56450e-21f2-4ef0-9baa-f0ded0bf79a7"
    },
    "usb digitisation is convenient": {
     "sentimentAnalysis": "USB-porten gør det nemt og attraktivt at optage plader på en USB-nøgle.",
     "simpleTitle": "USB-digitalisering er praktisk",
     "bias": "positive",
     "key": "usb",
     "groupId": "f11144d5-2f00-4f19-8467-c4cbc003e7d9"
    },
    "the dust cover leaves parts exposed": {
     "sentimentAnalysis": "Flere anmeldelser oplever det stilfulde låg som ufuldstændigt eller ineffektivt mod støv, og det frarådes at lade en plade ligge på pladespilleren.",
     "simpleTitle": "Støvlåget efterlader dele ubeskyttede",
     "bias": "negative",
     "key": "dustcover",
     "groupId": "ae2c339b-cbd4-4c8f-8410-d54f8a956d8d"
    },
    "usb recording level can be too low": {
     "sentimentAnalysis": "En anmeldelse ønsker et højere niveau på den digitaliserede udgang, mens en anden har problemer med at få den tilhørende software.",
     "simpleTitle": "USB-optageniveauet kan være for lavt",
     "bias": "negative",
     "key": "usb",
     "groupId": "f11144d5-2f00-4f19-8467-c4cbc003e7d9"
    },
    "automatic lift and stop add convenience": {
     "sentimentAnalysis": "Automatisk stop og lift roses som pålidelige og mere praktiske end fuldt manuel betjening.",
     "simpleTitle": "Automatisk lift og stop giver ekstra komfort",
     "bias": "positive",
     "key": "tonearm",
     "groupId": "559fe32a-e966-4b3f-a354-cb3fb3274937"
    },
