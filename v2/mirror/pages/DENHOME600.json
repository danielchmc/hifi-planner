  "reviews": {
   "summary": "DENHOME600 leverer en varm, kraftfuld og medrivende lyd med et imponerende bredt stereoperspektiv, selv med kun én højttaler. Streaming giver fremragende bekvemmelighed i hverdagen, mens det stilfulde design og den enkle betjening på enheden løfter helhedsoplevelsen. Appens stabilitet og forbindelser kan være frustrerende, men den kraftfulde og detaljerede lyd gør produktet meget attraktivt.",
   "headlines": {
    "excellent, powerful sound": {
     "sentimentAnalysis": "Lyden roses gentagne gange som fremragende, fyldig, dyb og kraftfuld, og især den stærke bas nævnes i en anmeldelse.",
     "simpleTitle": "Fremragende, kraftfuld lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "713fd87c-64c9-46a6-83e6-7579a6a5f491"
    },
    "broad, immersive stereo image": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den brede, rumfyldende lyd, den forbedrede dybde og den mere tilfredsstillende stereogengivelse, især med to højttalere.",
     "simpleTitle": "Bredt, medrivende stereoperspektiv",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "713fd87c-64c9-46a6-83e6-7579a6a5f491"
    },
    "app and connection problems": {
     "sentimentAnalysis": "Flere anmeldelser beskriver en uoverskuelig eller ustabil app, en equalizer der ikke fungerer, samt ustabile forbindelser inklusive Bluetooth-udfald.",
     "simpleTitle": "Problemer med app og forbindelse",
     "bias": "negative",
     "key": "app_connectivity",
