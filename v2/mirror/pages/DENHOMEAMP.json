  "reviews": {
   "summary": "DENHOMEAMP leverer varm, ren og slagkraftig lyd med rigeligt overskud og giver en medrivende opgradering til musik og tv. Opsætningen er generelt nem, og HEOS-streaming, multiroom-brug og den daglige betjening fungerer meget godt i de fleste systemer. Det kompakte design er særdeles praktisk, men skift mellem HDMI/eARC kan være ustabilt, appen har enkelte besværlige områder, og der følger ingen fjernbetjening med.",
   "headlines": {
    "warm, clean and powerful sound": {
     "sentimentAnalysis": "Anmelderne roser forstærkeren for klar, musikalsk og kraftfuld lyd til både musik og tv.",
     "simpleTitle": "Varm, ren og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "2a0d0fe8-ba01-4b35-a1ee-9df4381ec63c"
    },
    "easy HEOS streaming and control": {
     "sentimentAnalysis": "HEOS roses bredt for stabil streaming, multiroom-funktionalitet og enkel betjening.",
     "simpleTitle": "Nem HEOS-streaming og betjening",
     "bias": "positive",
     "key": "app",
     "groupId": "a549ffa0-3dff-4b11-bcf9-c95647c4ccfb"
    },
    "strong output for demanding speakers": {
     "sentimentAnalysis": "Forstærkeren vurderes at være kraftig nok til at drive større højttalere højt uden besvær.",
     "simpleTitle": "Stor effekt til krævende højttalere",
     "bias": "positive",
     "key": "power",
     "groupId": "dbe6789d-fe47-4e0f-b0be-21c443d2ee59"
    },
    "compact, attractive form factor": {
     "sentimentAnalysis": "Forstærkeren værdsættes for sit attraktive udseende og pladsbesparende format.",
     "simpleTitle": "Kompakt og attraktivt design",
     "bias": "positive",
     "key": "design",
     "groupId": "2f16812c-6943-48ab-acdf-7791539edceb"
    },
    "app interface can feel illogical": {
     "sentimentAnalysis": "Visse begrænsninger i betjening og equalizer gør appen mindre intuitiv ved detaljerede justeringer.",
     "simpleTitle": "Appens brugerflade kan virke ulogisk",
     "bias": "negative",
     "key": "app",
     "groupId": "a549ffa0-3dff-4b11-bcf9-c95647c4ccfb"
