  "reviews": {
   "summary": "Denon PMA-1700NE roses bredt for sin flotte byggekvalitet, kraftfulde ydelse og varme, fyldige og detaljerede lyd. Musikken får mere punch, dybde, kontrol og et medrivende lydbillede på tværs af højttalere og kilder, mens phono-trinnet, tilslutningerne og den automatiske skiftfunktion giver ekstra alsidighed. De største forbehold gælder den hurtige og upræcise lydstyrkeregulering på fjernbetjeningen, det begrænsede antal analoge indgange og den beskedne forskel fra ældre Denon-modeller, men den samlede vurdering er stadig meget begejstret.",
   "headlines": {
    "warm, powerful sound with strong detail and depth": {
     "sentimentAnalysis": "Anmelderne roser den varme, fyldige og energiske gengivelse, den kontrollerede bas, de klare højder, realistiske stemmer og den rummelige gengivelse.",
     "simpleTitle": "Varm og kraftfuld lyd med stor detaljegrad og dybde",
     "bias": "positive",
     "key": "sound",
     "groupId": "1a00e677-9768-4398-afec-e1ec194baac9"
    },
    "premium, solid construction": {
     "sentimentAnalysis": "Tunge materialer, aluminiumskonstruktion og omhyggelig forarbejdning giver forstærkeren et eksklusivt og holdbart indtryk.",
     "simpleTitle": "Eksklusiv og solid konstruktion",
     "bias": "positive",
     "key": "build",
     "groupId": "fb06ac32-682d-4c2d-823b-3dae9ed8a4d0"
    },
    "immersive soundstage and excellent musical balance": {
     "sentimentAnalysis": "Forstærkeren beskrives som medrivende og velafbalanceret med en overbevisende koncertagtig scene og tydelig adskillelse af instrumenter og frekvensområder.",
     "simpleTitle": "Medrivende lydbillede og fremragende musikalsk balance",
     "bias": "positive",
     "key": "sound",
     "groupId": "1a00e677-9768-4398-afec-e1ec194baac9"
    },
    "versatile inputs and useful automatic switching": {
     "sentimentAnalysis": "De mange tilslutninger, den automatiske indgangsskiftning og standby-funktionen ses som praktiske styrker ved integration i et større system.",
     "simpleTitle": "Alsidige indgange og praktisk automatisk skift",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "c9958326-a619-46b4-acc8-5434931eeed5"
    },
    "remote volume adjustment is too abrupt": {
     "sentimentAnalysis": "Flere anmeldelser oplever den motoriserede lydstyrkeregulering på fjernbetjeningen som for hurtig, så der opstår store spring, og finjustering bliver vanskelig.",
     "simpleTitle": "Lydstyrken ændres for brat med fjernbetjeningen",
     "bias": "negative",
     "key": "volume",
     "groupId": "5a57eb4d-bf24-4c3e-9bb5-1b5b5bb5c7d9"
    }
   },
