  "reviews": {
   "summary": "Denon PMA-1700NE leverer en varm, fyldig og meget detaljeret lyd med imponerende kraft, kontrolleret bas og et bredt, medrivende lydbillede. Den førsteklasses konstruktion, de mange tilslutninger, de praktiske phono- og digitalindgange samt den gode integration i forskellige hi-fi-anlæg gør forstærkeren til et fremragende valg. Lydstyrkereguleringen på fjernbetjeningen er for brat for nogle, og enkelte anmeldelser oplever kun en beskeden lydmæssig forbedring i forhold til ældre Denon-modeller, men den samlede vurdering er særdeles positiv.",
   "headlines": {
    "warm, powerful and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne roser den varme, fyldige og detaljerede gengivelse, den kontrollerede bas, de rene højder, den gode dynamik og det rummelige lydbillede.",
     "simpleTitle": "Varm, kraftfuld og medrivende lyd",
     "bias": "positive",
     "key": "warm powerful immersive sound",
     "groupId": "e932a934-0a53-4a34-bb99-1a4dddca9daa"
    },
    "high-end build quality": {
     "sentimentAnalysis": "Anmeldelserne beskriver samstemmende forstærkeren som solid, tung, eksklusiv og særdeles velbygget.",
     "simpleTitle": "Førsteklasses byggekvalitet",
     "bias": "positive",
     "key": "high end build",
     "groupId": "e1eca608-af97-47e5-bf1b-ad15835df2ce"
    },
    "excellent phono and digital connectivity": {
     "sentimentAnalysis": "Anmeldelserne værdsætter den indbyggede MM/MC-phono-forforstærker, digitalindgangene, den automatiske signalomskiftning og kompatibiliteten med cd-afspillere, streamere, tv og pladespillere.",
     "simpleTitle": "Fremragende phono- og digitaltilslutning",
     "bias": "positive",
     "key": "excellent connectivity",
     "groupId": "cca4723e-4d9a-4973-a594-cd3256c1ce7e"
    },
    "remote volume control is too abrupt": {
     "sentimentAnalysis": "Flere anmeldelser kritiserer, at fjernbetjeningen giver store lydstyrkespring og gør præcis regulering ved lav lydstyrke vanskelig.",
     "simpleTitle": "Fjernbetjeningens lydstyrke er for brat",
     "bias": "negative",
     "key": "abrupt volume control",
     "groupId": "987397f1-2459-4b4d-850e-669f9a0f8816"
    },
    "limited improvement over older Denon models": {
     "sentimentAnalysis": "To sammenligninger med ældre forstærkere rapporterer kun en lille hørbar forbedring; én anmeldelse oplever endda den ældre model som stærkere i bassen eller samlet set tilsvarende.",
     "simpleTitle": "Begrænset forbedring i forhold til ældre Denon-modeller",
     "bias": "negative",
     "key": "limited upgrade",
     "groupId": "e932a934-0a53-4a34-bb99-1a4dddca9daa"
    }
   },
