  "displayBookDemo": true,
  "reviews": {
   "summary": "Denon PMA-3000NE betragtes som en førsteklasses og usædvanligt solidt bygget forstærker med varm, silkeblød og meget detaljeret lyd. Den kraftfulde, stabile gengivelse, det brede stereoperspektiv og de fremragende resultater med både analoge og digitale kilder roses gentagne gange. Den store størrelse, den manglende Bluetooth-funktion og den automatiske standbyfunktion er kun mindre ulemper sammenlignet med den medrivende, slagkraftige og raffinerede musikgengivelse.",
   "headlines": {
    "warm, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en silkeblød, varm, kraftfuld og meget opløst gengivelse med transparente detaljer, dyb bas og en bred tredimensionel stereoscene.",
     "simpleTitle": "Varm, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "ac9d7ec9-6abf-458a-8edf-b48e2bcd05a1"
    },
    "ample power and stable speaker control": {
     "sentimentAnalysis": "Anmeldelserne fremhæver ubesværet styring, høj spidseffekt og stabil kontrol over krævende højttalere og frekvenser ved både lav og høj lydstyrke.",
     "simpleTitle": "Rigelig effekt og stabil højttalerstyring",
     "bias": "positive",
     "key": "power-and-drive",
     "groupId": "915dc89b-b320-4b67-a013-0cef9aaf36be"
    },
    "premium, substantial construction": {
     "sentimentAnalysis": "Forstærkeren roses for elegant og robust konstruktion samt en imponerende flagskibsudstråling, mens det store og tunge kabinet kræver god plads.",
     "simpleTitle": "Førsteklasses og massiv konstruktion",
     "bias": "positive",
     "key": "design-and-build",
     "groupId": "0c60a53e-e5ea-4c22-96e6-d8a2cff5df69"
    },
    "helpful, reliable retailer service": {
     "sentimentAnalysis": "Forhandlerens rådgivning, pris, levering og personlige service beskrives konsekvent som hjælpsom og pålidelig.",
     "simpleTitle": "Hjælpsom og pålidelig forhandlerservice",
     "bias": "positive",
     "key": "customer-service",
     "groupId": "4dc45a13-fec9-48ac-adb8-8754a06f6bbe"
    },
    "excellent analogue and digital sections": {
     "sentimentAnalysis": "Både analog og digital gengivelse vurderes som fremragende, med særlig ros til riaa-trinnet og DAC'en.",
     "simpleTitle": "Fremragende analog og digital del",
     "bias": "positive",
