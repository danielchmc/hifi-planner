  "displayBookDemo": true,
  "reviews": {
   "summary": "Denon PMA-3000NE leverer en varm, silkeblød og meget detaljeret lyd med et bredt, medrivende stereoperspektiv, dyb bas og kraftfuld kontrol over krævende højttalere. Byggekvaliteten føles enestående med et robust premiumdesign samt fremragende analog og digital gengivelse, herunder en højt rost RIAA-forstærker og DAC. Forstærkeren er stor og tung, og manglende funktioner som direkte Bluetooth samt en forbedret automatiske slukkefunktion er små ulemper sammenlignet med den fremragende musikgengivelse.",
   "headlines": {
    "warm, detailed and immersive sound": {
     "sentimentAnalysis": "Anmelderne roser den silkebløde, varme, klare og meget opløste gengivelse, det brede stereoperspektiv, den dybe bas og den engagerende musikalitet.",
     "simpleTitle": "Varm, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "f011172e-f3fb-445e-a285-b1c4283969ee"
    },
    "powerful control and ample headroom": {
     "sentimentAnalysis": "Anmeldelserne fremhæver ubesværet drift, høj spidseffekt, stabilitet over hele frekvensområdet og sikker kontrol over krævende højttalere.",
     "simpleTitle": "Kraftfuld kontrol og store reserver",
     "bias": "positive",
     "key": "power",
     "groupId": "aae996b2-d606-42cf-b420-f1da0f86e0de"
    },
    "premium, robust construction": {
     "sentimentAnalysis": "Forstærkeren beskrives gentagne gange som flot udført, robust, eksklusiv og imponerende solid.",
     "simpleTitle": "Eksklusiv og robust konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "3225cf84-55f0-442a-988d-be9abcec3bcb"
    },
    "large chassis needs generous space": {
     "sentimentAnalysis": "Det store og markante kabinet imponerer, men kræver meget plads og kan virke større end forventet.",
     "simpleTitle": "Det store kabinet kræver god plads",
     "bias": "meh",
     "key": "design",
     "groupId": "3225cf84-55f0-442a-988d-be9abcec3bcb"
    },
    "excellent analogue and digital performance": {
     "sentimentAnalysis": "Både analoge og digitale kilder får stor ros, især RIAA-forstærkeren og DAC'en.",
     "simpleTitle": "Fremragende analog og digital ydelse",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "5ca706b7-58d1-4099-b6f2-5edd0304150a"
    }
   },
