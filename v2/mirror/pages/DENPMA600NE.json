  "reviews": {
   "summary": "Denon PMA-600NE roses bredt som en varm, kraftfuld og detaljeret stereoforstærker med fremragende værdi for pengene. Bluetooth, phono-understøttelse og mange tilslutninger gør forstærkeren alsidig, mens solid konstruktion, flot design og enkel betjening styrker helhedsindtrykket. Enkelte ejere kritiserer det lille display, den besværlige fjernbetjening, manglende tonekontrol fra fjernbetjeningen, manglende tilslutning til passiv subwoofer eller lejlighedsvise fejl i phono-/forforstærkeren, men den samlede vurdering er meget positiv.",
   "headlines": {
    "exceptional value at the price": {
     "sentimentAnalysis": "Kombinationen af effekt, lydkvalitet, fleksibilitet og konstruktion vurderes gentagne gange som usædvanligt stærk i den prisvenlige klasse.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "f15fbce5-b0d7-4bdc-9fc5-e7d205ac6456"
    },
    "warm, powerful and detailed sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver gennemgående en varm, kontant, klar og omsluttende gengivelse med kraftig bas, gode detaljer og overbevisende dynamik fra vinyl, CD, Bluetooth og TV-lyd.",
     "simpleTitle": "Varm, kraftfuld og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "c8effa4d-6755-400a-84a5-ef32440aa9fa"
    },
    "bluetooth, phono and plentiful connections": {
     "sentimentAnalysis": "Bluetooth-parring beskrives gentagne gange som nem og stabil, mens phono-understøttelse samt mange analoge og digitale indgange gør forstærkeren til et fleksibelt centrum i anlægget.",
     "simpleTitle": "Bluetooth, phono og mange tilslutninger",
     "bias": "positive",
     "key": "features",
     "groupId": "a67dad92-682f-46d7-8cd8-faeec2a05135"
    },
    "simple controls and attractive construction": {
     "sentimentAnalysis": "Forstærkeren opleves ofte som nem at installere og betjene med taktile kontroller, overskueligt layout, solid opbygning og et afdæmpet design, der passer i et hi-fi-møbel.",
     "simpleTitle": "Enkel betjening og flot konstruktion",
     "bias": "positive",
     "key": "usability",
     "groupId": "b17ab0c7-feef-4027-a19e-9e7b40520ede"
    },
    "some control and display limitations": {
     "sentimentAnalysis": "Kritikken fokuserer på en besværlig fjernbetjening, lille displaytekst, svære aflæselige tonekontroller og manglende bas-, diskant- og balancekontrol på fjernbetjeningen.",
     "simpleTitle": "Visse begrænsninger ved betjening og display",
     "bias": "negative",
     "key": "usability",
     "groupId": "b17ab0c7-feef-4027-a19e-9e7b40520ede"
    },
    "some system-specific connection limitations": {
     "sentimentAnalysis": "En mindre del af ejerne nævner manglende direkte tilslutning til passiv subwoofer, for lav effekt fra Low-Level Pre-Out til visse subwooferopsætninger eller fejl i phono- og forforstærkerfunktionen.",
     "simpleTitle": "Visse begrænsninger ved bestemte tilslutninger",
     "bias": "negative",
     "key": "features",
     "groupId": "a67dad92-682f-46d7-8cd8-faeec2a05135"
    }
   },
