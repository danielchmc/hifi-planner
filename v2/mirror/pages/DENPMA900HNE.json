  "reviews": {
   "summary": "Denon PMA-900HNE roses bredt for sin varme, detaljerede og kraftfulde lyd med en rummelig og engagerende gengivelse. HEOS-streaming, de mange tilslutningsmuligheder og det stærke forhold mellem pris og kvalitet gør forstærkeren til en alsidig forbindelse mellem klassiske analoge kilder og moderne digital lytning. Opsætning og betjening er som regel enkel, men begrænsninger i HEOS, det lille display, manglende HDMI og enkelte forbindelses- eller driftsproblemer kritiseres.",
   "headlines": {
    "heos makes streaming versatile": {
     "sentimentAnalysis": "HEOS, netradio, Spotify, Tidal, AirPlay og andre netværkskilder værdsættes for at gøre streaming nemt og funktionerne alsidige.",
     "simpleTitle": "HEOS gør streaming alsidig",
     "bias": "positive",
     "key": "streaming",
     "groupId": "919c9fe1-b93f-4246-9f3c-a1c339a26e06"
    },
    "simple operation and useful connections": {
     "sentimentAnalysis": "Forstærkeren beskrives ofte som nem at tilslutte og betjene med nyttige indgange, automatisk kildeskift og en praktisk fjernbetjening.",
     "simpleTitle": "Enkel betjening og nyttige tilslutninger",
     "bias": "positive",
     "key": "usability",
     "groupId": "d1c10f7a-bf96-4a07-b98c-8286807ca367"
    },
    "warm, detailed and powerful sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en varm, klar og rummelig gengivelse med fast bas, mange detaljer og tilstrækkelig effekt til mange højttalere.",
     "simpleTitle": "Varm, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "e4676f08-682f-4c32-bd03-88ee5463ab9e"
    },
    "heos can be awkward and limited": {
     "sentimentAnalysis": "Flere anmeldelser oplever, at opsætning, navigation, playlister, netværkslager eller tjenesteintegration i HEOS er mindre intuitiv end forventet, selv om selve forstærkeren vurderes positivt.",
     "simpleTitle": "HEOS kan være besværligt og begrænset",
     "bias": "negative",
     "key": "streaming_limits",
     "groupId": "919c9fe1-b93f-4246-9f3c-a1c339a26e06"
    },
    "small display and missing HDMI disappoint": {
     "sentimentAnalysis": "Det lille og begrænsede display irriterer flere, og flere brugere bemærker også, at HDMI-indgange mangler, især i TV-baserede anlæg.",
     "simpleTitle": "Lille display og manglende HDMI skuffer",
     "bias": "negative",
     "key": "display_hdmi",
     "groupId": "d1c10f7a-bf96-4a07-b98c-8286807ca367"
    }
