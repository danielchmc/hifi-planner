  "displayBookDemo": true,
  "reviews": {
   "summary": "Et kompakt, alsidigt og meget prisvenligt mini-hi-fi-anlæg med varm, detaljeret og overraskende kraftfuld lyd fra cd, Bluetooth, vinyl og radio. Den fleksible placering, de mange funktioner og den gode værdi gør M-41 til et overbevisende valg til små rum, køkkener og soveværelser. Mindre ulemper er besværlige menuer, svage radioantenner, begrænsede tonekontroller og enkelte bekymringer om holdbarheden.",
   "headlines": {
    "warm, powerful sound from a compact system": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, detaljerede og kraftfulde lyd, især set i forhold til den kompakte størrelse og lave pris.",
     "simpleTitle": "Varm og kraftfuld lyd fra et kompakt anlæg",
     "bias": "positive",
     "key": "sound",
     "groupId": "4abefae2-3eb0-4022-a98a-a884e3da22a2"
    },
    "excellent value for the price": {
     "sentimentAnalysis": "Kombinationen af lydkvalitet, funktioner og kompakt konstruktion vurderes gentagne gange som enestående til prisen.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "1aaf252f-616d-4137-9d7e-2c303404ffec"
    },
    "compact and easy to place": {
     "sentimentAnalysis": "Det lille format og diskrete design roses gentagne gange til køkkener, soveværelser, reoler og andre steder med begrænset plads.",
     "simpleTitle": "Kompakt og nem at placere",
     "bias": "positive",
     "key": "compact",
     "groupId": "a8e15aed-ffb0-4557-939e-f5d1b2a8895c"
    },
    "good sound with different speakers and sources": {
     "sentimentAnalysis": "Anlægget opleves som alsidigt og lyder godt med flere højttalermærker samt cd, vinyl, Bluetooth og tv-lyd.",
     "simpleTitle": "God lyd med forskellige højttalere og kilder",
     "bias": "positive",
     "key": "sound",
     "groupId": "4abefae2-3eb0-4022-a98a-a884e3da22a2"
    },
    "simple operation and broad functionality": {
     "sentimentAnalysis": "Mange anmeldelser beskriver anlægget som nemt at installere og betjene med et nyttigt udvalg af funktioner.",
     "simpleTitle": "Enkel betjening og mange funktioner",
     "bias": "positive",
     "key": "usability",
     "groupId": "e5057f08-22c2-4c30-a4a3-68138dd5c998"
    },
    "bluetooth, CD and radio work well together": {
     "sentimentAnalysis": "Bluetooth-parring og afspilning modtages især positivt, mens cd, radio og flere indgange gør anlægget alsidigt.",
     "simpleTitle": "Bluetooth, cd og radio fungerer godt sammen",
     "bias": "positive",
     "key": "features",
     "groupId": "16a0bf06-7f6a-4071-bafa-7414f2e6af6a"
    },
    "tone controls and treble are limited": {
     "sentimentAnalysis": "Nogle anmeldelser påpeger manglende eller besværlig tonekontrol og en lidt svag diskantgengivelse.",
     "simpleTitle": "Tonekontrol og diskant er begrænset",
     "bias": "negative",
     "key": "sound",
     "groupId": "4abefae2-3eb0-4022-a98a-a884e3da22a2"
    },
    "menus and documentation can be frustrating": {
     "sentimentAnalysis": "Et mindretal af anmeldelserne finder indstillinger, menuer eller dokumentation sværere at forstå end forventet.",
     "simpleTitle": "Menuer og manual kan være besværlige",
     "bias": "negative",
     "key": "usability",
     "groupId": "e5057f08-22c2-4c30-a4a3-68138dd5c998"
    },
    "radio reception and antenna can be weak": {
     "sentimentAnalysis": "Radiopræstationen vurderes blandet: Nogle roser modtagelsen, mens andre finder den medfølgende antenne utilstrækkelig og indstillingen besværlig.",
     "simpleTitle": "Radiomodtagelse og antenne kan være svag",
     "bias": "negative",
     "key": "features",
     "groupId": "16a0bf06-7f6a-4071-bafa-7414f2e6af6a"
    }
   },
