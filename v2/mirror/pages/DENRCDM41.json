  "reviews": {
   "summary": "DENON RCD-M41 er et kompakt, alsidigt og meget prisvenligt mini-hi-fi-anlæg med varm, klar og overraskende kraftfuld lyd. CD-afspilning, Bluetooth, radio og fleksibel placering gør anlægget særligt attraktivt til køkkener, soveværelser og andre små rum, mens kompatibiliteten med mange forskellige højttalere ofte roses. Enkelte anmeldelser nævner besværlige menuer, svage antenner, begrænset tonekontrol og bekymringer om holdbarheden, men den samlede vurdering er stadig meget begejstret.",
   "headlines": {
    "compact and easy to place": {
     "sentimentAnalysis": "De kompakte mål og den nemme placering er store styrker, især i køkkener, soveværelser og andre små rum.",
     "simpleTitle": "Kompakt og nem at placere",
     "bias": "positive",
     "key": "compact-design",
     "groupId": "a3358da3-5621-4901-a533-40a9af966ef5"
    },
    "excellent value": {
     "sentimentAnalysis": "Kombinationen af lyd, funktioner og kompakt design anses bredt for at være fremragende til prisen.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "fab18e66-ad6f-465d-b186-b8abb33136d7"
    },
    "simple operation": {
     "sentimentAnalysis": "Mange anmeldelser roser den intuitive betjening, enkle installation og praktiske daglige brug.",
     "simpleTitle": "Enkel betjening",
     "bias": "positive",
     "key": "ease-of-use",
     "groupId": "2385372f-bef5-4e40-83ad-4bec34dbadd3"
    },
    "surprisingly powerful sound": {
     "sentimentAnalysis": "Lyden beskrives gentagne gange som klar, detaljeret, kraftfuld og imponerende for så lille et anlæg.",
     "simpleTitle": "Overraskende kraftfuld lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "bcf4aec3-7d9a-46a6-b1a6-6d6efe05f34f"
    },
    "excellent Bluetooth and broad functionality": {
     "sentimentAnalysis": "Bluetooth, CD, radio og streaming gør anlægget til et alsidigt alt-i-én-musikanlæg.",
     "simpleTitle": "Fremragende Bluetooth og mange funktioner",
     "bias": "positive",
     "key": "features-connectivity",
     "groupId": "bcda967c-9f87-444a-9d41-48cdbbef0903"
    },
    "limited tone control and radio reception": {
     "sentimentAnalysis": "Kritikken fokuserer på manglende eller begrænset tonekontrol, svage medfølgende antenner og fraværet af DAB i én anmeldelse.",
     "simpleTitle": "Begrænset tonekontrol og radiomodtagelse",
     "bias": "negative",
     "key": "sound-quality",
     "groupId": "bcf4aec3-7d9a-46a6-b1a6-6d6efe05f34f"
    },
    "menus and controls can be awkward": {
     "sentimentAnalysis": "Nogle brugere oplever menuer, indstillinger eller dokumentation som mere komplicerede end forventet.",
     "simpleTitle": "Menuer og betjening kan være besværlige",
     "bias": "negative",
     "key": "ease-of-use",
     "groupId": "2385372f-bef5-4e40-83ad-4bec34dbadd3"
    }
   },
