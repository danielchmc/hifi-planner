  "displayBookDemo": true,
  "reviews": {
   "summary": "Denon RCD-N12DAB bliver generelt vurderet som en kompakt og alsidig alt-i-én-receiver med varm, detaljeret og kraftfuld lyd, især sammen med passende højttalere. CD, DAB/FM- og internetradio, Bluetooth, streaming, phono- og TV-tilslutning gør anlægget meget praktisk, mens det kompakte design og den gode værdi også får megen ros. Opsætning, menuer og HEOS-appen kan være forvirrende, DAB- og netværksstabilitet varierer, og enkelte brugere oplever dæmpet bas, forbindelsesproblemer eller andre fejl.",
   "headlines": {
    "setup and controls can be confusing": {
     "sentimentAnalysis": "Den vigtigste kritik gælder uklare vejledninger, menuer med mange trin, vanskelige touchknapper på toppen og en HEOS-app, som nogle oplever som begrænset eller lidt intuitiv.",
     "simpleTitle": "Opsætning og betjening kan være forvirrende",
     "bias": "negative",
     "key": "usability",
     "groupId": "ab3a6bf6-7238-40fe-b5c6-e2b2cc5ba926"
    },
    "rich, powerful sound in a compact system": {
     "sentimentAnalysis": "Lyden beskrives oftest som klar, varm, detaljeret, dynamisk og overraskende kraftfuld i forhold til størrelsen, men højttal matchning er vigtig.",
     "simpleTitle": "Fyldig og kraftfuld lyd i et kompakt anlæg",
     "bias": "positive",
     "key": "sound",
     "groupId": "6fae4441-34da-4fc7-ba63-220b6f6a4f7e"
    },
    "many sources and connections in one box": {
     "sentimentAnalysis": "Kombinationen af CD, radio, streaming, Bluetooth, phono- og TV-tilslutning får gentagne gange ros, fordi den erstatter flere separate enheder.",
     "simpleTitle": "Mange kilder og tilslutninger i én enhed",
     "bias": "positive",
     "key": "versatility",
     "groupId": "87d32ec5-04c5-43a1-8278-4382dda3b4f7"
