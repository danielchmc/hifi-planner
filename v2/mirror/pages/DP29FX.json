  "reviews": {
   "summary": "DP29FX roses bredt som en prisvenlig og brugervenlig pladespiller med ren, behagelig lyd og tilstrækkelige funktioner til daglig vinylafspilning. Enkelte oplever konstruktionen som lidt spinkel, og forventningerne bør ligge under high-end-niveau, men samlet set vurderes den som fremragende til prisen.",
   "headlines": {
    "excellent value for the price": {
     "sentimentAnalysis": "Pladespilleren betragtes gentagne gange som et fornuftigt og prisvenligt køb med god ydelse uden high-end-ambitioner.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "price-value",
     "groupId": "c58c7380-8be0-452d-b602-23a966bd7bf4"
    },
    "clean, enjoyable sound": {
     "sentimentAnalysis": "Anmelderne beskriver lyden som ren, meget god og velegnet til almindelig lytning derhjemme, inklusive rock, pop og ældre vinyl.",
     "simpleTitle": "Ren og behagelig lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "24b70e1f-24ce-4084-bbef-b9a94dc593bc"
    },
