  "reviews": {
   "summary": "ESSBA1HDMIX er et pålideligt og prisvenligt HDMI-kabel, der generelt fungerer som forventet og roses for ren, detaljeret og fyldig lyd. De fleste forbindelser fungerer problemfrit, og kablet er et solidt hverdagsvalg, som er praktisk at kunne købe som basisvare. Enkelte oplevelser nævner problemer med UHD-genkendelse eller signal, men ombytning og god kundeservice kan hurtigt løse sådanne problemer.",
   "headlines": {
    "works reliably for everyday use": {
     "sentimentAnalysis": "Flere anmeldelser beskriver en enkel funktion i overensstemmelse med specifikationerne.",
     "simpleTitle": "Fungerer pålideligt i hverdagen",
     "bias": "positive",
     "key": "functionality",
     "groupId": "53fe3605-3093-4310-9d01-09309c89c568"
    },
    "clean, detailed and powerful sound": {
     "sentimentAnalysis": "Kablet forbindes med klar, veladskilt og imponerende lydgengivelse.",
     "simpleTitle": "Ren, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "de0a4625-dbd9-47d6-9ca3-b7450f36d8e9"
    },
    "some setups fail to detect UHD or deliver a signal": {
     "sentimentAnalysis": "Kompatibiliteten er ikke universel, da enkelte installationer mangler UHD-genkendelse eller signal.",
     "simpleTitle": "Nogle systemer registrerer ikke UHD eller leverer ikke noget signal",
     "bias": "negative",
     "key": "signal-compatibility",
     "groupId": "4a219351-5066-4c7b-b346-8a232681e93c"
    },
    "a practical, affordable basic cable": {
     "sentimentAnalysis": "Kablet værdsættes som et prisvenligt, behageligt og velegnet valg til basisbrug.",
     "simpleTitle": "Et praktisk og prisvenligt basis-kabel",
     "bias": "positive",
     "key": "cable-quality",
     "groupId": "5f70b8e1-3608-455a-b066-6197ec8bc5fc"
    },
    "nothing special beyond being a standard HDMI cable": {
     "sentimentAnalysis": "Nogle anmeldelser opfatter produktet som almindeligt og uspektakulært, men accepterer dets grundlæggende funktion.",
     "simpleTitle": "Ikke noget særligt ud over at være et almindeligt HDMI-kabel",
     "bias": "meh",
