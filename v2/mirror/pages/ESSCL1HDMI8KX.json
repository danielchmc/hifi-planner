     "sentimentAnalysis": "Flere anmeldelser vurderer, at kablet er rimeligt prissat i forhold til kvalitet og ydeevne.",
     "simpleTitle": "God værdi for pengene",
     "bias": "positive",
     "key": "good-value",
     "groupId": "d0ba70b1-2c55-4f95-9658-f382e147a9a0"
    },
    "clear, enjoyable sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver lyden som god, af høj kvalitet og behagelig til tv- og lydbrug.",
     "simpleTitle": "Klar og behagelig lyd",
     "bias": "positive",
     "key": "clear-enjoyable-sound",
