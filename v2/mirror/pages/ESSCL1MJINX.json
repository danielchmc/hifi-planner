    },
    "sturdy, high-quality construction": {
     "sentimentAnalysis": "Kablet roses gentagne gange for at være velbygget, robust og af høj kvalitet.",
     "simpleTitle": "Robust konstruktion i høj kvalitet",
     "bias": "positive",
     "key": "build",
     "groupId": "0382767d-480c-4365-9a08-6b4418359309"
    },
    "clean, detailed and interference-free sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver behagelig lyd, bevaret kvalitet og fravær af støj eller knasen.",
     "simpleTitle": "Ren, detaljeret og støjfri lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "aa934240-a5e9-4d7c-bf37-1e67a058dba4"
    },
    "flexible and easy to handle": {
