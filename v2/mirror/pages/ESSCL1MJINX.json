  "reviews": {
   "summary": "Et pålideligt og alsidigt kabel, der skaber rene forbindelser mellem kilder, højttalere, Sonos-systemer og forstærkere. Lyden forbliver klar, støjfri og fyldig, mens konstruktionen er solid, kablet fleksibelt og stikkene sikre. De største forbehold gælder lejlighedsvis kort længde, begrænset farveudvalg og en pris, som nogle synes er høj.",
   "headlines": {
    "reliable connections across many audio setups": {
     "sentimentAnalysis": "Kablet giver konsekvent enkle og problemfri forbindelser mellem forskellige lydkomponenter.",
     "simpleTitle": "Pålidelige forbindelser til mange lydsystemer",
     "bias": "positive",
     "key": "connection",
     "groupId": "05a1449c-8c12-4009-9b4e-3b6c57852b26"
    },
    "solid, well-finished construction": {
     "sentimentAnalysis": "Anmeldelserne fremhæver robuste materialer, god forarbejdning, flot finish og sikre forgyldte kontakter.",
     "simpleTitle": "Solid og veludført konstruktion",
     "bias": "positive",
     "key": "quality",
     "groupId": "4e4b1543-09de-4617-81a8-0195120c992c"
    },
    "clear, quiet and improved sound": {
     "sentimentAnalysis": "Kablet forbindes med klar, ren og støjfri lyd samt mærkbare forbedringer af anlæggets lyd.",
     "simpleTitle": "Klar, støjfri og forbedret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "92eb2a4e-2312-4c24-a433-8a92f25d64fb"
    },
    "flexible cable with useful length options": {
     "sentimentAnalysis": "Kablet roses for at være blødt, fleksibelt og fås i længder, der passer til forskellige installationer.",
     "simpleTitle": "Fleksibelt kabel med praktiske længder",
     "bias": "positive",
     "key": "length",
     "groupId": "6e922ab6-c44d-45d4-a8fd-fc4b1cb61911"
    },
    "some cables are too short": {
     "sentimentAnalysis": "Flere anmeldelser advarer om, at den valgte kabellængde kan være utilstrækkelig, så omhyggelig opmåling er vigtig.",
     "simpleTitle": "Nogle kabler er for korte",
     "bias": "negative",
     "key": "length",
     "groupId": "6e922ab6-c44d-45d4-a8fd-fc4b1cb61911"
    },
    "limited colour choice": {
