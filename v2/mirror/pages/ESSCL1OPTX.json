  "reviews": {
   "summary": "ESSCL1OPTX leverer ren, stabil og ofte imponerende fyldig lyd med varm bas, tydelig tale og skarpe detaljer til både musik og tv. Installationen er generelt enkel, og kablet føles fleksibelt, solidt og pengene værd. Kompatibiliteten er fremragende i de fleste opsætninger, selv om et ældre Panasonic-tv muligvis ikke understøtter forbindelsen, og HDMI var tilstrækkeligt for nogle brugere.",
   "headlines": {
    "solid, flexible and good value": {
     "sentimentAnalysis": "Anmeldelserne beskriver samstemmigt et vellavet, fleksibelt kabel med stabil ydelse og god værdi for pengene.",
     "simpleTitle": "Solid, fleksibel og god værdi",
     "bias": "positive",
     "key": "cable-quality",
     "groupId": "5863d3ad-6060-4ae7-83cd-d588738d3e48"
    },
    "easy connection in most systems": {
     "sentimentAnalysis": "De fleste brugere rapporterer om enkle forbindelser mellem tv, forstærkere, højttalere og streamere med få eller ingen opsætningsproblemer.",
     "simpleTitle": "Nem tilslutning i de fleste systemer",
     "bias": "positive",
     "key": "setup-compatibility",
     "groupId": "3bd169ff-4f1d-4597-ac71-c7ee08abb072"
    },
    "full, clear and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne roser den fyldige, varme og detaljerede gengivelse med tydelig tale, kraftig bas og et omsluttende stereoperspektiv.",
     "simpleTitle": "Fyldig, klar og omsluttende lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "5ead93a4-d41a-461b-9283-44ba69d7925b"
    },
    "limited compatibility with one older TV": {
     "sentimentAnalysis": "Der er en mindre kompatibilitetsbekymring: Et ældre Panasonic-tv kunne ikke tilsluttes, mens en anden bruger fandt HDMI tilstrækkeligt.",
     "simpleTitle": "Begrænset kompatibilitet med et ældre tv",
     "bias": "negative",
     "key": "setup-compatibility",
     "groupId": "3bd169ff-4f1d-4597-ac71-c7ee08abb072"
    }
   },
