  "reviews": {
   "summary": "ESSCL1SCX betragtes generelt som et solidt og prisvenligt højttalerkabel, der leverer en ren og kompetent lyd og fungerer pålideligt i almindelige anlæg. Kablet roses for den robuste konstruktion, den gode værdi og den nemme tilslutning i mange installationer. Den mest gennemgående ulempe er den meget stive yderkappe, som kan gøre det sværere at føre kablet rundt om hjørner, samle kablerne og afisolere det.",
   "headlines": {
    "robust construction at a fair price": {
     "sentimentAnalysis": "Kablet betragtes ofte som velbygget, tilstrækkeligt kraftigt og attraktivt prissat til almindelige højttalerinstallationer.",
     "simpleTitle": "Robust konstruktion til en fair pris",
     "bias": "positive",
     "key": "quality-value",
     "groupId": "026fae02-d966-4548-98d4-83c91beb3678"
    },
    "very stiff and hard to route": {
     "sentimentAnalysis": "Den vigtigste kritik af håndteringen er den store stivhed, som gør bøjninger, hjørner, samling og diskret føring vanskeligere.",
     "simpleTitle": "Meget stift og svært at føre",
     "bias": "negative",
     "key": "flexibility",
     "groupId": "d0dfb487-252f-4721-b6dd-48a6406d505e"
    },
    "clean, capable sound": {
     "sentimentAnalysis": "Kablet beskrives gentagne gange som leverandør af ren, detaljeret og musikalsk lyd og løser sin lydmæssige opgave pålideligt.",
     "simpleTitle": "Ren og kompetent lyd",
     "bias": "positive",
     "key": "sound",
