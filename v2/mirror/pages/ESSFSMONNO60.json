  "reviews": {
   "summary": "Disse elegante og veludførte højttalerstativer giver imponerende værdi for pengene, solid støtte og smart kabelføring. Stativerne kan give en klarere, mere omsluttende og dejligt kontant lyd, mens glaspladerne tilfører et raffineret præg. Enkelte detaljer deler dog vandene, især den lave højde, de bløde fødder og den manglende ensartede placering af logoet.",
   "headlines": {
    "elegant, well-finished design": {
     "sentimentAnalysis": "Det slanke, attraktive udseende og den gode finish bliver gentagne gange rost, mens den vendbare glasplade giver ekstra fleksibilitet i udtrykket.",
     "simpleTitle": "Elegant og veludført design",
     "bias": "positive",
     "key": "design",
     "groupId": "2dbfc4c5-ad15-4ed5-8c94-95c625247811"
    },
    "excellent value at the price": {
     "sentimentAnalysis": "Stativerne vurderes gentagne gange som rimeligt eller meget godt prissat og leverer solid ydelse sammenlignet med dyrere alternativer.",
     "simpleTitle": "Fremragende værdi til prisen",
     "bias": "positive",
     "key": "value",
     "groupId": "cd315918-ad54-4de0-b20a-90e2b402518e"
    },
    "cable routing keeps the setup tidy": {
     "sentimentAnalysis": "Den integrerede kabelstyring værdsættes, fordi den skjuler kablerne og giver en renere og mere gennemført installation.",
     "simpleTitle": "Kabelstyring holder opsætningen ryddelig",
     "bias": "positive",
     "key": "cables",
     "groupId": "1a71c407-35ac-4d0c-b93e-ca276c4be543"
    },
    "solid enough for everyday use": {
     "sentimentAnalysis": "Flere kommentarer beskriver stativerne som robuste, solide og stabile nok til normal brug med højttalere.",
     "simpleTitle": "Stabil nok til daglig brug",
     "bias": "positive",
     "key": "stability",
     "groupId": "3bfd3479-7628-463e-9ae9-c65939d7b612"
    },
    "soft feet can feel wobbly": {
     "sentimentAnalysis": "Stabiliteten er generelt acceptabel, men bløde fødder og manglende mulighed for ekstra ballast giver bekymring for vippen og fasthed.",
     "simpleTitle": "Bløde fødder kan føles ustabile",
     "bias": "negative",
     "key": "stability",
     "groupId": "3bfd3479-7628-463e-9ae9-c65939d7b612"
    },
    "clearer, more immersive sound": {
     "sentimentAnalysis": "Stativerne forbindes med en tydelig forbedring af lydgengivelsen og en samlet lyd, der får stor ros.",
     "simpleTitle": "Klarere og mere omsluttende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "7f2001ba-5ff3-4654-9b78-bdabf853cfc6"
    },
    "logo placement is inconsistent": {
     "sentimentAnalysis": "To kommentarer kritiserer specifikt, at logoet mangler på det ene af de to stativer.",
