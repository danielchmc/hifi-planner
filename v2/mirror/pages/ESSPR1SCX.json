  "reviews": {
   "summary": "ESSPR1SCX roses bredt som et solidt kabel af høj kvalitet, der leverer en ren, detaljeret og engagerende lyd. Den fleksible konstruktion gør kabelføring og montering nem, mens det diskrete udseende passer godt ind i hjemmet. De vigtigste forbehold er den relativt høje pris, at polariteten kan være svær at se, og at forskellen fra billigere kabler er begrænset i nogle anlæg.",
   "headlines": {
    "clean, detailed and engaging sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en ren, klar og detaljeret gengivelse med større musikglæde og tydeligere detaljer i flere anlæg.",
     "simpleTitle": "Ren, detaljeret og engagerende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "4a01ab75-f39c-414e-8985-9750dddb00a2"
    },
    "flexible and easy to route": {
     "sentimentAnalysis": "Kablet beskrives gentagne gange som smidigt, nemt at afisolere, enkelt at montere og let at skjule bag møbler eller i kabelkanaler.",
     "simpleTitle": "Fleksibelt og nemt at føre",
     "bias": "positive",
     "key": "installation",
     "groupId": "6e238ddf-f805-40bf-95c0-ca65ecdafc1d"
    },
    "good value despite a premium price": {
     "sentimentAnalysis": "Mange anmeldelser vurderer kvalitet og lyd som pengene værd, selv om kablet ikke er blandt de billigste muligheder.",
     "simpleTitle": "God værdi trods en højere pris",
     "bias": "positive",
     "key": "value",
     "groupId": "badea323-bb99-4c86-b8f3-a7a43b0edca4"
    },
    "little audible difference from cheaper cables": {
     "sentimentAnalysis": "Nogle lyttere kan især uden direkte sammenligning ikke høre forskel på kablet og billigere eller almindelige alternativer.",
     "simpleTitle": "Begrænset hørbar forskel fra billigere kabler",
     "bias": "negative",
     "key": "sound",
     "groupId": "4a01ab75-f39c-414e-8985-9750dddb00a2"
    },
    "polarity and terminal fit can be awkward": {
     "sentimentAnalysis": "Flere kommentarer nævner vanskelig polaritetsidentifikation, behov for at fjerne bananstik eller en stram pasform i visse apparattilslutninger.",
     "simpleTitle": "Polaritet og tilslutning kan være besværlig",
     "bias": "negative",
     "key": "installation",
     "groupId": "6e238ddf-f805-40bf-95c0-ca65ecdafc1d"
    },
    "some consider the cable too expensive": {
     "sentimentAnalysis": "Prisen er den tydeligste tilbagevendende kritik, og nogle stiller spørgsmål ved merprisen, når lydforbedringer er svære at påvise.",
     "simpleTitle": "Nogle synes, kablet er for dyrt",
     "bias": "negative",
     "key": "value",
     "groupId": "badea323-bb99-4c86-b8f3-a7a43b0edca4"
    }
