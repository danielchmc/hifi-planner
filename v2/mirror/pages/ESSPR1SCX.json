  "reviews": {
   "summary": "ESSPR1SCX betragtes generelt som et kvalitetskabel til højttalere, der leverer ren, detaljeret og ofte mærkbart forbedret lyd. Kablet roses også for solid konstruktion, fleksibilitet og nem montering, blandt andet diskret rundt om møbler og gennem kabelkanaler. Prisforholdet vurderes overvejende positivt, selv om nogle ikke hører forskel fra billigere kabler og synes, at prisen er høj.",
   "headlines": {
    "clean, detailed and improved sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver ren, detaljeret og mere medrivende lyd, og nogle oplever en tydelig forbedring i forhold til billigere eller almindelige kabler.",
     "simpleTitle": "Ren, detaljeret og forbedret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "15d38e87-b0e8-467e-9223-e80f32ce2b80"
    },
    "high-quality, solid construction": {
     "sentimentAnalysis": "Anmeldelserne beskriver gennemgående kablet som holdbart, velbygget, solidt og passende eksklusivt til kvalitetsanlæg.",
     "simpleTitle": "Høj kvalitet og solid konstruktion",
     "bias": "positive",
     "key": "build",
     "groupId": "feea3b6e-2856-4552-8bc1-100adbb2a306"
    },
    "good value for the performance": {
     "sentimentAnalysis": "Mange anmeldelser vurderer kablet som rimeligt prissat eller som god værdi, især i forhold til den oplevede lyd- og byggekvalitet.",
     "simpleTitle": "God værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "454ad179-8e6a-4eb8-83b1-113634cf2c74"
    },
    "flexible and easy to route": {
     "sentimentAnalysis": "Kablet beskrives gentagne gange som smidigt, nemt at arbejde med, enkelt at montere og let at skjule rundt om møbler eller i kabelkanaler.",
     "simpleTitle": "Fleksibelt og nemt at føre",
     "bias": "positive",
     "key": "installation",
     "groupId": "618c8686-c295-48cd-ac5a-4ce84f06bd8e"
    },
    "some hear little or no difference": {
     "sentimentAnalysis": "En mindre del af anmeldelserne kan ikke skelne kablet fra billigere eller almindelige alternativer eller vil ikke konkludere uden en direkte sammenligning.",
     "simpleTitle": "Nogle hører lille eller ingen forskel",
     "bias": "negative",
     "key": "sound",
     "groupId": "15d38e87-b0e8-467e-9223-e80f32ce2b80"
    },
    "price feels high for some": {
     "sentimentAnalysis": "Flere anmeldelser beskriver kablet som dyrt, især når den hørbare forbedring i forhold til billigere alternativer er usikker.",
     "simpleTitle": "Nogle synes, prisen er høj",
     "bias": "negative",
     "key": "value",
     "groupId": "454ad179-8e6a-4eb8-83b1-113634cf2c74"
    }
