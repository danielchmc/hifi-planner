  "reviews": {
   "summary": "ESSRADIO1X er en kompakt og attraktiv hverdagsradio med varm, klar og fyldig lyd, enkel betjening og god værdi for pengene. Det lille design passer til køkkener, soveværelser og andre mindre rum, mens den hurtige opsætning og stabile modtagelse ofte fremhæves. De vigtigste forbehold gælder DAB-modtagelsen nogle steder, den først forvirrende automatiske slukning efter to timer samt enkelte begrænsninger ved display og funktioner.",
   "headlines": {
    "warm, clear and powerful sound": {
     "sentimentAnalysis": "Lyden beskrives gentagne gange som rigtig god, klar, kraftig og imponerende for en lille radio.",
     "simpleTitle": "Varm, klar og fyldig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "25ed2a32-f234-4b58-8e24-b625df8e131d"
    },
    "simple controls and quick setup": {
     "sentimentAnalysis": "Betjeningen opfattes som let at forstå med hurtig automatisk indstilling og enkel daglig brug.",
     "simpleTitle": "Enkel betjening og hurtig opsætning",
     "bias": "positive",
     "key": "usability",
     "groupId": "c7caeb2d-13d1-41d3-b141-c7fefd271fcd"
    },
    "compact, discreet and attractive design": {
     "sentimentAnalysis": "Den kompakte form, diskrete fremtoning og tidløse stil passer godt til køkkener, soveværelser og mindre rum.",
     "simpleTitle": "Kompakt, diskret og attraktivt design",
     "bias": "positive",
     "key": "design",
     "groupId": "bed85fad-5126-45c3-8856-63a37ae638ff"
    },
    "dab reception can fail in some locations": {
     "sentimentAnalysis": "DAB-modtagelsen beskrives som utilgængelig i nogle områder, selv om modtagelsen roses andre steder.",
     "simpleTitle": "DAB-modtagelsen kan svigte nogle steder",
     "bias": "negative",
     "key": "reception",
     "groupId": "d4738e64-bb4a-4a27-9b75-6d9c72de1dcd"
    },
    "two-hour shutoff causes confusion": {
     "sentimentAnalysis": "Den forudindstillede sluk efter to timer opleves som en uforklarlig afbrydelse og kræver en ændring fra brugeren.",
     "simpleTitle": "Slukning efter to timer skaber forvirring",
     "bias": "negative",
     "key": "autooff",
     "groupId": "cc06bc5f-6fee-45fc-9e3c-066b68ce7fc9"
    }
   },
