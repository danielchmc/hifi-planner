  "reviews": {
   "summary": "ESSENTIALS RADIO 3X leverer varm, fyldig og overraskende rummelig lyd fra et kompakt kabinet, mens DAB, internet-radio, Bluetooth og streaming giver imponerende alsidighed. Enkel betjening og nem opsætning gør den daglige lytning ubesværet for de fleste, og det kompakte design passer især godt i køkken og stue. Enkelte anmeldelser nævner svagere FM-lyd, lejlighedsvise udfald på internettet, en besværlig app eller brugerflade samt skuffende bas for krævende lyttere, men helhedsindtrykket er stadig meget begejstret og giver stor værdi for pengene.",
   "headlines": {
    "easy to set up and operate": {
     "sentimentAnalysis": "De fleste kommentarer beskriver nem opsætning, intuitiv betjening og ukompliceret daglig lytning.",
     "simpleTitle": "Nem at sætte op og betjene",
     "bias": "positive",
     "key": "ease-of-use",
     "groupId": "176114ef-d034-42ad-bf18-ee139d675e54"
    },
    "warm, powerful sound from a compact radio": {
     "sentimentAnalysis": "Det kompakte kabinet leverer konsekvent rost, klar og fyldig lyd, hvor bas og rummelighed overgår forventningerne til størrelsen.",
     "simpleTitle": "Varm og kraftfuld lyd fra en kompakt radio",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "7ef4a9ec-62b5-4403-9542-58e5f34270d5"
    },
    "broad radio and streaming options": {
     "sentimentAnalysis": "DAB, FM, internet-radio, Bluetooth, Spotify Connect, podcasts og ældre programmer giver en alsidig lytteplatform.",
     "simpleTitle": "Mange radio- og streamingmuligheder",
     "bias": "positive",
     "key": "features-connectivity",
     "groupId": "c6950354-c998-4708-a73b-1c64a71b22e1"
    },
    "sound varies by source, with FM and bass drawing criticism": {
     "sentimentAnalysis": "Et mindretal finder FM-lyd, basdybde eller den samlede detaljerigdom mindre overbevisende, især sammenlignet med dedikerede Bluetooth-højttalere eller dyrere anlæg.",
     "simpleTitle": "Lyden varierer efter kilde, og FM og bas får kritik",
     "bias": "negative",
     "key": "sound-quality",
     "groupId": "7ef4a9ec-62b5-4403-9542-58e5f34270d5"
    },
    "app and interface need refinement": {
     "sentimentAnalysis": "Betjeningen er ikke altid gennemarbejdet, og iPhone-appen, menuerne, knappernes placering og opsætning på radioen får kritik.",
     "simpleTitle": "App og brugerflade trænger til forbedringer",
     "bias": "negative",
     "key": "ease-of-use",
     "groupId": "176114ef-d034-42ad-bf18-ee139d675e54"
    },
    "internet radio can be unreliable": {
     "sentimentAnalysis": "Internet-radio roses for det store udvalg, men kan være svær at starte eller have udfald, hvilket muligvis skyldes Wi-Fi.",
     "simpleTitle": "Internet-radio kan være ustabil",
     "bias": "negative",
     "key": "features-connectivity",
     "groupId": "c6950354-c998-4708-a73b-1c64a71b22e1"
    }
   },
