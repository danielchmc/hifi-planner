     "parentProductCode": "ESSWBSONERA100X",
     "reviews": {
      "summary": "Et smart og pladsbesparende beslag, der passer perfekt til Sonos Era 100-højttalere og er imponerende nemt at montere. Det rene design, den solide funktion i hverdagen og de fleksible placeringsmuligheder giver en pæn opsætning med varm og fyldig lyd. Den fremragende værdi for pengene skinner igennem, selv om nogle plastikdele giver efter under tryk, og højttaleren sidder lidt længere fra væggen end forventet.",
      "headlines": {
       "simple wall mounting": {
        "sentimentAnalysis": "Den ukomplicerede montering og klare vejledning gør installationen hurtig og problemfri.",
        "simpleTitle": "Enkel vægmontering",
        "bias": "positive",
        "key": "easy-installation",
        "groupId": "a0924eef-0222-46db-bd87-2e9ea3d69952"
       },
       "good value for money": {
        "sentimentAnalysis": "Den lave pris kombineres gentagne gange med nyttig funktionalitet og pålidelig ydeevne i hverdagen.",
        "simpleTitle": "God værdi for pengene",
        "bias": "positive",
        "key": "good-value",
        "groupId": "606cc8fd-1168-4936-8e20-108a0ea9fafa"
       },
       "some flex under speaker weight or pressure": {
        "sentimentAnalysis": "Flere anmeldelser nævner let bøjning eller blødhed, når den tunge højttaler er monteret, eller når der trykkes på knapperne.",
        "simpleTitle": "Giver lidt efter under vægt eller tryk",
        "bias": "negative",
        "key": "flex-under-load",
        "groupId": "0a71dea3-18e3-4576-8020-f6ce38859c9a"
       },
       "clean, solid fit for Era 100": {
        "sentimentAnalysis": "Beslaget passer godt til Sonos Era 100-højttalere og giver et pænt vægmonteret udtryk.",
        "simpleTitle": "Pæn og stabil pasform til Era 100",
        "bias": "positive",
        "key": "era-100-fit",
        "groupId": "afaa4fa9-766b-4ebe-bd47-844fd1e97b3e"
       },
       "flexible positioning": {
        "sentimentAnalysis": "Justeringsmulighederne gør vinkling og praktisk placering af højttaleren nemmere.",
        "simpleTitle": "Fleksibel placering",
        "bias": "positive",
        "key": "flexible-positioning",
