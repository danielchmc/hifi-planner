  "reviews": {
   "summary": "Hegel H190V roses bredt for sin klare, detaljerede og meget musikalske lyd, der kombinerer en åben og rummelig gengivelse med en stram, punchy bas og stærk kontrol. Forstærkeren leverer masser af kraft, driver krævende højttalere overbevisende og afslører indspilningernes karakter med imponerende præcision. Fremragende ydelse og værdi præger vurderingen, selv om bassen kan kræve lidt volumen, og én anmelder synes, at prisen er høj.",
   "headlines": {
    "clear, detailed and spacious sound": {
     "sentimentAnalysis": "Forstærkeren beskrives gentagne gange som klar, detaljeret, åben, luftig og rummelig med stærk adskillelse af instrumenter og sangstemmer.",
     "simpleTitle": "Klar, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "clear-detailed-sound",
     "groupId": "d63f85c4-4a9c-4d84-92aa-39d618cb6ad5"
    },
    "tight, punchy and powerful bass": {
     "sentimentAnalysis": "Bassen roses for at kombinere slagkraft, stramhed, præcision og rigelig kraft, også ved lavere lydstyrke.",
     "simpleTitle": "Stram, punchy og kraftfuld bas",
     "bias": "positive",
     "key": "punchy-bass",
     "groupId": "d63f85c4-4a9c-4d84-92aa-39d618cb6ad5"
    },
    "bass needs some volume to emerge": {
     "sentimentAnalysis": "Basgengivelsen roses generelt, men en anmeldelse bemærker, at der kræves lidt volumen for at få bassen i indspilningerne frem.",
     "simpleTitle": "Bassen kræver lidt volumen",
     "bias": "negative",
     "key": "bass-volume",
     "groupId": "d63f85c4-4a9c-4d84-92aa-39d618cb6ad5"
    },
    "confidently drives demanding speakers": {
     "sentimentAnalysis": "Forstærkeren roses kraftigt for sin ydelse, sin evne til at drive højttalere og kontrollen over store højttalersystemer.",
     "simpleTitle": "Driver krævende højttalere overbevisende",
     "bias": "positive",
     "key": "speaker-driving",
     "groupId": "c05db12b-323b-4cdf-823f-96137667a80b"
    },
    "strong performance for the price": {
     "sentimentAnalysis": "H190V opfattes som dyr af én anmelder, men vurderes stadig klart til at være pengene værd og muligvis blandt Hegels bedste valg med hensyn til pris og ydelse.",
     "simpleTitle": "Stærk ydelse til prisen",
