  "reviews": {
   "summary": "HEGEL H400 er en smukt bygget og meget kompetent alt-i-én-forstærker med varm, kraftfuld og usædvanligt kontrolleret lyd. Forstærkeren leverer punchy dynamik, krystalklare detaljer og overbevisende realisme med mange forskellige højttalere og musikgenrer. TV-tilslutning kan give problemer i visse opsætninger, men den samlede ydelse og værdi er meget overbevisende.",
   "headlines": {
    "drives demanding speakers with complete control": {
     "sentimentAnalysis": "Forstærkeren værdsættes konsekvent for sin autoritet, kontrol og evne til at fungere godt med krævende højttalere.",
     "simpleTitle": "Driver krævende højttalere med fuld kontrol",
     "bias": "positive",
     "key": "speaker-control",
     "groupId": "e6b1631f-8322-4d66-8720-72d3bedb7e3f"
    },
    "clear, detailed and natural sound": {
     "sentimentAnalysis": "Forstærkeren roses for krystalklar, præcis, naturlig og meget realistisk gengivelse på tværs af forskellige musikgenrer.",
     "simpleTitle": "Klar, detaljeret og naturlig lyd",
     "bias": "positive",
     "key": "clear-natural-sound",
     "groupId": "96f8dbbc-5646-4b77-b0eb-7ae5c0df569a"
    },
    "powerful and immersive musical punch": {
     "sentimentAnalysis": "H400 beskrives som en forstærker med et magisk punch, der gør mange forskellige musiktyper særdeles medrivende.",
     "simpleTitle": "Kraftfuldt og medrivende musikalsk punch",
     "bias": "positive",
     "key": "musical-punch",
     "groupId": "96f8dbbc-5646-4b77-b0eb-7ae5c0df569a"
