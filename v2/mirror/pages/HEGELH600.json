  "reviews": {
   "summary": "HEGELH600 betragtes bredt som en fremragende high-end integreret forstærker, der leverer varm, kraftfuld og særdeles kontrolleret lyd med enestående klarhed, detaljer, dybde og åbenhed. Forstærkeren driver krævende højttalere ubesværet og er en markant opgradering i forhold til flere tidligere Hegel-modeller, herunder H190, H200, H360 og H590. Det raffinerede design, de omfattende forbedringer og den medrivende gengivelse gør HEGELH600 til et særdeles overbevisende valg til seriøs lytning.",
   "headlines": {
    "a major leap over earlier Hegel amplifiers": {
     "sentimentAnalysis": "Ejere, der skifter fra H190, H200, H360 eller H590, beskriver en overraskende stor forbedring og ser HEGELH600 som en markant mere kapabel efterfølger.",
     "simpleTitle": "Et stort spring fremad fra tidligere Hegel-forstærkere",
     "bias": "positive",
     "key": "major-upgrade",
     "groupId": "4012d7a7-b6f1-4940-bcc6-01607aa26b0d"
    },
    "clear, detailed and open sound": {
     "sentimentAnalysis": "Anmeldelserne roser den enestående klare, højtopløste og åbne gengivelse med dyb, bred lydbillede og sort baggrund.",
     "simpleTitle": "Klar, detaljeret og åben lyd",
     "bias": "positive",
     "key": "clear-detailed-open-sound",
     "groupId": "8dec0afa-d56a-40e8-b73c-229885f866ed"
    },
    "powerful control over demanding speakers": {
     "sentimentAnalysis": "Forstærkeren beskrives som et kraftværk med præcis bas, stor autoritet og ubesværet kontrol over højttalere.",
     "simpleTitle": "Kraftfuld kontrol over krævende højttalere",
     "bias": "positive",
