  "reviews": {
   "summary": "HEGELH600 roses bredt som en spektakulær high-end integreret forstærker, der leverer varm, kraftfuld og særdeles kontrolleret lyd med enestående klarhed, detaljering, dybde og åbenhed. Flere ejere beskriver markante forbedringer i forhold til H190, H200, H360 og H590, hvilket gør forstærkeren til en komplet og overbevisende opgradering. Kombinationen af slagkraftig bas, et omsluttende lydbillede og ubesværet højttalerkontrol gør HEGELH600 til en stærk anbefaling til krævende anlæg.",
   "headlines": {
    "major improvement over earlier Hegel amplifiers": {
     "sentimentAnalysis": "Ejere beskriver konsekvent skiftet fra ældre Hegel-modeller som en markant, til tider dramatisk, forbedring fra en ny generation.",
     "simpleTitle": "Markant forbedring i forhold til tidligere Hegel-forstærkere",
     "bias": "positive",
     "key": "major_upgrade",
     "groupId": "e7ff5d65-4ef5-4208-8dde-ba45ddc3e969"
    },
    "clear, detailed and open sound": {
     "sentimentAnalysis": "Forstærkeren roses gentagne gange for glasklar gengivelse, høj opløsning, åbenhed og ubesværet musikalsk detaljering.",
     "simpleTitle": "Klar, detaljeret og åben lyd",
     "bias": "positive",
     "key": "clear_detailed_open_sound",
     "groupId": "a52e4434-6af1-4466-b595-b0cb5af33ab5"
    },
    "effortless power and speaker control": {
     "sentimentAnalysis": "Forstærkeren beskrives som et kraftværk med enestående kontrol, der ubesværet kan drive krævende højttalere.",
     "simpleTitle": "Ubesværet kraft og højttalerkontrol",
     "bias": "positive",
     "key": "effortless_power_control",
     "groupId": "3d466cce-6cde-4d53-b957-3ff1a4207a05"
    },
    "deep, wide and punchy presentation": {
     "sentimentAnalysis": "Beskrivelserne fremhæver kraftfuld dynamik, præcis bas, dybde, bredde, en sort baggrund og et omsluttende high-end-lydbillede.",
     "simpleTitle": "Dyb, bred og slagkraftig gengivelse",
     "bias": "positive",
