  "reviews": {
   "summary": "HEGELV10 betragtes bredt som en markant opgradering og leverer en varm, åben og meget detaljeret lyd med kontant bas, et stort lydbillede og høj musikalitet. Justerbare indstillinger til pickupper giver fremragende fleksibilitet til både MM- og MC-pickupper, mens det meget lave støjniveau holder gengivelsen ren og engagerende. De balancerede tilslutninger roses af nogle, men manglen på XLR-indgange og den uhensigtsmæssige placering af betjeningsknapperne skuffer andre.",
   "headlines": {
    "open, detailed and powerful sound": {
     "sentimentAnalysis": "Anmeldelserne roser den store, detaljerede og kontante gengivelse og beskriver en tydelig forbedring i forhold til tidligere RIAA-trin.",
     "simpleTitle": "Åben, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "4cde8a8f-e164-464b-8ae5-8b4cafe28853"
    },
    "clean, quiet and highly musical": {
     "sentimentAnalysis": "RIAA-trinnet roses for at fjerne uønsket støj, knasen og statiske lyde, samtidig med at den bevarer en engagerende musikalsk karakter.",
     "simpleTitle": "Ren, støjsvag og meget musikalsk",
     "bias": "positive",
     "key": "noise",
     "groupId": "4d5e6630-3b61-45e3-b0fe-868b5ed1f951"
    },
    "flexible settings for different cartridges": {
     "sentimentAnalysis": "Anmeldelserne værdsætter den brede pickup-kompatibilitet og den valgbare forstærkning, inklusive den nyttige mulighed for en fremtidig MC-opgradering.",
     "simpleTitle": "Fleksible indstillinger til forskellige pickupper",
     "bias": "positive",
     "key": "adjustability",
     "groupId": "4eebf01b-04df-4865-a993-531fab0eff1f"
    },
    "balanced output is a strong advantage": {
     "sentimentAnalysis": "Den balancerede XLR-udgang fremhæves som fordelagtig sammen med kompatibel Hegel-forstærkning.",
     "simpleTitle": "Den balancerede udgang er en stor fordel",
     "bias": "positive",
     "key": "connections",
     "groupId": "d49dac71-242f-4109-a485-d7b6499e98cc"
    },
    "missing XLR inputs disappoint": {
     "sentimentAnalysis": "En del af kritikken retter sig mod de manglende XLR-indgange og den uhensigtsmæssige placering af strømtilslutning og DIP-kontakter.",
     "simpleTitle": "Manglende XLR-indgange skuffer",
     "bias": "negative",
     "key": "connections",
     "groupId": "d49dac71-242f-4109-a485-d7b6499e98cc"
    }
   },
