  "reviews": {
   "summary": "HEGELV10 roses bredt for at levere en stor, musikalsk opgradering med varm, åben og meget detaljeret lyd, herunder en slagkraftig bas og et stort lydbillede. Den usædvanligt støjsvage drift samt de fleksible indstillinger for pickupper og forstærkning giver stor praktisk værdi, mens den balancerede XLR-udgang kan forbedre systemets ydelse yderligere. Enkelte kritikpunkter gælder en lidt lys klangbalance, uhensigtsmæssigt placerede kontakter og manglen på XLR-indgange, men den samlede vurdering er fortsat meget begejstret.",
   "headlines": {
    "open, detailed and powerful sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en rummelig, åben, klar og dynamisk gengivelse med mange detaljer og stram bas.",
     "simpleTitle": "Åben, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "0b59be50-78a3-4ed2-a9a3-2c2a626f9da7"
    },
    "a major audible upgrade": {
     "sentimentAnalysis": "Enheden beskrives gentagne gange som en værdifuld og markant forbedring i forhold til tidligere riaa-trin eller eksisterende anlæg.",
     "simpleTitle": "En tydelig hørbar opgradering",
     "bias": "positive",
     "key": "sound",
     "groupId": "0b59be50-78a3-4ed2-a9a3-2c2a626f9da7"
    },
    "virtually silent operation": {
     "sentimentAnalysis": "Anmeldelserne roser samstemmende det lave støjniveau og reduktionen eller fraværet af susen, knasen og statisk støj.",
     "simpleTitle": "Næsten lydløs drift",
     "bias": "positive",
     "key": "noise",
     "groupId": "fa2bb42e-5515-4678-8521-009a835b357c"
    },
    "flexible cartridge and gain configuration": {
     "sentimentAnalysis": "Tilpasning til forskellige pickupper og valgfri forstærkning betragtes som en stor styrke og understøtter fremtidige opgraderinger.",
     "simpleTitle": "Fleksibel konfiguration af pickup og forstærkning",
     "bias": "positive",
     "key": "settings",
     "groupId": "cf9b8819-8588-4778-a8ed-5d3ef0f5d707"
    },
    "some listeners find the treble slightly bright": {
     "sentimentAnalysis": "En anmeldelse betegner udtrykkeligt lyden som lidt lys, mens en anden er utilfreds med den samlede gengivelse trods tilfredshed med riaa-trinnet.",
     "simpleTitle": "Nogle lyttere oplever diskanten som lidt lys",
     "bias": "negative",
     "key": "sound",
     "groupId": "0b59be50-78a3-4ed2-a9a3-2c2a626f9da7"
    },
    "balanced XLR output is highly useful": {
     "sentimentAnalysis": "Den balancerede udgang roses for at bidrage til høj ydelse ved tilslutning til kompatibel Hegel-forstærkning.",
     "simpleTitle": "Den balancerede XLR-udgang er meget nyttig",
     "bias": "positive",
     "key": "connections",
     "groupId": "d24acd44-746f-498f-8b3d-83b3c688be99"
