  "reviews": {
   "summary": "HEGELVIKING betragtes som en fremragende CD-afspiller med varm, detaljeret og meget musikalsk lyd. Gengivelsen er rummelig og medrivende, med god separation, artikuleret bas og en organisk, analoglignende klang. HEGELVIKING løfter konsekvent komplette anlæg og anbefales begejstret som en kilde i topklasse.",
   "headlines": {
    "warm, detailed and analogue-like sound": {
     "sentimentAnalysis": "Lyden roses for sin varme, fine detaljering og organiske, analoglignende musikalitet.",
     "simpleTitle": "Varm, detaljeret og analoglignende lyd",
     "bias": "positive",
     "key": "warm-analogue-sound",
     "groupId": "c93fedaf-ed32-4a21-923a-a13f5d0a0793"
    },
    "spacious, precise soundstage": {
     "sentimentAnalysis": "Afspilleren skaber et bredt, dybt og velordnet lydbillede, hvor instrumenter og vokaler forbliver tydeligt adskilt.",
     "simpleTitle": "Rummeligt, præcist lydbillede",
     "bias": "positive",
     "key": "soundstage-separation",
     "groupId": "c93fedaf-ed32-4a21-923a-a13f5d0a0793"
    },
    "articulate bass and system-wide improvement": {
     "sentimentAnalysis": "Basgengivelsen beskrives som tydeligt artikuleret, mens afspilleren også strammer gengivelsen op og fremhæver flere detaljer i hele anlægget.",
     "simpleTitle": "Artikuleret bas og løft af hele anlægget",
     "bias": "positive",
     "key": "bass-system-upgrade",
