  "reviews": {
   "summary": "JBL Bar 1300MK2 leverer varm, kraftfuld og medrivende lyd, der løfter film, musik og tv-lyd markant. Dolby Atmos, surroundlyd, slagkraftig bas og et bredt lydbillede skaber en overbevisende hjemmebiografoplevelse, mens de aftagelige batteridrevne højttalere giver fleksibel placering uden strømkabler. Appen og indstillingsmulighederne giver nyttig kontrol og gør systemet til en imponerende og meget tilfredsstillende opgradering.",
   "headlines": {
    "powerful, wide and highly detailed sound": {
     "sentimentAnalysis": "Lyden beskrives som usædvanligt kraftfuld, bred og markant bedre end almindelig tv-lyd eller tidligere højttalersystemer.",
     "simpleTitle": "Kraftfuld, bred og detaljeret lyd",
     "bias": "positive",
     "key": "sound_power",
     "groupId": "7f50adb8-a1b7-4463-b0df-4a212e53d759"
    },
    "punchy, plentiful bass": {
     "sentimentAnalysis": "Subwooferen og soundbaren leverer masser af slagkraftig bas, der giver film og musik mere effekt, og som kan justeres efter behov.",
     "simpleTitle": "Kraftfuld og fyldig bas",
     "bias": "positive",
     "key": "punchy_bass",
     "groupId": "7f50adb8-a1b7-4463-b0df-4a212e53d759"
    },
    "battery-powered speakers simplify placement": {
     "sentimentAnalysis": "De aftagelige baghøjttalere værdsættes, fordi de fjerner behovet for strømkabler, giver fleksibel placering og nemt kan sættes tilbage på soundbaren.",
     "simpleTitle": "Batteridrevne højttalere gør placeringen nem",
     "bias": "positive",
     "key": "wireless_speaker_flexibility",
     "groupId": "79307077-3ff2-4315-ad14-1e5312605660"
    },
    "convincing surround and Dolby Atmos immersion": {
     "sentimentAnalysis": "Surround og Dolby Atmos roses for at skabe en langt mere omsluttende og biograflignende filmoplevelse.",
     "simpleTitle": "Overbevisende surround- og Dolby Atmos-oplevelse",
     "bias": "positive",
     "key": "immersive_surround",
     "groupId": "559bc41e-2354-4986-aa6e-009cb4fdd1b6"
    },
    "useful app and equalizer controls": {
     "sentimentAnalysis": "JBL-appen og lydindstillingerne betragtes som stærke funktioner, der gør finjustering nemt.",
     "simpleTitle": "Nyttige app- og equalizer-indstillinger",
     "bias": "positive",
     "key": "app_equalizer",
     "groupId": "3089f102-5675-4565-9a24-bf9554405715"
    }
   },
