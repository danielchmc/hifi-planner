  "reviews": {
   "summary": "JBL Bar 800 MK2 leverer en varm, kraftfuld og omsluttende lyd med tilfredsstillende bas og imponerende lydstyrke. De aftagelige sidehøjttalere giver fleksibel surroundlyd, mens opsætningen er enkel, og købsoplevelsen er problemfri. Lydkvaliteten får overvejende ros, selv om forventningen bør være solid soundbar-ydelse frem for absolut topklasse.",
   "headlines": {
    "powerful, immersive sound with rich bass": {
     "sentimentAnalysis": "Lyden roses som fremragende, kraftfuld og meget engagerende, især på grund af den stærke bas og høje lydstyrke.",
     "simpleTitle": "Kraftfuld, omsluttende lyd med fyldig bas",
     "bias": "positive",
     "key": "sound-power",
     "groupId": "9c9626ba-0615-478a-886e-a4d471b6cc61"
    },
    "fast delivery and smooth service": {
     "sentimentAnalysis": "Forhandleroplevelsen roses for konkurrencedygtige priser, hurtig levering og problemfri håndtering.",
     "simpleTitle": "Hurtig levering og problemfri service",
     "bias": "positive",
     "key": "smooth-purchase",
     "groupId": "d99478c8-af42-4fc4-bb35-5ad9bf40fe5c"
    },
    "solid rather than outstanding sound quality": {
     "sentimentAnalysis": "Den samlede soundbar-ydelse vurderes som god og passende, men ikke konsekvent som enestående.",
     "simpleTitle": "Solid snarere end enestående lydkvalitet",
     "bias": "negative",
     "key": "sound-solid",
     "groupId": "9c9626ba-0615-478a-886e-a4d471b6cc61"
    },
    "removable speakers are practical and versatile": {
     "sentimentAnalysis": "De aftagelige sidehøjttalere opfattes som en særligt nyttig og attraktiv funktion.",
     "simpleTitle": "Aftagelige højttalere er praktiske og fleksible",
     "bias": "positive",
