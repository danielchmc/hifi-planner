  "displayBookDemo": true,
  "reviews": {
   "summary": "KEFKC62 roses bredt som en kompakt, men kraftfuld subwoofer, der tilfører dyb, kontrolleret og musikalsk bas til mange forskellige højttalersystemer. Bassen beskrives ofte som præcis, slagkraftig, ren og velintegreret, især til musik, mens det lille kabinet og det flotte design gør den nem at placere. En tilbagevendende kritik er den for følsomme dvaletilstand, som kan afbryde stille lytning, og enkelte systemer kan lyde for buldrende, hvis niveauet sættes for højt.",
   "headlines": {
    "deep, controlled and musical bass": {
     "sentimentAnalysis": "Subwooferen leverer overraskende dyb, ren og kontrolleret bas med særligt høj musikalitet.",
     "simpleTitle": "Dyb, kontrolleret og musikalsk bas",
     "bias": "positive",
     "key": "deep-bass",
     "groupId": "8a6ee26f-fc78-41d0-8f8c-e6a48765b661"
    },
    "compact, attractive and powerful cabinet": {
     "sentimentAnalysis": "Det usædvanligt lille kabinet opfattes som flot og imponerende kraftfuldt og kombinerer nem placering med høj ydelse.",
     "simpleTitle": "Kompakt, flot og kraftfuldt kabinet",
     "bias": "positive",
     "key": "compact-design",
     "groupId": "08151249-6e0c-4899-ab6e-179d3a5e1dc5"
    },
    "a richer, punchier and more immersive system": {
     "sentimentAnalysis": "Subwooferen supplerer kompakte og aktive højttalere effektivt med mere tyngde, fylde, slagkraft og rumfornemmelse i bunden.",
     "simpleTitle": "Et fyldigere, mere slagkraftigt og mere rummeligt system",
     "bias": "positive",
     "key": "system-enhancement",
     "groupId": "05a6a16c-c956-4614-9f65-4356a74b1329"
    },
    "sleep mode interrupts quiet listening": {
     "sentimentAnalysis": "Den automatiske dvalefunktion er for følsom og kan afbryde musik eller tv ved lavere lydstyrker.",
     "simpleTitle": "Dvaletilstand afbryder stille lytning",
     "bias": "negative",
     "key": "sleep-interruption",
     "groupId": "9e7eb327-3d9b-4779-b305-90a664f3dc5d"
    },
    "high levels can become boomy": {
     "sentimentAnalysis": "Nogle systemer kræver omhyggelig niveaujustering, fordi for høj subwooferlydstyrke kan gøre bunden dominerende og buldrende.",
     "simpleTitle": "Høje niveauer kan blive buldrende",
     "bias": "negative",
     "key": "excess-bass",
     "groupId": "8a6ee26f-fc78-41d0-8f8c-e6a48765b661"
    }
   },
