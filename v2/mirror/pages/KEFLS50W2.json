  "reviews": {
   "summary": "KEF LS50 Wireless II leverer en usædvanligt klar, detaljeret og rummelig lyd med imponerende bas samt en varm og medrivende gengivelse fra et kompakt design. Det elegante udseende, den høje byggekvalitet og de alsidige muligheder for TV, streaming og trådløs tilslutning gør systemet til en komplet high-end-lydløsning. Opsætning via appen er som regel enkel og stabil, men enkelte oplevelser nævner udfald i den trådløse forbindelse, begrænset brugervenlighed samt en til tider klinisk eller for varm klangbalance.",
   "headlines": {
    "detailed, spacious and powerful sound": {
     "sentimentAnalysis": "Højttalerne roses gentagne gange for en ren, meget detaljeret, rummelig og kraftfuld gengivelse med overraskende markant bas.",
     "simpleTitle": "Detaljeret, rummelig og kraftfuld lyd",
     "bias": "positive",
     "key": "detailed-spacious-powerful",
     "groupId": "4e5514cc-20bd-4f7b-8164-c43750181cde"
    },
    "elegant, premium design": {
     "sentimentAnalysis": "De kompakte højttalere beskrives konsekvent som flotte, velbyggede og eksklusive i udtrykket.",
     "simpleTitle": "Elegant premiumdesign",
     "bias": "positive",
     "key": "premium-design",
     "groupId": "8634812c-c09b-46ee-8083-e26a22c6f871"
    },
    "easy setup and flexible connections": {
     "sentimentAnalysis": "Tilslutningerne beskrives ofte som hurtige, stabile og praktiske, mens appen gør opsætning og daglig brug enklere.",
     "simpleTitle": "Nem opsætning og fleksible tilslutninger",
     "bias": "positive",
     "key": "easy-connections",
     "groupId": "183122b5-fd3f-470c-a73f-f91d87859d1c"
    },
    "strong TV performance without extra components": {
     "sentimentAnalysis": "Højttalerne leverer detaljeret, rummelig og kraftfuld TV-lyd, og nogle opsætninger savner hverken centerhøjttaler eller subwoofer.",
     "simpleTitle": "Stærk TV-lyd uden ekstra komponenter",
     "bias": "positive",
     "key": "tv-performance",
     "groupId": "e0f10f0c-d909-4f4a-b154-c6bf51ea9f03"
    },
    "wireless dropouts and usability concerns": {
     "sentimentAnalysis": "Nogle oplevelser beskriver lav brugervenlighed eller trådløse udfald, som kræver kabeltilstand eller en kablet forbindelse.",
     "simpleTitle": "Trådløse udfald og problemer med brugervenlighed",
     "bias": "negative",
     "key": "wireless-usability-issues",
     "groupId": "183122b5-fd3f-470c-a73f-f91d87859d1c"
    },
    "warm and immersive tonal balance": {
     "sentimentAnalysis": "En varm, fyldig og medrivende gengivelse fremhæves til både musik og TV-lyd.",
     "simpleTitle": "Varm og medrivende klangbalance",
     "bias": "positive",
     "key": "warm-immersive",
     "groupId": "4e5514cc-20bd-4f7b-8164-c43750181cde"
    },
    "some tonal and clarity limitations": {
     "sentimentAnalysis": "En vurdering oplever gengivelsen som lidt klinisk, mens en anden oplever lavere taleforståelighed og instrumentadskillelse på grund af den varme tuning.",
     "simpleTitle": "Visse begrænsninger i klang og klarhed",
     "bias": "negative",
     "key": "tonal-limitations",
     "groupId": "4e5514cc-20bd-4f7b-8164-c43750181cde"
    },
    "long-term durability remains uncertain": {
     "sentimentAnalysis": "Købstilfredsheden dæmpes af håb og spørgsmål om, hvor længe højttalerne forbliver pålidelige.",
     "simpleTitle": "Langtidsholdbarheden er stadig usikker",
     "bias": "meh",
     "key": "durability-uncertain",
     "groupId": "bf8f13e7-d40e-4948-8276-2a5aa7d827de"
    }
   },
