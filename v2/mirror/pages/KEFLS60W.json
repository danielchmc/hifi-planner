  "displayBookDemo": true,
  "reviews": {
   "summary": "KEF LS60 Wireless leverer en varm, fyldig og yderst detaljeret lyd med et imponerende stereoperspektiv, dyb bas og fremragende dynamik. Det slanke, elegante design kombineres med nem installation, enkel betjening og stærke forbindelsesmuligheder. Begrænsede EQ-muligheder og enkelte oplevelser af en tynd bas ved lav lydstyrke er mindre ulemper, mens den samlede tilfredshed er særdeles høj.",
   "headlines": {
    "detailed, spacious stereo sound": {
     "sentimentAnalysis": "Anmeldelserne roser den brede stereoseparation, den rummelige gengivelse, klarheden, detaljegraden og dynamikken.",
     "simpleTitle": "Detaljeret, rummelig stereolyd",
     "bias": "positive",
     "key": "stereo_detail",
     "groupId": "ca5df91f-42f0-4157-b853-04f237837499"
    },
    "strong, deep and balanced bass": {
     "sentimentAnalysis": "Flere anmeldelser beskriver bassen som fremragende, dyb og flot eller som en del af en velafbalanceret gengivelse.",
     "simpleTitle": "Kraftig, dyb og afbalanceret bas",
     "bias": "positive",
     "key": "bass_quality",
     "groupId": "ca5df91f-42f0-4157-b853-04f237837499"
    },
    "slim and attractive design": {
     "sentimentAnalysis": "Anmeldelserne roser den slanke profil, det flotte udseende og den gode integration i indretningen.",
     "simpleTitle": "Slankt og attraktivt design",
     "bias": "positive",
     "key": "design_appeal",
     "groupId": "5e58f173-1910-4111-b2a7-97336b394e6a"
    },
    "easy installation and operation": {
     "sentimentAnalysis": "Anmeldelserne fremhæver enkel installation, nem betjening og god konnektivitet.",
     "simpleTitle": "Nem installation og betjening",
     "bias": "positive",
     "key": "easy_use",
     "groupId": "e598fe36-b63e-42be-b78d-333bbef5ccd4"
    },
    "limited EQ and app control": {
     "sentimentAnalysis": "Anmeldelserne kritiserer de begrænsede equalizer-muligheder i KEF-appen og finder alternativ software mere fleksibel eller praktisk til afspilning.",
     "simpleTitle": "Begrænset EQ- og appstyring",
     "bias": "negative",
     "key": "app_eq",
     "groupId": "e598fe36-b63e-42be-b78d-333bbef5ccd4"
    },
    "bass can feel thin at low volume": {
     "sentimentAnalysis": "To anmeldelser foreslår en subwoofer, fordi bunden kan mangle ekstra energi eller virke tynd, især ved lav lydstyrke.",
     "simpleTitle": "Bassen kan virke tynd ved lav lydstyrke",
     "bias": "negative",
     "key": "bass_limitation",
     "groupId": "ca5df91f-42f0-4157-b853-04f237837499"
    }
   },
