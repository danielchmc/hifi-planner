  "reviews": {
   "summary": "KEF LSX II leverer bemærkelsesværdigt klar, naturlig og omsluttende lyd fra et kompakt kabinet med detaljerede vokaler, levende musikgengivelse og overraskende fyldig bas. Det elegante design, de mange tilslutningsmuligheder og den enkle trådløse streaming gør højttalerne alsidige til skrivebord, TV, kontor og stue. Den dybe bas kan være begrænset i større rum, så en subwoofer kan være attraktiv, mens appopsætning, lejlighedsvise forbindelsesproblemer og registreringskrav skaber irritation.",
   "headlines": {
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, naturlige, detaljerede og rummelige gengivelse samt stærke vokaler og god musikalsk adskillelse.",
     "simpleTitle": "Klar, detaljeret og omsluttende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "70987bf1-1343-4502-b397-c1c32bde52ce"
    },
    "app setup and connections can be frustrating": {
     "sentimentAnalysis": "Anmeldelserne nævner lejlighedsvise problemer med Wi-Fi, app og HDMI-genkendelse, mens en anmeldelse kraftigt kritiserer obligatorisk registrering med personlige data og afhængighed af smartphone.",
     "simpleTitle": "Appopsætning og forbindelser kan være frustrerende",
     "bias": "negative",
     "key": "app-issues",
     "groupId": "f1ae158d-19e5-4976-8fd7-799762b0ea60"
    },
    "surprisingly full bass for the size": {
     "sentimentAnalysis": "Flere anmeldelser oplever bassen som dyb, kontrolleret og tilstrækkelig uden subwoofer, især set i forhold til de kompakte kabinetter.",
     "simpleTitle": "Overraskende fyldig bas i størrelsen",
     "bias": "positive",
     "key": "bass",
     "groupId": "70987bf1-1343-4502-b397-c1c32bde52ce"
    },
    "deep bass may need a subwoofer": {
     "sentimentAnalysis": "Nogle anmeldelser oplever begrænset dybbas og anbefaler en subwoofer for ægte fuldbåndsgengivelse eller større rum.",
     "simpleTitle": "Dyb bas kan kræve en subwoofer",
     "bias": "negative",
     "key": "bass-limited",
     "groupId": "70987bf1-1343-4502-b397-c1c32bde52ce"
    },
    "compact, elegant and versatile design": {
     "sentimentAnalysis": "Anmeldelserne værdsætter det kompakte format, den fine finish og egnetheden til skrivebord, reol eller TV.",
     "simpleTitle": "Kompakt, elegant og alsidigt design",
     "bias": "positive",
     "key": "design",
     "groupId": "34134367-75c4-46f0-b7c0-21e3af68f2ee"
    },
    "wireless streaming and connections are strong": {
     "sentimentAnalysis": "Anmeldelserne roser de mange indgange, den trådløse betjening, AirPlay og integrationen med streamingtjenester.",
     "simpleTitle": "Trådløs streaming og tilslutninger fungerer godt",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "f1ae158d-19e5-4976-8fd7-799762b0ea60"
    }
   },
