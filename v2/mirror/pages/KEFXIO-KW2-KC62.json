     "reviews": {
      "summary": "KEF KC62 roses bredt som en bemærkelsesværdigt kompakt subwoofer, der leverer dyb, ren, slagkraftig og præcis bas, som beriger musik, film og aktive højttalersystemer markant. Integrationen med KEF- og andre højttalere er som regel fremragende og giver en balanceret, sømløs og mere rumlig gengivelse, mens det flotte kompakte design passer til mindre rum. En tilbagevendende svaghed er den for følsomme dvaletilstand, som kan afbryde stille lytning, og nogle systemer kan blive for buldrende ved for højt niveau.",
      "headlines": {
       "seamless enhancement of speaker systems": {
        "sentimentAnalysis": "Subwooferen integreres naturligt med forskellige højttalersystemer og tilfører dybde, slagkraft og rumfornemmelse uden at lyde adskilt.",
        "simpleTitle": "Sømløs forbedring af højttalersystemer",
        "bias": "positive",
        "key": "seamless-integration",
        "groupId": "c332d132-d379-4925-97ff-7e4b02decc10"
       },
       "deep, clean and precise bass": {
        "sentimentAnalysis": "KC62 leverer usædvanligt dyb, ren og kontrolleret bas for sin størrelse med højt output og stor præcision.",
        "simpleTitle": "Dyb, ren og præcis bas",
        "bias": "positive",
        "key": "deep-bass",
        "groupId": "03333bd3-54fd-4f46-987c-666b9e7bf788"
       },
       "compact and attractive construction": {
        "sentimentAnalysis": "Det lille format, den solide konstruktion og det flotte udseende gør KC62 nem at placere og diskret i rummet.",
        "simpleTitle": "Kompakt og attraktiv konstruktion",
        "bias": "positive",
        "key": "compact-design",
        "groupId": "c0540f0c-9df9-42e5-a8b3-da1f3165ea64"
       },
       "sleep mode interrupts quiet listening": {
        "sentimentAnalysis": "Subwooferen kan gå i dvale under stille passager eller scener, så der må lyttes højere, hvilket forringer oplevelsen.",
        "simpleTitle": "Dvaletilstand afbryder stille lytning",
        "bias": "negative",
        "key": "sleep-interruption",
        "groupId": "232ab4da-5291-430f-8881-04c2c8cd8694"
       },
       "level requires careful adjustment": {
        "sentimentAnalysis": "Korrekt kalibrering er vigtig, da for højt niveau kan gøre bassen dominerende, mørk eller buldrende.",
        "simpleTitle": "Niveauet kræver omhyggelig justering",
        "bias": "negative",
        "key": "level-adjustment",
        "groupId": "03333bd3-54fd-4f46-987c-666b9e7bf788"
       }
      },
