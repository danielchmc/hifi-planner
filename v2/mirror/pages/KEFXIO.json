  "displayBookDemo": true,
  "reviews": {
   "summary": "KEF Xio får stor ros for varm, fyldig og omsluttende lyd, mens den kraftfulde bas ofte gør en separat subwoofer overflødig. Stereo- og Dolby Atmos-gengivelsen, det eksklusive design og den klare anbefaling fremhæves i anmeldelserne. Softwareintegrationen har stadig svagheder, og mellemtoner og diskant overgår muligvis ikke billigere soundbarer.",
   "headlines": {
    "warm, full and highly engaging sound": {
     "sentimentAnalysis": "Anmeldelserne roser samstemmende lyden som fyldig, imponerende og af høj kvalitet.",
     "simpleTitle": "Varm, fyldig og meget medrivende lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "775fd45d-ff54-45d8-903e-000ad8d1bbed"
    },
    "powerful bass without needing a subwoofer": {
     "sentimentAnalysis": "Basgengivelsen beskrives gentagne gange som så kraftig og tilfredsstillende, at en separat subwoofer kan undværes.",
     "simpleTitle": "Kraftfuld bas uden behov for subwoofer",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "775fd45d-ff54-45d8-903e-000ad8d1bbed"
    },
    "clean, premium-looking design": {
     "sentimentAnalysis": "Soundbaren roses for finish og elegante udseende, også ved vægmontering.",
     "simpleTitle": "Elegant design med eksklusivt udtryk",
     "bias": "positive",
     "key": "design-build",
     "groupId": "8e7ee09f-8ce5-44e0-91b0-7055584aa732"
    }
   },
