  "reviews": {
   "summary": "LYNGDORF BW2 leverer varm, slagkraftig og imponerende dyb bas fra et kompakt kabinet i høj kvalitet. Den stramme, præcise og rene integration med Lyngdorf-forstærkere og RoomPerfect skaber et medrivende og sammenhængende lydbillede uden generende bulder. Den enkle opsætning, fleksible placering og stærke værdi gør BW2 særligt attraktiv, selv om større rum eller krævende filmlyd kan have fordel af et par, og den manglende app er en mindre ulempe.",
   "headlines": {
    "deep, tight and precise bass": {
     "sentimentAnalysis": "Anmeldelserne roser gennemgående bassen som dyb, stram, hurtig, ren og veldefineret.",
     "simpleTitle": "Dyb, stram og præcis bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "2ed32b90-1714-4c1a-98e4-aece713e8342"
    },
    "coherent, immersive system integration": {
     "sentimentAnalysis": "Lyngdorf-forstærkere, RoomPerfect og kompatible højttalere beskrives gentagne gange som en kilde til en komplet og sammenhængende gengivelse.",
     "simpleTitle": "Sammenhængende og medrivende systemintegration",
     "bias": "positive",
     "key": "setup",
     "groupId": "282ca100-f664-4f15-bb14-f0fabb99cc8e"
    },
    "compact and easy to place": {
     "sentimentAnalysis": "Det slanke kabinet roses gentagne gange for at passe i små rum, under møbler eller bag gardiner, samtidig med at det leverer mere, end størrelsen antyder.",
     "simpleTitle": "Kompakt og let at placere",
     "bias": "positive",
     "key": "design",
     "groupId": "00ed55c6-67b5-40ae-99b3-7a8565e91a8e"
    },
