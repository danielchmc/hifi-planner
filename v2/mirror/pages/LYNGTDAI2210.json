  "displayBookDemo": true,
  "reviews": {
   "summary": "LYNGDORF TDAI-2210 roses bredt som en kraftfuld, kompakt streamingforstærker med varm, detaljeret og omsluttende lyd, en bemærkelsesværdig rolig baggrund og rigeligt overskud til krævende højttalere. RoomPerfect opleves som regel som let at bruge og meget effektivt med strammere bas, større transparens og bedre tilpasning til rummet. Enkelte anmeldelser nævner dog umoden software, app-udfald, streamingafbrydelser og HDMI-/CEC-problemer, men den fremragende lyd og store fleksibilitet gør stadig forstærkeren til en overbevisende high-end-opgradering.",
   "headlines": {
    "detailed, powerful and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en klar, varm til neutral gengivelse med mange detaljer, dyb kontrolleret bas, lav forvrængning og en meget rolig baggrund.",
     "simpleTitle": "Detaljeret, kraftfuld og omsluttende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "46fd8544-1616-470b-92aa-53e620846fdb"
    },
    "roomPerfect makes setup easy and improves bass control": {
     "sentimentAnalysis": "RoomPerfect roses gentagne gange for den guidede opsætning og hørbare forbedringer i basrenhed, transparens og rumtilpasning.",
     "simpleTitle": "RoomPerfect gør opsætningen nem og forbedrer baskontrollen",
     "bias": "positive",
     "key": "roomperfect",
     "groupId": "f0a93acb-d767-4311-9507-204fb6022fd6"
    },
    "software and connections can be unreliable": {
     "sentimentAnalysis": "Flere anmeldelser nævner fejl, app-afbrydelser, streamingudfald, standbyproblemer og ustabil HDMI-/CEC-adfærd, som nogle gange kræver genstart eller Ethernet.",
     "simpleTitle": "Software og forbindelser kan være ustabile",
     "bias": "negative",
     "key": "software",
     "groupId": "a1f5b035-2374-4b43-b780-0dbd19334ab2"
    },
    "flexible controls and streaming features": {
     "sentimentAnalysis": "Anmeldelserne roser det brede udvalg af ind- og udgange, justerbare profiler og EQ, enkel appstyring samt problemfri integration af Spotify, Tidal og Qobuz.",
     "simpleTitle": "Fleksibel styring og streamingfunktioner",
     "bias": "positive",
     "key": "software",
     "groupId": "a1f5b035-2374-4b43-b780-0dbd19334ab2"
    }
   },
