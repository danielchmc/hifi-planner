  "displayBookDemo": true,
  "reviews": {
   "summary": "LYNGDORF TDAI3400 roses bredt som en kraftfuld, transparent og meget detaljeret forstærker med et usædvanligt effektivt RoomPerfect-rumkorrektionssystem. Opsætning og app-styring opleves som enkel, mens streaming og de mange funktioner gør apparatet til en alsidig forstærker og streamer. Den høje pris og de begrænsede muligheder i analogmodulet er ulemper, og der nævnes lejlighedsvise Spotify-udfald samt en langsom fjernbetjening, men den samlede vurdering er meget begejstret.",
   "headlines": {
    "transparent, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en ren, præcis og meget afslørende gengivelse med stærk dynamik, fokus, dybde og musikalsk engagement.",
     "simpleTitle": "Transparent, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "13d677b5-5311-44cc-b908-b5b7fbb87025"
    },
    "roomPerfect makes difficult rooms sound right": {
     "sentimentAnalysis": "RoomPerfect får gentagne gange æren for at forbedre rumakustikken, især i bassen, samtidig med at systemet er let at opsætte.",
     "simpleTitle": "RoomPerfect får vanskelige rum til at lyde rigtigt",
     "bias": "positive",
     "key": "roomperfect",
     "groupId": "c6fddab2-ebbe-4da2-907f-425053e79ec4"
    },
    "easy app control and broad functionality": {
     "sentimentAnalysis": "Appen, indgangsjusteringen og de mange funktioner opleves som intuitive og alsidige, og appen kan ofte erstatte fjernbetjeningen.",
     "simpleTitle": "Nem app-styring og mange funktioner",
     "bias": "positive",
     "key": "features",
     "groupId": "e8f29ee5-c018-4da7-b72d-01468f3131a1"
    },
    "powerful enough for demanding speakers": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den ubesværede kontrol over store eller krævende højttalere og den usædvanligt stærke forstærkerkapacitet.",
     "simpleTitle": "Kraftfuld nok til krævende højttalere",
     "bias": "positive",
     "key": "power",
     "groupId": "90fc725d-ee91-4db0-b2db-a810b1861758"
    },
    "premium pricing limits the value proposition": {
     "sentimentAnalysis": "Produktet anses for exceptionelt, men dyrt; prisstigningen og de ekstra betalte analogmuligheder reducerer værdien.",
     "simpleTitle": "Den høje pris begrænser værdien",
