  "displayBookDemo": true,
  "reviews": {
   "summary": "MARACINEMA40 bliver bredt rost som en kraftfuld og velafstemt AV-receiver med varm, detaljeret og omsluttende lyd til både stereomusik og hjemmebio. Den stærke forstærkning, den brede formatunderstøttelse, rumkorrektionen og den fremragende byggekvalitet gør den til en overbevisende opgradering med god værdi for pengene. Opsætningen er ofte enkel med guiden, men menuer, lydformat-navigation, softwareintegration og visse multiroom-funktioner kan føles unødigt komplekse.",
   "headlines": {
    "powerful, detailed sound for music and films": {
     "sentimentAnalysis": "Anmeldelserne beskriver en kraftfuld, klar og omsluttende gengivelse med stærk stereoydelse, fremragende hjemmebioeffekt, mange detaljer og god kontrol over højttalerne.",
     "simpleTitle": "Kraftfuld, detaljeret lyd til musik og film",
     "bias": "positive",
     "key": "sound",
     "groupId": "64ff25b4-e553-4351-bdbe-7d1e2ac94953"
    },
    "setup is often easy with the assistant": {
     "sentimentAnalysis": "Flere anmeldelser beskriver opsætningen som enkel, godt dokumenteret eller hurtigt gennemførlig, især med opsætningsguiden.",
     "simpleTitle": "Opsætningen er ofte enkel med guiden",
     "bias": "positive",
     "key": "setup",
     "groupId": "70f1c750-234f-4450-b1d5-e64e61035380"
    },
    "premium design and solid construction": {
     "sentimentAnalysis": "Receiveren roses gentagne gange for attraktivt design, materialer i høj kvalitet, fremragende finish og solid tyngde.",
     "simpleTitle": "Eksklusivt design og solid konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "73f062f4-5639-4d66-9f25-e2d337d9e76a"
    },
    "a clear upgrade over older receivers": {
     "sentimentAnalysis": "Cinema 40 beskrives som mere fyldig, musikalsk og kompetent end tidligere udstyr fra Denon, NAD og Marantz.",
     "simpleTitle": "En tydelig opgradering fra ældre receivere",
     "bias": "positive",
     "key": "sound",
     "groupId": "64ff25b4-e553-4351-bdbe-7d1e2ac94953"
    },
    "menus and controls can be complex": {
     "sentimentAnalysis": "Navigationen gennem lydformater, indstillinger, indgange og rumkorrektionsmålinger kritiseres som uintuitiv eller omstændelig.",
     "simpleTitle": "Menuer og betjening kan være komplekse",
     "bias": "negative",
     "key": "setup",
     "groupId": "70f1c750-234f-4450-b1d5-e64e61035380"
    },
    "heos streaming is good but has limitations": {
     "sentimentAnalysis": "Streamingkvalitet og musik i hele hjemmet roses, mens HEOS-funktioner og Bluetooth-adfærd har tydelige begrænsninger.",
     "simpleTitle": "HEOS-streaming er god, men har begrænsninger",
     "bias": "meh",
     "key": "streaming",
     "groupId": "c9eee505-b3a1-407b-8a0c-1f9ecc8ec118"
    }
   },
   "grouping": {
    "64ff25b4-e553-4351-bdbe-7d1e2ac94953": {
     "title": "Lydkvalitet",
