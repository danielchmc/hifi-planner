  "displayBookDemo": true,
  "reviews": {
   "summary": "MARACTON3 leverer varm, fyldig og overraskende rummelig lyd fra et kompakt kabinet med tilfredsstillende bas og rigelig kraft til små og mellemstore rum. Retrodesignet, den solide konstruktion og den enkle Bluetooth-betjening gør højttaleren særdeles attraktiv til hverdagsbrug. Den gode værdi for pengene, tonekontrollerne og den nemme opsætning vækker stor begejstring, selv om netdrift, energisparefunktion og lejlighedsvis tomgangsstøj er begrænsninger.",
   "headlines": {
    "strong value for the money": {
     "sentimentAnalysis": "Den kompakte højttaler opfattes gentagne gange som et godt køb med høj kvalitet, god ydelse og mange funktioner til prisen.",
     "simpleTitle": "God værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "94ab43e0-286a-48ec-92f8-02174ce0b8ea"
    },
    "warm, full and powerful sound": {
     "sentimentAnalysis": "Højttaleren roses bredt for varm, fyldig og detaljeret lyd, kraftig bas og imponerende lydstyrke i forhold til størrelsen.",
     "simpleTitle": "Varm, fyldig og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "46b21454-0291-40d9-b6c9-e04748ee0710"
    },
    "distinctive retro design": {
     "sentimentAnalysis": "Det klassiske retrolook beskrives gentagne gange som stilfuldt, attraktivt og særpræget, hvilket gør højttaleren til et flot indretningselement.",
     "simpleTitle": "Markant retrodesign",
     "bias": "positive",
     "key": "design",
     "groupId": "2dde6074-8155-43bc-87f9-ffa9914512a9"
    },
    "easy setup and reliable connections": {
     "sentimentAnalysis": "Bluetooth-parring, skift mellem enheder og daglig betjening opleves konsekvent som hurtig, intuitiv og pålidelig.",
     "simpleTitle": "Nem opsætning og stabile forbindelser",
     "bias": "positive",
     "key": "usability",
     "groupId": "327331b1-41b5-47f1-96a3-21bb11223575"
    },
    "sound can be limited in some situations": {
     "sentimentAnalysis": "En mindre gruppe nævner for lidt bas og lydstyrke, ubalanceret klang ved højere niveauer, begrænset spredning i rummet og svag susen i stilhed.",
     "simpleTitle": "Lyden kan være begrænset i visse situationer",
     "bias": "negative",
     "key": "sound",
     "groupId": "46b21454-0291-40d9-b6c9-e04748ee0710"
    }
   },
