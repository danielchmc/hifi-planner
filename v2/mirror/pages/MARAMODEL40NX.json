  "reviews": {
   "summary": "MARAMODEL40NX roses bredt som en førsteklasses og fleksibel netværksforstærker med varm, detaljeret og kraftfuld lyd, stærke tilslutningsmuligheder og elegant konstruktion. Streaming, tv-lyd og kildeintegration er blandt de største styrker, mens HEOS-appen får blandede vurderinger, og den klanglige farvning ikke passer til alle. Samlet leverer forstærkeren en omsluttende, slagkraftig og raffineret oplevelse med stor værdi som alt-i-en-system.",
   "headlines": {
    "warm, detailed and powerful sound": {
     "sentimentAnalysis": "Anmelderne roser den varme, klare, detaljerede og kraftfulde gengivelse, inklusive fyldig bas ved lav lydstyrke.",
     "simpleTitle": "Varm, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "warm detailed sound",
     "groupId": "8ccee1cd-ba53-4aaa-9c98-20571c9fbe37"
    },
    "strong sound with well-matched speakers": {
     "sentimentAnalysis": "Forstærkeren beskrives gentagne gange som et fremragende match til flere højttalermærker med et kraftfuldt, behageligt og musikalsk resultat.",
     "simpleTitle": "Kraftfuld lyd med passende højttalere",
     "bias": "positive",
     "key": "speaker matching",
     "groupId": "8ccee1cd-ba53-4aaa-9c98-20571c9fbe37"
    },
    "heos app is capable but inconsistent": {
     "sentimentAnalysis": "Nogle finder appen enkel og godt integreret, mens andre kritiserer brugerfladen og integrationen af musikapps fra tredjeparter sammenlignet med alternativer.",
     "simpleTitle": "HEOS-appen er alsidig, men ujævn",
     "bias": "meh",
     "key": "heos app",
     "groupId": "25d9d5f2-16c6-459e-a62e-e30e17abd438"
    },
    "broad streaming and source support": {
     "sentimentAnalysis": "Anmeldelserne fremhæver AirPlay, USB, Tidal, Spotify Connect, HDMI ARC, tv-lyd og flere fysiske kilder som nyttige styrker.",
     "simpleTitle": "Omfattende streaming- og kildeunderstøttelse",
     "bias": "positive",
     "key": "source flexibility",
     "groupId": "372bc8a9-6aae-47d1-a5b4-1cdf1244b744"
    },
    "tonal balance can sound coloured": {
     "sentimentAnalysis": "En anmeldelse kritiserer den ikke-neutrale mellem- og diskantgengivelse, mens en anden accepterer den velkendte lyd, men finder den sorte finish mindre overbevisende.",
     "simpleTitle": "Klangbalancen kan virke farvet",
     "bias": "negative",
     "key": "tonal coloration",
     "groupId": "8ccee1cd-ba53-4aaa-9c98-20571c9fbe37"
    },
    "premium, elegant construction": {
     "sentimentAnalysis": "Forstærkeren roses for sit attraktive design, førsteklasses udseende og solide udførelse trods et forbehold over for den sorte finish.",
     "simpleTitle": "Førsteklasses, elegant konstruktion",
     "bias": "positive",
