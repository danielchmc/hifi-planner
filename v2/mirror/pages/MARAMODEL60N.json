  "displayBookDemo": true,
  "reviews": {
   "summary": "Marantz 60N får stor ros for en varm, afbalanceret, detaljeret og kraftfuld lyd med særligt stærk gengivelse af musik og TV-lyd. De mange tilslutningsmuligheder og problemfri streaming via HEOS, Tidal, Spotify, HDMI-ARC, Bluetooth, Wi-Fi og phono gør forstærkeren meget alsidig. Det elegante design og den generelt enkle betjening fuldender en fremragende pakke, selv om opsætningen kan virke forvirrende, og HEOS-appen samt lydstyrkekontrollen indimellem giver problemer.",
   "headlines": {
    "broad connectivity and reliable streaming": {
     "sentimentAnalysis": "Understøttelse af Tidal, Spotify, HEOS, HDMI-ARC, Bluetooth, Wi-Fi, USB og phono gør integrationen af kilder fleksibel og pålidelig.",
     "simpleTitle": "Mange tilslutninger og stabil streaming",
     "bias": "positive",
     "key": "versatile-streaming",
     "groupId": "d0ee4b36-0760-4936-9b78-967152515ab9"
    },
    "warm, detailed and powerful sound": {
     "sentimentAnalysis": "En varm, rummelig, afbalanceret og slagkraftig gengivelse leverer tydelige detaljer og stor musikalsk gennemslagskraft.",
     "simpleTitle": "Varm, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "warm-detailed-sound",
     "groupId": "258b7546-93de-42e4-92e6-aa89131f8803"
    },
    "simple everyday operation": {
     "sentimentAnalysis": "Overskuelige betjeningselementer og nem installation gør den daglige brug behagelig for mange brugere.",
     "simpleTitle": "Enkel betjening i hverdagen",
     "bias": "positive",
     "key": "easy-operation",
     "groupId": "2ac5aa73-7a18-45b4-88f3-80b53a978866"
    },
    "crystal-clear and immersive presentation": {
     "sentimentAnalysis": "Den rene, dybe og medrivende lyd værdsættes især for klarheden og gengivelsen af klassisk musik.",
     "simpleTitle": "Krystalklar og medrivende gengivelse",
     "bias": "positive",
     "key": "clear-immersive-presentation",
     "groupId": "258b7546-93de-42e4-92e6-aa89131f8803"
    },
    "stylish, well-finished construction": {
     "sentimentAnalysis": "Det markante, elegante ydre og den flotte finish giver den kapable forstærker ekstra visuel appel.",
     "simpleTitle": "Stilfuldt design og flot finish",
     "bias": "positive",
     "key": "stylish-construction",
     "groupId": "125226ea-ea30-4880-bc07-fbee298c876e"
    },
    "setup and app controls can be frustrating": {
     "sentimentAnalysis": "Den første kabelføring, netværksopsætningen, HEOS-frysninger og forvirrende lydstyrkekontrol kan besværliggøre betjeningen og medføre pludselige lydstyrkestigninger.",
