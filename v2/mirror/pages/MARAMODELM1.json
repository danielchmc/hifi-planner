  "displayBookDemo": true,
  "reviews": {
   "summary": "Marantz M1 leverer varm, klar og meget detaljeret lyd med masser af kraft fra et imponerende kompakt kabinet. Streaming, tv-lyd og samspillet med forskellige højttalere får megen ros, mens Dirac giver særligt effektiv kontrol over bas og rumkorrektion. HEOS-appen fungerer for mange, men kan føles besværlig eller ustabil, og manglen på en fysisk fjernbetjening er den tydeligste betjeningsulempe.",
   "headlines": {
    "warm, clear and detailed sound": {
     "sentimentAnalysis": "M1 roses gentagne gange for varm, åben, klar, musikalsk og meget detaljeret gengivelse med flere forskellige højttalersystemer.",
     "simpleTitle": "Varm, klar og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "289bfe7f-3d9d-41b0-8bfb-03fd5fe1b171"
    },
    "powerful performance in a compact format": {
     "sentimentAnalysis": "Ejere beskriver ubesværet drift af både kompakte og store gulvhøjttalere, høje lydniveauer, kraftig bas og usædvanligt meget effekt fra det lille kabinet.",
     "simpleTitle": "Kraftfuld ydelse i kompakt format",
     "bias": "positive",
     "key": "power",
     "groupId": "408963ee-d00e-417b-b822-8f3463d28eb2"
    },
    "heos works, but feels inconsistent": {
     "sentimentAnalysis": "HEOS anses for brugbar og til tider god, men flere ejere finder brugerfladen middelmådig, besværlig, netværksfølsom eller mangelfuld med hensyn til computer- og hardwarebetjening.",
     "simpleTitle": "HEOS fungerer, men føles ustabil",
     "bias": "meh",
     "key": "app",
     "groupId": "2a5c5e1d-619b-4164-9e28-99d4a3799858"
    },
    "strong TV and streaming integration": {
     "sentimentAnalysis": "TV-afspilning, tabsfri streaming, Tidal Connect, AirPlay, Spotify Connect, dialogforbedring og fleksible subwooferindstillinger fremhæves som vigtige styrker.",
     "simpleTitle": "Stærk TV- og streamingintegration",
     "bias": "positive",
     "key": "tvstream",
     "groupId": "dffa411a-4afc-487b-83ec-82b85079f835"
    }
   },
