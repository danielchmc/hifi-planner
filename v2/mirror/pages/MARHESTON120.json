  "reviews": {
   "summary": "MARHEaston120 leverer et kraftfuldt, varmt og omsluttende lydbillede med tydelige stemmer, god musikgengivelse og kraftig bas, som ofte bliver endnu bedre med den matchende subwoofer. Installationen er generelt hurtig og enkel, mens appen og betjeningen på enheden giver fleksibel kontrol efter en kort tilvænning. Elegant design og solid byggekvalitet fuldender en særdeles positiv pakke, selv om det brede kabinet ikke passer til alle opsætninger.",
   "headlines": {
    "rich, powerful sound for music and films": {
     "sentimentAnalysis": "Anmeldelserne beskriver gennemgående lyden som kraftfuld, klar, rummelig og behagelig til musik, film og tv.",
     "simpleTitle": "Fyldig, kraftfuld lyd til musik og film",
     "bias": "positive",
     "key": "sound",
     "groupId": "98ce52aa-7b47-44dc-b3eb-02f4177d9c17"
    },
    "deep bass is impressive, with the subwoofer adding extra depth": {
     "sentimentAnalysis": "Anmeldelserne roser den kraftige indbyggede bas og beskriver den matchende subwoofer som en effektiv opgradering med større dybde.",
     "simpleTitle": "Imponerende dyb bas, hvor subwooferen giver ekstra dybde",
     "bias": "positive",
     "key": "bass",
     "groupId": "5ab41aae-0dec-4308-a512-80af23aab65c"
    },
    "app and onboard controls offer flexible operation": {
     "sentimentAnalysis": "Appen og de fysiske betjeningselementer roses gentagne gange for at gøre lydjustering og daglig brug nem.",
     "simpleTitle": "App og betjening på enheden giver fleksibel kontrol",
     "bias": "positive",
     "key": "controls",
     "groupId": "9a332030-debf-44b5-88d4-45c38b8b91f8"
    },
    "installation is quick and uncomplicated": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den nemme og hurtige installation.",
     "simpleTitle": "Installationen er hurtig og enkel",
     "bias": "positive",
     "key": "installation",
     "groupId": "338dc8f3-6b22-4acb-947f-b1d4a5854986"
    },
    "clear voices remain easy to follow": {
     "sentimentAnalysis": "Soundbaren roses for tydelig, ikke-skarp dialog og god gengivelse af stemmer selv med baggrundsstøj.",
     "simpleTitle": "Tydelige stemmer er nemme at følge",
     "bias": "positive",
     "key": "sound",
     "groupId": "98ce52aa-7b47-44dc-b3eb-02f4177d9c17"
    }
   },
