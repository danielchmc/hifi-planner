  "reviews": {
   "summary": "MARSHALL120 leverer et varmt, kraftfuldt og medrivende lydbillede med tydelige stemmer, stærk bas samt god musik- og filmgengivelse. Styringen er alsidig via app, betjening på enheden og rumtilpasning, mens installationen generelt er hurtig og enkel. Det eksklusive design og den solide udførelse øger appellen, selv om det brede kabinet og et lejlighedsvist ønske om en subwoofer er mindre ulemper.",
   "headlines": {
    "warm, clear and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver kraftfuld, klar og behagelig lyd til musik, film og stemmer samt en medrivende gengivelse, der er en tydelig forbedring i forhold til tidligere soundbarer.",
     "simpleTitle": "Varm, klar og medrivende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "da6f4303-46c1-4f83-926f-728a830b74c1"
    },
    "powerful bass, with optional subwoofer depth": {
     "sentimentAnalysis": "Soundbaren leverer allerede alene en tilfredsstillende, kraftig bas, mens den matchende subwoofer tilfører endnu mere dybde og slagkraft.",
     "simpleTitle": "Kraftig bas med ekstra dybde fra valgfri subwoofer",
     "bias": "positive",
     "key": "bass",
     "groupId": "30cefac4-e641-4933-8be3-02e6d4fb8d53"
    },
    "flexible, capable controls": {
     "sentimentAnalysis": "Rumtilpasning, appstyring og fysiske betjeningselementer roses for at gøre soundbaren nem at tilpasse og bruge.",
     "simpleTitle": "Fleksibel og effektiv betjening",
     "bias": "positive",
     "key": "controls",
     "groupId": "89fbcdbf-eb3f-42b0-8ed4-502e683c8004"
    },
    "quick, easy installation": {
     "sentimentAnalysis": "Installationen beskrives gentagne gange som hurtig, problemfri og enkel.",
     "simpleTitle": "Hurtig og enkel installation",
     "bias": "positive",
     "key": "installation",
     "groupId": "edb718bb-fad8-41ff-9454-bc233df99478"
    },
    "premium styling and build": {
     "sentimentAnalysis": "Udseendet opfattes som attraktivt og eksklusivt, og en anmeldelse fremhæver desuden den fremragende udførelse.",
     "simpleTitle": "Eksklusivt design og solid udførelse",
     "bias": "positive",
     "key": "design",
     "groupId": "aac78129-9dc1-4563-acb4-5a505c151c54"
    }
   },
