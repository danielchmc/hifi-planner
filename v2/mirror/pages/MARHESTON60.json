  "reviews": {
   "summary": "MARHESTON60 leverer en varm, fyldig og slagkraftig lyd, der især fungerer godt til tv og film, mens Dolby Atmos giver en immersiv rumfornemmelse. Musik er behagelig, især ved rolige optagelser, men komplekse arrangementer mangler adskillelse og dynamik sammenlignet med separate højttalere. Soundbaren er overordnet nem at bruge og har et stilfuldt design, men appen kan være frustrerende, og HDMI-forbindelsens stabilitet er et problem.",
   "headlines": {
    "full, punchy sound": {
     "sentimentAnalysis": "Lyden roses som fyldig, behagelig og kraftfuld i forhold til soundbarens størrelse, og en ekstra subwoofer savnes ikke umiddelbart.",
     "simpleTitle": "Fyldig og slagkraftig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "d71993cf-9280-469c-8319-341a03f3effd"
    },
    "good for films and television": {
     "sentimentAnalysis": "Dolby Surround- eller Atmos-ydelsen vurderes som mere end tilstrækkelig til film, selv om den ikke kan erstatte et komplet system med flere højttalere.",
     "simpleTitle": "God til film og tv",
     "bias": "positive",
     "key": "sound",
     "groupId": "d71993cf-9280-469c-8319-341a03f3effd"
    },
    "music lacks high-end dynamics": {
     "sentimentAnalysis": "Musikafspilningen er behagelig ved roligt materiale, men når især ved komplekse arrangementer ikke niveauet fra en god forstærker og separate high-end-højttalere.",
     "simpleTitle": "Musik mangler high-end-dynamik",
     "bias": "negative",
     "key": "sound",
     "groupId": "d71993cf-9280-469c-8319-341a03f3effd"
    },
    "app is slow and difficult to connect": {
     "sentimentAnalysis": "Appen kritiseres for upålidelig parring på tværs af telefoner og langsom ydeevne, især på en nyere iPhone.",
     "simpleTitle": "Appen er langsom og svær at forbinde",
     "bias": "negative",
     "key": "app",
     "groupId": "374594d6-fc29-4c68-be8c-d64f559ff3b9"
    }
   },
