  "displayBookDemo": true,
  "reviews": {
   "summary": "MARKILBURN3 får bred ros for varm, fyldig og kraftfuld lyd, overraskende dyb bas og stærk ydelse for en transportabel højttaler. Lang batteritid, attraktivt Marshall-design og enkel betjening øger appellen, mens Bluetooth-parringen generelt er hurtig og stabil. Enkelte anmeldelser nævner manglende detaljer eller behov for justering med equalizeren, og ét produkt så ud til at være brugt ved levering.",
   "headlines": {
    "long-lasting battery": {
     "sentimentAnalysis": "Batteritiden får gentagne gange ros; én anmeldelse nævner specifikt op til 50 timers musikafspilning.",
     "simpleTitle": "Lang batteritid",
     "bias": "positive",
     "key": "long_battery",
     "groupId": "0dcf2446-28f3-41ae-846e-7094408f24c7"
    },
    "attractive design and solid construction": {
     "sentimentAnalysis": "Det klassiske design, det attraktive udseende, de taktile knapper og den oplevede byggekvalitet får stor ros.",
     "simpleTitle": "Attraktivt design og solid konstruktion",
     "bias": "positive",
     "key": "attractive_design",
     "groupId": "4ecc73de-3346-4282-af43-0903b195a1fb"
    },
    "warm, full and powerful sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en varm, fyldig og kraftfuld gengivelse med tilfredsstillende bas, hvilket er særligt imponerende for en transportabel højttaler.",
     "simpleTitle": "Varm, fyldig og kraftfuld lyd",
     "bias": "positive",
     "key": "warm_full_sound",
     "groupId": "45e60034-a406-4ec1-81d8-fc62c46e7f3e"
    },
    "simple controls and reliable Bluetooth pairing": {
     "sentimentAnalysis": "Anmeldelserne fremhæver hurtig enhedsregistrering, enkel tilslutning og praktiske fysiske bas-, diskant- og volumenkontroller.",
     "simpleTitle": "Enkel betjening og stabil Bluetooth-parring",
     "bias": "positive",
     "key": "easy_connection",
     "groupId": "2dde8d69-7e21-4b1d-b286-91e953ec19c1"
    },
    "clear improvement over previous speakers": {
     "sentimentAnalysis": "Flere anmeldelser beskriver højttaleren som en markant opgradering i forhold til tidligere eller konkurrerende trådløse højttalere.",
     "simpleTitle": "Tydelig forbedring i forhold til tidligere højttalere",
     "bias": "positive",
     "key": "sound_upgrade",
     "groupId": "45e60034-a406-4ec1-81d8-fc62c46e7f3e"
    },
    "some sound detail requires equalizer adjustment": {
     "sentimentAnalysis": "Et mindretal af anmeldelserne finder lyden mindre detaljeret eller lidt skuffende, selv om equalizeren kan forbedre balancen.",
     "simpleTitle": "Nogle lyddetaljer kræver justering med equalizer",
     "bias": "negative",
     "key": "sound_detail_limits",
     "groupId": "45e60034-a406-4ec1-81d8-fc62c46e7f3e"
    }
   },
