  "displayBookDemo": true,
  "reviews": {
   "summary": "MARKILBURN3 leverer en varm, slagkraftig og medrivende lyd med overraskende dyb bas for en transportabel højttaler, mens bas og diskant kan finjusteres. Den lange batteritid, nemme Bluetooth-parring og taktile betjening gør brugen ubesværet både hjemme og udendørs. Klassisk design, solid byggekvalitet og opmærksom service fuldender en særdeles attraktiv pakke.",
   "headlines": {
    "long-lasting battery": {
     "sentimentAnalysis": "Batteritiden beskrives gentagne gange som meget god, langvarig eller nærmest endeløs; en anmeldelse nævner op til 50 timer.",
     "simpleTitle": "Lang batteritid",
     "bias": "positive",
     "key": "batteryDuration",
     "groupId": "d3bcd29b-81c2-437f-9ff2-8b38c40eca5b"
    },
    "distinctive, well-built design": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent det klassiske og attraktive udseende, den eksklusive fornemmelse og den solide konstruktion.",
     "simpleTitle": "Karakteristisk design og solid kvalitet",
     "bias": "positive",
     "key": "designAppearance",
     "groupId": "09706190-3be1-4127-acc7-fa4df6540de1"
    },
    "warm, powerful sound with deep bass": {
     "sentimentAnalysis": "Anmeldelserne fremhæver en varm, fyldig og slagkraftig gengivelse med dyb og kraftig bas, som er imponerende for en transportabel højttaler.",
     "simpleTitle": "Varm og kraftfuld lyd med dyb bas",
     "bias": "positive",
     "key": "soundWarmBass",
     "groupId": "2a2f12de-149b-46ca-8e9c-9ed738c1f445"
    },
    "excellent sound for the size and price": {
     "sentimentAnalysis": "Flere anmeldelser beskriver højttaleren som særdeles god værdi for pengene med fyldig eller meget detaljeret lyd, der overgår forventningerne til den kompakte størrelse.",
     "simpleTitle": "Fremragende lyd for størrelse og pris",
     "bias": "positive",
     "key": "soundValue",
     "groupId": "2a2f12de-149b-46ca-8e9c-9ed738c1f445"
    },
    "sound can be refined with equalizer controls": {
     "sentimentAnalysis": "Fysiske eller app-baserede bas- og diskantkontroller gør det let at tilpasse lyden og kan også forbedre et lidt indelukket mellem- og diskantområde.",
     "simpleTitle": "Lyden kan finjusteres med equalizer",
     "bias": "positive",
     "key": "soundAdjustability",
     "groupId": "2a2f12de-149b-46ca-8e9c-9ed738c1f445"
    },
    "easy pairing and intuitive controls": {
     "sentimentAnalysis": "Bluetooth-parringen beskrives som hurtig og pålidelig, mens de traditionelle fysiske knapper gør betjeningen enkel.",
     "simpleTitle": "Nem parring og intuitiv betjening",
     "bias": "positive",
     "key": "easyOperation",
     "groupId": "fe73f6e3-9e32-43fe-a680-587f2134e48d"
    },
    "store service is friendly and competent": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver ud over produktet også den hjælpsomme, venlige og kompetente service i butikken.",
     "simpleTitle": "Venlig og kompetent service",
     "bias": "positive",
     "key": "friendlyService",
     "groupId": "1356c6b7-6f8f-49e9-9470-6bea032aaa81"
    },
    "some competitors offer more detailed sound": {
     "sentimentAnalysis": "To anmeldelser bemærker, at lyden ganske vist er god til prisen, men kunne byde på flere detaljer eller et større løft i forhold til alternativer.",
     "simpleTitle": "Nogle konkurrenter leverer mere detaljeret lyd",
     "bias": "negative",
     "key": "soundDetailLimitation",
     "groupId": "2a2f12de-149b-46ca-8e9c-9ed738c1f445"
    }
   },
