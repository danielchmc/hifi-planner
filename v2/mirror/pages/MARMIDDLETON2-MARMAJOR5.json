     "reviews": {
      "summary": "MARMAJOR5 leverer en varm, slagkraftig og medrivende lyd med klare detaljer og tilfredsstillende bas, så musikken føles levende på tværs af genrer. Den fremragende batteritid, den behagelige konstruktion til lang tids brug og det karakteristiske retrodesign gør hovedtelefonerne til fremragende ledsagere i hverdagen og på rejser. Den stærke værdi for pengene, de intuitive betjeningsknapper og de nyttige EQ-funktioner øger appellen, selv om enkelte oplever pasformen som lidt løs, bassen som mindre kraftig eller manglende vandtæthed som en begrænsning.",
      "headlines": {
       "rich, clear sound with satisfying bass": {
        "sentimentAnalysis": "Lyden roses gentagne gange som klar, fyldig, kraftfuld og basorienteret.",
        "simpleTitle": "Fyldig, klar lyd med tilfredsstillende bas",
        "bias": "positive",
        "key": "sound",
        "groupId": "ef5fc6d8-b07e-4d55-8c99-9669a9683eba"
       },
       "exceptional battery life": {
        "sentimentAnalysis": "Den lange batteritid, inklusive omkring 100 timer, er en af de stærkeste gennemgående fordele.",
        "simpleTitle": "Fremragende batteritid",
        "bias": "positive",
        "key": "battery",
        "groupId": "a0323cd1-15c5-4661-96fa-8f567a3e9ad6"
       },
       "comfortable for long listening": {
        "sentimentAnalysis": "Bløde ørepuder og en behagelig pasform understøtter lang tids daglig brug.",
        "simpleTitle": "Behagelige ved lang tids brug",
        "bias": "positive",
        "key": "comfort",
        "groupId": "5bb79cc0-0e22-442d-85a6-c2cf194e359b"
       },
       "distinctive retro design": {
        "sentimentAnalysis": "Det stilfulde, cool retrolook får gennemgående ros.",
