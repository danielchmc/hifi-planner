     "reviews": {
      "summary": "MARMAJOR5 leverer en varm, slagkraftig og imponerende klar lyd med tilfredsstillende bas og en medrivende musikoplevelse. Den lange batteritid, den lette komfort og det markante retrodesign gør hovedtelefonerne til fremragende ledsagere i hverdagen og på farten. Den gode værdi for pengene, den solide konstruktion og de praktiske betjeningsknapper fuldender en begejstrende pakke, selv om pasformen kan føles lidt løs, og manglen på vandtæthed eller ANC kan begrænse nogle anvendelser.",
      "headlines": {
       "rich, clear and powerful sound": {
        "sentimentAnalysis": "Anmeldelserne roser konsekvent en fyldig, klar og basrig gengivelse, især til energisk musik.",
        "simpleTitle": "Fyldig, klar og kraftfuld lyd",
        "bias": "positive",
        "key": "sound",
        "groupId": "5a7e4741-bfb7-4e12-83a1-414aa8af20d4"
       },
       "comfortable for extended wear": {
        "sentimentAnalysis": "Flere anmeldelser beskriver blød kontakt med ørerne, lavt tryk og god komfort ved lang tids brug.",
        "simpleTitle": "Behagelige ved længere tids brug",
        "bias": "positive",
        "key": "comfort",
        "groupId": "5e0e42f2-6ba9-4d82-8081-0d43da5b9d37"
       },
       "exceptional battery endurance": {
        "sentimentAnalysis": "Batteritiden beskrives gentagne gange som ekstremt lang med angivelser på 100 timer og meget lidt behov for opladning.",
        "simpleTitle": "Enestående batteritid",
        "bias": "positive",
        "key": "battery",
        "groupId": "3ec7c7bf-b855-4610-af56-0e89e3acd0e7"
       },
       "distinctive retro styling": {
        "sentimentAnalysis": "Det klassiske Marshall-design roses gentagne gange som attraktivt, cool og markant.",
        "simpleTitle": "Markant retrodesign",
        "bias": "positive",
        "key": "design",
