     "reviews": {
      "summary": "MARMINOR4 leverer en varm, fyldig og ofte medrivende lyd samt et stilfuldt, solidt design og nyttig app-styring. Batteritiden roses, og samtalekvaliteten er god i de tilgængelige anmeldelser. Pasformen er den største svaghed: De store earbuds sidder perfekt i nogle ører, men falder ud eller bliver ukomfortable hos andre, især under bevægelse.",
      "headlines": {
       "warm, powerful sound": {
        "sentimentAnalysis": "Lyden beskrives gentagne gange som fremragende, klar, kraftfuld og behagelig, trods enkelte markant negative vurderinger.",
        "simpleTitle": "Varm, kraftfuld lyd",
        "bias": "positive",
        "key": "sound",
        "groupId": "193a92d4-90d2-45c8-89ea-7b72a03ca19f"
       },
       "large earbuds fall out or cause discomfort": {
        "sentimentAnalysis": "Pasformen varierer meget: Flere brugere oplever store earbuds, øresmerter eller hyppigt udfald, også under træning og selv når de sidder stille.",
        "simpleTitle": "Store earbuds falder ud eller giver ubehag",
        "bias": "negative",
        "key": "fit",
        "groupId": "8963842f-410f-4092-8f89-f522fcb7aa6f"
       },
       "stylish, solid design": {
        "sentimentAnalysis": "Designet opfattes bredt som attraktivt og eksklusivt, og etuiet samt den imponerende holdbarhed i en krævende oplevelse får ros.",
        "simpleTitle": "Stilfuldt, solidt design",
        "bias": "positive",
        "key": "design",
        "groupId": "01fef25a-5ac3-40ec-bd40-79f98becd683"
       },
       "comfortable fit for some ears": {
        "sentimentAnalysis": "Flere anmeldelser roser den sikre, komfortable pasform og behagelige brug.",
        "simpleTitle": "Komfortabel pasform til nogle ører",
        "bias": "positive",
        "key": "fit",
        "groupId": "8963842f-410f-4092-8f89-f522fcb7aa6f"
       },
       "sound can lack bass or detail": {
        "sentimentAnalysis": "Nogle lytteoplevelser vurderes som skuffende med for meget diskant, for lidt bas eller generelt dårlig lydkvalitet.",
        "simpleTitle": "Lyden kan mangle bas eller detaljer",
        "bias": "negative",
        "key": "sound",
        "groupId": "193a92d4-90d2-45c8-89ea-7b72a03ca19f"
