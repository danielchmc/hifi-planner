  "reviews": {
   "summary": "Marshall Middleton II leverer en varm, slagkraftig og bemærkelsesværdigt klar lyd med imponerende bas, høj lydstyrke og en omsluttende 360°-gengivelse. Den solide konstruktion, det stilfulde retrodesign, den enkle betjening og den praktiske mobilitet gør højttaleren særligt attraktiv til lytning derhjemme og sociale sammenkomster. Batteriydelsen er generelt stærk med hurtig opladning, men basfylde, ydelse udendørs og den reelle spilletid kan variere afhængigt af placering og lydstyrke.",
   "headlines": {
    "clear, detailed and powerful sound": {
     "sentimentAnalysis": "Højttaleren roses gentagne gange for sin klare, fyldige, detaljerede og kraftfulde lyd.",
     "simpleTitle": "Klar, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "805607e9-ea16-4835-b4f9-4d2734a459f4"
    },
    "strong and enjoyable bass": {
     "sentimentAnalysis": "Bassen beskrives som fremragende, fyldig og kraftig nok til fortsat at være imponerende ved høj lydstyrke.",
     "simpleTitle": "Kraftig og medrivende bas",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "805607e9-ea16-4835-b4f9-4d2734a459f4"
    },
    "stylish and sturdy construction": {
     "sentimentAnalysis": "Retrodesignet, den flotte finish og den robuste, bærbare konstruktion bliver konsekvent værdsat.",
     "simpleTitle": "Stilfuld og solid konstruktion",
     "bias": "positive",
     "key": "design_build",
     "groupId": "f10fd1fb-e8c2-4b08-94e7-e9585c19a17e"
    },
    "bass and soundstage can feel limited": {
     "sentimentAnalysis": "I nogle lyttesituationer virker bassen, lydbilledet eller dækningen af store udendørsområder mindre overbevisende.",
     "simpleTitle": "Bas og lydbillede kan virke begrænset",
     "bias": "negative",
     "key": "sound_quality",
     "groupId": "805607e9-ea16-4835-b4f9-4d2734a459f4"
    },
    "long-lasting battery with fast charging": {
     "sentimentAnalysis": "Batteritiden vurderes generelt som meget god, mens hurtig opladning giver ekstra praktisk anvendelighed.",
     "simpleTitle": "Lang batteritid med hurtig opladning",
     "bias": "positive",
     "key": "battery_life",
     "groupId": "34044521-d392-41de-aaf5-d719981b8523"
    },
    "useful controls and connections": {
     "sentimentAnalysis": "Bluetooth, kablet tilslutning, direkte EQ-justering og enkel betjening værdsættes som nyttige funktioner.",
     "simpleTitle": "Praktisk betjening og tilslutning",
     "bias": "positive",
     "key": "controls_connectivity",
     "groupId": "12c5a727-d355-4327-bcb1-436ba02a30d2"
    }
