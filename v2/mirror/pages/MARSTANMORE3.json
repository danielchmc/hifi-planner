  "reviews": {
   "summary": "MARSTANMORE3 leverer en varm, kraftfuld og rumfyldende lyd med klare detaljer, tilfredsstillende bas og stærk ydelse ved både lav og høj lydstyrke. Det ikoniske retrodesign, den solide kvalitet og de taktile fysiske knapper gør højttaleren særligt attraktiv og nem at leve med. Bluetooth-tilslutning og daglig betjening er konsekvent enkel, selv om enkelte lyttere synes, at lyden er mindre audiophile, eller ønsker mere maksimal lydstyrke; samlet set er værdien og musikglæden fremragende.",
   "headlines": {
    "warm, powerful sound with deep bass": {
     "sentimentAnalysis": "Anmeldelserne roser den fyldige, kraftfulde og rumfyldende gengivelse, især bassen.",
     "simpleTitle": "Varm og kraftfuld lyd med dyb bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "b65fe7d8-32fc-4002-8179-eafa15304fa2"
    },
    "iconic retro design and premium construction": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent det stilfulde retrolook, den smagfulde finish og den solide byggekvalitet.",
     "simpleTitle": "Ikonisk retrodesign og førsteklasses kvalitet",
     "bias": "positive",
     "key": "design",
     "groupId": "4d0edbd3-12ad-4e85-a2f1-1277fd0cb080"
    },
    "physical controls feel excellent and operation is simple": {
     "sentimentAnalysis": "Anmeldelserne værdsætter den enkle betjening og de taktile, tilfredsstillende fysiske knapper.",
     "simpleTitle": "Fremragende fysiske knapper og enkel betjening",
     "bias": "positive",
     "key": "usability",
     "groupId": "684fcae1-bd75-4fca-872a-fd716038a02a"
    },
    "clear and enjoyable at different volume levels": {
     "sentimentAnalysis": "Anmeldelserne beskriver en åben, klar og behagelig lyd, der fungerer både som stille baggrundsmusik og ved højere afspilning.",
     "simpleTitle": "Klar og behagelig ved forskellige lydstyrker",
     "bias": "positive",
     "key": "sound",
     "groupId": "b65fe7d8-32fc-4002-8179-eafa15304fa2"
    },
    "bluetooth connections are effortless and reliable": {
     "sentimentAnalysis": "Anmeldelserne fremhæver nem parring, stabilt skift og vellykket integration med pladespillere og andet lydudstyr.",
     "simpleTitle": "Bluetooth-forbindelser er problemfrie og stabile",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "c44f41e3-f97b-4587-ada3-baa1de0a6d0d"
    },
    "some listeners want more volume or audiophile refinement": {
     "sentimentAnalysis": "Et mindretal bemærker trods stor generel tilfredshed begrænset lydstyrke eller en lyd, der ikke er helt audiophile.",
     "simpleTitle": "Nogle lyttere ønsker mere lydstyrke eller audiophile detaljer",
     "bias": "negative",
     "key": "sound",
     "groupId": "b65fe7d8-32fc-4002-8179-eafa15304fa2"
    }
   },
