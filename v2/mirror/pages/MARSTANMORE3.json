  "reviews": {
   "summary": "MARSTANMORE3 leverer en varm, kraftfuld og rumfyldende lyd med klare detaljer, behagelig bas og masser af overskud. Det retroinspirerede design, den solide konstruktion og de taktile analoge betjeningsknapper gør højttaleren særligt attraktiv. Enkel betjening og stabil Bluetooth-forbindelse giver høj praktisk værdi i hverdagen, selv om det manglende batteri og enkelte sammenligninger med mere raffinerede eller højere spillende alternativer er mindre ulemper.",
   "headlines": {
    "iconic retro design and solid construction": {
     "sentimentAnalysis": "Retrolooket, de flotte finish og den høje oplevede byggekvalitet fremhæves konsekvent som store styrker.",
     "simpleTitle": "Ikonisk retrodesign og solid konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "bd1dd47b-8681-4ab5-887e-a7c0ca9eb9ae"
    },
    "warm, powerful sound with satisfying bass": {
     "sentimentAnalysis": "Anmeldelserne roser den fyldige, kraftfulde og rumfyldende gengivelse, især den gode bas og høje ydelse i forhold til størrelsen.",
     "simpleTitle": "Varm og kraftfuld lyd med god bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "327ff8a5-c4ee-4fc0-a630-ba7b21327f55"
    },
    "easy controls and dependable Bluetooth": {
     "sentimentAnalysis": "Anmeldelserne fremhæver intuitiv betjening, gode fysiske knapper og nemme, stabile Bluetooth-forbindelser.",
     "simpleTitle": "Enkel betjening og stabil Bluetooth",
     "bias": "positive",
     "key": "usability",
     "groupId": "2de7f63a-b171-40a2-8213-9b4a8b3241c4"
    },
    "clear and open sound at low and moderate volume": {
     "sentimentAnalysis": "Højttaleren beskrives gentagne gange som klar, åben og behagelig, også ved stille baggrundsmusik eller moderat lydstyrke.",
     "simpleTitle": "Klar og åben lyd ved lav og moderat lydstyrke",
     "bias": "positive",
     "key": "sound",
     "groupId": "327ff8a5-c4ee-4fc0-a630-ba7b21327f55"
    },
    "some listeners wanted more volume or refinement": {
     "sentimentAnalysis": "En mindre del af anmeldelserne bemærker, at højttaleren ikke er helt audiofil og ikke så høj eller raffineret som håbet eller en konkurrerende model.",
     "simpleTitle": "Nogle ønskede mere lydstyrke eller finesse",
     "bias": "negative",
     "key": "sound",
     "groupId": "327ff8a5-c4ee-4fc0-a630-ba7b21327f55"
    }
   },
