  "reviews": {
   "summary": "MARSTANMORE3 leverer en varm, slagkraftig og rumfyldende lyd med tydelige detaljer, tilfredsstillende bas og masser af kraft. Retrodesignet, den solide konstruktion og de taktile fysiske knapper gør højttaleren særligt attraktiv og nem at leve med. Bluetooth-forbindelsen og den daglige betjening er generelt problemfri, selv om det manglende batteri og sammenligninger med mere raffinerede eller større højttalere afslører mindre begrænsninger.",
   "headlines": {
    "powerful, clear and room-filling sound": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, fyldige og kraftfulde gengivelse med god bas og tilstrækkelig effekt til at fylde et rum eller skabe fest.",
     "simpleTitle": "Kraftfuld, klar og rumfyldende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "bb1d759f-12ee-46fd-a954-cc4cfae680d1"
    },
    "iconic retro design and premium construction": {
     "sentimentAnalysis": "Designet beskrives gentagne gange som flot, ikonisk, retro og tidløst, mens byggekvaliteten og materialerne giver et førsteklasses indtryk.",
     "simpleTitle": "Ikonisk retrodesign og førsteklasses konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "3365c42b-1095-4467-a1e4-0780b2b1df4f"
    },
    "simple controls and reliable Bluetooth use": {
     "sentimentAnalysis": "Anmeldelserne fremhæver problemfri betjening, behagelige fysiske knapper, enkel Bluetooth-parring og pålidelig skift mellem tilsluttede enheder.",
     "simpleTitle": "Enkel betjening og stabil Bluetooth-forbindelse",
     "bias": "positive",
     "key": "usability",
     "groupId": "b359c6a6-541d-4415-b5f4-2bb0072cf437"
    },
    "less refined than some larger or audiophile alternatives": {
     "sentimentAnalysis": "Nogle sammenligninger bemærker, at højttaleren ikke er helt audiophil, kan overgås af større modeller og måske ikke spiller så højt som forventet.",
     "simpleTitle": "Mindre raffineret end visse større eller audiophile alternativer",
     "bias": "negative",
     "key": "sound",
     "groupId": "bb1d759f-12ee-46fd-a954-cc4cfae680d1"
    },
    "balanced and enjoyable at lower volumes": {
     "sentimentAnalysis": "Højttaleren forbliver åben, behagelig og detaljeret ved moderat eller lav lydstyrke, hvilket gør den velegnet til baggrundslytning.",
     "simpleTitle": "Afbalanceret og behagelig ved lav lydstyrke",
     "bias": "positive",
     "key": "sound",
     "groupId": "bb1d759f-12ee-46fd-a954-cc4cfae680d1"
    }
   },
