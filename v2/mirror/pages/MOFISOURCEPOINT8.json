  "reviews": {
   "summary": "MoFi SourcePoint 8 får stor ros for sin varme, klare og meget detaljerede lyd med fyldig bas, et stort lydbillede og en medrivende gengivelse. Byggekvalitet og design er også stærke sider, mens enkelte lyttere bemærker begrænset dybbas og behovet for omhyggelig placering og matchning. Samlet leverer højttaleren en imponerende stor, musikalsk og engagerende gengivelse i forhold til størrelsen, især med korrekt opsætning og eventuel støtte fra en subwoofer.",
   "headlines": {
    "warm, clear and highly detailed sound": {
     "sentimentAnalysis": "Lyden beskrives gentagne gange som klar, varm, fyldig, musikalsk og meget detaljeret, med stor begejstring.",
     "simpleTitle": "Varm, klar og meget detaljeret lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "e657cae0-c924-471c-82a8-6f84d11e81ce"
    },
    "powerful bass with limited deepest extension": {
     "sentimentAnalysis": "Bassen roses som fyldig, fremragende og fænomenal med en subwoofer, mens en lytter savner den dybeste bas efter tidligere at have brugt langt større basenheder.",
     "simpleTitle": "Kraftig bas med begrænset dybbas",
     "bias": "meh",
     "key": "bass",
     "groupId": "e88952aa-b27e-4ad5-adbc-34eed615f791"
    },
    "expansive, focused and immersive soundstage": {
     "sentimentAnalysis": "Højttalerne skaber en bred, præcis og medrivende gengivelse med overbevisende instrumentplacering og et stabilt tonalt indtryk i lytteområdet.",
     "simpleTitle": "Stort, fokuseret og medrivende lydbillede",
     "bias": "positive",
     "key": "soundstage",
