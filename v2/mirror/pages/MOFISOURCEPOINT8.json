  "reviews": {
   "summary": "MOFI SOURCEPOINT8 leverer en varm, meget detaljeret og medrivende gengivelse med slagkraftig bas, klare diskanttoner og et imponerende stort lydbillede. Højttalerne fremhæver musikalske detaljer, placerer instrumenterne overbevisende og lyder imponerende fyldigt trods monitorformatet. Den dybeste bas kan have gavn af en subwoofer, mens rumstørrelse, placering, lytteposition og forstærkning kan påvirke den tonale balance markant.",
   "headlines": {
    "warm, detailed and highly musical sound": {
     "sentimentAnalysis": "Højttalerne roses for varm, raffineret, klar og meget musikalsk gengivelse med stor detaljegrad.",
     "simpleTitle": "Varm, detaljeret og musikalsk lyd",
     "bias": "positive",
     "key": "warm-detailed-sound",
     "groupId": "1b3cf966-1a98-4cea-8612-a677ea81109d"
    },
    "large, focused and immersive soundstage": {
     "sentimentAnalysis": "Det koaksiale design forbindes med en bred, fokuseret gengivelse og overbevisende placering af instrumenterne.",
     "simpleTitle": "Stort, fokuseret og medrivende lydbillede",
     "bias": "positive",
     "key": "large-focused-soundstage",
     "groupId": "35984168-5134-4371-adf6-4a7e89dd68a2"
    },
    "powerful bass, but limited deepest bass": {
     "sentimentAnalysis": "Bassen beskrives som fyldig og fremragende generelt, men de dybeste frekvenser kan kræve en subwoofer for lyttere, der er vant til meget store basenheder.",
     "simpleTitle": "Kraftig bas, men begrænset dybbas",
     "bias": "meh",
     "key": "bass-depth",
     "groupId": "ac31970e-182a-41fa-9f00-af6a15474de2"
    },
    "room and positioning can strongly affect tonal balance": {
     "sentimentAnalysis": "Højttalerne kan belønne omhyggelig opsætning, men ét lyttemiljø afslørede tilbagetrukne mellemtoner, begrænset spredning og en tonal balance, der forblev uegnet trods ændringer i placering og forstærkning.",
     "simpleTitle": "Rum og placering påvirker den tonale balance markant",
     "bias": "negative",
     "key": "placement-sensitivity",
     "groupId": "1b3cf966-1a98-4cea-8612-a677ea81109d"
    },
    "premium finish and substantial design": {
     "sentimentAnalysis": "Valnøddefineren, byggekvaliteten, terminalerne og de flotte proportioner roses tydeligt trods de betydelige dimensioner.",
     "simpleTitle": "Førsteklasses finish og solidt design",
     "bias": "positive",
     "key": "premium-build",
     "groupId": "053881dd-5562-4496-88a7-fdc4ca98be83"
    }
