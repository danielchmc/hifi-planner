  "reviews": {
   "summary": "MOFI SOURCEPOINT8 leverer en varmt klingende og meget detaljeret gengivelse med slagkraftig bas, klare diskanttoner og et immersivt, rummeligt lydbillede. Det betydelige kabinet er flot udført og kan lyde imponerende stort, men bassentusiaster kan få glæde af en subwoofer, og omhyggelig placering er vigtig. Den tonale balance og lytteoplevelsen kan variere efter rum og anlæg, så en prøvelytning anbefales.",
   "headlines": {
    "warm, detailed and powerful sound": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, fyldige, varme og meget musikalske gengivelse med god detaljeopløsning og imponerende størrelse.",
     "simpleTitle": "Varm, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "warm-detailed-sound",
     "groupId": "612aa336-6724-4ca4-83d1-21fb219bb028"
    },
    "exceptional soundstage and imaging": {
     "sentimentAnalysis": "Det koaksiale design forbindes med et bredt, immersivt og præcist fokuseret stereobillede samt overbevisende instrumentplacering.",
     "simpleTitle": "Fremragende lydbillede og placering",
     "bias": "positive",
     "key": "soundstage-imaging",
     "groupId": "78c67411-dd2c-424c-b5b4-6f2d2d90d334"
    },
    "deep bass may need a subwoofer": {
     "sentimentAnalysis": "Højttaleren leverer fremragende bas, men de dybeste frekvenser kan være utilstrækkelige for lyttere, der er vant til meget store basenheder; en subwoofer nævnes som en effektiv løsning.",
     "simpleTitle": "Dyb bas kan kræve en subwoofer",
     "bias": "negative",
     "key": "deep-bass-limit",
     "groupId": "609ba6e0-a0b7-46f6-9c20-f0fcbc5954a2"
    },
    "high-quality construction and attractive finish": {
     "sentimentAnalysis": "Valnøddefinér, terminaler, kabinet og den generelle produktionskvalitet får stor ros trods de markante monitorproportioner.",
     "simpleTitle": "Høj kvalitet og flot finish",
     "bias": "positive",
     "key": "build-finish",
     "groupId": "1073bbd7-4f86-4501-8662-4d1e69cdc34d"
    },
    "placement and room matching are critical": {
     "sentimentAnalysis": "Anmeldelserne viser, at afstand til væg, rumstørrelse, lytte vinkel og matching med anlægget påvirker resultatet kraftigt; en opsætning bemærker især den begrænsede spredning.",
     "simpleTitle": "Placering og rumstilpasning er afgørende",
     "bias": "meh",
     "key": "placement-critical",
     "groupId": "ae4e8926-d9e7-48f9-b062-9f886aabe7a7"
    }
   },
