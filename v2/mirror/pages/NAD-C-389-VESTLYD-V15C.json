     "reviews": {
      "summary": "NAD C389 roses bredt for sin kraftfulde, klare og meget detaljerede lyd med varm, rummelig og engagerende gengivelse. Højttalerkontrol, basdefinition og ydelse ved forskellige lydstyrker er gennemgående styrker, mens BluOS- og Dirac-moduler giver fremragende muligheder for streaming og rumkorrektion. Enkel betjening, fleksible tilslutninger og et kompakt design gør forstærkeren til en overbevisende opgradering, selv om nogle brugere finder betjeningen mindre intuitiv, savner bestemte udgange eller oplever begrænsninger med Bluetooth og streaming.",
      "headlines": {
       "straightforward operation and useful remote control": {
        "sentimentAnalysis": "De fleste relevante anmeldelser finder betjeningen overskuelig, intuitiv og praktisk, især med fjernbetjeningen eller BluOS-appen.",
        "simpleTitle": "Enkel betjening og praktisk fjernbetjening",
        "bias": "positive",
        "key": "operation",
        "groupId": "82d4ccaf-a243-4af5-b4e7-5dcb87e1b142"
       },
       "clear, spacious and highly detailed sound": {
        "sentimentAnalysis": "Anmeldelserne beskriver en klar, bred, detaljeret og rummelig gengivelse med bedre separation og større dybde.",
        "simpleTitle": "Klar, rummelig og meget detaljeret lyd",
        "bias": "positive",
        "key": "sound",
        "groupId": "728138d5-7598-43fd-a00d-e068ba679372"
       },
       "warm, controlled and powerful bass": {
        "sentimentAnalysis": "Anmeldelserne roser den kraftfulde, fyldige og velkontrollerede bas samt den luftige gengivelse.",
        "simpleTitle": "Varm, kontrolleret og kraftfuld bas",
        "bias": "positive",
        "key": "sound",
        "groupId": "728138d5-7598-43fd-a00d-e068ba679372"
       },
       "strong control and ample power": {
        "sentimentAnalysis": "Forstærkeren beskrives gentagne gange som stabil, dynamisk og i stand til at drive krævende højttalere med autoritet.",
        "simpleTitle": "Stærk kontrol og rigelig effekt",
        "bias": "positive",
        "key": "power",
        "groupId": "011a52e2-9a30-4ced-b474-20702a57b955"
       },
       "bluOS and Dirac make streaming more complete": {
        "sentimentAnalysis": "Det valgfrie modul værdsættes for appstyring, brede streamingmuligheder og Dirac-rumkorrektion, som forbedrer den rumlige gengivelse.",
        "simpleTitle": "BluOS og Dirac gør streaming mere komplet",
        "bias": "positive",
        "key": "streaming",
        "groupId": "8a8a04b0-3222-4573-b4bf-e6ef782dcf9d"
       },
       "some handling and Bluetooth limitations": {
        "sentimentAnalysis": "En mindre del af anmeldelserne nævner uoverskuelig betjening, besværlig opsætning, TIDAL-forbindelsesproblemer eller vanskeligheder med at parre Bluetooth-hovedtelefoner.",
        "simpleTitle": "Visse begrænsninger i betjening og Bluetooth",
        "bias": "negative",
        "key": "operation",
        "groupId": "82d4ccaf-a243-4af5-b4e7-5dcb87e1b142"
       },
       "flexible inputs and upgradeable connections": {
        "sentimentAnalysis": "Anmeldelserne værdsætter de optiske, analoge, digitale og modulære tilslutninger til forskellige kilder.",
        "simpleTitle": "Fleksible indgange og udvidelsesmuligheder",
        "bias": "positive",
        "key": "connections",
        "groupId": "f106fc05-2455-490d-b2b6-5a809e2376d0"
       },
       "limited legacy inputs and missing optical output": {
        "sentimentAnalysis": "Nogle brugere savner traditionelle tilslutningsmuligheder, især en optisk lydudgang og flere ældre indgange.",
        "simpleTitle": "Begrænsede ældre indgange og manglende optisk udgang",
        "bias": "negative",
        "key": "connections",
        "groupId": "f106fc05-2455-490d-b2b6-5a809e2376d0"
       }
