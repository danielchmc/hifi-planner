  "reviews": {
   "summary": "NAD C268 leverer en varm, klar og slagkraftig lyd med imponerende kontrol, dynamik og fast bas, især sammen med NAD-elektronik og krævende højttalere. Brokobling eller en ekstra enhed giver et markant løft i effekt, åbenhed og detaljer, så forstærkeren fungerer fremragende til både musik og hjemmebio. Den største anke er energisparefunktionen, som kan slukke ved lav lydstyrke eller forsinke opstarten.",
   "headlines": {
    "warm, clear and dynamic sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver lyden som klar, varm, detaljeret, dynamisk og meget vellydende.",
     "simpleTitle": "Varm, klar og dynamisk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "284c594c-a89b-4c7d-9d36-452d80c4849f"
    },
    "major gains in power and control": {
     "sentimentAnalysis": "Tilføjelse eller brokobling af forstærkeren forbindes gentagne gange med højere effekt, større dynamik, strammere bas og bedre højttalerkontrol.",
     "simpleTitle": "Markant mere effekt og kontrol",
     "bias": "positive",
     "key": "power",
