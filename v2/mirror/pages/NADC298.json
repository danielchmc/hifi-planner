  "reviews": {
   "summary": "NAD C298 leverer masser af ubesværet effekt med ren, transparent og punchy lyd til selv krævende højttalere. Den brede, medrivende lydscene, den præcise baskontrol samt den forbedrede klarhed, instrumentseparation og dynamik bliver rost igen og igen. En mindre del af anmeldelserne nævner brum eller følsomhed over for udefrakommende støj, men den stærke værdi og gode service gør effektforstærkeren særdeles anbefalelsesværdig.",
   "headlines": {
    "effortless power for demanding speakers": {
     "sentimentAnalysis": "Forstærkeren roses gentagne gange for ubesværet, rigelig effekt og sikker kontrol over krævende højttalere.",
     "simpleTitle": "Ubesværet effekt til krævende højttalere",
     "bias": "positive",
     "key": "power",
     "groupId": "a7e66104-aca7-478e-979c-3bfa3bb2299e"
    },
    "clean, transparent and highly detailed sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en klar, transparent, rolig og detaljeret gengivelse, som forbliver ren uden at lyde anstrengt.",
     "simpleTitle": "Ren, transparent og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "7cf73c12-d9f5-4fcf-ab0f-1bfc060f7e4b"
    },
    "wider soundstage and stronger musical impact": {
     "sentimentAnalysis": "Forstærkeren tilskrives en større lydscene samt mere punch, separation og indlevelse.",
     "simpleTitle": "Bredere lydscene og større musikalsk gennemslagskraft",
     "bias": "positive",
     "key": "sound",
     "groupId": "7cf73c12-d9f5-4fcf-ab0f-1bfc060f7e4b"
    },
    "tight, controlled and punchy bass": {
     "sentimentAnalysis": "Bassen beskrives som fyldig, stram, kontrolleret og punchy med et stærkt greb om højttalerne.",
     "simpleTitle": "Stram, kontrolleret og punchy bas",
     "bias": "positive",
     "key": "bass",
     "groupId": "c246fd51-a321-4078-b03d-484bc8aff1e7"
    },
    "some sensitivity to hum and external noise": {
     "sentimentAnalysis": "To anmeldelser nævner mindre støjproblemer, herunder følsomhed over for udefrakommende forstyrrelser og en svag brummen tæt på forstærkeren.",
     "simpleTitle": "En vis følsomhed over for brum og udefrakommende støj",
     "bias": "negative",
     "key": "noise",
     "groupId": "6aed4205-db24-495f-baba-857983fc6064"
