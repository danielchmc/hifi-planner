  "reviews": {
   "summary": "NAD C298 leverer masser af ubesværet effekt med stram baskontrol samt ren, transparent og meget detaljeret lyd. Forstærkeren driver også krævende højttalere sikkert og tilfører punch, bedre instrumentseparation, klarhed samt et bredere og dybere lydbillede i både musik- og hjemmebiografsystemer. Det fremragende forhold mellem pris og ydelse samt den gode systemsynergi gør C298 til en imponerende opgradering, selv om enkelte opsætninger oplever en svag brummen fra strømforsyningen eller følsomhed over for støj udefra.",
   "headlines": {
    "abundant power for demanding speakers": {
     "sentimentAnalysis": "Ejerne beskriver gentagne gange ubesværet effekt og sikker drift af store eller krævende højttalere.",
     "simpleTitle": "Masser af effekt til krævende højttalere",
     "bias": "positive",
     "key": "power",
     "groupId": "3c8a4b4e-2bed-4796-b1bd-a94540507859"
    },
    "clean, transparent and detailed sound": {
     "sentimentAnalysis": "Anmeldelserne roser gennemgående den rene, transparente, klare og meget detaljerede gengivelse.",
     "simpleTitle": "Ren, transparent og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "4154fb3d-d600-4dab-9c27-3e9f92dd88c8"
    },
    "tight, punchy and controlled bass": {
     "sentimentAnalysis": "Forstærkeren roses for et fast greb om bassen, kraftigt punch og god kontrol, også ved høj lydstyrke.",
     "simpleTitle": "Stram, punchy og kontrolleret bas",
     "bias": "positive",
     "key": "power",
     "groupId": "3c8a4b4e-2bed-4796-b1bd-a94540507859"
    },
    "noticeable upgrade over previous amplification": {
     "sentimentAnalysis": "Flere anmeldelser beskriver markante forbedringer i forhold til tidligere eller langt dyrere forstærkere, især i effekt og klarhed.",
     "simpleTitle": "Mærkbar opgradering i forhold til tidligere forstærkning",
     "bias": "positive",
     "key": "value",
     "groupId": "a0d108c6-2c2a-4198-bfe6-0576e2362ca7"
    },
    "broader, deeper and more immersive soundstage": {
     "sentimentAnalysis": "Flere anlæg får et mærkbart bredere, dybere eller mere musikalsk lydbillede efter tilføjelsen af C298.",
     "simpleTitle": "Bredere, dybere og mere omsluttende lydbillede",
     "bias": "positive",
     "key": "sound",
     "groupId": "4154fb3d-d600-4dab-9c27-3e9f92dd88c8"
