  "reviews": {
   "summary": "NAD C298 leverer masser af ubesværet effekt med stram kontrol og driver krævende højttalere og høje lydniveauer uden problemer. Lyden roses bredt for at være ren, transparent, detaljeret og slagkraftig med bedre separation, større lydbillede og præcis bas. Den fremragende værdi for pengene og de mange kombinationsmuligheder gør forstærkeren til en særdeles overbevisende opgradering, selv om enkelte anlæg oplever en svag brummen eller følsomhed over for udefrakommende støj.",
   "headlines": {
    "abundant power for demanding speakers": {
     "sentimentAnalysis": "Forstærkeren roses gentagne gange for ubesværet effekt, stærkt drive og sikker kontrol over krævende højttalere og høj lydstyrke.",
     "simpleTitle": "Masser af effekt til krævende højttalere",
     "bias": "positive",
     "key": "power",
     "groupId": "ff9bc48f-cd72-43ee-8319-bed821fd6c76"
    },
    "clean, transparent and detailed sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver samstemmende en klar, transparent, detaljeret og ubesværet gengivelse med rene høje toner og forbedret klarhed.",
     "simpleTitle": "Ren, transparent og detaljeret lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "8372ce5a-c426-4340-97da-ee25abc42a5f"
    },
    "wider soundstage and stronger separation": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver et bredere og dybere lydbillede samt tydeligere separation af instrumenter efter tilføjelsen af forstærkeren.",
     "simpleTitle": "Bredere lydbillede og bedre separation",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "8372ce5a-c426-4340-97da-ee25abc42a5f"
    },
    "tight, controlled and punchy bass": {
     "sentimentAnalysis": "Basgengivelsen roses for ekstra tyngde, slagkraft, præcision og kontrol, også med krævende højttalere og subwoofersystemer.",
     "simpleTitle": "Stram, kontrolleret og slagkraftig bas",
     "bias": "positive",
     "key": "bass-control",
     "groupId": "6df7e24d-d6c9-4aa7-964a-56f3ec31ceb5"
    },
    "occasional hum or sensitivity to noise": {
     "sentimentAnalysis": "To anmeldelser nævner mindre støjproblemer: følsomhed over for udefrakommende forstyrrelser og en svag brummen tæt på forstærkeren, uden at nogen af delene opleves som alvorligt generende.",
     "simpleTitle": "Lejlighedsvis brummen eller følsomhed over for støj",
     "bias": "negative",
     "key": "noise",
     "groupId": "17b63b5b-007b-4313-85be-7d7ffe3daf5e"
    }
   },
