  "reviews": {
   "summary": "NAD C 3030 roses bredt for sin varme, klare, detaljerede og velkontrollerede lyd samt en overraskende kraftfuld ydelse i forhold til den opgivne effekt. Retrodesignet, VU-metrene og den pålidelige HDMI-integration til TV bidrager til den store appel, mens det begrænsede antal indgange er den primære kritik. Samlet set leverer forstærkeren en usædvanligt musikalsk og afbalanceret oplevelse til en attraktiv pris.",
   "headlines": {
    "warm, clear and detailed sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en klar, varm, åben og detaljeret gengivelse med kontrolleret bas og stærk musikalitet.",
     "simpleTitle": "Varm, klar og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "ebea8764-cf2b-4790-adfd-244d0351d0ee"
    },
    "surprisingly powerful performance": {
     "sentimentAnalysis": "Flere anmeldelser oplever forstærkeren som kraftigere end specifikationerne antyder, samtidig med at gengivelsen forbliver ren og blød.",
     "simpleTitle": "Overraskende kraftfuld ydelse",
     "bias": "positive",
     "key": "sound",
     "groupId": "ebea8764-cf2b-4790-adfd-244d0351d0ee"
    },
    "retro design and appealing VU meters": {
     "sentimentAnalysis": "Retrolooket vurderes gentagne gange som attraktivt, og VU-metrene tilfører et særligt nostalgisk og karakteristisk præg.",
     "simpleTitle": "Retrodesign og flotte VU-metre",
     "bias": "positive",
     "key": "design",
     "groupId": "5d81985b-8b42-4e1c-a3bd-e8d14510474d"
    },
    "limited number of inputs": {
     "sentimentAnalysis": "De enkle tilslutningsmuligheder passer til basale systemer, men to anmeldelser fremhæver specifikt det begrænsede antal indgange som en ulempe.",
