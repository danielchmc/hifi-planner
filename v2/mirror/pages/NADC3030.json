  "reviews": {
   "summary": "NAD C3030 leverer en varm, klar, detaljeret og velkontrolleret lyd med imponerende kræfter, som gør musik, tv og fysiske medier meget engagerende. Retrodesignet, VU-metrene samt de praktiske HDMI-, Bluetooth- og optiske tilslutninger er stærke fordele, mens det begrænsede antal indgange kan genere brugere med større anlæg. Det fremragende forhold mellem pris og kvalitet samt den alsidige funktionalitet gør forstærkeren særdeles anbefalelsesværdig.",
   "headlines": {
    "warm, clear and highly detailed sound": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, varme, åbne, kontrollerede og detaljerede gengivelse til musik og tv.",
     "simpleTitle": "Varm, klar og meget detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "a9e2f8cd-2913-4d70-a444-4b80724d0df2"
    },
    "retro styling and VU meters stand out": {
     "sentimentAnalysis": "Retrolooket og de nostalgiske VU-metre beskrives gentagne gange som flotte og markante.",
     "simpleTitle": "Retrodesign og VU-metre skiller sig ud",
     "bias": "positive",
     "key": "design",
     "groupId": "9d6a8ac6-f35a-46c2-ae30-3547dcb4785d"
    },
    "useful HDMI, optical and Bluetooth connections": {
     "sentimentAnalysis": "Anmeldelserne fremhæver nem integration med tv samt praktisk understøttelse af optiske, HDMI-, Bluetooth- og fysiske kilder.",
     "simpleTitle": "Praktiske HDMI-, optiske og Bluetooth-tilslutninger",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "51234e9a-c9bc-4bea-a40a-4fc294d5fcc7"
    },
    "more powerful than the rating suggests": {
     "sentimentAnalysis": "Forstærkeren opleves gentagne gange som kraftfuld, ren og stærkere end den angivne effekt antyder.",
     "simpleTitle": "Kraftigere end specifikationerne antyder",
     "bias": "positive",
     "key": "power",
     "groupId": "49466236-9361-4755-a917-1af83232c9fe"
    },
    "bluetooth streaming can sound compressed": {
     "sentimentAnalysis": "Bluetooth er praktisk, men streamingkvaliteten kan lejlighedsvis lyde klemt eller komprimeret.",
     "simpleTitle": "Bluetooth-streaming kan lyde klemt",
     "bias": "negative",
