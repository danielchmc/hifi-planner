     "reviews": {
      "summary": "NAD C3050 roses bredt for sin varme, detaljerede og kraftfulde lyd, sit markante retrodesign og sine alsidige moderne funktioner. Forstærkeren fungerer særligt godt med mange forskellige højttalere og kilder som vinyl, tv og Bluetooth, mens det valgfri BluOS-modul udvider streamingmulighederne. Kritikpunkterne er især de få analoge indgange, behovet for høj lydstyrke med nogle højttalere, den kraftige belysning og enkelte problemer med betjening eller tilslutning.",
      "headlines": {
       "distinctive and highly praised retro styling": {
        "sentimentAnalysis": "Valnøddefinish, VU-metre og vintageudtryk er hyppige købsgrunde og vækker stor begejstring.",
        "simpleTitle": "Markant og meget rost retrodesign",
        "bias": "positive",
        "key": "design",
        "groupId": "3754789d-2b78-4e04-9418-31fb7a1448cb"
       },
       "warm, detailed and spacious sound": {
        "sentimentAnalysis": "Anmeldelserne beskriver en varm, klar, detaljeret og rummelig gengivelse med stor musikalitet.",
        "simpleTitle": "Varm, detaljeret og rummelig lyd",
        "bias": "positive",
        "key": "sound",
        "groupId": "e2bcddb0-3d83-4822-aa07-42f36bd9d16b"
       },
       "broad source compatibility, with streaming expansion available": {
        "sentimentAnalysis": "Bluetooth, HDMI-, phono- og digitale indgange værdsættes, mens BluOS ses som en nyttig vej til integreret streaming.",
        "simpleTitle": "Mange kilder og mulighed for streamingudvidelse",
        "bias": "positive",
        "key": "connectivity",
        "groupId": "cda3988e-b6c9-4e6e-9743-54677d5b7930"
       },
       "strong drive and punch with suitable speakers": {
        "sentimentAnalysis": "Flere ejere fremhæver fremragende højttalerkontrol, kraft og nyt liv i eksisterende højttalere.",
        "simpleTitle": "Kraftfuld kontrol med passende højttalere",
        "bias": "positive",
        "key": "sound",
        "groupId": "e2bcddb0-3d83-4822-aa07-42f36bd9d16b"
       },
       "bass and body can need higher volume": {
        "sentimentAnalysis": "Nogle lyttere oplever mindre fylde ved lav lydstyrke eller for lidt råstyrke med krævende højttalere, mens forvrængning ved maksimal lydstyrke ikke er et gennemgående problem.",
        "simpleTitle": "Bas og fylde kan kræve højere lydstyrke",
        "bias": "negative",
        "key": "sound",
        "groupId": "e2bcddb0-3d83-4822-aa07-42f36bd9d16b"
       },
       "limited analogue inputs and some functional omissions": {
        "sentimentAnalysis": "Flere anmeldelser nævner manglende USB-, tape- og ekstra analoge indgange samt manglende loudness eller automatisk indgangsskift.",
        "simpleTitle": "Få analoge indgange og manglende funktioner",
        "bias": "negative",
        "key": "connectivity",
        "groupId": "cda3988e-b6c9-4e6e-9743-54677d5b7930"
       }
      },
