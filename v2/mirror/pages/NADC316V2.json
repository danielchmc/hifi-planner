  "reviews": {
   "summary": "NAD C316V2 leverer en varm, klar, dynamisk og meget musikalsk lyd fra en kompakt, traditionel klasse AB-forstærker. Det fremragende forhold mellem pris og ydelse, den gode phono-gengivelse og den tilstrækkelige effekt til mange klassiske højttalere gør forstærkeren til et attraktivt valg til en enkel hi-fi-opstilling. Den enkle betjening og analoge opbygning bliver ofte rost, mens den lille fjernbetjening, den begrænsede phono-kompatibilitet, lejlighedsvis brummen fra transformeren og begrænsede effektreserver er tydelige ulemper.",
   "headlines": {
    "warm, clear and highly musical sound": {
     "sentimentAnalysis": "Anmeldelserne roser den varme, naturlige, klare og afbalancerede gengivelse, især til vokaler, klassisk musik og vinyl.",
     "simpleTitle": "Varm, klar og meget musikalsk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "d1362b28-c2d9-45ff-91cb-585024789f7e"
    },
    "excellent value and straightforward analogue design": {
     "sentimentAnalysis": "Anmeldelserne fremstiller konsekvent forstærkeren som et usædvanligt kompetent og prisvenligt valg til traditionel analog hi-fi uden unødvendige funktioner.",
     "simpleTitle": "Fremragende værdi og enkelt analogt design",
     "bias": "positive",
     "key": "value",
     "groupId": "acdd67e5-3619-4b18-9fc7-c62bcff722eb"
    },
    "strong dynamics and ample power for the price": {
     "sentimentAnalysis": "Forstærkeren beskrives gentagne gange som slagkraftig og overraskende kraftig og driver mange højttalere sikkert trods den moderate nominelle effekt.",
     "simpleTitle": "God dynamik og rigelig effekt til prisen",
     "bias": "positive",
     "key": "power",
     "groupId": "3dc2f725-c6b6-417f-b668-57530e8c08b8"
    },
    "simple controls and useful analogue connections": {
     "sentimentAnalysis": "Det overskuelige frontpanel, de fysiske tonekontroller, den nemme opsætning og de alsidige analoge tilslutninger passer til brugere, der foretrækker direkte betjening uden menuer eller digitale ekstra funktioner.",
     "simpleTitle": "Enkel betjening og praktiske analoge tilslutninger",
     "bias": "positive",
     "key": "simplicity",
     "groupId": "0e026ee7-4665-47b6-a8ff-77890fc2be78"
    },
    "remote control and connection details could be improved": {
     "sentimentAnalysis": "Den lille fjernbetjening mangler nyttige funktioner, mens nogle brugere oplever besværlige højttalertilslutninger og andre mindre betjeningskompromiser.",
     "simpleTitle": "Fjernbetjening og tilslutninger kan forbedres",
     "bias": "negative",
     "key": "simplicity",
     "groupId": "0e026ee7-4665-47b6-a8ff-77890fc2be78"
    },
    "limited power for larger-scale listening": {
     "sentimentAnalysis": "Nogle anmeldelser finder forstærkeren mindre overbevisende end ældre eller kraftigere alternativer, især med hensyn til bas, slagkraft og større rum.",
     "simpleTitle": "Begrænset effekt til større rum",
     "bias": "negative",
     "key": "power",
     "groupId": "3dc2f725-c6b6-417f-b668-57530e8c08b8"
    }
   },
