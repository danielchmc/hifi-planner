  "reviews": {
   "summary": "NAD C316V2 roses bredt for sin varme, naturlige og musikalske lyd med klar, slagkraftig og detaljeret gengivelse. Stærk dynamik, rigelig effekt og overbevisende stereoperspektiv gør det kompakte klasse A/B-design til et fremragende match med mange højttalere, vinylanlæg og ældre udstyr. Enkel betjening, fornuftige tilslutninger og fremragende værdi gør denne traditionelle forstærker særligt attraktiv trods enkelte forbehold om fjernbetjeningen, de begrænsede funktioner og lejlighedsvise lyd- eller brumproblemer.",
   "headlines": {
    "excellent value for money": {
     "sentimentAnalysis": "Forstærkeren opfattes konsekvent som et usædvanligt kapabelt og overkommeligt køb, der ofte overgår forventningerne og dyrere alternativer.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "excellent-value",
     "groupId": "2aba406f-4aed-4278-aae0-e060a12dce5c"
    },
    "powerful, dynamic and detailed presentation": {
     "sentimentAnalysis": "Anmeldelserne fremhæver godt punch, tør og differentieret bas, fin dynamik, et klart frekvensområde, rigelig lydstyrke og et bredt stereoperspektiv i prisklassen.",
     "simpleTitle": "Kraftfuld, dynamisk og detaljeret gengivelse",
     "bias": "positive",
     "key": "power-dynamics",
     "groupId": "f24c9b87-2635-47b2-b863-ba68e896d79a"
    },
    "warm, natural and musical sound": {
     "sentimentAnalysis": "Forstærkeren beskrives gentagne gange som varm, naturlig, afbalanceret og musikalsk med særlig appel til vinyl, vokaler samt akustisk og klassisk musik.",
     "simpleTitle": "Varm, naturlig og musikalsk lyd",
     "bias": "positive",
     "key": "warm-sound",
     "groupId": "f24c9b87-2635-47b2-b863-ba68e896d79a"
    },
    "simple, traditional operation": {
     "sentimentAnalysis": "Det ukomplicerede analoge design, de fysiske betjeningsknapper og den enkle opsætning værdsættes af lyttere, der ønsker de vigtigste funktioner uden menuer eller digitalt rod.",
     "simpleTitle": "Enkel, traditionel betjening",
     "bias": "positive",
     "key": "simple-operation",
     "groupId": "e6cf085e-31ef-4b22-bd5b-156f4ba5bb5a"
    },
    "some sound and quality reservations": {
     "sentimentAnalysis": "En mindre del af anmeldelserne nævner skuffende lyd, mindre bas og tryk end fra en ældre NAD, lejlighedsvis overstyring eller generende brum fra transformeren.",
     "simpleTitle": "Visse forbehold om lyd og kvalitet",
     "bias": "negative",
     "key": "sound-reservations",
     "groupId": "f24c9b87-2635-47b2-b863-ba68e896d79a"
    }
