  "reviews": {
   "summary": "NAD C328 leverer en varm, klar og kraftfuld lyd med imponerende kontrol på tværs af mange højttalere og lydkilder. Den minimalistiske betjening, Bluetooth, digitale indgange og den indbyggede phono-forforstærker gør forstærkeren alsidig, mens fronten forbliver enkel og overskuelig. De største forbehold gælder den skrøbelige og retningsfølsomme fjernbetjening, de meget små volumetrin samt manglen på tone- og balancekontroller.",
   "headlines": {
    "clear, natural and powerful sound": {
     "sentimentAnalysis": "Forstærkeren roses gentagne gange for klar, detaljeret, naturlig og kraftfuld gengivelse med kontrolleret bas og en behagelig lyd.",
     "simpleTitle": "Klar, naturlig og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "ba7eeb7c-2fbc-4039-b7a6-747fae1367d6"
    },
    "remote control feels flimsy and unresponsive": {
     "sentimentAnalysis": "Fjernbetjeningen opfattes gennemgående som det svageste punkt på grund af billig konstruktion, dårlig respons, snæver retning og for små volumetrin.",
     "simpleTitle": "Fjernbetjeningen virker billig og reagerer dårligt",
     "bias": "negative",
     "key": "remote",
     "groupId": "b0a2a0fa-0601-4c15-8eb8-a09451de5256"
    },
    "useful connectivity and simple operation": {
     "sentimentAnalysis": "Nem opsætning, enkel betjening, Bluetooth, digitale indgange og den indbyggede phono-forforstærker gør den minimalistiske forstærker praktisk og alsidig.",
     "simpleTitle": "Nyttige tilslutninger og enkel betjening",
     "bias": "positive",
     "key": "features",
     "groupId": "dee6cbe1-7a7b-46f8-b938-09472812a29b"
    },
    "smart, attractive construction": {
     "sentimentAnalysis": "Forstærkeren værdsættes for sit flotte udseende, behagelige følelse, kompakte form og overbevisende byggekvalitet.",
     "simpleTitle": "Flot og solid konstruktion",
     "bias": "positive",
     "key": "design",
     "groupId": "69194e88-6975-4ba4-b300-c3f33dfbde87"
    },
    "missing tone and balance controls": {
     "sentimentAnalysis": "Det minimalistiske design kritiseres, fordi forstærkeren mangler tone- og balancekontroller, hvilket begrænser justeringsmulighederne i nogle anlæg.",
     "simpleTitle": "Manglende tone- og balancekontroller",
