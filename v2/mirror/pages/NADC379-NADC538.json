     "reviews": {
      "summary": "NAD C538 er en enkel, driftssikker og meget musikalsk CD-afspiller med varm, klar, detaljeret og dynamisk lyd. Den nemme betjening, støjsvage afspilning, kompakte NAD-design og fremragende pris gør den til en stærk partner til NAD-forstærkere og eksisterende CD-samlinger. Enkelte brugere kritiserer plastikkabinettet, det mørke display, den enkle fjernbetjening samt mindre mekaniske eller kompatibilitetsproblemer, men den samlede vurdering er meget begejstret.",
      "headlines": {
       "warm, clear and highly detailed sound": {
        "sentimentAnalysis": "Afspilleren roses gentagne gange for varm, klar, naturlig, detaljeret, dynamisk og medrivende musikgengivelse.",
        "simpleTitle": "Varm, klar og meget detaljeret lyd",
        "bias": "positive",
        "key": "sound",
        "groupId": "d653129c-6302-4435-bd13-14c0ec8619e2"
       },
       "simple, intuitive operation": {
        "sentimentAnalysis": "Det overskuelige layout, de få knapper og den hurtige afspilning gør den daglige CD-lytning særdeles enkel.",
        "simpleTitle": "Enkel og intuitiv betjening",
        "bias": "positive",
        "key": "usability",
        "groupId": "454d3681-084b-47dc-b790-f4635f4589ee"
       },
       "excellent value and NAD system matching": {
        "sentimentAnalysis": "Kombinationen af rimelig pris, kompakt design, solid ydelse og nem NAD-integration er en vigtig grund til de stærke anbefalinger.",
        "simpleTitle": "Fremragende pris og NAD-integration",
        "bias": "positive",
        "key": "value",
        "groupId": "361d3779-41a7-48cc-8484-529c297cdb19"
       },
       "some build and control compromises": {
        "sentimentAnalysis": "Et mindretal finder display, knapper, fjernbetjening, skuffemekanisme eller plastikkabinettet mindre raffineret end forventet.",
        "simpleTitle": "Nogle kompromiser i byggekvalitet og betjening",
        "bias": "negative",
        "key": "value",
        "groupId": "361d3779-41a7-48cc-8484-529c297cdb19"
       }
