  "displayBookDemo": true,
  "reviews": {
   "summary": "NAD C 379 roses bredt for varm, klar, detaljeret og dynamisk lyd samt rigelig effekt til mange forskellige højttalere. De mange tilslutningsmuligheder med blandt andet HDMI ARC, Bluetooth, pladespillerindgang og valgfri BluOS-streaming gør forstærkeren alsidig. Enkelte anmeldelser nævner besværlig opsætning eller betjening, manglende trykt dokumentation, softwareproblemer og lejlighedsvis støj fra TV eller skift, men den samlede tilfredshed er meget høj.",
   "headlines": {
    "warm, clear and detailed sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en varm, ren, afbalanceret og meget detaljeret gengivelse med stor klarhed over hele frekvensområdet.",
     "simpleTitle": "Varm, klar og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "ca5b3e08-e06e-4145-b142-450f00470fb0"
    },
    "many useful connections and streaming options": {
     "sentimentAnalysis": "Anmeldelserne værdsætter det brede udvalg af analoge og digitale indgange, HDMI ARC, Bluetooth, pladespillerunderstøttelse og valgfri BluOS-udvidelse.",
     "simpleTitle": "Mange nyttige tilslutninger og streamingmuligheder",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "ed79ec3a-abc1-4e33-928f-cc877a42d4ed"
    },
    "powerful and dynamic performance": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver fyldigere lyd, god kontrol over højttalerne, energisk dynamik og tydelige forbedringer i forhold til ældre forstærkere.",
     "simpleTitle": "Kraftfuld og dynamisk gengivelse",
     "bias": "positive",
     "key": "sound",
     "groupId": "ca5b3e08-e06e-4145-b142-450f00470fb0"
    },
    "straightforward operation for many users": {
     "sentimentAnalysis": "Flere anmeldelser beskriver opsætning, fjernbetjening eller daglig betjening som enkel og praktisk.",
     "simpleTitle": "Enkel betjening for mange brugere",
     "bias": "positive",
     "key": "usability",
     "groupId": "10ad5976-daff-493d-8aab-58ce5b1b4a33"
    },
    "setup and documentation can be frustrating": {
     "sentimentAnalysis": "Nogle anmeldelser nævner vanskelige menuer, en besværlig førstegangsopsætning og manglende trykt eller let tilgængelig manual.",
     "simpleTitle": "Opsætning og dokumentation kan være besværlig",
     "bias": "negative",
     "key": "usability",
     "groupId": "10ad5976-daff-493d-8aab-58ce5b1b4a33"
    },
    "solid, understated construction": {
     "sentimentAnalysis": "Anmeldelserne roser det afdæmpede udseende, den solide konstruktion, den gode haptik og det attraktive design.",
     "simpleTitle": "Solid og afdæmpet konstruktion",
     "bias": "positive",
     "key": "build",
     "groupId": "fc8edf59-768e-4f35-b6e0-feea59705a11"
    },
    "a few sound issues and comparisons": {
     "sentimentAnalysis": "En minoritet nævner dæmpede eller mindre detaljerede højder, mindre slagkraft end en referenceforstærker eller hørbar TV- og forbindelsesstøj.",
     "simpleTitle": "Enkelte lydproblemer og sammenligninger",
     "bias": "negative",
     "key": "sound",
     "groupId": "ca5b3e08-e06e-4145-b142-450f00470fb0"
    }
   },
