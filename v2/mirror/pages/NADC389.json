  "displayBookDemo": true,
  "reviews": {
   "summary": "NAD C389 roses bredt for sin kraftfulde, detaljerede og alsidige lyd med klar, rummelig og ofte varm klang, som driver mange forskellige højttalere sikkert. BluOS- og Dirac-modulerne giver værdsat streaming, app-styring og rumkorrektion, mens det enkle design og de mange tilslutninger gør forstærkeren fleksibel. Enkelte anmeldelser nævner besværlig opsætning, få traditionelle indgange, problemer med Bluetooth-hovedtelefoner eller mindre god synergi med bestemte højttalere, men helhedsindtrykket er særdeles positivt med kontrolleret, fyldig og medrivende lyd til prisen.",
   "headlines": {
    "clear, detailed and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en meget opløst, transparent og rummelig gengivelse med god separation og dybde.",
     "simpleTitle": "Klar, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "89d0cfd5-6bfa-431c-ba65-7cb7dd57dc8a"
    },
    "warm, punchy and controlled bass": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den varme klang, den markante bas og den gode kontrol over hele frekvensområdet.",
     "simpleTitle": "Varm, slagkraftig og kontrolleret bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "89d0cfd5-6bfa-431c-ba65-7cb7dd57dc8a"
    },
    "strong power for demanding speakers": {
     "sentimentAnalysis": "Forstærkeren beskrives gentagne gange som kraftfuld og stabil med evne til at kontrollere krævende højttalere ved høje niveauer.",
     "simpleTitle": "Stor effekt til krævende højttalere",
     "bias": "positive",
     "key": "power",
     "groupId": "14bdc787-ddb6-4e69-b566-822df7db630e"
    },
    "bluOS and Dirac greatly expand the system": {
     "sentimentAnalysis": "De valgfri moduler værdsættes for problemfri streaming, fremragende app-styring og hørbare forbedringer fra rumkorrektionen.",
     "simpleTitle": "BluOS og Dirac udvider systemet markant",
     "bias": "positive",
     "key": "streaming",
     "groupId": "d2872433-948d-4b04-a975-d7e9d5915362"
    },
    "simple operation and clean design": {
     "sentimentAnalysis": "Det enkle frontdesign, den intuitive betjening og den velfungerende fjernbetjening får ofte ros.",
     "simpleTitle": "Enkel betjening og rent design",
     "bias": "positive",
     "key": "usability",
     "groupId": "46e9137c-99e7-41a8-9ce3-2ff35f56354a"
    },
    "some setup and Bluetooth limitations": {
     "sentimentAnalysis": "En mindre del af anmeldelserne nævner uoverskuelig betjening, firmware- eller TIDAL-problemer samt upålidelig registrering af Bluetooth-hovedtelefoner.",
     "simpleTitle": "Visse begrænsninger ved opsætning og Bluetooth",
     "bias": "negative",
     "key": "connectivity",
     "groupId": "70d6274f-ee39-469b-9f87-91c56f5649ad"
    },
    "sound can depend on speaker pairing": {
     "sentimentAnalysis": "To anmeldelser oplever en lidt tynd gengivelse eller for lidt bas med bestemte højttalerkombinationer, hvilket viser betydningen af systemmatchning.",
     "simpleTitle": "Lyden afhænger af højttalerkombinationen",
     "bias": "negative",
     "key": "sound",
     "groupId": "89d0cfd5-6bfa-431c-ba65-7cb7dd57dc8a"
    }
   },
