  "reviews": {
   "summary": "NAD C389 roses bredt som en kraftfuld, velafstemt og alsidig forstærker. Lyden beskrives typisk som klar, detaljeret, varm, rummelig og velkontrolleret med solid bas og fremragende højttalerkontrol. Den enkle betjening, de mange tilslutningsmuligheder og de valgfrie BluOS-/Dirac-opgraderinger giver stor værdi, selv om enkelte savner bestemte udgange eller oplever begrænsninger med Bluetooth og streaming.",
   "headlines": {
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne roser en klar, detaljeret og rummelig gengivelse med god separation og engagerende musikalitet.",
     "simpleTitle": "Klar, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "04cc3d59-d75b-42a8-b66e-2ce7eae8cf33"
    },
    "powerful and controlled across speakers and volumes": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent rigelig effekt, kraftfuld bas og stabil kontrol over krævende højttalere.",
     "simpleTitle": "Kraftfuld og kontrolleret med forskellige højttalere",
     "bias": "positive",
     "key": "power",
     "groupId": "74309e2a-561a-43ee-bafa-5957f93f2539"
    },
    "bluOS and Dirac add streaming and room correction": {
     "sentimentAnalysis": "Det valgfrie BluOS-modul værdsættes for bekvem streaming via app, mens Dirac-rumkorrektion kan forbedre rumfornemmelse og lydkvalitet markant.",
     "simpleTitle": "BluOS og Dirac tilføjer streaming og rumkorrektion",
     "bias": "positive",
     "key": "features",
     "groupId": "bed8aff5-d36c-4773-a06d-cfffe717764c"
    },
    "easy and uncluttered everyday operation": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver intuitiv betjening, et overskueligt frontpanel og en praktisk fjernbetjening.",
     "simpleTitle": "Nem og overskuelig betjening",
     "bias": "positive",
     "key": "usability",
     "groupId": "fbf1c84a-8ff0-4663-aafa-79add8065b77"
    },
    "some setup and connection limitations": {
     "sentimentAnalysis": "Et mindretal nævner, at mobilstyring kræver det valgfrie modul, at opsætningen kan være vanskelig, at enkelte ældre eller optiske udgange mangler, og at visse Bluetooth-hovedtelefoner ikke registreres.",
     "simpleTitle": "Visse begrænsninger ved opsætning og tilslutninger",
     "bias": "negative",
     "key": "features",
     "groupId": "bed8aff5-d36c-4773-a06d-cfffe717764c"
    }
   },
