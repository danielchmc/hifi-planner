  "displayBookDemo": true,
  "reviews": {
   "summary": "NAD C399 roses bredt som en kraftfuld, stabil og meget transparent integreret forstærker. Lyden beskrives som varm, klar, dynamisk, detaljeret og rummelig med fremragende kontrol over krævende højttalere og ren gengivelse ved alle lydstyrker. De mange tilslutninger, BluOS og Dirac Live giver stor fleksibilitet, selv om enkelte anmeldelser nævner softwareproblemer, manglende højttaleromskifter og lejlighedsvise problemer med opsætning eller TV-kompatibilitet.",
   "headlines": {
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne fremhæver en transparent, præcis og rummelig gengivelse med mange detaljer og en medrivende, koncertlignende karakter.",
     "simpleTitle": "Klar, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "sound-clear-detailed",
     "groupId": "231c279f-6be7-41e3-bb72-31dc6e2bbc5c"
    },
    "powerful control over demanding speakers": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent de store reserver, stabiliteten og den ubesværede drift, også ved høj lydstyrke og krævende højttalerbelastninger.",
     "simpleTitle": "Kraftfuld kontrol over krævende højttalere",
     "bias": "positive",
     "key": "powerful-control",
     "groupId": "047288c6-b114-41a9-9884-32b490d52340"
    },
    "bluOS and Dirac make the system more complete": {
     "sentimentAnalysis": "Det valgfrie modul værdsættes for fleksibel streaming, adgang til mange tjenester og rumkorrektion, der forbedrer balance og baskontrol.",
     "simpleTitle": "BluOS og Dirac gør systemet mere komplet",
     "bias": "positive",
     "key": "bluos-dirac",
     "groupId": "9ab04bfe-8545-44a1-b601-afadf8aada1a"
    },
    "some usability and compatibility limitations remain": {
     "sentimentAnalysis": "Et mindretal nævner softwarefejl, støj ved skift, problemer med TV-kompatibilitet, en mindre intuitiv betjening eller manglende uafhængig højttaler A/B-omskifter.",
     "simpleTitle": "Visse begrænsninger i betjening og kompatibilitet",
     "bias": "negative",
     "key": "usability-limitations",
     "groupId": "9ab04bfe-8545-44a1-b601-afadf8aada1a"
    }
   },
