  "displayBookDemo": true,
  "reviews": {
   "summary": "NAD C399 roses bredt som en kraftfuld og alsidig forstærker, der leverer en klar, detaljeret, dynamisk og ofte varm lyd. Selv krævende højttalere styres ubesværet, og lyden forbliver ren ved både lav og høj volumen; sammen med BluOS- og Dirac-modulet giver den stor værdi for pengene. Mindre kritikpunkter omfatter lejlighedsvise software- eller HDMI-problemer, et begrænset display og manglen på en A/B-vælger til højttalere, men den samlede tilfredshed er meget høj.",
   "headlines": {
    "powerful control of demanding speakers": {
     "sentimentAnalysis": "Anmeldelserne fremhæver de store kraftreserver, den stabile gengivelse ved høj volumen og den ubesværede kontrol over store eller krævende højttalere.",
     "simpleTitle": "Kraftfuld kontrol over krævende højttalere",
     "bias": "positive",
     "key": "power",
     "groupId": "1bc99da5-fe92-430c-8990-90be89b487fd"
    },
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en klar, åben, præcis og meget omsluttende gengivelse med mange detaljer i hele frekvensområdet.",
     "simpleTitle": "Klar, detaljeret og omsluttende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "e8a23e36-8efd-4279-b525-530b0a0c9675"
    },
    "bluOS and Dirac make the system more complete": {
     "sentimentAnalysis": "Den valgfri BluOS-streaming og Dirac-rumkorrektion beskrives gentagne gange som vigtige tilføjelser, der forbedrer fleksibilitet, integration og rumtilpasning.",
     "simpleTitle": "BluOS og Dirac gør systemet mere komplet",
     "bias": "positive",
     "key": "features",
     "groupId": "2e2e3769-31e9-42c2-b19c-475a343b2428"
    },
    "speaker A/B switching is missing": {
     "sentimentAnalysis": "Flere anmeldelser kritiserer, at der ikke findes en rigtig A/B-vælger til højttalere, især fordi der er to højttalerudgange.",
     "simpleTitle": "Højttaler-A/B-skift mangler",
     "bias": "negative",
     "key": "features",
     "groupId": "2e2e3769-31e9-42c2-b19c-475a343b2428"
    }
   },
