  "displayBookDemo": true,
  "reviews": {
   "summary": "NAD C700 V2 roses bredt som en kompakt og kraftfuld streamingforstærker med varm, detaljeret og rummelig lyd, mange tilslutningsmuligheder og et flot display. BluOS og streamingintegrationen er store styrker, selv om opsætning, Wi-Fi-forbindelse og enkelte app-funktioner kan kræve tålmodighed. Nogle anmeldelser nævner kraftig varmeudvikling, begrænset kontrol over tone og TV-lydstyrke, manglende funktioner som hovedtelefonudgang eller Roon-understøttelse samt lejlighedsvise problemer med kildeskift og software.",
   "headlines": {
    "setup and app control can be frustrating": {
     "sentimentAnalysis": "Flere anmeldelser beskriver en indlæringskurve, uklare vejledninger, problemer med Wi-Fi-opsætning, langsomme app-svar eller lejlighedsvise forbindelsesproblemer.",
     "simpleTitle": "Opsætning og appbetjening kan være frustrerende",
     "bias": "negative",
     "key": "usability",
     "groupId": "6a83642c-6aca-4594-978a-c8a049488ca1"
    },
    "bluOS makes streaming easy and versatile": {
     "sentimentAnalysis": "BluOS, integrationen af streamingtjenester og multiroom-funktionen beskrives ofte som problemfri, praktisk og alsidig.",
     "simpleTitle": "BluOS gør streaming nemt og alsidigt",
     "bias": "positive",
     "key": "usability",
     "groupId": "6a83642c-6aca-4594-978a-c8a049488ca1"
    },
    "compact design with a useful display": {
     "sentimentAnalysis": "Den kompakte størrelse, det flotte design og det informative display roses gentagne gange som praktisk og visuelt tiltalende.",
     "simpleTitle": "Kompakt design med nyttigt display",
     "bias": "positive",
     "key": "design",
     "groupId": "87f1bcfb-ad30-43cb-b2ea-212439b5bca3"
    },
    "warm, detailed and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne roser gennemgående den klare, dynamiske, kraftfulde og rummelige gengivelse, og flere fremhæver varme, detaljer og musikalitet.",
     "simpleTitle": "Varm, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "a3b99feb-1fb0-4cb2-b21d-72712c9354b2"
    },
    "broad connections for TV, vinyl and digital sources": {
     "sentimentAnalysis": "Anmeldelserne værdsætter kombinationen af HDMI ARC, phono, digitale indgange, AirPlay, Bluetooth og streamingtjenester i én stereokomponent.",
     "simpleTitle": "Mange tilslutninger til TV, vinyl og digitale kilder",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "c4e3b97b-b71a-4173-9160-dcef943cb369"
    },
    "runs noticeably warm": {
     "sentimentAnalysis": "Flere ejere bemærker, at forstærkeren bliver ret varm under brug, selv om en anmeldelse ikke oplever nogen påvirkning af ydelsen.",
     "simpleTitle": "Bliver mærkbart varm",
     "bias": "negative",
     "key": "design",
     "groupId": "87f1bcfb-ad30-43cb-b2ea-212439b5bca3"
    },
    "limited fullness or bass in some setups": {
     "sentimentAnalysis": "En minoritet oplever, at der skal skrues op eller bruges en subwoofer for at få tilstrækkelig fylde, bas eller varme.",
     "simpleTitle": "Mindre fylde eller bas i visse opsætninger",
     "bias": "negative",
     "key": "sound",
     "groupId": "a3b99feb-1fb0-4cb2-b21d-72712c9354b2"
    }
   },
