  "reviews": {
   "summary": "NAD C700 V2 roses bredt som en kompakt og kraftfuld streamingforstærker med varm, detaljeret og rummelig lyd, mange tilslutningsmuligheder og et flot display. BluOS og streaming opleves generelt som praktisk og velfungerende, selv om opsætning, Wi-Fi, skift af kilde og enkelte app-funktioner kan kræve tålmodighed. Nogle anmeldelser nævner høj varmeudvikling, begrænset betjening fra fjernbetjeningen, manglende funktioner og lejlighedsvise forbindelses- eller softwareproblemer, men samlet set opfattes forstærkeren som et fremragende og alsidigt køb.",
   "headlines": {
    "bluOS and streaming are versatile": {
     "sentimentAnalysis": "BluOS giver adgang til mange streamingtjenester, radio og multiroom-afspilning og beskrives ofte som smidigt og intuitivt efter opsætning.",
     "simpleTitle": "BluOS og streaming er alsidigt",
     "bias": "positive",
     "key": "usability",
     "groupId": "a2e575d0-a8cf-4d11-898f-84a4cbe5e3f5"
    },
    "setup and app control can be frustrating": {
     "sentimentAnalysis": "Flere anmeldelser nævner vanskelig opsætning, langsom eller ustabil app, forvirrende kildeskift og utilstrækkelig dokumentation.",
     "simpleTitle": "Opsætning og appbetjening kan være frustrerende",
     "bias": "negative",
     "key": "usability",
     "groupId": "a2e575d0-a8cf-4d11-898f-84a4cbe5e3f5"
    },
    "powerful, warm and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en klar, detaljeret, dynamisk og omsluttende lyd med stor kraft for en kompakt forstærker.",
     "simpleTitle": "Kraftfuld, varm og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "274b10f5-a62f-4b9b-a0ab-1e46995255b6"
    },
    "compact and attractive design": {
     "sentimentAnalysis": "Det lille format, det enkle design og det nyttige display roses gentagne gange for at passe let ind i moderne hjem.",
     "simpleTitle": "Kompakt og attraktivt design",
     "bias": "positive",
     "key": "design",
     "groupId": "90384adf-53f4-45d8-ae12-cb48dcf5fe1a"
    },
    "broad connections for streaming and physical sources": {
     "sentimentAnalysis": "Anmeldelserne værdsætter kombinationen af BluOS, AirPlay, TV-tilslutning, phono-indgang og understøttelse af CD-afspillere og andre kilder.",
     "simpleTitle": "Mange tilslutninger til streaming og fysiske kilder",
     "bias": "positive",
     "key": "connectivity",
     "groupId": "8baacd7f-1964-4afe-8cbf-31fec8b0b228"
