  "displayBookDemo": true,
  "reviews": {
   "summary": "NAD M10 V3 roses bredt som en kompakt og flot bygget all-in-one-forstærker, der leverer kraftfuld, varm, detaljeret og medrivende lyd. Streaming, tv-integration, phono, tilslutningsmuligheder og BlueOS-appen gør systemet alsidigt og let at leve med, mens det attraktive design og det fremragende display passer godt ind i moderne hjem. Dirac-rumkorrektion kan løfte ydelsen markant, men opsætning og softwarestabilitet opleves forskelligt; enkelte nævner begrænsninger med HDMI, streaming og hovedtelefoner.",
   "headlines": {
    "powerful, detailed and musical sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en varm, klar, kraftfuld og meget detaljeret gengivelse med god dynamik, kontrol og rumfornemmelse på tværs af forskellige højttalere.",
     "simpleTitle": "Kraftfuld, detaljeret og musikalsk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "4af47868-9236-4ebb-986e-af4080b7c4b2"
    },
    "compact, premium and attractive design": {
     "sentimentAnalysis": "Det kompakte format, den eksklusive konstruktion, det flotte design og det informative display fremhæves gentagne gange som store fordele i stuen.",
     "simpleTitle": "Kompakt, eksklusivt og attraktivt design",
     "bias": "positive",
     "key": "design",
     "groupId": "468dbdb1-87aa-4118-a4c5-e30a9c8c1248"
    },
    "dirac can significantly improve system performance": {
     "sentimentAnalysis": "En vellykket Dirac-kalibrering forbindes med bedre balance, rumtilpasning og samlet systemydelse, især når målingen udføres omhyggeligt.",
     "simpleTitle": "Dirac kan forbedre systemets ydelse markant",
     "bias": "positive",
     "key": "dirac",
     "groupId": "ab13216f-2fa3-4bb4-b592-ad3c123deb3f"
    },
    "versatile all-in-one connectivity": {
     "sentimentAnalysis": "Anmeldelserne værdsætter den integrerede DAC, phono, HDMI, tv-lyd, streaming og de mange fysiske tilslutninger som en komplet multimedieløsning.",
     "simpleTitle": "Alsidige all-in-one-tilslutninger",
     "bias": "positive",
     "key": "features",
     "groupId": "92a9b6cf-8b04-4820-996c-951173a18bcc"
    },
    "dirac and software setup can be frustrating": {
     "sentimentAnalysis": "Nogle brugere oplever Dirac-appen som fejlbehæftet eller skuffende, at opsætningen kræver tålmodighed, og at softwareproblemer forringer den ellers stærke forstærkeroplevelse.",
     "simpleTitle": "Dirac- og softwareopsætning kan være frustrerende",
     "bias": "negative",
     "key": "dirac",
     "groupId": "ab13216f-2fa3-4bb4-b592-ad3c123deb3f"
    },
    "streaming and HDMI reliability issues": {
     "sentimentAnalysis": "Et mindre, men tydeligt antal anmeldelser nævner afbrudt streaming, besværligt skift mellem enheder, HDMI-/CEC-problemer og knas mellem TIDAL-numre.",
     "simpleTitle": "Problemer med streaming og HDMI-stabilitet",
     "bias": "negative",
     "key": "software",
     "groupId": "dbbb1ba5-5c90-4896-b067-dd2be9c51047"
    }
   },
