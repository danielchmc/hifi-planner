  "displayBookDemo": true,
  "reviews": {
   "summary": "NAD M10 V3 roses bredt som en kompakt alt-i-en-forstærker med varm, detaljeret og kraftfuld lyd, fremragende streaming og mange tilslutninger. Det elegante design, den høje byggekvalitet og den intuitive betjening gør den særligt attraktiv til tv, vinyl, digital musik og multiroom. Dirac Live kan forbedre klarhed og rumtilpasning yderligere, men opsætning, HDMI/CEC, streamingstabilitet og manglende hovedtelefonsupport kritiseres, mens prisen lejlighedsvis vurderes som høj.",
   "headlines": {
    "warm, detailed and powerful sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent en klar, naturlig, rummelig og meget detaljeret gengivelse med rigelig effekt, god kontrol og engagerende musikalitet.",
     "simpleTitle": "Varm, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "2bd5faad-57df-48c1-b6eb-9282eb913ce2"
    },
    "compact premium design with ample power": {
     "sentimentAnalysis": "Den lille størrelse, det eksklusive udseende, det flotte display og den stærke effekt roses gentagne gange som en sjælden kombination af bekvemmelighed og high-end-udtryk.",
     "simpleTitle": "Kompakt premiumdesign med masser af effekt",
     "bias": "positive",
     "key": "design",
     "groupId": "e8098de2-da9d-4a6c-bbe1-c37c1370acf7"
    },
    "versatile all-in-one streaming hub": {
     "sentimentAnalysis": "Den integrerede DAC, phono-forforstærker, HDMI, streamingplatforme, tv-lyd, multiroom-muligheder og de mange indgange gør forstærkeren til et komplet systemcentrum.",
     "simpleTitle": "Alsidig alt-i-en-streamingcentral",
     "bias": "positive",
     "key": "features",
     "groupId": "b7b09754-aaff-4402-b300-c12aea1f9f22"
    },
    "dirac Live can significantly improve room integration": {
     "sentimentAnalysis": "En vellykket kalibrering beskrives som en måde at stramme gengivelsen op, forbedre ældre højttalere og tilpasse lyden effektivt til rummet.",
     "simpleTitle": "Dirac Live kan forbedre rumtilpasningen markant",
     "bias": "positive",
     "key": "dirac",
     "groupId": "ab94f9d0-1dc1-41c7-ac04-01a11ceff3f3"
    },
    "setup and software can be frustrating": {
     "sentimentAnalysis": "Flere anmeldelser nævner en fejlbehæftet eller vanskelig opsætning, HDMI/CEC-problemer, afbrudt streaming eller afspilningsfejl, selv om den daglige betjening oftest er enkel.",
     "simpleTitle": "Opsætning og software kan være frustrerende",
     "bias": "negative",
     "key": "usability",
     "groupId": "d516b03e-6327-4914-93c8-b82ed1d78ce9"
    },
    "limited headphone support": {
     "sentimentAnalysis": "Den manglende hovedtelefonudgang og de begrænsede routingmuligheder gør produktet mindre egnet til hovedtelefonlytning.",
     "simpleTitle": "Begrænset hovedtelefonsupport",
     "bias": "negative",
     "key": "features",
     "groupId": "b7b09754-aaff-4402-b300-c12aea1f9f22"
    }
