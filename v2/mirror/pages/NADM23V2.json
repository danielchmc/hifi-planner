    "detailed, clean and precise sound": {
     "sentimentAnalysis": "Anmeldelserne roser den højopløste, klare og stramt kontrollerede gengivelse med præcis bas og mange detaljer selv ved baggrundsniveauer.",
     "simpleTitle": "Detaljeret, ren og præcis lyd",
     "bias": "positive",
     "key": "sound",
