  "reviews": {
   "summary": "NAD M33 V2 betragtes bredt som en fremragende og alsidig streamingforstærker med varm, klar og detaljeret lyd, imponerende kraft og ubesværet kontrol over højttalerne. BluOS er intuitivt, mens den enkle opsætning og den omfattende alt-i-en-funktionalitet giver stor bekvemmelighed. Den eneste tilbagevendende anke er, at Dirac-indmålingen ikke forbedrer lyden i alle rum, og at forskellen i lyd i forhold til forgængeren ikke er tydelig for alle.",
   "headlines": {
    "warm, clear and highly detailed sound": {
     "sentimentAnalysis": "Anmeldelserne roser den varme, bløde, klare og detaljerede gengivelse med god separation og en engagerende karakter.",
     "simpleTitle": "Varm, klar og meget detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "6c8cbdd5-3225-4f33-8dfc-d0d527f1bd82"
    },
    "powerful and effortless speaker drive": {
     "sentimentAnalysis": "Forstærkeren beskrives gentagne gange som kraftfuld, rolig og i stand til ubesværet at drive krævende højttalere og store rum.",
     "simpleTitle": "Kraftfuld og ubesværet højttalerdrift",
     "bias": "positive",
     "key": "power",
     "groupId": "7ec3fcfb-c2e8-4912-8dcd-4b51a3c52389"
    },
    "intuitive all-in-one streaming": {
     "sentimentAnalysis": "BluOS og den integrerede streaming værdsættes for at være intuitiv, omfattende og nem at bruge.",
     "simpleTitle": "Intuitiv alt-i-en-streaming",
     "bias": "positive",
     "key": "streaming",
     "groupId": "cff1a322-014c-4583-af03-0023bcd08517"
    },
    "dirac calibration can underperform": {
     "sentimentAnalysis": "Dirac-rumkorrektion er ikke universelt fordelagtig; i de beskrevne lytteomgivelser foretrækkes lyden uden korrektion.",
     "simpleTitle": "Dirac-indmåling kan give dårligere resultater",
     "bias": "negative",
     "key": "dirac",
     "groupId": "de0d2042-b0d7-47d4-b7e8-73b57fd2ab99"
    }
   },
