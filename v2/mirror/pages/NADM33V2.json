  "reviews": {
   "summary": "NAD M33 V2 roses bredt som en kraftfuld, raffineret og meget musikalsk streamingforstærker. Gengivelsen er varm, men samtidig ren, detaljeret og omsluttende, med punchy bas, fremragende separation og kontrol nok til krævende højttalere. BluOS og den enkle betjening giver ekstra komfort, mens Dirac-resultaterne kan afhænge af systemet, og forbedringen i forhold til den tidligere version ikke opleves lige tydeligt af alle.",
   "headlines": {
    "warm, detailed and highly musical sound": {
     "sentimentAnalysis": "Forstærkeren roses for en varm, ren, detaljeret og engagerende gengivelse, som samtidig er let at lytte til.",
     "simpleTitle": "Varm, detaljeret og meget musikalsk lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "b856f6e0-7215-42fe-b23b-10a044c01256"
    },
    "effortless power for demanding speakers": {
     "sentimentAnalysis": "Anmeldelserne beskriver store kraftreserver, ubesværet kontrol over højttalerne, mindre anstrengelse og bedre fylde i rummet.",
     "simpleTitle": "Ubesværet kraft til krævende højttalere",
     "bias": "positive",
     "key": "power",
     "groupId": "bd0280e8-57cc-4145-b47b-75711edf4e95"
    },
    "bluOS streaming is intuitive and complete": {
     "sentimentAnalysis": "BluOS opleves som problemfri, intuitiv og tilstrækkeligt omfattende, mens integreret streaming giver ekstra bekvemmelighed.",
     "simpleTitle": "BluOS-streaming er intuitiv og komplet",
     "bias": "positive",
     "key": "streaming-usability",
     "groupId": "2c2f52ac-69e6-42c2-9459-dc64db36fdea"
    },
    "excellent separation and controlled bass": {
     "sentimentAnalysis": "Den tydelige adskillelse mellem mellemtone, bas og diskant samt den kontrollerede bas fremhæves som en stor forbedring.",
     "simpleTitle": "Fremragende separation og kontrolleret bas",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "b856f6e0-7215-42fe-b23b-10a044c01256"
    }
   },
