  "reviews": {
   "summary": "NAD M33 V2 er en usædvanligt kraftfuld og velafstemt streaming-integreret forstærker med varm, detaljeret og rummelig lyd. Musikken får mere punch, kontrol, separation og ubesværet overskud, mens selv krævende højttalere drives med imponerende autoritet. BluOS og den enkle plug-and-play-betjening bliver værdsat højt, selv om Dirac-indmålingen kan give blandede resultater, og opgraderingen fra den tidligere version ikke er lige tydelig for alle.",
   "headlines": {
    "warm, detailed and spacious sound": {
     "sentimentAnalysis": "Forstærkeren roses gentagne gange for at kombinere klarhed og detaljer med varme, blødhed og en medrivende gengivelse.",
     "simpleTitle": "Varm, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "11713a4b-74f4-4d98-ab73-66c0995db4fc"
    },
    "effortless power for demanding speakers": {
     "sentimentAnalysis": "M33 V2 beskrives konsekvent som muskuløs og ubesværet med rigelige reserver til store eller krævende højttalere.",
     "simpleTitle": "Uanstrengt kraft til krævende højttalere",
     "bias": "positive",
     "key": "power-drive",
     "groupId": "081fb82a-2f4f-4c4d-b8f4-7d07e1a28209"
    },
    "bluOS is intuitive and reliable": {
     "sentimentAnalysis": "BluOS roses for problemfri, intuitiv betjening og en komplet integreret streamingoplevelse.",
     "simpleTitle": "BluOS er intuitivt og driftssikkert",
     "bias": "positive",
     "key": "streaming-usability",
     "groupId": "ea0bb702-bb20-4c7e-bf99-d75d2b74d8ee"
    },
    "excellent separation and controlled bass": {
     "sentimentAnalysis": "Anmeldelserne fremhæver den tydelige adskillelse mellem bas, mellemtone og diskant samt den stramme, kontrollerede bas.",
     "simpleTitle": "Fremragende separation og kontrolleret bas",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "11713a4b-74f4-4d98-ab73-66c0995db4fc"
    }
