  "reviews": {
   "summary": "NAD M66 leverer varm, kraftfuld og meget detaljeret lyd med strammere bas, større dybde i lydbilledet og en medrivende stereogengivelse. Dirac Live og baskorrektion kan give særligt imponerende klarhed, præcision og dybde, mens streaming og BluOS tilbyder omfattende funktioner, når alt fungerer problemfrit. Det raffinerede design, den solide byggekvalitet og de fleksible funktioner gør M66 til en spændende high-end-forforstærker, selv om softwareproblemer, begrænsninger i betjeningen og utilstrækkelig hjælp til opsætning er tydelige svagheder.",
   "headlines": {
    "detailed, spacious and controlled sound": {
     "sentimentAnalysis": "Lyden roses for klarhed, detaljer, dybde, stram bas og et mere komplet stereobillede.",
     "simpleTitle": "Detaljeret, rummelig og kontrolleret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "c11e9e4e-73bf-4fcb-9deb-36b230be0758"
    },
    "elegant, premium construction": {
     "sentimentAnalysis": "Produktet beskrives gentagne gange som attraktivt, æstetisk tiltalende og meget solidt bygget.",
     "simpleTitle": "Elegant konstruktion i høj kvalitet",
     "bias": "positive",
     "key": "design",
     "groupId": "fe17fac7-b3a1-4226-b31b-59c0664e1ce4"
    },
    "dirac Live makes a major difference": {
     "sentimentAnalysis": "Rumkorrektion giver klarere og dybere lyd samt strammere bas og beskrives som den mest mærkbare opgradering.",
     "simpleTitle": "Dirac Live gør en stor forskel",
     "bias": "positive",
     "key": "roomcorrection",
     "groupId": "345a2ff6-5fe2-4d3b-a5a7-e1e82cbd7b4f"
    },
    "bluOS and control software can be awkward": {
     "sentimentAnalysis": "Softwaren kritiseres for svag implementering, uintuitiv betjening og manglende netværksstyring.",
     "simpleTitle": "BluOS og kontrolsoftwaren kan være besværlig",
     "bias": "negative",
     "key": "streaming",
     "groupId": "ffae404a-2989-4248-841f-6662dcd41099"
