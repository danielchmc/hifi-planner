  "reviews": {
   "summary": "NAD M66 leverer en usædvanligt klar, varm og medrivende lyd med strammere bas, flere detaljer og et mere overbevisende tredimensionelt lydbillede. Dirac Live og baskontrol kan give den største forbedring og skabe imponerende præcision og dybde ved korrekt opsætning. Den raffinerede konstruktion, alsidige tilslutning og problemfri BluOS-streaming opvejes dog af frustrerende mangler i software, betjening og opsætning.",
   "headlines": {
    "clear, detailed and immersive sound": {
     "sentimentAnalysis": "Lyden roses for usædvanlig klarhed, flere detaljer, blødere diskant og et mere komplet stereobillede.",
     "simpleTitle": "Klar, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "sound_detail",
     "groupId": "b4b6f8ee-068c-4239-8ab9-534830439701"
    },
    "tighter, more precise bass": {
     "sentimentAnalysis": "Anmeldelserne beskriver bassen som strammere, blødere og mere kontrolleret, især i de dybeste frekvenser.",
     "simpleTitle": "Strammere og mere præcis bas",
     "bias": "positive",
     "key": "sound_bass",
     "groupId": "b4b6f8ee-068c-4239-8ab9-534830439701"
    },
    "dirac adds clarity and depth": {
     "sentimentAnalysis": "Rumkorrektion beskrives gentagne gange som en stor opgradering, der forbedrer baspræcision, klarhed og dybde i lydbilledet.",
     "simpleTitle": "Dirac giver klarhed og dybde",
     "bias": "positive",
     "key": "dirac_impact",
     "groupId": "a997233a-9b9e-4460-babb-78784d47a969"
    },
    "high-quality, attractive construction": {
     "sentimentAnalysis": "Produktet roses for sit elegante udseende, pæne finish og høje byggekvalitet.",
     "simpleTitle": "Høj kvalitet og attraktiv konstruktion",
     "bias": "positive",
     "key": "design_quality",
     "groupId": "c1a3b571-187a-494b-ba7a-389e6b203658"
    },
    "bluOS and control software feel underdeveloped": {
     "sentimentAnalysis": "BluOS og netværksstyring kritiseres for svag implementering, manglende funktioner, besværlig app-adfærd og upålidelig integration.",
     "simpleTitle": "BluOS og styringssoftwaren virker ufærdige",
     "bias": "negative",
     "key": "software_shortcomings",
     "groupId": "4a194d6d-325b-4eec-96e2-cb227408e88a"
    }
   },
