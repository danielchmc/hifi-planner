  "reviews": {
   "summary": "NAD PP2e leverer en varm, klar og engagerende vinyllyd til en attraktiv pris og er enkel at bruge. Phonotrinnet fungerer godt med både MM- og MC-pickupper, forbedrer mange eksisterende anlæg og giver vinylafspilningen mere dynamik og nærvær. Automatisk standby og lejlighedsvis baggrundsstøj er de største ulemper, mens det kompakte design og den nemme installation tæller positivt.",
   "headlines": {
    "clear, warm and engaging vinyl sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver lyden som klar, varm, åben, dynamisk og behagelig til vinyllytning.",
     "simpleTitle": "Klar, varm og engagerende vinyllyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "15b44785-5e07-461c-a7ed-34a2ad180456"
    },
    "a noticeable upgrade to existing systems": {
     "sentimentAnalysis": "Phonotrinnet roses for at gøre ældre eller indbyggede phonoløsninger mere dynamiske og bedre.",
     "simpleTitle": "En mærkbar opgradering af eksisterende anlæg",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "15b44785-5e07-461c-a7ed-34a2ad180456"
    },
    "some background noise is audible": {
     "sentimentAnalysis": "To anmeldelser nævner svag baggrundsstøj, især ved højere lydstyrke eller uden afspilning.",
     "simpleTitle": "Der kan høres baggrundsstøj",
     "bias": "negative",
