     "groupId": "5f24721f-e449-4976-a8d6-13fae5e8d047"
    },
    "some audible background noise": {
     "sentimentAnalysis": "Flere anmeldelser nævner svag baggrundsstøj, især ved højere lydstyrke eller i stille passager.",
     "simpleTitle": "Nogen hørbar baggrundsstøj",
     "bias": "negative",
     "key": "noise",
     "groupId": "aea88e64-a4d3-448a-827b-53a4612f1ca9"
    },
    "automatic standby cannot be disabled": {
     "sentimentAnalysis": "Anmeldelserne kritiserer den faste automatiske standby-funktion, herunder langsom aktivering og et hørbart plop ved tænding.",
