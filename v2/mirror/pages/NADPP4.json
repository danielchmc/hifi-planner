  "reviews": {
   "summary": "NADPP4 leverer klar, varm, fyldig og medrivende lyd til en attraktiv pris, er nem at betjene og fungerer overbevisende med forskellige pladespilleropsætninger. Digitalisering af LP’er og singler er praktisk, mens USB-tilslutningen også gør kassetteoverførsel mulig. Den medfølgende VinylStudio-software er den største svaghed, da tilgængelighed, begrænsninger og optagestabilitet kritiseres.",
   "headlines": {
    "clear, warm sound": {
     "sentimentAnalysis": "RIAA-trinnet roses gentagne gange for klar, varm og konsekvent ren lyd og for at forbedre eksisterende receiver- eller NAD-RIAA-trin.",
     "simpleTitle": "Klar, varm lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "5e777ee3-54f1-4330-a4bf-aca3ab04fc2b"
    },
    "attractive price": {
     "sentimentAnalysis": "Enheden vurderes gentagne gange som prisvenlig og tilbyder meget god lyd og nyttige funktioner til prisen.",
     "simpleTitle": "Attraktiv pris",
     "bias": "positive",
     "key": "value",
     "groupId": "2870717e-4b2f-4ef8-8570-d53e105d8a23"
    },
    "strong turntable performance": {
     "sentimentAnalysis": "Kompatibilitet med Rega- og Thorens-pladespillere kombineres med meget god lyd, hvor vinyl kan måle sig med cd’er og streaming i høj opløsning.",
     "simpleTitle": "Stærk pladespillerydelse",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "5e777ee3-54f1-4330-a4bf-aca3ab04fc2b"
    },
    "practical vinyl digitisation": {
     "sentimentAnalysis": "USB-optagelse anses for nyttig til digitalisering af LP’er og singler, og kassetteoverførsel nævnes også som en praktisk anvendelse.",
     "simpleTitle": "Praktisk vinyldigitalisering",
     "bias": "positive",
     "key": "digitisation",
     "groupId": "10f00935-cf00-48a9-b9b1-358fe9c5813a"
    },
    "vinylStudio software is limited and unreliable": {
     "sentimentAnalysis": "Den anbefalede VinylStudio-software kritiseres for manglende downloads, stramme begrænsninger i gratisversionen og gentagne optagelsesafbrydelser, så alternativer bliver brugt.",
     "simpleTitle": "VinylStudio er begrænset og ustabilt",
     "bias": "negative",
     "key": "digitisation",
     "groupId": "10f00935-cf00-48a9-b9b1-358fe9c5813a"
