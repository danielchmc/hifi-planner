  "reviews": {
   "summary": "NAD T 778 roses bredt for varm, detaljeret og kraftfuld lyd i både stereo og hjemmebio og giver ofte eksisterende højttalere nyt liv. Dirac Live kan løfte den allerede stærke gengivelse yderligere, mens BluOS og de mange tilslutningsmuligheder gør receiveren alsidig til musik og film. Manualen, enkelte problemer med indgange og eARC, de begrænsede analoge tilslutninger samt blæserstøj nævnes som ulemper, selv om forhandlerservicen konsekvent er fremragende.",
   "headlines": {
    "warm, detailed and powerful sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver lyden som varm, fremragende, klar og kraftfuld i både stereo og surround.",
     "simpleTitle": "Varm, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "9b0a24ef-5a23-4c03-90b6-bd0046eeeae3"
    },
    "a major upgrade for existing speakers": {
     "sentimentAnalysis": "Flere anmeldelser fortæller, at receiveren får eksisterende højttalere til at lyde markant bedre eller giver ældre anlæg nyt liv.",
     "simpleTitle": "En stor opgradering af eksisterende højttalere",
     "bias": "positive",
     "key": "sound",
     "groupId": "9b0a24ef-5a23-4c03-90b6-bd0046eeeae3"
    },
    "dealer support is responsive and effective": {
     "sentimentAnalysis": "Kundeservicen roses gentagne gange for nyttig rådgivning, hurtige svar og løsning af problemer med opsætning eller udstyr.",
     "simpleTitle": "Forhandlerservicen er hurtig og effektiv",
     "bias": "positive",
     "key": "service",
     "groupId": "df25626a-839a-450c-a8b9-9317924058e5"
    },
    "dirac Live can transform the presentation": {
     "sentimentAnalysis": "Dirac Live roses for en markant forbedring efter kalibrering og imponerende rumkorrektion.",
     "simpleTitle": "Dirac Live kan forvandle gengivelsen",
     "bias": "positive",
     "key": "calibration",
     "groupId": "cd26d246-2a68-43b6-baf7-f12323382dfd"
    },
    "versatile and easy everyday operation": {
     "sentimentAnalysis": "BluOS, de overskuelige menuer, automatisk kildeskift, touchdisplayet og den brede kildeunderstøttelse beskrives som praktiske og nemme at bruge.",
     "simpleTitle": "Alsidig og nem betjening i hverdagen",
     "bias": "positive",
     "key": "usability",
     "groupId": "885d9b3d-b742-4382-aefd-24987c7feb38"
    },
    "some setup and control limitations remain": {
     "sentimentAnalysis": "Anmeldelser nævner en mangelfuld manual, store lydstyrkeforskelle mellem HDMI og analog, afhængighed af telefonen samt manglende analoge eller MC-phono-tilslutninger.",
     "simpleTitle": "Visse begrænsninger ved opsætning og betjening",
     "bias": "negative",
     "key": "usability",
     "groupId": "885d9b3d-b742-4382-aefd-24987c7feb38"
    },
    "fan noise is audible in quiet passages": {
     "sentimentAnalysis": "Begge anmeldelser om blæseren kritiserer den hørbare støj; den ene beskriver den som ekstremt høj, mens den anden især bemærker den, når der ikke afspilles noget.",
     "simpleTitle": "Blæserstøj høres i stille passager",
     "bias": "negative",
     "key": "fan",
     "groupId": "e144081b-ed4a-4812-8f2b-0abb9fa56915"
    }
   },
