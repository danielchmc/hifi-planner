  "reviews": {
   "summary": "Disse hovedtelefoner leverer en varm, dynamisk og detaljeret lyd med især vellykket bas samt generelt god komfort og et stærkt forhold mellem pris og kvalitet. Støjreduktionen roses af mange til rejser og hverdagsbrug, selv om flere synes, at den er svagere end hos dyrere alternativer. Nem betjening, sammenklappeligt design og lang batteritid gør dem attraktive, mens begrænsede justeringsmuligheder, manglende batteriindikator og enkelte fysiske eller basrelaterede ulemper trækker ned.",
   "headlines": {
    "comfortable and light for extended wear": {
     "sentimentAnalysis": "Den lave vægt og gode pasform gør hovedtelefonerne komfortable til pendling, arbejde og længere lytteperioder.",
     "simpleTitle": "Komfortable og lette ved længere tids brug",
     "bias": "positive",
     "key": "comfort",
     "groupId": "0c59b69d-1d84-4f8e-9927-600578ba1db9"
    },
    "noise cancellation works well for travel and daily use": {
     "sentimentAnalysis": "Den aktive støjreduktion beskrives ofte som effektiv mod flystøj, stemmer og omgivende lyde.",
     "simpleTitle": "Støjreduktionen fungerer godt på rejser og i hverdagen",
     "bias": "positive",
     "key": "anc",
     "groupId": "378f72ec-3de0-4b19-b059-4e274884409e"
    },
    "warm, punchy sound with strong bass": {
     "sentimentAnalysis": "Lyden roses bredt som klar, musikalsk og fyldig med særligt engagerende bas og en stærk mellemtone.",
     "simpleTitle": "Varm og dynamisk lyd med kraftig bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "bad0951d-5a7c-405b-b6a7-2841f93fd9d6"
    },
    "easy controls and practical foldable design": {
     "sentimentAnalysis": "Overskuelig betjening, nem parring og et sammenklappeligt format gør den daglige håndtering enkel.",
     "simpleTitle": "Nem betjening og praktisk sammenklappeligt design",
     "bias": "positive",
     "key": "usability",
     "groupId": "d0759eba-6082-4afc-99d3-2a1bb4cd3c21"
    },
    "noise cancellation falls short of premium rivals": {
     "sentimentAnalysis": "Flere anmeldelser vurderer støjreduktionen som acceptabel til prisen, men tydeligt svagere end hos førende mærker.",
     "simpleTitle": "Støjreduktionen er svagere end hos premiumkonkurrenter",
     "bias": "negative",
     "key": "anc",
     "groupId": "378f72ec-3de0-4b19-b059-4e274884409e"
    },
    "bass can become excessive or distort at high levels": {
     "sentimentAnalysis": "Den livlige bas er tiltalende, men i visse situationer bliver den for kraftig eller forvrænget, og muligheden for tonejustering savnes.",
     "simpleTitle": "Bassen kan blive for kraftig eller forvrænget ved højt niveau",
     "bias": "negative",
     "key": "sound",
     "groupId": "bad0951d-5a7c-405b-b6a7-2841f93fd9d6"
    },
    "small controls and limited adjustability frustrate": {
     "sentimentAnalysis": "Små knapper, manglen på en app og begrænset lydjustering reducerer fleksibiliteten.",
     "simpleTitle": "Små knapper og begrænsede justeringsmuligheder frustrerer",
     "bias": "negative",
     "key": "usability",
     "groupId": "d0759eba-6082-4afc-99d3-2a1bb4cd3c21"
    }
