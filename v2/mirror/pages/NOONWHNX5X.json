  "reviews": {
   "summary": "NOONWHNX5X leverer en varm, slagkraftig og detaljeret lyd med en særligt tilfredsstillende bas, som gør musik og film medrivende. Den komfortable og lette konstruktion samt den lange batteritid passer godt til daglig lytning, mens støjreduktionen ofte roses til rejser og fordybelse. De væsentligste forbehold gælder varierende ANC-ydeevne, begrænsede muligheder for lydjustering uden en app samt enkelte praktiske detaljer ved betjening og komfort.",
   "headlines": {
    "lightweight and comfortable for extended wear": {
     "sentimentAnalysis": "Høretelefonerne beskrives gentagne gange som lette, velsiddende og behagelige til transport, arbejde og længere lyttesessioner.",
     "simpleTitle": "Let og behagelig ved længere tids brug",
     "bias": "positive",
     "key": "comfort",
     "groupId": "7cd454fc-c91f-4e3f-ab2d-93f94262360b"
    },
    "anc is effective for travel and focus": {
     "sentimentAnalysis": "ANC roses ofte for at reducere fly-, husholdnings- og omgivelsesstøj og skabe et fredeligt lytterum.",
     "simpleTitle": "ANC er effektiv til rejser og fordybelse",
     "bias": "positive",
     "key": "anc",
     "groupId": "27f997db-98ae-4982-bc30-49befb6a1b4a"
    },
    "warm, punchy sound with strong bass": {
     "sentimentAnalysis": "Den fyldige, varme og energiske gengivelse roses, især den dybe og markante bas.",
     "simpleTitle": "Varm, slagkraftig lyd med kraftig bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "35d2895f-ff19-4147-ad01-39c1a9c57635"
    },
    "clear and versatile sound": {
     "sentimentAnalysis": "Lyden beskrives som klar, bred og velafbalanceret på tværs af musik, tale og film.",
     "simpleTitle": "Klar og alsidig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "35d2895f-ff19-4147-ad01-39c1a9c57635"
    },
    "noise cancellation falls short for some listeners": {
     "sentimentAnalysis": "En mindre del af anmeldelserne vurderer ANC som svagere end forventet eller under niveauet hos dyrere konkurrenter, selv om den stadig kan bruges.",
     "simpleTitle": "Støjreduktionen lever ikke op til alles forventninger",
     "bias": "negative",
     "key": "anc",
     "groupId": "27f997db-98ae-4982-bc30-49befb6a1b4a"
    },
    "easy pairing and straightforward operation": {
     "sentimentAnalysis": "Parring og daglig betjening opleves ofte som enkel, og en app er ikke nødvendig til grundlæggende brug.",
     "simpleTitle": "Nem parring og enkel betjening",
     "bias": "positive",
     "key": "controls",
     "groupId": "fb1fc5ca-ca97-4bbd-bd20-ef216e9095c4"
    },
    "bass can become excessive or distort at maximum": {
     "sentimentAnalysis": "Flere anmeldelser kan lide den kraftige bas, men bemærker, at klangen kan blive for dominerende, og at der kan opstå forvrængning ved høj bas og ANC.",
     "simpleTitle": "Bassen kan blive for kraftig eller forvrænge ved maksimum",
     "bias": "negative",
     "key": "sound",
     "groupId": "35d2895f-ff19-4147-ad01-39c1a9c57635"
    },
    "ear cups and fit can become warm or tiring": {
     "sentimentAnalysis": "Nogle brugere oplever varme, sved eller stivhed i starten ved længere tids brug, hvilket viser, at komforten ikke er lige ensartet for alle.",
     "simpleTitle": "Ørepuder og pasform kan blive varme eller trættende",
     "bias": "negative",
     "key": "comfort",
     "groupId": "7cd454fc-c91f-4e3f-ab2d-93f94262360b"
    },
    "long battery life": {
     "sentimentAnalysis": "Batteritiden roses for at holde til længere tids daglig brug og rejser.",
     "simpleTitle": "Lang batteritid",
     "bias": "positive",
     "key": "battery",
     "groupId": "5f8b21d0-1d76-4ae0-8215-03e01eca2c6e"
    },
    "small controls and no app limit adjustment": {
     "sentimentAnalysis": "De fysiske knapper kan føles for små, mens manglen på en app forhindrer equalizerjusteringer og gør USB-lyd mere besværlig.",
     "simpleTitle": "Små knapper og manglende app begrænser justeringen",
     "bias": "negative",
     "key": "controls",
     "groupId": "fb1fc5ca-ca97-4bbd-bd20-ef216e9095c4"
    },
    "battery status is not clearly indicated": {
     "sentimentAnalysis": "Manglen på en batteriindikator nævnes som en praktisk ulempe.",
     "simpleTitle": "Batteriniveauet vises ikke tydeligt",
     "bias": "negative",
