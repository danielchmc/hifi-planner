  "reviews": {
   "summary": "NOONWISPORT3X leverer varm, klar og overraskende fyldig lyd til en attraktiv pris og sidder sikkert i mange ører, også under træning. Komfort, enkel parring og den gode værdi for pengene bliver ofte rost, mens støjreduktion og mikrofoner til telefonsamtaler er mindre overbevisende. De overfølsomme touch-funktioner og besværlige enhedsskift er de største frustrationer, men helhedsindtrykket er stadig stærkt for prisbevidste lyttere.",
   "headlines": {
    "over-sensitive touch controls": {
     "sentimentAnalysis": "Mange anmeldelser nævner utilsigtede kommandoer, fordi touch-felterne reagerer for let, når ørepropperne justeres eller bæres.",
     "simpleTitle": "Overfølsomme touch-funktioner",
     "bias": "negative",
     "key": "controls",
     "groupId": "c8786a62-463c-4b14-bb85-b53c23c7386b"
    },
    "warm, clear sound with strong value": {
     "sentimentAnalysis": "Flere anmeldelser roser den klare, fyldige eller overraskende kraftige lyd, især i forhold til den lave pris.",
     "simpleTitle": "Varm og klar lyd til en god pris",
     "bias": "positive",
     "key": "sound",
     "groupId": "051b3b34-6997-4b2f-865e-bdb3913f3235"
    },
    "secure fit for exercise": {
     "sentimentAnalysis": "Flere anmeldelser beskriver en komfortabel og sikker pasform, der bliver siddende under løb, cykling eller anden aktivitet.",
     "simpleTitle": "Sikker pasform under træning",
     "bias": "positive",
     "key": "fit",
     "groupId": "20afcaa3-599d-4559-a1e2-138db51d8e02"
    },
    "call microphones disappoint": {
     "sentimentAnalysis": "Flere anmeldelser siger, at samtalepartnere har svært ved at høre stemmen tydeligt, især i støj eller vind.",
     "simpleTitle": "Mikrofonerne skuffer ved samtaler",
     "bias": "negative",
     "key": "calls",
     "groupId": "25c04596-5d55-4591-b52b-186006e48e3d"
    },
    "noise cancellation is inconsistent": {
     "sentimentAnalysis": "Støjreduktionen beskrives gentagne gange som svag eller under forventning, og vindstøj påvirker også ydeevnen.",
     "simpleTitle": "Støjreduktionen er ujævn",
     "bias": "negative",
     "key": "noise",
     "groupId": "5c0df854-21dd-4e7d-90ea-aef2ea2a697a"
    },
    "switching between devices is cumbersome": {
     "sentimentAnalysis": "Skift mellem enheder og fastholdelse af forbindelsen kritiseres, fordi det kan være nødvendigt at glemme og parre igen.",
     "simpleTitle": "Skift mellem enheder er besværligt",
     "bias": "negative",
     "key": "connectivity",
     "groupId": "e0d68873-d767-4e71-8b38-eb63b537acbc"
    }
