        "bias": "positive",
        "key": "dali-system-match",
        "groupId": "879d1c53-76a7-4f34-9bbb-2ea777cd742b"
       },
       "excellent dialogue intelligibility": {
        "sentimentAnalysis": "Dialoger og vokaler beskrives gentagne gange som klare, luftige og lette at følge, selv under høje lydeffekter.",
        "simpleTitle": "Fremragende dialogforståelse",
        "bias": "positive",
        "key": "dialogue-intelligibility",
        "groupId": "0e342f70-a00f-4463-8f0e-183628fe692a"
