     "groupId": "26d5223b-8274-43f0-9591-c159abb5741b"
    },
    "very good value for the price": {
     "sentimentAnalysis": "Anmeldelserne beskriver samstemmigt pickuppen som en god investering og usædvanligt god værdi for pengene.",
     "simpleTitle": "Meget god værdi for pengene",
     "bias": "positive",
     "key": "value",
