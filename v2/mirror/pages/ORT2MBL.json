  "reviews": {
   "summary": "ORT2MBL giver en varm, slagkraftig og meget detaljeret lydopgradering med et bredt, åbent stereoperspektiv, rene diskanttoner samt dybere og mere dynamisk bas. Nålen giver gamle plader nyt liv og fremhæver nuancer, der tidligere var skjulte. Nem montering og god rådgivning fuldender den stærke værdi, selv om kompatibilitet, justering og lejlighedsvis følsomhed kræver opmærksomhed.",
   "headlines": {
    "a dramatic upgrade for existing turntables": {
     "sentimentAnalysis": "Anmeldelserne beskriver samstemmende pickuppen som et stort spring frem fra standard-, Red-, Silver-, Rega- og andre begynderpickupper.",
     "simpleTitle": "Markant opgradering af eksisterende pladespillere",
     "bias": "positive",
     "key": "upgrade",
     "groupId": "ba5a14bf-cd35-40f4-b943-f6efa95a6b87"
    },
    "helpful installation and advice": {
     "sentimentAnalysis": "Butiksmontering, justering og produktrådgivning bliver ofte rost som venlig, kompetent og bekvem.",
     "simpleTitle": "God montering og rådgivning",
     "bias": "positive",
     "key": "service_installation",
     "groupId": "e8d17167-af00-4bc9-99bc-d6ebe00a5fe4"
    },
    "clear, detailed sound with a wide stereo image": {
     "sentimentAnalysis": "Anmeldelserne roser den rene, åbne og meget detaljerede gengivelse med god detaljeopløsning og kanaladskillelse.",
     "simpleTitle": "Klar og detaljeret lyd med bred stereobredde",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "87f7a8e3-0041-41bd-b064-d772e9d8ca8d"
    },
    "excellent value for the price": {
     "sentimentAnalysis": "Anmeldelserne fremhæver gentagne gange produktet som et usædvanligt godt køb i prisklassen.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "638737bc-1a1e-4d1c-a705-6046d0991e08"
    },
    "fuller bass and greater dynamics": {
     "sentimentAnalysis": "Flere anmeldelser beskriver dybere, strammere bas, mere punch og en mere dynamisk gengivelse end med tidligere pickupper.",
     "simpleTitle": "Fyldigere bas og større dynamik",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "87f7a8e3-0041-41bd-b064-d772e9d8ca8d"
