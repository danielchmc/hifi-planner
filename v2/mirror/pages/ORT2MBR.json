  "reviews": {
   "summary": "ORT2MBR er en varm, detaljeret og meget musikalsk pickup, der giver vinylafspilningen et markant løft. Lyden kombinerer kontant bas, klare diskanter, et stort stereobillede og medrivende dybde med en afslappet, men præcis karakter. Montering og justering kan kræve omhu, men den gode værdi, hjælpsomme service og brede kompatibilitet gør pickuppen til et særdeles stærkt valg.",
   "headlines": {
    "helpful installation and store service": {
     "sentimentAnalysis": "Butikspersonalet roses for god rådgivning, professionel montering og konsekvent god service.",
     "simpleTitle": "God hjælp til montering og service i butikken",
     "bias": "positive",
     "key": "installation",
     "groupId": "0b31fa36-f14e-4980-905d-725c3372bcd3"
    },
    "a worthwhile upgrade from entry-level cartridges": {
     "sentimentAnalysis": "2M Bronze beskrives gentagne gange som en tydelig og værdifuld opgradering fra Red, Blue og andre standardpickupper.",
     "simpleTitle": "Værdifuld opgradering fra begynderpickupper",
     "bias": "positive",
     "key": "upgrade",
     "groupId": "5f424cb8-11f3-478a-91bd-b5033909c845"
    },
    "warm, detailed and spacious sound": {
     "sentimentAnalysis": "Pickuppen roses for varm klang, mange detaljer, dybde og et bredt stereobillede.",
     "simpleTitle": "Varm, detaljeret og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "d034a244-f99c-4f9e-ae17-bc58cde97f8b"
    },
    "clearer, deeper and more dynamic playback": {
     "sentimentAnalysis": "Anmeldelserne beskriver en tydelig forbedring af klarhed, dybde, dynamik, klangfarver og mellemtoner.",
     "simpleTitle": "Klarere, dybere og mere dynamisk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "d034a244-f99c-4f9e-ae17-bc58cde97f8b"
    },
    "setup may require careful adjustment": {
     "sentimentAnalysis": "Lavt nåletryk, resonansfølsomhed og justering nævnes som udfordringer, selv om praktiske løsninger blev fundet.",
     "simpleTitle": "Justering kan kræve omhu",
     "bias": "negative",
