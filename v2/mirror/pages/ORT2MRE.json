  "reviews": {
   "summary": "ORT2MRE leverer en levende, varm og detaljeret vinyllyd med tydelige vokaler, kontant bas og en engagerende, omsluttende gengivelse. Pickup’en roses bredt som en markant opgradering i forhold til ældre eller fabriksmonterede pickupper og får ofte ældre pladespillere til at lyde levende igen. Den stærke værdi for pengene, nemme montering og konsekvent hjælpsomme service fuldender en særdeles positiv oplevelse.",
   "headlines": {
    "helpful, professional installation service": {
     "sentimentAnalysis": "Butikspersonalet roses for venlig vejledning, professionel montering og praktisk installation, mens kunden venter.",
     "simpleTitle": "Hjælpsom og professionel monteringsservice",
     "bias": "positive",
     "key": "service",
     "groupId": "d07b9161-380c-468a-b9af-4dc1391e6e6d"
    },
    "a major improvement over older cartridges": {
     "sentimentAnalysis": "Anmeldelserne beskriver samstemmigt pickup’en som en markant opgradering fra standard-, original- eller ældre pickupper.",
     "simpleTitle": "Markant forbedring i forhold til ældre pickupper",
     "bias": "positive",
     "key": "upgrade",
     "groupId": "fabbaa99-eaca-40c3-a0cb-0dd40b67410b"
    },
    "excellent value for the price": {
     "sentimentAnalysis": "Pickup’en vurderes gentagne gange som prisvenlig, samtidig med at lydkvalitet og ydelse ligger over prisklassen.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "fbe6a3a5-7898-44ca-8455-d9025b2fa91a"
    },
    "warm, clear and detailed sound": {
     "sentimentAnalysis": "Anmeldelserne roser en varm, ren og meget detaljeret gengivelse med tydelig instrumentseparation og realistisk klang.",
     "simpleTitle": "Varm, klar og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "79e64b46-d8f2-4260-8550-09a5574e52a2"
    },
    "punchy bass and fuller presentation": {
     "sentimentAnalysis": "Flere anmeldelser beskriver mere bastryk, en fyldigere klangbalance og mere musikalsk energi ved lavere lydstyrke.",
     "simpleTitle": "Kontant bas og fyldigere lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "79e64b46-d8f2-4260-8550-09a5574e52a2"
