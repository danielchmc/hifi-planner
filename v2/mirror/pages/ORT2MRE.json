    "professional, friendly installation and advice": {
     "sentimentAnalysis": "Butikspersonalet roses gentagne gange for kyndig vejledning, venlig betjening og dygtig montering, ofte mens kunden venter.",
     "simpleTitle": "Professionel og venlig montering samt rådgivning",
     "bias": "positive",
     "key": "service",
     "groupId": "39388b24-f119-4358-a5f0-e05895f8e0d1"
    },
