  "reviews": {
   "summary": "ORTMCX leverer en begejstrende, meget detaljeret og velafbalanceret lyd med varm musikalitet, kontant dynamik og et medrivende, rummeligt lydbillede. Klare højder, fyldig mellemtone og præcis bas fremhæver mikrodetaljer, vokaler og instrumenternes lagdeling uden at virke skarpt; især orkester- og progrockoptagelser får glæde af den fine separation. En omhyggelig tilspilning på 20–30 timer og præcis justering frigiver det fulde potentiale og gør denne MC-pickup til en overbevisende allrounder med stærk værdi.",
   "headlines": {
    "detailed, dynamic and spacious sound": {
     "sentimentAnalysis": "Pickuppen roses for høj detaljeopløsning, livlig dynamik, et bredt lydbillede og tydeligt lagdelte instrumenter.",
     "simpleTitle": "Detaljeret, dynamisk og rummelig lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "42933de7-2f88-409b-bd5d-c5e8c1cebd94"
    },
    "balanced, clear and non-aggressive tonality": {
     "sentimentAnalysis": "Anmeldelserne beskriver en balanceret, afslappet og åben gengivelse med ren diskant uden sibilans eller aggressivitet samt stærk bas og mellemtone.",
     "simpleTitle": "Balanceret, klar og ikke-aggressiv klang",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "42933de7-2f88-409b-bd5d-c5e8c1cebd94"
    },
    "requires patience during break-in": {
     "sentimentAnalysis": "Den ønskede lyd udvikler sig først efter cirka 20–30 timer, så tålmodighed er nødvendig, men belønnes.",
     "simpleTitle": "Kræver tålmodighed under tilspilning",
     "bias": "meh",
     "key": "break-in",
     "groupId": "c5b54c07-b562-4d0f-a6d9-ada8386e277e"
