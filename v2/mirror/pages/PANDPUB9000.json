  "reviews": {
   "summary": "PANDPUB9000 er en førsteklasses Blu-ray-afspiller med varm, kraftfuld og meget detaljeret lyd og billedkvalitet. Den solide konstruktion, det flotte design, den støjsvage drift og den nemme betjening giver en ægte high-end-oplevelse, også som CD-afspiller. Enkelte anmeldelser nævner langsom opstart eller lejlighedsvise firmwareproblemer, men den samlede vurdering er stadig meget begejstret.",
   "headlines": {
    "excellent picture and sound quality": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent det skarpe billede i høj kvalitet og den kraftfulde, fremragende lyd, også ved almindelige DVD'er og CD-afspilning.",
     "simpleTitle": "Fremragende billed- og lydkvalitet",
     "bias": "positive",
     "key": "picture-sound",
     "groupId": "c40b68d7-b46d-4d40-9d5a-9fbce071b28b"
    },
    "solid and attractive construction": {
     "sentimentAnalysis": "Afspilleren roses for sit eksklusive udseende, gode taktile kvalitet og særligt solide, veludførte chassis og kabinet.",
     "simpleTitle": "Solid og attraktiv konstruktion",
     "bias": "positive",
     "key": "design-build",
     "groupId": "1adeb7c0-617c-4e1b-aebd-d23f866c1d93"
    },
    "simple everyday operation": {
     "sentimentAnalysis": "Opsætning og betjening beskrives som ligetil, og brugerne kan installere og håndtere afspilleren uden problemer.",
     "simpleTitle": "Nem betjening i hverdagen",
     "bias": "positive",
     "key": "ease-of-use",
