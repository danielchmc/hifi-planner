  "reviews": {
   "summary": "RACLARITY62 får bred ros som en kompakt højttaler med et usædvanligt stort og medrivende lydbillede, krystalklare detaljer, naturlige mellemtoner, luftige højder og dyb, slagkraftig bas. Byggekvalitet, attraktivt design og stærk værdi for pengene er gennemgående styrker, og rumkorrektion samt passende forstærkning kan løfte ydelsen yderligere. Et mindretal oplever diskanten som lidt tilbageholdende eller lyden som en anelse kølig, mens højttalerne kan kræve en kraftig forstærker, og basbalancen kan afhænge af rum og musikstil.",
   "headlines": {
    "crystal-clear, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en usædvanligt klar, neutral til varm gengivelse med mange detaljer, overbevisende rumfornemmelse, naturlige stemmer og et medrivende lydbillede.",
     "simpleTitle": "Krystalklar, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "d56d3862-0d8a-46d3-8ea2-d6a981563725"
    },
    "deep, punchy bass from a compact cabinet": {
     "sentimentAnalysis": "Det kompakte kabinet leverer gentagne gange usædvanligt dyb, rumfyldende og slagkraftig bas, som ofte gør en subwoofer overflødig.",
     "simpleTitle": "Dyb og slagkraftig bas fra et kompakt kabinet",
     "bias": "positive",
     "key": "bass",
     "groupId": "cb75b996-1586-4ec5-b138-3a46ff0af212"
    },
    "refined design and high-quality construction": {
     "sentimentAnalysis": "Højttalerne beskrives gentagne gange som visuelt attraktive, kompakte og særdeles velbyggede med førsteklasses finish og komponentkvalitet.",
     "simpleTitle": "Elegant design og høj byggekvalitet",
     "bias": "positive",
     "key": "design",
     "groupId": "d2c27286-d316-4b64-ab77-a2c4ddd0be01"
    },
    "powerful amplification and room correction improve results": {
     "sentimentAnalysis": "Dirac eller RoomPerfect samt en kapabel forstærker forbindes gentagne gange med fremragende integration, tonal balance og en meget tilfredsstillende lytteoplevelse.",
     "simpleTitle": "Kraftig forstærkning og rumkorrektion forbedrer resultatet",
     "bias": "positive",
     "key": "amplification",
     "groupId": "19323699-dcc2-4af2-9e8c-8b34e4fc0ca4"
    },
    "bass can dominate in some rooms or recordings": {
     "sentimentAnalysis": "Bassen roses overordnet, men bestemte rum eller musikgenrer kan få den til at virke for dominerende eller mindre fyldig end forventet.",
     "simpleTitle": "Bassen kan dominere i visse rum eller optagelser",
     "bias": "negative",
     "key": "bass",
     "groupId": "cb75b996-1586-4ec5-b138-3a46ff0af212"
    },
    "treble can sound restrained or slightly cool": {
     "sentimentAnalysis": "To anmeldelser oplever sammenlignet med andre AMT- eller velkendte højttalere en mindre sprudlende, lidt kølig balance og mere tilbageholden øverste diskant.",
     "simpleTitle": "Diskanten kan virke tilbageholdende eller en anelse kølig",
     "bias": "negative",
     "key": "sound",
     "groupId": "d56d3862-0d8a-46d3-8ea2-d6a981563725"
    }
   },
