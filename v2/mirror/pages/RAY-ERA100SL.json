     "parentProductCode": "SONERA100SL",
     "reviews": {
      "summary": "Sonos Era 100SL leverer bemærkelsesværdig varm, fyldig og rummelig lyd fra et kompakt kabinet med overraskende dyb bas og klar adskillelse. Enkel Wi-Fi-forbindelse, nem multiroom-integration og stærk ydelse i køkken, soveværelse, kontor og hjemmebiograf gør højttaleren meget alsidig. Enkelte ejere nævner installationsproblemer, TV-synkronisering eller radioafspilning, begrænsede monteringsmuligheder og manglende batteri, men den samlede værdi og tilfredshed er meget høj.",
      "headlines": {
       "clear, enjoyable sound across everyday spaces": {
        "sentimentAnalysis": "Brug i køkken, soveværelse og kontor roses konsekvent for klar, behagelig baggrundslyd, der fylder rummet.",
        "simpleTitle": "Klar og behagelig lyd i hverdagsrum",
        "bias": "positive",
        "key": "sound",
        "groupId": "4e7cb31b-5d8d-49ff-baa9-0360a8d026c5"
       },
       "easy installation and convenient control": {
        "sentimentAnalysis": "De fleste kommentarer beskriver enkel installation, hurtig parring og ubesværet daglig betjening.",
        "simpleTitle": "Nem installation og praktisk betjening",
        "bias": "positive",
        "key": "setup",
        "groupId": "d2ee3870-a692-4d54-a30c-eac578614641"
       },
       "strong surround and stereo integration": {
        "sentimentAnalysis": "Stereopar og baghøjttalerkonfigurationer roses for problemfri integration, overbevisende stereoperspektiv og fyldigere TV-lyd.",
        "simpleTitle": "Stærk surround- og stereo-integration",
        "bias": "positive",
        "key": "integration",
        "groupId": "6d8425ca-aca9-4344-b568-99335b98b143"
