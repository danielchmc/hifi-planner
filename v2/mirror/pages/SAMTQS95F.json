  "reviews": {
   "summary": "Dette er et imponerende TV med varm, naturlig og særdeles detaljeret billedkvalitet, som giver en kraftfuld og medrivende seeroplevelse selv i lyse rum. Den matte skærm håndterer refleksioner fremragende, mens det bemærkelsesværdigt tynde og velbyggede design understreger det eksklusive indtryk. Smart-funktioner og menuer er mindre gennemarbejdede, men det fremragende billede og den gode værdi gør helheden meget overbevisende.",
   "headlines": {
    "outstanding picture quality": {
     "sentimentAnalysis": "TV'et leverer særdeles skarpe, imponerende og tilfredsstillende billeder, og naturlige farver kan opnås efter justering.",
     "simpleTitle": "Fremragende billedkvalitet",
     "bias": "positive",
     "key": "picture-quality",
     "groupId": "26660ab2-7e04-4515-9b01-88d7277a543a"
    },
    "excellent reflection control": {
     "sentimentAnalysis": "Den matte skærm dæmper refleksioner bemærkelsesværdigt godt, så TV kan ses behageligt i dagslys selv med stærkt sollys eller mange vinduer.",
     "simpleTitle": "Fremragende reflektionshåndtering",
     "bias": "positive",
     "key": "anti-reflection",
     "groupId": "e0d8585f-4e84-4055-a042-1bbb2649fbdb"
    },
    "smart software feels less polished": {
     "sentimentAnalysis": "Menuer, stemmefunktioner, låste indstillinger og afspilningskompatibilitet skaber lidt besvær trods den ellers stærke TV-oplevelse.",
     "simpleTitle": "Smart-softwaren virker mindre gennemarbejdet",
     "bias": "negative",
     "key": "smart-interface",
     "groupId": "bcca689d-1117-4ddb-919a-d7f683105925"
    },
    "strong value at the price": {
     "sentimentAnalysis": "Produktet vurderes at levere fremragende funktioner og billedkvalitet i forhold til prisklassen.",
     "simpleTitle": "God værdi til prisen",
     "bias": "positive",
     "key": "value",
     "groupId": "08fddd58-c54a-4b15-ae6c-fda0757c5876"
    },
    "remarkably thin and well built": {
     "sentimentAnalysis": "Det slanke og velbyggede kabinet giver et eksklusivt indtryk.",
     "simpleTitle": "Bemærkelsesværdigt tyndt og velbygget",
     "bias": "positive",
