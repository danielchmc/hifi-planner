  "reviews": {
   "summary": "SENAMBEOSBMINI leverer imponerende klar, detaljeret og slagkraftig lyd fra et kompakt og diskret kabinet, som løfter både TV, musik og streaming. Opsætningen beskrives oftest som enkel, mens Wi-Fi, Bluetooth og app-integration giver ekstra fleksibilitet. Dyb bas, omsluttende rumfornemmelse og TV-tilslutning kan være begrænset i nogle opsætninger, og en subwoofer kan give mere fylde; værdien er bedst til tilbudspris.",
   "headlines": {
    "clear, powerful sound from a compact bar": {
     "sentimentAnalysis": "Anmelderne roser den klare, detaljerede og for den kompakte størrelse overraskende kraftfulde lyd.",
     "simpleTitle": "Klar og kraftfuld lyd fra en kompakt soundbar",
     "bias": "positive",
     "key": "sound",
     "groupId": "fb6306f6-c133-43d7-9268-3af9b2c80439"
    },
    "compact, discreet design fits well": {
     "sentimentAnalysis": "Anmeldelserne værdsætter konsekvent det attraktive, lille og diskrete design, især ved siden af et TV i samme størrelse.",
     "simpleTitle": "Kompakt og diskret design passer godt ind",
     "bias": "positive",
     "key": "design",
     "groupId": "d6902004-21ff-43a5-bcce-e2ef3538e60d"
    },
    "setup is usually quick and straightforward": {
     "sentimentAnalysis": "De fleste anmeldelser beskriver installation, parring og opstart som nem og intuitiv.",
     "simpleTitle": "Opsætningen er normalt hurtig og enkel",
     "bias": "positive",
     "key": "setup",
     "groupId": "705a3596-46f8-4e58-84ad-9664bc506643"
    },
    "strong value when discounted": {
     "sentimentAnalysis": "Flere anmeldelser vurderer soundbaren som et fremragende køb, især når den fås til en lavere tilbudspris.",
     "simpleTitle": "God værdi til tilbudspris",
     "bias": "positive",
     "key": "value",
     "groupId": "20618111-1f79-4a5b-b5f0-b3b01fbd1c28"
    },
    "full price can feel high": {
     "sentimentAnalysis": "Nogle anmeldelser oplever normalprisen som høj sammenlignet med konkurrenterne og anbefaler at vente på et tilbud.",
     "simpleTitle": "Normalprisen kan føles høj",
     "bias": "negative",
     "key": "value",
     "groupId": "20618111-1f79-4a5b-b5f0-b3b01fbd1c28"
    },
    "indicator and connection glitches occur": {
     "sentimentAnalysis": "Nogle anmeldelser nævner, at indikator eller fjernbetjening lejlighedsvis svigter, eller at forbindelsen til TV'et afbrydes.",
     "simpleTitle": "Problemer med indikator og forbindelse forekommer",
     "bias": "negative",
     "key": "reliability",
     "groupId": "f29b35e6-115f-4e36-a836-916a6ca22a55"
    },
    "bass and immersion benefit from a subwoofer": {
     "sentimentAnalysis": "Nogle anmeldelser oplever begrænset dyb bas og stor rumfornemmelse uden den tilhørende subwoofer.",
     "simpleTitle": "Bas og rumfornemmelse forbedres med en subwoofer",
     "bias": "negative",
     "key": "sound",
     "groupId": "fb6306f6-c133-43d7-9268-3af9b2c80439"
    },
    "tv connection can be fiddly": {
     "sentimentAnalysis": "Et mindretal oplever problemer med TV-forbindelsen eller begrænsede tilslutningsmuligheder.",
     "simpleTitle": "TV-tilslutningen kan være besværlig",
