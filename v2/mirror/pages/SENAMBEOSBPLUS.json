  "displayBookDemo": true,
  "reviews": {
   "summary": "SENAMBEOSBPLUS leverer en usædvanligt klar, kraftfuld og omsluttende lydoplevelse til tv, film og musik med dyb bas selv uden subwoofer og overbevisende taleforbedring. Lydbilledet og AMBEO-behandlingen skaber en imponerende biografstemning, men de bageste surroundeffekter er begrænsede sammenlignet med et komplet højttalersystem. Opsætning og appstyring er som regel praktisk, men tilbagevendende forbindelses-, opstarts-, app- og firmwareproblemer forhindrer en konsekvent fejlfri oplevelse.",
   "headlines": {
    "rich, powerful sound with deep bass": {
     "sentimentAnalysis": "Anmelderne roser den fyldige, slagkraftige og afbalancerede gengivelse med overraskende kraftig bas selv uden ekstra subwoofer.",
     "simpleTitle": "Fyldig, kraftfuld lyd med dyb bas",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "3e1a6eb6-ef08-4465-b8e3-37928e0fdd99"
    },
    "recurring connection and startup problems": {
     "sentimentAnalysis": "En tilbagevendende kritik går på appnedbrud, forbindelsesudfald, langsom opstart, HDMI-lydproblemer, fastfrysning ved opdateringer og lejlighedsvise nulstillinger, hvilket gør systemet mindre plug-and-play end forventet.",
     "simpleTitle": "Tilbagevendende forbindelses- og opstartsproblemer",
     "bias": "negative",
     "key": "reliability",
     "groupId": "216d088b-5d2f-4ae3-a2a6-90ee6deb785d"
    },
    "clear dialogue and immersive soundstage": {
     "sentimentAnalysis": "Anmelderne fremhæver præcise, tydelige stemmer og en bred, filmisk gengivelse, der løfter almindeligt tv-indhold, film og spil.",
     "simpleTitle": "Klar dialog og omsluttende lydbillede",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "3e1a6eb6-ef08-4465-b8e3-37928e0fdd99"
    },
    "surround effects do not fully replace rear speakers": {
     "sentimentAnalysis": "Flere anmeldelser finder den virtuelle eller frontfokuserede surroundlyd imponerende, men bemærker svage eller manglende effekter bagfra og efterlyser trådløse baghøjttalere.",
     "simpleTitle": "Surroundeffekter erstatter ikke helt baghøjttalere",
     "bias": "negative",
     "key": "surround",
     "groupId": "771c3261-890c-4b17-8cd3-7b47ee94f604"
    },
    "easy installation and useful app controls": {
     "sentimentAnalysis": "De fleste anmeldelser af opsætningen beskriver appen, kalibreringen og den daglige betjening som enkel, hurtig og fleksibel.",
     "simpleTitle": "Nem opsætning og nyttig appstyring",
     "bias": "positive",
     "key": "setup-app",
     "groupId": "35b6cc2b-22d4-48ec-8504-109817a5f42e"
    }
   },
