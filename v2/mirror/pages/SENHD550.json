  "reviews": {
   "summary": "SENHD550 leverer en varm, transparent og meget velafbalanceret lyd med imponerende dyb og slagkraftig bas for en åben hovedtelefon. Den lette konstruktion og høje komfort gør lange lyttesessioner ubesværede. Den stærke værdi, fine tuning og rummelige gengivelse gør hovedtelefonen til et begejstrende valg til både hi-fi og optagelser.",
   "headlines": {
    "lightweight and comfortable for long sessions": {
     "sentimentAnalysis": "Anmeldelserne beskriver samstemmende en let og behagelig pasform, som forbliver komfortabel under lang tids lytning.",
     "simpleTitle": "Let og behagelig til lange sessioner",
     "bias": "positive",
     "key": "long-session-comfort",
     "groupId": "13d20a68-702e-4f8f-9f20-11ce72ba8863"
    },
    "balanced, transparent sound": {
     "sentimentAnalysis": "Anmeldelserne roser den neutrale, balancerede, transparente og åbne lyd, som kvalitetsmæssigt sammenlignes positivt med dyrere Sennheiser-modeller.",
     "simpleTitle": "Balanceret, transparent lyd",
     "bias": "positive",
     "key": "balanced-transparent-sound",
     "groupId": "f3a2fcbf-1a5f-4f4b-a8ea-fc9080971a47"
    },
    "deep, prominent bass": {
     "sentimentAnalysis": "Anmeldelserne fremhæver den overraskende dybe bas for en åben hovedtelefon samt et lidt mere markant basområde end normalt fra Sennheiser.",
     "simpleTitle": "Dyb, fremtrædende bas",
     "bias": "positive",
     "key": "deep-prominent-bass",
     "groupId": "f3a2fcbf-1a5f-4f4b-a8ea-fc9080971a47"
    },
