  "reviews": {
   "summary": "SENHD560S leverer en usædvanligt klar, afbalanceret, detaljeret og rummelig lyd til prisen med stram bas og en naturlig, neutral gengivelse til musik, gaming og studiearbejde. Den lave vægt og de bløde, komfortable ørepuder gør lange lyttesessioner behagelige, mens det åbne design giver en luftig og mindre indelukket oplevelse. Det korte kabel, lydlækage og lejlighedsvist pres er de største ulemper, og enkelte kilder har gavn af ekstra forstærkning, men den samlede værdi er stadig fremragende.",
   "headlines": {
    "clear, detailed and balanced sound": {
     "sentimentAnalysis": "Den rummelige, naturlige, neutrale og meget detaljerede gengivelse med kontrolleret bas og høj klarhed bliver rost.",
     "simpleTitle": "Klar, detaljeret og afbalanceret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "1afea507-11e6-4414-9356-f5d6d9b85fec"
    },
    "excellent value for money": {
     "sentimentAnalysis": "Høretelefonerne vurderes gentagne gange som usædvanligt kompetente og vellavede til prisen og overgår ofte dyrere alternativer.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "fd101154-547c-4124-87a5-848c3693e487"
    },
    "comfortable for long listening": {
     "sentimentAnalysis": "Lav vægt, bløde puder og god pasform gør timevis af lytning, gaming og musiknydelse behagelig.",
     "simpleTitle": "Behagelige ved lang tids brug",
     "bias": "positive",
     "key": "comfort",
     "groupId": "86983883-2181-4a41-a536-e63cdddab72b"
    },
    "cable is too short": {
     "sentimentAnalysis": "Flere anmeldelser finder det medfølgende kabel upraktisk kort, især til desktop- og gamingopsætninger.",
     "simpleTitle": "Kablet er for kort",
     "bias": "negative",
     "key": "cable",
     "groupId": "8e03aa40-cc04-436b-94d6-3d5d19894202"
    },
    "open design lets outside sound in": {
     "sentimentAnalysis": "Den åbne konstruktion forbedrer rumfornemmelsen og undgår en indelukket følelse, men isolerer kun lidt og egner sig ikke til støjende omgivelser.",
     "simpleTitle": "Det åbne design lader lyd udefra komme ind",
     "bias": "negative",
     "key": "open",
     "groupId": "12135954-497b-460f-8a10-0f912b673838"
    }
