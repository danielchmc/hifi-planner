  "reviews": {
   "summary": "SENHD560S leverer en usædvanligt klar, afbalanceret og detaljeret lyd med en rummelig, luftig gengivelse, stram bas og naturlige mellemtoner. Den lave vægt samt de bløde, komfortable ørepuder gør lange lytte-sessioner behagelige, mens det åbne design modvirker en indelukket fornemmelse, men lukker lyd udefra ind. Pris-kvalitetsforholdet er fremragende, selv om et kort kabel, lejlighedsvis pres og mulig forbedring med en forstærker nævnes.",
   "headlines": {
    "excellent comfort for long sessions": {
     "sentimentAnalysis": "Lav vægt, bløde puder og en behagelig pasform gør hovedtelefonerne komfortable til lange lytte-, gaming- og musiksessioner.",
     "simpleTitle": "Fremragende komfort til lange sessioner",
     "bias": "positive",
     "key": "comfort",
     "groupId": "9834955b-d52b-4665-b4eb-8eed6977dac1"
    },
    "outstanding value for money": {
     "sentimentAnalysis": "Kombinationen af hi-fi-ydeevne, komfort og byggekvalitet vurderes gentagne gange som fremragende til denne pris.",
     "simpleTitle": "Fremragende pris-kvalitetsforhold",
     "bias": "positive",
     "key": "value",
     "groupId": "52ae7a72-2dfc-43c5-adf0-f45167cb9d3c"
    },
    "clear, balanced and highly detailed sound": {
     "sentimentAnalysis": "Anmeldelserne fremhæver gennemgående den naturlige, neutrale, rummelige og detaljerede gengivelse med kontrolleret bas og klare højder.",
     "simpleTitle": "Klar, afbalanceret og meget detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "17fc28d4-54bf-450b-bba3-7e283e3f6417"
    },
    "open design improves spaciousness but leaks sound": {
     "sentimentAnalysis": "Den åbne konstruktion roses for en luftig, ikke-indelukket gengivelse og bevidsthed om omgivelserne, men lydgennemgang gør hovedtelefonerne mindre egnede i støjende eller offentlige miljøer.",
     "simpleTitle": "Åbent design giver rumfornemmelse, men lukker lyd ind",
     "bias": "meh",
     "key": "open",
     "groupId": "1685ae8e-723e-4212-9b20-47fdb78a56e4"
    },
    "short cable limits convenience": {
     "sentimentAnalysis": "Flere anmeldelser finder det medfølgende kabel for kort, især til gaming-, stereo- eller mikrofonopsætninger.",
     "simpleTitle": "Kort kabel begrænser brugervenligheden",
     "bias": "negative",
     "key": "cable",
     "groupId": "a954aaf3-9be4-4058-8658-769e18605e86"
    },
    "amplification can unlock fuller performance": {
     "sentimentAnalysis": "En separat forstærker siges at forbedre lydstyrke, fylde og kontrol, selv om flere anmeldelser også finder hovedtelefonerne anvendelige med telefoner og andre hverdagskilder.",
     "simpleTitle": "Forstærkning kan frigive større ydeevne",
     "bias": "positive",
     "key": "drive",
     "groupId": "eb4024f7-d20e-43d7-bd8f-4bad740bd7c6"
    }
   },
