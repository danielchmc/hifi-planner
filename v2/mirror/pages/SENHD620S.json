  "reviews": {
   "summary": "SENHD620S får stor ros for en varm, detaljeret og naturlig lyd med punchy bas, bløde diskanttoner og et usædvanligt stort lydbillede for en lukket hovedtelefon. Den lette og komfortable konstruktion samt de tætsluttende ørekopper gør lang tids lytning behagelig, selv om nogle brugere synes, at pasformen er for stram, eller oplever tryk oven på hovedet. Hovedtelefonen giver fremragende værdi for pengene og fungerer især godt med egnede lydkilder, mens en hovedtelefonforstærker kan være en fordel ved mobil brug.",
   "headlines": {
    "warm, detailed and natural sound": {
     "sentimentAnalysis": "Anmeldelserne roser den meget detaljerede, afbalancerede og naturlige gengivelse med bløde diskanttoner og god separation.",
     "simpleTitle": "Varm, detaljeret og naturlig lyd",
     "bias": "positive",
     "key": "warm-detailed-sound",
     "groupId": "08567c75-d6ba-49b0-a0de-66de2f6e76f8"
    },
    "punchy, deep bass": {
     "sentimentAnalysis": "Bassglade lyttere beskriver bunden som dyb, ren og punchy uden at gå ud over balancen.",
     "simpleTitle": "Punchy og dyb bas",
     "bias": "positive",
     "key": "punchy-bass",
     "groupId": "08567c75-d6ba-49b0-a0de-66de2f6e76f8"
    },
    "spacious presentation for a closed-back headphone": {
     "sentimentAnalysis": "Den lukkede konstruktion roses for stadig at levere en rummelig, naturlig og engagerende gengivelse.",
     "simpleTitle": "Stort lydbillede for en lukket hovedtelefon",
     "bias": "positive",
     "key": "spacious-closed-sound",
     "groupId": "08567c75-d6ba-49b0-a0de-66de2f6e76f8"
    },
    "lightweight and comfortable for extended listening": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den lave vægt, den sikre øreindeslutning og komforten ved lang tids lytning.",
     "simpleTitle": "Let og komfortabel til lang tids lytning",
     "bias": "positive",
     "key": "comfortable-lightweight",
     "groupId": "401024a9-9555-4234-b2aa-a51c0ac6863a"
    },
    "fit can feel too tight": {
     "sentimentAnalysis": "Nogle brugere oplever for kraftigt klemmetryk eller ubehageligt tryk oven på hovedet.",
     "simpleTitle": "Pasformen kan føles for stram",
     "bias": "negative",
     "key": "tight-fit",
     "groupId": "401024a9-9555-4234-b2aa-a51c0ac6863a"
    },
    "excellent value for money": {
     "sentimentAnalysis": "Produktet betragtes som et særligt godt køb i forhold til pris og anvendelse.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "excellent-value",
     "groupId": "6afd668f-be1f-450d-bf09-6e2767c6baa7"
    },
    "mobile sources may benefit from amplification": {
     "sentimentAnalysis": "Mobil lytning er mulig, men anmeldelserne anbefaler en dedikeret forstærker eller dongle for bedst mulig gengivelse.",
     "simpleTitle": "Mobile kilder kan have gavn af forstærkning",
     "bias": "meh",
     "key": "amplification-needed",
     "groupId": "9b091d97-ad4c-43f3-b769-02065245cd67"
    }
   },
