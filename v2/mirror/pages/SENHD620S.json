  "reviews": {
   "summary": "SENHD620S får stor ros for varm, detaljeret og naturlig lyd med punchy bas, afbalancerede mellemtoner og bløde diskanttoner. Det lukkede design giver en usædvanligt rummelig og medrivende gengivelse, mens store ørekopper og lav vægt gør længere tids lytning behagelig. Den fremragende værdi for pengene, solide kvalitet og brede kompatibilitet gør hovedtelefonerne til et meget tilfredsstillende valg, selv om en passende forstærker kan frigive endnu mere af potentialet.",
   "headlines": {
    "detailed, natural and energetic sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent en meget detaljeret, naturlig og levende gengivelse med god separation og en engagerende præsentation.",
     "simpleTitle": "Detaljeret, naturlig og energisk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "4389035d-c536-484e-b93f-ad6f3ee3e27f"
    },
    "punchy bass with balanced, smooth highs": {
     "sentimentAnalysis": "Basorienterede lyttere roser den dybe, rene og punchy bas, mens andre anmeldelser fremhæver afbalancerede mellemtoner og blød, ikke-skarp diskant.",
     "simpleTitle": "Punchy bas med afbalanceret, blød diskant",
     "bias": "positive",
     "key": "sound",
     "groupId": "4389035d-c536-484e-b93f-ad6f3ee3e27f"
    },
    "spacious presentation for a closed headphone": {
     "sentimentAnalysis": "Den lukkede konstruktion roses gentagne gange for at kombinere fordelene ved en lukket hovedtelefon med en rummelig, naturlig og medrivende gengivelse.",
     "simpleTitle": "Rummelig gengivelse fra en lukket hovedtelefon",
     "bias": "positive",
     "key": "closed-design",
     "groupId": "31173d9e-9e54-4fc0-b715-516914ef4022"
    },
    "lightweight and comfortable for long sessions": {
     "sentimentAnalysis": "Flere anmeldelser roser den lave vægt, sikre pasform og rummelige ørekopper som behagelige ved længere tids lytning.",
     "simpleTitle": "Let og behagelig ved lange lyttepas",
     "bias": "positive",
     "key": "comfort",
     "groupId": "dc73ec25-e4d9-4d49-8f66-4e0552f8a5da"
    },
    "good value for the investment": {
     "sentimentAnalysis": "Anmeldelserne beskriver hovedtelefonerne som et fremragende køb til prisen og velegnede til individuelle behov.",
     "simpleTitle": "God værdi for pengene",
     "bias": "positive",
     "key": "value",
     "groupId": "261992f2-324f-477a-9d6e-7b6356360d97"
    }
