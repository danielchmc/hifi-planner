  "reviews": {
   "summary": "SENHD620S roses bredt for sin varme, detaljerede og naturlige lyd med punchy bas, afbalancerede mellemtoner, bløde diskanttoner og et usædvanligt stort lydbillede for en lukket hovedtelefon. Komfort og lav vægt vurderes generelt positivt, selv om enkelte lyttere synes, at pasformen er for stram eller mærker tryk på toppen af hovedet. Hovedtelefonen giver fremragende værdi for pengene og fungerer godt med passende kilder, mens mobil lytning kan have gavn af en hovedtelefonforstærker, og kablet kunne være længere.",
   "headlines": {
    "warm, detailed and natural sound": {
     "sentimentAnalysis": "Lyden roses for at være detaljeret, naturlig, afbalanceret og blød med en varm karakter.",
     "simpleTitle": "Varm, detaljeret og naturlig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "e287d055-dfd2-4285-a760-a6840ebde745"
    },
    "lightweight and comfortable for long listening": {
     "sentimentAnalysis": "Hovedtelefonen beskrives generelt som let, stabil og behagelig, også ved længere tids lytning.",
     "simpleTitle": "Let og komfortabel ved lang tids lytning",
     "bias": "positive",
     "key": "comfort",
     "groupId": "1d95e90f-5e74-4513-9773-996fff012462"
    },
    "punchy bass and wide soundstage": {
     "sentimentAnalysis": "Lyttere fremhæver den dybe, rene og punchy bas samt den imponerende rummelighed for en lukket hovedtelefon.",
     "simpleTitle": "Punchy bas og stort lydbillede",
     "bias": "positive",
     "key": "sound",
     "groupId": "e287d055-dfd2-4285-a760-a6840ebde745"
    },
    "some users find the fit too tight or uncomfortable": {
     "sentimentAnalysis": "Et mindretal oplever for meget spænding eller smertefuldt tryk på toppen af hovedet.",
     "simpleTitle": "Nogle brugere synes, at pasformen er for stram eller ukomfortabel",
     "bias": "negative",
     "key": "comfort",
     "groupId": "1d95e90f-5e74-4513-9773-996fff012462"
    },
    "may need amplification from mobile sources": {
     "sentimentAnalysis": "Hovedtelefonen fungerer godt fra laptops og passende anlæg, men mobile enheder kan have gavn af en hovedtelefonforstærker eller dongle.",
     "simpleTitle": "Kan kræve forstærkning fra mobile kilder",
     "bias": "meh",
     "key": "source",
     "groupId": "277c1717-e041-47ef-bab1-ac6a8237ad71"
    }
