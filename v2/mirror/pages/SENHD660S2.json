  "reviews": {
   "summary": "SENHD660S2 leverer en varm, detaljeret og medrivende hi-fi-lyd med klare mellemtoner, kontrolleret og slagkraftig bas samt en luftig, naturlig gengivelse. Den fremragende komfort gør lange lyttesessioner, gaming og musiknydelse behagelige, mens det åbne design skaber et stort, højttalerlignende lydbillede. Den stærke værdi for pengene og brede forstærkerkompatibilitet gør hovedtelefonen meget anbefalelsesværdig, selv om nogle oplever pasformen som lidt stram, kablet som for kort og byggekvaliteten som mindre eksklusiv end forventet.",
   "headlines": {
    "detailed, spacious and natural sound": {
     "sentimentAnalysis": "Anmeldelserne roser den luftige, neutrale, detaljerede og rummelige gengivelse som naturlig, medrivende og på referenceniveau.",
     "simpleTitle": "Detaljeret, rummelig og naturlig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "6163f4ae-72c9-461a-9928-258c7af4dcc2"
    },
    "punchy, controlled bass with clear mids": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver fyldig eller forbedret subbas, kraftfuld bas, klare mellemtoner og en behagelig balance uden overdreven bas.",
     "simpleTitle": "Slagkraftig, kontrolleret bas med klare mellemtoner",
     "bias": "positive",
     "key": "sound",
     "groupId": "6163f4ae-72c9-461a-9928-258c7af4dcc2"
    },
    "comfortable for long listening": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent de lette hovedtelefoner som komfortable ved lange lyttepassager, også med briller.",
     "simpleTitle": "Komfortabel ved lang tids lytning",
     "bias": "positive",
     "key": "comfort",
     "groupId": "e16b19a1-0187-4728-8d55-2e4376e49329"
    },
    "excellent value for the sound quality": {
     "sentimentAnalysis": "Anmeldelserne fremhæver gentagne gange hovedtelefonen som et fremragende eller førsteklasses køb, hvor ydelsen overgår dyrere alternativer.",
     "simpleTitle": "Fremragende værdi for lydkvaliteten",
     "bias": "positive",
     "key": "value",
     "groupId": "85600e3b-b977-4cb4-8969-dcae6d854eb9"
    },
    "short cable limits couch use": {
     "sentimentAnalysis": "To anmeldelser beskriver det medfølgende kabel som for kort til afslappet lytning i sofaen; en bruger har tilføjet et andet kabel.",
     "simpleTitle": "Det korte kabel begrænser brug i sofaen",
     "bias": "negative",
     "key": "sound",
     "groupId": "6163f4ae-72c9-461a-9928-258c7af4dcc2"
    }
   },
