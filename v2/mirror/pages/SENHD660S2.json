  "reviews": {
   "summary": "Sennheiser HD 660S2 roses bredt for en varm, detaljeret, rummelig og naturlig lyd med kraftfuld, kontrolleret bas og fremragende klarhed til musik, film og gaming. Det lette og behagelige design egner sig til lange lytte-sessioner, mens den åbne konstruktion giver en luftig, højttaleragtig gengivelse. Den stærke værdi for pengene og den musikalske kvalitet gør HD 660S2 til en varm anbefaling, selv om det korte kabel, det begrænsede tilbehør og den til tider stramme pasform kritiseres.",
   "headlines": {
    "warm, detailed and natural sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en raffineret, naturlig og meget detaljeret gengivelse, ofte med varme og en rummelig, livagtig karakter.",
     "simpleTitle": "Varm, detaljeret og naturlig lyd",
     "bias": "positive",
     "key": "sound_warm_detail",
     "groupId": "54bceb54-d305-421c-bc28-cba9553b77c4"
    },
    "strong, controlled bass and clear presentation": {
     "sentimentAnalysis": "Lyden roses gentagne gange for nærværende, men kontrolleret bas, klare mellemtoner og høj detaljegrad uden skarphed eller overdreven bulder.",
     "simpleTitle": "Kraftfuld, kontrolleret bas og klar gengivelse",
     "bias": "positive",
     "key": "sound_bass_clarity",
     "groupId": "54bceb54-d305-421c-bc28-cba9553b77c4"
    },
    "comfortable for long listening": {
     "sentimentAnalysis": "Den lave vægt og behagelige polstring gør lang tids lytning nem, også i flere timer og med briller.",
     "simpleTitle": "Behagelig ved lang tids lytning",
     "bias": "positive",
     "key": "comfort_long_use",
     "groupId": "225b4622-ba34-48f0-aa3b-446c442bd049"
    },
    "excellent value for the performance": {
     "sentimentAnalysis": "Flere anmeldelser vurderer lyd og samlet kvalitet som usædvanligt stærk i forhold til prisen, selv sammenlignet med dyrere hovedtelefoner.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value_performance",
     "groupId": "5a3d206b-ce81-4eb8-89dc-1c72924d0918"
    },
    "airy, speaker-like open-back presentation": {
     "sentimentAnalysis": "Den åbne konstruktion forbindes med et luftigt lydbillede, en naturlig rumfornemmelse og fravær af en indelukket følelse.",
     "simpleTitle": "Luftig, højttaleragtig åben gengivelse",
     "bias": "positive",
     "key": "open_airy",
     "groupId": "4203506f-bf3c-495d-b0ef-1fdc1569688f"
    },
    "cable is too short for relaxed seating": {
     "sentimentAnalysis": "Det medfølgende kabel anses for kort til lytning fra sofaen, selv om problemet blev løst med et ekstra kabel i en anmeldelse.",
     "simpleTitle": "Kablet er for kort til afslappet lytning",
     "bias": "negative",
     "key": "sound_cable_short",
     "groupId": "54bceb54-d305-421c-bc28-cba9553b77c4"
    },
    "fit can feel too tight": {
     "sentimentAnalysis": "En mindretalsopfattelse oplever pasformen som lidt stram eller upraktisk, når hovedet hviler på en pude.",
     "simpleTitle": "Pasformen kan føles for stram",
     "bias": "negative",
     "key": "comfort_tight",
     "groupId": "225b4622-ba34-48f0-aa3b-446c442bd049"
    }
   },
