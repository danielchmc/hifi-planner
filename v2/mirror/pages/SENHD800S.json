  "reviews": {
   "summary": "SENHD800S roses bredt for en usædvanligt detaljeret, klar og naturlig lyd med et enormt, medrivende lydbillede og præcis placering af instrumenterne. Det åbne design og den behagelige pasform gør lange lytte-sessioner komfortable, mens den afdæmpede bas er den væsentligste indvending for lyttere, der ønsker kraftigt tryk. Med en god forstærker og kilde leverer hovedtelefonerne en varm, rummelig lyd på referenceklasse-niveau.",
   "headlines": {
    "exceptional detail and clarity": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent den fine detaljegengivelse samt den klare og veldefinerede diskant og mellemtone.",
     "simpleTitle": "Exceptionel detaljering og klarhed",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "12195fbd-5f5d-4435-8d61-42ebfb0f80c5"
    },
    "huge, immersive soundstage": {
     "sentimentAnalysis": "Den åbne gengivelse beskrives gentagne gange som rummelig, naturlig og medrivende med overbevisende instrumentplacering.",
     "simpleTitle": "Enormt, medrivende lydbillede",
     "bias": "positive",
     "key": "soundstage",
     "groupId": "c44755d0-89c9-4158-8829-afccf704e42e"
    },
    "natural, full and warm presentation": {
     "sentimentAnalysis": "Flere anmeldelser beskriver en behagelig og ufarvet gengivelse, der med passende forstærkning kan blive varm og fyldig.",
     "simpleTitle": "Naturlig, fyldig og varm gengivelse",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "12195fbd-5f5d-4435-8d61-42ebfb0f80c5"
    },
    "comfortable for hours": {
     "sentimentAnalysis": "Pasformen roses som behagelig og uden irritation ved lang tids lytning, også med briller.",
     "simpleTitle": "Komfortable i timevis",
     "bias": "positive",
     "key": "comfort",
     "groupId": "5060ec0d-228b-470c-b940-0f8af0a30063"
    },
    "bass may feel too restrained": {
     "sentimentAnalysis": "Nogle anmeldelser bemærker begrænset basvægt og foreslår equalizer, hvis der ønskes mere punch.",
     "simpleTitle": "Bassen kan virke for afdæmpet",
     "bias": "negative",
     "key": "sound_quality",
     "groupId": "12195fbd-5f5d-4435-8d61-42ebfb0f80c5"
    }
