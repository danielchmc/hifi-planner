  "reviews": {
   "summary": "Sennheiser HD800S leverer en usædvanligt detaljeret, klar og rummelig lyd med præcis placering af instrumenterne og en medrivende, næsten højttaleragtig gengivelse. Komforten er fremragende til lange lyttesessioner, mens det åbne design giver en luftig karakter, men også lader udefrakommende lyd slippe ind. Bassen kan virke tilbageholdende uden equalizer, og hovedtelefonerne fungerer bedst med en god forstærker og kilde; samlet set får produktet stor ros som et køb i referenceklassen.",
   "headlines": {
    "exceptional detail and instrument separation": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent den højopløselige gengivelse, hørbare nuancer og klare adskillelse af instrumenter.",
     "simpleTitle": "Fremragende detaljer og instrumentadskillelse",
     "bias": "positive",
     "key": "detail",
     "groupId": "e6a48f44-8a38-47c7-9fc1-5e7a565ba413"
    },
    "expansive and immersive soundstage": {
     "sentimentAnalysis": "Flere anmeldelser beskriver en usædvanligt rummelig, tredimensionel og højttaleragtig gengivelse.",
     "simpleTitle": "Stor og medrivende lydboble",
     "bias": "positive",
     "key": "soundstage",
     "groupId": "e6a48f44-8a38-47c7-9fc1-5e7a565ba413"
    },
    "bass is restrained without adjustment": {
     "sentimentAnalysis": "Anmeldelserne bemærker, at bassen kan halte efter resten af gengivelsen, selv om equalizer kan tilføre mere bas.",
     "simpleTitle": "Bassen virker tilbageholdende uden justering",
     "bias": "negative",
     "key": "bass",
     "groupId": "e6a48f44-8a38-47c7-9fc1-5e7a565ba413"
    },
    "comfortable for extended listening": {
     "sentimentAnalysis": "Begge anmeldelser fremhæver komfort uden irritation under lang tids lytning.",
     "simpleTitle": "Komfortabel ved lang tids lytning",
     "bias": "positive",
     "key": "long-listening",
     "groupId": "ffc223ac-8af4-41cd-9260-89931d1e0cca"
    },
    "open construction lets outside sound through": {
     "sentimentAnalysis": "Anmeldelserne værdsætter den luftige åbne karakter, men ser lydindslip som en begrænsning i fælles eller støjende omgivelser.",
     "simpleTitle": "Den åbne konstruktion lader udefrakommende lyd slippe ind",
     "bias": "negative",
     "key": "leakage",
     "groupId": "231551a1-13b6-431e-82d2-be274b21bd87"
    }
   },
