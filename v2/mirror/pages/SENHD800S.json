  "reviews": {
   "summary": "SENHD800S leverer en meget detaljeret, klar og medrivende gengivelse med et enormt, præcist lydbillede og fremragende instrumentadskillelse. Komforten ved lange lyttesessioner er fremragende, mens det åbne design skaber en luftig og naturlig oplevelse uden skarp diskant for de fleste lyttere. Bassen kan virke tilbageholdende for lyttere, der ønsker kraftigt punch, og hovedtelefonerne fungerer bedst med en kapabel forstærker og kilde.",
   "headlines": {
    "highly detailed and precise sound": {
     "sentimentAnalysis": "Anmeldelserne roser konsekvent den fremragende opløsning, klarhed og evne til at gengive fine musikalske detaljer og adskille instrumenterne.",
     "simpleTitle": "Meget detaljeret og præcis lyd",
     "bias": "positive",
     "key": "detail",
     "groupId": "edffe214-1690-483b-8508-8c0556a89917"
    },
    "huge, spacious soundstage": {
     "sentimentAnalysis": "Lyden beskrives gentagne gange som usædvanligt åben, rummelig og medrivende med overbevisende instrumentplacering.",
     "simpleTitle": "Enormt og rummeligt lydbillede",
     "bias": "positive",
     "key": "soundstage",
     "groupId": "edffe214-1690-483b-8508-8c0556a89917"
    },
    "comfortable for hours": {
     "sentimentAnalysis": "Begge komfortanmeldelser beskriver timevis af behagelig lytning uden irritation, også med briller.",
     "simpleTitle": "Komfortable i timevis",
     "bias": "positive",
     "key": "long-session-comfort",
     "groupId": "43402330-e6df-4a45-9a49-40770e243b8e"
    },
    "open design creates an airy presentation": {
     "sentimentAnalysis": "Den åbne konstruktion roses for at fjerne resonans fra lukkede hovedtelefoner og understøtte en rummelig, naturlig gengivelse.",
     "simpleTitle": "Det åbne design skaber en luftig gengivelse",
     "bias": "positive",
     "key": "airy-open-sound",
     "groupId": "50043972-cef9-4472-b9b4-1624dc290b73"
    },
    "bass lacks impact for some listeners": {
     "sentimentAnalysis": "Bassen er det vigtigste forbehold: En anmeldelse kalder basområdet tilbageholdende, mens en anden tilføjer bas med EQ for et fyldigere resultat.",
     "simpleTitle": "Bassen mangler pondus for nogle lyttere",
     "bias": "negative",
     "key": "restrained-bass",
     "groupId": "fbe6c9aa-3863-42cc-8296-cf155da59f19"
    }
   },
