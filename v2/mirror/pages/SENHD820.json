  "reviews": {
   "summary": "SENHD820 leverer en kraftfuld, varm og immersiv lytteoplevelse med dyb, punchy bas, klare vokaler og et stort lydbillede. Den førsteklasses konstruktion, gode lukkede isolering og høje komfort ved lange lyttesessioner gør hovedtelefonerne særdeles overbevisende med en kompetent forstærker. Den høje pris, den følsomme pasform og lidt lydlækage forhindrer universel begejstring, men helhedsindtrykket er klart positivt for krævende lyttere.",
   "headlines": {
    "powerful, spacious and highly detailed sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en stor, kraftfuld og særdeles fornøjelig gengivelse med dyb bas, klare vokaler og stærke detaljer.",
     "simpleTitle": "Kraftfuld, rummelig og detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "7dd1257f-c42b-4368-a133-4c9544885718"
    },
    "analytical clarity and open midrange": {
     "sentimentAnalysis": "Hovedtelefonerne roses for ren diskant, åben mellemtone og en analytisk gengivelse, der holder vokaler og instrumenter adskilt.",
     "simpleTitle": "Analytisk klarhed og åben mellemtone",
     "bias": "positive",
     "key": "sound",
     "groupId": "7dd1257f-c42b-4368-a133-4c9544885718"
    },
    "comfortable for extended listening": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den fremragende bærekomfort, også ved mange timers lytning.",
     "simpleTitle": "Komfortable ved lang tids lytning",
     "bias": "positive",
