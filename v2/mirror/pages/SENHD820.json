  "reviews": {
   "summary": "SENHD820 roses bredt for sin kraftfulde, detaljerede og medrivende lyd, især den dybe bas, klare vokaler og rummelige gengivelse. Komfort og byggekvalitet vurderes ofte som fremragende, mens den gode isolering gør det lukkede design velegnet til koncentreret lytning. De største forbehold gælder den meget høje pris, pasformen til mindre hoveder og briller, lejlighedsvis ubalance i lyden samt nogen lydlækage; en kapabel hovedtelefonforstærker anbefales kraftigt.",
   "headlines": {
    "powerful, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en meget fornøjelig, kraftfuld og rummelig gengivelse, der overgår forventningerne.",
     "simpleTitle": "Kraftfuld, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "912960c2-9aa3-4f17-a394-133947d024be"
    },
    "deep, controlled bass and clear mids": {
     "sentimentAnalysis": "Bassen roses for dybde, kraft og detaljer, mens vokaler og mellemtoner forbliver klare og åbne.",
     "simpleTitle": "Dyb, kontrolleret bas og klare mellemtoner",
     "bias": "positive",
     "key": "sound",
     "groupId": "912960c2-9aa3-4f17-a394-133947d024be"
    },
    "sound can be overly bass-heavy or uneven": {
     "sentimentAnalysis": "Nogle lyttere finder gengivelsen blot tilfredsstillende eller for bastung og har brug for EQ for at skabe balance.",
     "simpleTitle": "Lyden kan være for bastung eller ujævn",
     "bias": "negative",
     "key": "sound",
     "groupId": "912960c2-9aa3-4f17-a394-133947d024be"
    },
    "comfortable for long listening": {
     "sentimentAnalysis": "Flere anmeldelser rapporterer fremragende komfort, også ved brug i mange timer.",
     "simpleTitle": "Komfortable ved lang tids lytning",
     "bias": "positive",
     "key": "comfort",
     "groupId": "9033bccf-bb60-4019-8860-0e51084cecbb"
    },
    "fit can be difficult for smaller heads and glasses": {
     "sentimentAnalysis": "Pasformen afhænger i høj grad af hovedstørrelsen; mindre hoveder og briller kan forringe komfort og tætning.",
     "simpleTitle": "Pasformen kan være vanskelig for mindre hoveder og briller",
     "bias": "negative",
