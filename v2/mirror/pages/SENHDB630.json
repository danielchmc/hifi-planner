  "bundleRelations": [],
  "displayBookDemo": true,
  "reviews": {
   "summary": "Sennheiser HDB 630 leverer en usædvanligt klar, balanceret og detaljeret lyd med en varm, musikalsk klang og stærke justeringsmuligheder via den parametriske EQ. Komforten er generelt god, og batteritiden er fremragende, mens den medfølgende BTD 700-dongle og de kablede muligheder giver imponerende alsidighed. ANC’en er solid til pendling og indendørs brug, men matcher ikke konsekvent de bedste Sony- eller Bose-modeller, og touchbetjening, forbindelsesproblemer og små ørekopper er tilbagevendende svagheder.",
   "headlines": {
    "long battery life and versatile high-quality connections": {
     "sentimentAnalysis": "Anmeldelserne fremhæver den fremragende batteritid samt nyttige USB-, Bluetooth-, kablede og dongle-baserede forbindelser, især til højopløst lyd og brug ved computer med lav latenstid.",
     "simpleTitle": "Lang batteritid og alsidige forbindelser i høj kvalitet",
     "bias": "positive",
     "key": "battery_connectivity",
     "groupId": "847d996b-136b-4b62-9940-bd1ce0db9844"
    },
    "clear, balanced and highly detailed sound": {
     "sentimentAnalysis": "Anmeldelserne fremhæver konsekvent den neutrale, transparente, rummelige og præcise gengivelse med mange detaljer og tydelig instrumentseparation.",
     "simpleTitle": "Klar, balanceret og meget detaljeret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "cfe18886-fc2b-459b-a0ab-4961714ca0a4"
    },
    "parametric EQ adds exceptional flexibility": {
     "sentimentAnalysis": "Appen og den parametriske EQ roses gentagne gange for præcis personlig tilpasning, hørebåren kalibrering og muligheden for at tilføje bas uden at miste klarhed.",
     "simpleTitle": "Parametrisk EQ giver enestående fleksibilitet",
     "bias": "positive",
     "key": "app_eq",
     "groupId": "71cd7176-8df8-4820-acd3-121b83aef26c"
    },
    "anc is effective but not class-leading": {
     "sentimentAnalysis": "ANC håndterer konstant baggrundsstøj og pendling godt, men flere anmeldelser placerer den under Sony og Bose med ujævn håndtering af vind og pludselige lyde.",
     "simpleTitle": "ANC er effektiv, men ikke klasseførende",
     "bias": "meh",
     "key": "anc",
     "groupId": "af051158-e4f6-4e6a-ade7-491b99e57c4e"
    },
    "comfortable for long listening, but earcups can be small": {
     "sentimentAnalysis": "De fleste anmeldelser beskriver en behagelig og stabil pasform ved lang tids brug, men større ører eller hoveder kan opleve tryk, varme eller for lidt plads i ørekopperne.",
     "simpleTitle": "Komfortable til lang tids lytning, men ørekopperne kan være små",
     "bias": "positive",
     "key": "comfort",
     "groupId": "7c387021-ccf6-44d1-ba7f-7c7246b37039"
    },
    "neutral bass divides opinion": {
     "sentimentAnalysis": "Flere anmeldelser værdsætter den kontrollerede og ærlige bas, mens andre synes, at bunden er for afdæmpet eller mangler tryk sammenlignet med basorienterede alternativer.",
     "simpleTitle": "Den neutrale bas deler vandene",
