  "reviews": {
   "summary": "SENIE600 leverer en enestående, detaljeret og medrivende lyd med stram bas, klare mellemtoner og livlige diskantområder. Komforten er generelt fremragende, men den rigtige forsegling kan kræve, at man prøver forskellige ørepropper, og nogle brugere oplever problemer med pasform eller ørebøjler. Kablet og de medfølgende ørepropper er de største svagheder, men den fremragende musikgengivelse gør produktet særdeles anbefalelsesværdigt.",
   "headlines": {
    "exceptional detail and musical immersion": {
     "sentimentAnalysis": "Lyden beskrives gentagne gange som fænomenal, meget detaljeret, klar og dybt medrivende på tværs af genrer.",
     "simpleTitle": "Enestående detaljer og musikalsk indlevelse",
     "bias": "positive",
     "key": "exceptional_detail",
     "groupId": "d4a78076-9faa-4195-bcd5-a4b20b227cb4"
    },
    "comfortable for extended listening": {
     "sentimentAnalysis": "Komforten beskrives som fremragende, træthedsfri og næsten umærkelig ved gentagen eller længere tids lytning.",
     "simpleTitle": "Komfortabel ved længere tids lytning",
     "bias": "positive",
     "key": "long_listening_comfort",
     "groupId": "6730e735-aa93-4919-b069-ed8c5efa05a6"
    },
    "bright, clear presentation with strong bass": {
     "sentimentAnalysis": "Klangbalancen roses for klare mellemtoner og diskant, kontrolleret eller stram bas samt høj detaljeopløsning.",
     "simpleTitle": "Lys og klar gengivelse med kraftig bas",
     "bias": "positive",
     "key": "bright_clear_sound",
     "groupId": "d4a78076-9faa-4195-bcd5-a4b20b227cb4"
    },
    "cable quality and microphonics disappoint": {
     "sentimentAnalysis": "Det medfølgende kabel kritiseres som skuffende til prisen, især på grund af kraftig berøringsstøj og et uattraktivt stik.",
     "simpleTitle": "Kabelkvalitet og mikrofonie skuffer",
     "bias": "negative",
     "key": "cable_issues",
     "groupId": "cffd6b95-bc46-478b-a352-b8612c2bcb50"
    }
   },
