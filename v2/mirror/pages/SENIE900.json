  "reviews": {
   "summary": "SENIE900 leverer en enestående, detaljeret og medrivende lyd med dyb, ren og kontant bas, klare mellemtoner, bred rumfornemmelse og imponerende alsidighed på tværs af genrer. Komforten roses konsekvent, også ved lang tids lytning, og den lave vægt bidrager yderligere til oplevelsen. Den høje pris anses generelt for at være rimelig i forhold til ydelsen, selv om kablet og et rapporteret problem med emballagen trækker lidt ned i et ellers førsteklasses produkt.",
   "headlines": {
    "detailed, spacious and balanced sound": {
     "sentimentAnalysis": "Anmeldelserne roser IE 900 for klare høje toner, rene mellemtoner, høj detaljegrad, en afbalanceret tuning og en rummelig, veldefineret gengivelse.",
     "simpleTitle": "Detaljeret, rummelig og afbalanceret lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "802e675c-3481-4012-ab47-3dc90b733669"
    },
    "deep, clean and powerful bass": {
     "sentimentAnalysis": "Bassen beskrives gentagne gange som dyb, ren, kraftfuld og meget nærværende uden at blive påtrængende.",
     "simpleTitle": "Dyb, ren og kraftfuld bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "802e675c-3481-4012-ab47-3dc90b733669"
    },
    "comfortable for extended listening": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver den fremragende komfort, også under flere timers lytning.",
     "simpleTitle": "Komfortabel ved lang tids lytning",
     "bias": "positive",
     "key": "comfort",
     "groupId": "87d283da-6ebf-400c-ba1f-7e790bd72442"
    },
    "premium price feels justified": {
     "sentimentAnalysis": "Selv om prisen beskrives som høj, anses lydkvaliteten og lytteglæden for at være investeringen værd.",
     "simpleTitle": "Premiumprisen føles berettiget",
     "bias": "positive",
     "key": "value",
     "groupId": "625afd72-a5ab-4164-b470-0717d0f962f6"
    },
    "versatile across music genres": {
     "sentimentAnalysis": "IE 900 vurderes som velegnet til en bred vifte af genrer, fra metal og jazz til soul, funk og klassisk musik.",
     "simpleTitle": "Alsidig på tværs af musikgenrer",
     "bias": "positive",
     "key": "sound",
     "groupId": "802e675c-3481-4012-ab47-3dc90b733669"
    },
    "the cable could be better": {
     "sentimentAnalysis": "To anmeldelser peger på kablet som den største hardwaremæssige svaghed og foreslår at udskifte eller forbedre det.",
     "simpleTitle": "Kablet kunne være bedre",
     "bias": "negative",
     "key": "cable",
     "groupId": "f24155b9-4063-4416-8230-6054d592d454"
    }
   },
