  "reviews": {
   "summary": "Sennheiser IE 900 leverer en fremragende, varm og meget detaljeret lyd med dyb, slagkraftig bas, rene mellemtoner, klare højder og en omsluttende rumfornemmelse på tværs af mange musikgenrer. Komforten forbliver fremragende under lange lyttesessioner, mens den høje pris generelt anses for berettiget af den enestående musikoplevelse og høje kvalitet. Kablet er den vigtigste tilbagevendende svaghed, men den samlede begejstring og tilfredshed er usædvanligt høj.",
   "headlines": {
    "detailed, balanced and spacious sound": {
     "sentimentAnalysis": "Anmeldelserne roser IE 900 for ren, moden, meget detaljeret og rummelig lyd med god separation og en afbalanceret gengivelse.",
     "simpleTitle": "Detaljeret, afbalanceret og rummelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "f4de034e-427d-4089-916a-736053c508f1"
    },
    "deep and powerful bass": {
     "sentimentAnalysis": "Bassen beskrives gentagne gange som dyb, ren, kraftfuld og engagerende uden at blive påtrængende.",
     "simpleTitle": "Dyb og kraftfuld bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "f4de034e-427d-4089-916a-736053c508f1"
    },
    "comfortable for extended listening": {
     "sentimentAnalysis": "Anmeldelserne beskriver konsekvent øretelefonerne som komfortable, sikre i pasformen og egnede til lange lyttesessioner.",
     "simpleTitle": "Komfortabel ved lang tids lytning",
     "bias": "positive",
     "key": "comfort",
     "groupId": "97a156e8-f2bd-43c6-937d-7729c35f01cf"
    },
    "high price justified by the performance": {
     "sentimentAnalysis": "Den høje pris anerkendes, men den fremragende lyd og musikoplevelse gør købet værdifuldt.",
     "simpleTitle": "Den høje pris er berettiget af ydeevnen",
     "bias": "positive",
     "key": "value",
     "groupId": "b6a4d0ff-68ee-4667-81f8-e78738ca3f6c"
    },
    "excellent retailer service": {
     "sentimentAnalysis": "Forhandlerservice, leveringshastighed og kundesupport får stor ros.",
     "simpleTitle": "Fremragende forhandlerservice",
     "bias": "positive",
     "key": "service",
     "groupId": "657b5fa0-50e1-4807-bc2d-d3108511fce4"
    },
    "excellent across musical genres": {
     "sentimentAnalysis": "IE 900 anses for alsidig nok til forskellige genrer samt både afslappet og analytisk lytning.",
     "simpleTitle": "Fremragende på tværs af musikgenrer",
     "bias": "positive",
     "key": "sound",
