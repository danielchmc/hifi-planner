  "reviews": {
   "summary": "SENMOMENTUM5 leverer en varm, punchy og meget musikalsk lyd med klare mellemtoner, kraftfuld bas og en medrivende gengivelse. Komforten er en stor styrke, mens ANC generelt er effektiv, og batteritiden er fremragende. Touch-betjening, sensorer, byggekvalitet og enkelte softwarefunktioner kan forbedres, men samlet set er pakken stadig meget anbefalelsesværdig.",
   "headlines": {
    "warm, powerful and musical sound": {
     "sentimentAnalysis": "Anmeldelserne roser den klare, varme, basrige og meget musikalske gengivelse.",
     "simpleTitle": "Varm, kraftfuld og musikalsk lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "9d6c15bf-897f-4ede-b62e-f565ed4994e5"
    },
    "effective noise cancellation": {
     "sentimentAnalysis": "ANC beskrives gentagne gange som stærk, effektiv og overraskende kompetent.",
     "simpleTitle": "Effektiv støjreduktion",
     "bias": "positive",
     "key": "anc",
     "groupId": "0adacb7c-bd76-49c5-aade-0dd31694eae9"
    },
    "comfortable for extended wear": {
     "sentimentAnalysis": "Hovedtelefonerne roses bredt for en behagelig pasform under lange lytteperioder og arbejdsdage.",
     "simpleTitle": "Komfortabel ved lang tids brug",
     "bias": "positive",
     "key": "comfort",
     "groupId": "b42d5035-a954-45ae-bbc7-95e883df4a6e"
    },
    "exceptional battery life": {
     "sentimentAnalysis": "Batteritiden beskrives som fremragende og særligt nyttig til brug hele dagen.",
     "simpleTitle": "Fremragende batteritid",
     "bias": "positive",
     "key": "battery",
