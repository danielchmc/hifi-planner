       "adds immersion to films, TV and music": {
        "sentimentAnalysis": "Subwooferen beskrives bredt som en markant forbedring af Sonos-soundbarer og surroundsystemer, især til filmlyd.",
        "simpleTitle": "Giver mere indlevelse til film, tv og musik",
        "bias": "positive",
        "key": "integration",
        "groupId": "042df3c9-596b-400b-9956-ae2f2b1e324d"
