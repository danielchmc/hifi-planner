     "reviews": {
      "summary": "SONOS Sub Mini roses bredt for sin varme, kontante og overraskende dybe bas, som gør musik og film fyldigere, bredere og mere medrivende. Det kompakte design passer godt i små og mellemstore rum, mens integrationen med Beam, Arc, Era og andre Sonos-højttalere som regel er problemfri. Opsætning og appstyring er ofte enkel, men lejlighedsvise Wi-Fi- eller appproblemer, den høje pris og mindre dybde i større rum nævnes som forbehold.",
      "headlines": {
       "warm, deep and powerful bass": {
        "sentimentAnalysis": "Sub Mini tilfører konsekvent en fyldigere, dybere og kraftigere bas end de tilsluttede højttalere alene.",
        "simpleTitle": "Varm, dyb og kraftfuld bas",
        "bias": "positive",
        "key": "sound_quality",
        "groupId": "52c4b5f5-a731-4784-a987-a8e698de5fd3"
       },
       "easy Sonos integration": {
        "sentimentAnalysis": "De fleste beskriver hurtig tilslutning og problemfri integration med eksisterende Sonos-systemer og Sonos-appen.",
        "simpleTitle": "Nem Sonos-integration",
        "bias": "positive",
        "key": "setup_integration",
        "groupId": "229af36b-bc69-42a0-b4c2-ff126e887bbe"
       },
       "a more immersive music and film experience": {
        "sentimentAnalysis": "Den ekstra dybde forbedrer indlevelse, surroundeffekt og fyldig lyd ved film, tv og musik.",
        "simpleTitle": "En mere medrivende musik- og filmoplevelse",
        "bias": "positive",
        "key": "sound_quality",
        "groupId": "52c4b5f5-a731-4784-a987-a8e698de5fd3"
       },
       "compact design with room-friendly output": {
        "sentimentAnalysis": "De kompakte mål, det flotte design og den nemme placering gør Sub Mini særligt velegnet til små og mellemstore rum.",
        "simpleTitle": "Kompakt design med passende ydelse til rummet",
        "bias": "positive",
        "key": "design_size",
        "groupId": "30550f9b-f9de-4d58-aa0c-13dd6021f084"
       },
       "app and connectivity issues": {
        "sentimentAnalysis": "En mindre gruppe oplever vanskelig opsætning, appnedbrud eller ustabile forbindelser, blandt andet efter skift af Wi-Fi.",
        "simpleTitle": "Problemer med app og forbindelse",
        "bias": "negative",
        "key": "setup_integration",
        "groupId": "229af36b-bc69-42a0-b4c2-ff126e887bbe"
       },
       "less depth than expected in larger rooms": {
        "sentimentAnalysis": "Nogle ønsker mere effekt ved lav lydstyrke samt dybere og fyldigere bas, især i større rum eller sammenlignet med den store Sub.",
        "simpleTitle": "Mindre dybde end forventet i større rum",
        "bias": "negative",
        "key": "sound_quality",
        "groupId": "52c4b5f5-a731-4784-a987-a8e698de5fd3"
       }
      },
