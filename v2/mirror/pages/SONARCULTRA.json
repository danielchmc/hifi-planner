  "displayBookDemo": true,
  "reviews": {
   "summary": "SONARCULTRA leverer et varmt, kraftfuldt og meget omsluttende lydbillede med tydelige dialoger, detaljeret musik og overraskende dyb bas fra én soundbar. Dolby Atmos og udvidede Sonos-systemer med Sub- og Era-højttalere kan skabe en overbevisende biografoplevelse, mens opsætningen generelt er hurtig og enkel. Enkelte oplever forbindelses-, app-, synkroniserings- eller lydstyrkeproblemer, og den høje pris samt et lejlighedsvist behov for Sub dæmper den ellers meget begejstrede vurdering.",
   "headlines": {
    "warm, detailed and immersive sound": {
     "sentimentAnalysis": "Anmeldelserne beskriver en klar, fyldig og biografisk lyd, der engagerer med stærk musikgengivelse.",
     "simpleTitle": "Varm, detaljeret og omsluttende lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "0397f5e3-0018-4779-a1c2-f8381ececcaa"
    },
    "deep bass, often without a Sub": {
     "sentimentAnalysis": "Mange anmeldelser roser soundbarens kraftfulde, kontrollerede og overraskende dybe bas, også uden en ekstern Sub.",
     "simpleTitle": "Dyb bas, ofte uden Sub",
     "bias": "positive",
     "key": "bass",
     "groupId": "8c60917d-6e36-4d5e-99c4-981d9af2eeff"
    },
    "easy installation and calibration": {
     "sentimentAnalysis": "Opsætning, app-vejledning og rumkalibrering opleves generelt som hurtig, enkel og brugervenlig.",
     "simpleTitle": "Nem opsætning og kalibrering",
     "bias": "positive",
     "key": "setup",
     "groupId": "8e20253a-2ce1-4c2e-b9aa-926f3ac808c1"
    },
    "immersive cinema with Atmos and rear speakers": {
     "sentimentAnalysis": "Atmos og ekstra Era-højttalere fremhæves ofte for at skabe et bredt, realistisk og biograflignende surroundfelt.",
     "simpleTitle": "Omsluttende biograflyd med Atmos og baghøjttalere",
     "bias": "positive",
     "key": "surround",
     "groupId": "2cfe1060-73a5-45e5-848b-480f12b51178"
    },
    "intermittent connection and app issues": {
     "sentimentAnalysis": "En mindre gruppe rapporterer om ustabile forbindelser, en besværlig app, problemer med læbesynkronisering eller inkompatible Atmos-opsætninger.",
     "simpleTitle": "Periodiske forbindelses- og appproblemer",
     "bias": "negative",
     "key": "connectivity",
     "groupId": "a6e17550-d76b-4be0-a87b-e98746a15354"
    }
   },
