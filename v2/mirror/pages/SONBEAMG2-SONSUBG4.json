       "easy setup and seamless Sonos integration": {
        "sentimentAnalysis": "De fleste anmeldelser fremhæver den hurtige, enkle opsætning og den gode kompatibilitet med Arc-, Arc Ultra-, Beam- og Era-systemer.",
        "simpleTitle": "Nem opsætning og problemfri Sonos-integration",
        "bias": "positive",
        "key": "easy_integration",
        "groupId": "de8c29ea-634b-4ef4-a05a-51cb236fea73"
       },
       "bass stays controlled and tunable": {
        "sentimentAnalysis": "Bassen forbliver ren, naturlig og fri for raslen og kan nemt justeres i appen til rum og optagelser.",
        "simpleTitle": "Kontrollerbar og justerbar bas",
        "bias": "positive",
        "key": "controlled_tunable_bass",
        "groupId": "dea139f9-0013-4a57-9e64-372ee460b8f8"
       },
