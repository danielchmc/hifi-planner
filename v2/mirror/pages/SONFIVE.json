  "displayBookDemo": true,
  "reviews": {
   "summary": "SONOS Five leverer kraftfuld, varm og rummelig lyd fra en forholdsvis kompakt højttaler med dyb bas, tydelige detaljer og god fylde i rummet. Nem opsætning, fleksibel streaming og mulighed for stereopar gør systemet særligt attraktivt til hverdagslytning og større rum. Enkelte anmeldelser kritiserer appoplevelsen, den begrænsede kompatibilitet med ældre Sonos-produkter og en lyd, der ikke helt når ægte hi-fi-niveau.",
   "headlines": {
    "simple installation and convenient streaming": {
     "sentimentAnalysis": "Mange anmeldelser beskriver opsætningen som hurtig og nem, mens direkte integration med streamingtjenester og Sonos-økosystemet gør brugen bekvem.",
     "simpleTitle": "Nem opsætning og bekvem streaming",
     "bias": "positive",
     "key": "setup_and_app",
     "groupId": "5983db72-c2bd-4084-8331-748873a5e90b"
    },
    "warm, powerful and room-filling sound": {
     "sentimentAnalysis": "Anmeldelserne roser ofte den fyldige, dybe, rummelige og dynamiske gengivelse, især til mellemstore og store rum.",
     "simpleTitle": "Varm, kraftfuld og rumfyldende lyd",
     "bias": "positive",
     "key": "sound_quality",
     "groupId": "4920e0d0-cb47-4731-858b-14659bf5e25a"
    },
    "bass and hi-fi expectations are not unanimous": {
     "sentimentAnalysis": "Flere anmeldelser synes, at bas eller samlet lyd er skuffende til prisen, og sammenligninger med dedikerede hi-fi-systemer viser begrænsninger.",
     "simpleTitle": "Bas og hi-fi-forventninger er ikke entydige",
     "bias": "negative",
     "key": "sound_quality",
     "groupId": "4920e0d0-cb47-4731-858b-14659bf5e25a"
    },
    "stereo pairs create a wider, stronger presentation": {
     "sentimentAnalysis": "Anmeldelser beskriver konsekvent to højttalere i stereo som en stor forbedring med mere bredde, indlevelse og lydtryk.",
     "simpleTitle": "Stereopar giver et bredere og stærkere lydbillede",
     "bias": "positive",
     "key": "stereo_and_compatibility",
     "groupId": "abbd9841-54aa-4bfe-a332-90f47d92df16"
    },
    "app stability and usability can disappoint": {
     "sentimentAnalysis": "En mindre, men tydelig gruppe oplever en ustabil eller uintuitiv app, som vanskeliggør opsætning og daglig betjening.",
     "simpleTitle": "Appens stabilitet og brugervenlighed kan skuffe",
     "bias": "negative",
     "key": "setup_and_app",
     "groupId": "5983db72-c2bd-4084-8331-748873a5e90b"
    },
    "compatibility with older Sonos products is limited": {
     "sentimentAnalysis": "Nogle anmeldelser er frustrerede over, at Five ikke kan kombineres i stereo med bestemte ældre eller andre Sonos-højttalermodeller.",
     "simpleTitle": "Kompatibiliteten med ældre Sonos-produkter er begrænset",
     "bias": "negative",
     "key": "stereo_and_compatibility",
     "groupId": "abbd9841-54aa-4bfe-a332-90f47d92df16"
    }
   },
