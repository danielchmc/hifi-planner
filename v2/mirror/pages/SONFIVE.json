  "displayBookDemo": true,
  "reviews": {
   "summary": "SONOS Five leverer en varm, fyldig og rummelig lyd med imponerende dybde og bas i forhold til den kompakte størrelse. Nem opsætning, fleksibel streaming og stereoparring gør højttaleren velegnet til både hverdagslytning og større rum. Nogle anmeldelser finder dog appen frustrerende, bassen utilstrækkelig til prisen eller lyden mindre raffineret end i traditionelle hi-fi-systemer.",
   "headlines": {
    "rich, spacious sound with strong bass": {
     "sentimentAnalysis": "Anmeldelserne roser den fyldige, dybe, klare og rummelige gengivelse med kraft nok til store rum og ofte uden behov for en subwoofer.",
     "simpleTitle": "Fyldig og rummelig lyd med kraftig bas",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "21f481b0-47ef-4ab1-9036-ed5e8256e26f"
    },
    "easy setup and convenient streaming": {
     "sentimentAnalysis": "Mange anmeldelser fremhæver den ukomplicerede opsætning, pålidelige drift og bekvemme styring eller streaming via Sonos, Spotify og Apple Music.",
     "simpleTitle": "Nem opsætning og bekvem streaming",
     "bias": "positive",
     "key": "setup-app",
     "groupId": "00d4ae8c-673f-49e2-89fe-541191e19bfd"
    },
    "stereo pairs create a major improvement": {
     "sentimentAnalysis": "Anmeldelserne beskriver samstemmende stereoparring som en markant bredere, fyldigere og mere imponerende lytteoplevelse.",
     "simpleTitle": "Stereopar giver en markant forbedring",
     "bias": "positive",
     "key": "stereo-compatibility",
     "groupId": "c375bce1-320c-4733-98a7-0374ef2c68fd"
    },
    "sound quality can fall short of hi-fi expectations": {
     "sentimentAnalysis": "Et mindretal beskriver lyden som middelmådig, dump eller under ægte hi-fi-niveau, især sammenlignet med passive højttalere eller forventet bas.",
     "simpleTitle": "Lydkvaliteten kan skuffe hi-fi-forventninger",
     "bias": "negative",
     "key": "sound-quality",
     "groupId": "21f481b0-47ef-4ab1-9036-ed5e8256e26f"
    },
    "the app can be unstable or unintuitive": {
     "sentimentAnalysis": "Flere anmeldelser nævner frustrerende opsætning, ustabilitet efter appopdateringer eller en brugerflade, der ikke er selvforklarende.",
     "simpleTitle": "Appen kan være ustabil eller svær at bruge",
     "bias": "negative",
     "key": "setup-app",
     "groupId": "00d4ae8c-673f-49e2-89fe-541191e19bfd"
    },
    "compatibility limitations can be disappointing": {
     "sentimentAnalysis": "Anmeldelserne kritiserer, at Five ikke kan parres med visse ældre eller andre Sonos-højttalere, hvilket skaber skuffede forventninger til systemets fleksibilitet.",
     "simpleTitle": "Kompatibilitetsbegrænsninger kan skuffe",
     "bias": "negative",
     "key": "stereo-compatibility",
     "groupId": "c375bce1-320c-4733-98a7-0374ef2c68fd"
    }
   },
