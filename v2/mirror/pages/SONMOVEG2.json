  "reviews": {
   "summary": "SONOS Move 2 får stor ros som en førsteklasses transportabel højttaler med varm, fyldig og overraskende rummelig lyd, kraftig bas, klare detaljer og høj lydstyrke i forhold til størrelsen. Den lange batteritid, nemme transport, fleksible brug via Wi-Fi og Bluetooth samt gode integration med eksisterende Sonos-systemer gør den alsidig både inde og ude. De største forbehold gælder vægten, en til tider frustrerende Sonos-app eller forbindelse, den høje pris og lejlighedsvis skuffelse over lydens detaljer eller manglende Google Assistant-understøttelse.",
   "headlines": {
    "smooth Sonos integration and flexible connections": {
     "sentimentAnalysis": "Mange anmeldelser værdsætter hurtig opsætning, stabile Wi-Fi- eller Bluetooth-forbindelser og enkel integration med andre Sonos-højttalere.",
     "simpleTitle": "Nem Sonos-integration og fleksible forbindelser",
     "bias": "positive",
     "key": "setup-positive-1",
     "groupId": "f7ed9c80-f3a7-4ec1-9f76-bcc802b5645d"
    },
    "warm, powerful sound with punchy bass": {
     "sentimentAnalysis": "Anmeldelserne beskriver ofte lyden som fyldig, klar, kraftfuld og basrig med imponerende output for en transportabel højttaler.",
     "simpleTitle": "Varm og kraftfuld lyd med fyldig bas",
     "bias": "positive",
     "key": "sound-positive-1",
     "groupId": "95bbea84-e0e5-422c-9ddf-4712ff0a77e6"
    },
    "long-lasting battery": {
     "sentimentAnalysis": "Batteriets udholdenhed får gentagne gange ros, og flere anmeldelser nævner meget lang afspilningstid og stabil brug i hverdagen.",
     "simpleTitle": "Lang batteritid",
     "bias": "positive",
     "key": "battery-positive-1",
     "groupId": "9e4ac80f-73d7-40f7-aae9-1f1f9b29bca6"
    },
    "easy to move indoors and outdoors": {
     "sentimentAnalysis": "Mobiliteten er en klar styrke og gør det nemt at bruge højttaleren i forskellige rum, haver, på terrasser og andre udendørs steder.",
     "simpleTitle": "Nem at flytte inde og ude",
     "bias": "positive",
     "key": "portability-positive-1",
     "groupId": "08076351-f286-4004-9aed-a33c88f55aec"
    },
    "app and connection issues can frustrate": {
     "sentimentAnalysis": "En tilbagevendende kritik fra en mindre del af anmeldelserne gælder en uoverskuelig eller ustabil app, problemer med at finde og forbinde til højttaleren samt lejlighedsvis forsinkelse.",
     "simpleTitle": "Problemer med app og forbindelse kan frustrere",
     "bias": "negative",
     "key": "app-negative-1",
     "groupId": "22c4ef76-c9f3-4c01-a079-6351298ecac1"
    },
    "some listeners find the sound less refined than expected": {
     "sentimentAnalysis": "En mindre gruppe synes, at klarhed, opløsning eller kraft ved højere lydstyrke ikke lever op til prisen eller sammenligningen med større Sonos-modeller.",
     "simpleTitle": "Nogle synes, lyden er mindre raffineret end forventet",
     "bias": "negative",
     "key": "sound-negative-1",
     "groupId": "95bbea84-e0e5-422c-9ddf-4712ff0a77e6"
    }
   },
