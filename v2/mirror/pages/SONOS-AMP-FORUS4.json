     "reviews": {
      "summary": "SONAMP roses bredt som en kompakt, kraftfuld og brugervenlig måde at integrere passive højttalere i Sonos-økosystemet på. Lyden beskrives generelt som klar, levende, varm og kraftfuld, med stærk tv- og surroundintegration samt problemfri multiroom-streaming. Opsætning og daglig betjening er som regel enkel, men app-problemer, lejlighedsvise forbindelsesproblemer, manglende indgange, begrænset Bluetooth-understøttelse og den relativt høje pris nævnes flere gange som ulemper.",
      "headlines": {
       "powerful, lively sound": {
        "sentimentAnalysis": "Anmeldelserne beskriver forstærkeren som kraftfuld, musikalsk og detaljeret med en kontant bas og en medrivende gengivelse, der giver både ældre og nyere højttalere nyt liv.",
        "simpleTitle": "Kraftfuld og levende lyd",
        "bias": "positive",
        "key": "sound",
        "groupId": "a92244b1-eee6-476b-9668-32367831a375"
       },
       "easy installation and operation": {
        "sentimentAnalysis": "De fleste anmeldelser beskriver opsætning, betjening og integration som hurtig, intuitiv og ukompliceret.",
        "simpleTitle": "Nem opsætning og betjening",
        "bias": "positive",
        "key": "setup",
        "groupId": "3febb64f-d2b8-420e-bec2-2eef0f2e23de"
       },
       "seamless Sonos ecosystem integration": {
        "sentimentAnalysis": "Forstærkeren værdsættes for at kunne tilføje passive højttalere, ældre udstyr og eksisterende subwoofere til et samlet Sonos-multiroom-system.",
        "simpleTitle": "Problemfri integration i Sonos-økosystemet",
        "bias": "positive",
        "key": "integration",
        "groupId": "32f2e89d-bde2-4d45-b788-a378a21fc0b1"
       },
       "excellent TV and surround integration": {
        "sentimentAnalysis": "HDMI- og ARC-forbindelser roses gentagne gange for god tv-lyd, enkel lydstyring og overbevisende Dolby-surroundopsætninger.",
        "simpleTitle": "Fremragende tv- og surroundintegration",
        "bias": "positive",
        "key": "tv",
        "groupId": "1b0d3d98-17fe-41dd-ac6a-815ceb471f84"
       },
       "app and connection instability": {
        "sentimentAnalysis": "Nogle anmeldelser nævner nedbrud, forsvundne enheder, gentagne genforbindelser, forsinket afspilning og en app, der kan være vanskelig eller ubrugelig på visse enheder.",
        "simpleTitle": "Ustabil app og forbindelse",
        "bias": "negative",
        "key": "reliability",
        "groupId": "fda6754b-0127-4835-b985-8c4c1dcfe451"
       }
