  "reviews": {
   "summary": "SONPORT er en kompakt og pålidelig bro, der bringer pladespillere, stereoanlæg, DJ-udstyr og andre analoge kilder ind i Sonos-økosystemet. Opsætningen er som regel hurtig og problemfri, mens lyden ofte beskrives som fyldig, detaljeret, rummelig og medrivende. De største forbehold gælder den høje pris, lejlighedsvise problemer med app og opsætning, kompatibilitetsbegrænsninger samt enkelte forbindelses- og lydstyrkeproblemer.",
   "headlines": {
    "brings analogue equipment into the Sonos system": {
     "sentimentAnalysis": "SONPORT værdsættes især for at gøre pladespillere, stereoanlæg og andre analoge kilder tilgængelige i hele Sonos-opsætningen.",
     "simpleTitle": "Bringer analogt udstyr ind i Sonos-systemet",
     "bias": "positive",
     "key": "analogue-integration",
     "groupId": "7d5a77ab-0776-4dc4-aeb7-9b4658301b42"
    },
    "setup is generally quick and straightforward": {
     "sentimentAnalysis": "Mange anmeldelser beskriver opsætningen som enkel, hurtig og stort set automatisk efter tilslutning.",
     "simpleTitle": "Opsætningen er som regel hurtig og enkel",
     "bias": "positive",
     "key": "easy-setup",
     "groupId": "5db530ce-09eb-41ba-8ce3-61981d649198"
    },
    "the price feels too high": {
     "sentimentAnalysis": "En tilbagevendende kritik er, at SONPORT trods sin nytteværdi koster mere end forventet i forhold til funktionerne.",
     "simpleTitle": "Prisen føles for høj",
     "bias": "negative",
     "key": "high-price",
     "groupId": "e528a988-6cd7-4486-ab84-72a9b6eedead"
    },
    "the Sonos app can be confusing": {
     "sentimentAnalysis": "Flere anmeldelser oplever appen som uintuitiv, især ved valg af indgange, opsætning eller håndtering af ældre Sonos-produkter.",
     "simpleTitle": "Sonos-appen kan være forvirrende",
     "bias": "negative",
     "key": "app-friction",
     "groupId": "c5d5f7b7-9dea-4884-a2b2-f528202365a2"
    },
    "rich, detailed and immersive sound": {
     "sentimentAnalysis": "Lyden roses for at være fyldig, rummelig og detaljeret samt for at give en medrivende musikoplevelse.",
     "simpleTitle": "Fyldig, detaljeret og medrivende lyd",
     "bias": "positive",
     "key": "rich-sound",
     "groupId": "cef03b0e-a873-4d3e-b86a-58a6252abe7c"
    }
