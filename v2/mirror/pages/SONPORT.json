  "reviews": {
   "summary": "SONPORT er en fremragende bro, der bringer pladespillere, stereoanlæg, DJ-udstyr og andre analoge kilder ind i Sonos-universet. Opsætningen er ofte hurtig og problemfri, mens lyden beskrives som varm, detaljeret, rummelig og opslugende. De største forbehold er den høje pris, lejlighedsvise problemer med app eller forbindelse samt visse kompatibilitetsbegrænsninger.",
   "headlines": {
    "brings analogue sources into the Sonos ecosystem": {
     "sentimentAnalysis": "Den centrale styrke er problemfri afspilning i hele hjemmet fra pladespillere, stereoanlæg, DJ-udstyr og andre analoge kilder.",
     "simpleTitle": "Bringer analoge kilder ind i Sonos-universet",
     "bias": "positive",
     "key": "integration",
     "groupId": "b0b8721b-5e0f-4583-ba1d-ac1d998e6609"
    },
    "quick and simple installation": {
     "sentimentAnalysis": "Mange anmeldelser beskriver opsætning og tilslutning som hurtig, intuitiv og enkel.",
     "simpleTitle": "Hurtig og enkel opsætning",
     "bias": "positive",
     "key": "setup",
     "groupId": "3a00ecd7-5cd2-4a52-b18a-d4f772aaa89b"
    },
    "detailed, spacious and immersive sound": {
     "sentimentAnalysis": "Lydkvaliteten roses for fylde, flere detaljer, rummelighed og en opslugende musikoplevelse.",
     "simpleTitle": "Detaljeret, rummelig og opslugende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "050a5850-c450-4f58-82a5-5384b13aa229"
    },
    "compatibility and connection issues remain": {
     "sentimentAnalysis": "Nogle anmeldelser nævner Wi-Fi-udfald, problemer efter opdateringer, lydafbrydelser og begrænsninger med ældre Sonos-hardware.",
     "simpleTitle": "Kompatibilitets- og forbindelsesproblemer består",
     "bias": "negative",
     "key": "reliability",
     "groupId": "7014b74a-604f-45ce-945a-dc9194b7cbf6"
    },
    "app navigation and setup can be confusing": {
     "sentimentAnalysis": "Sonos-appen kritiseres gentagne gange for uklare indstillinger, vanskelig valg af kilde og uensartede opsætningsoplevelser.",
     "simpleTitle": "App-navigation og opsætning kan være forvirrende",
     "bias": "negative",
     "key": "setup",
     "groupId": "3a00ecd7-5cd2-4a52-b18a-d4f772aaa89b"
    },
    "high price for a necessary Sonos bridge": {
     "sentimentAnalysis": "Flere anmeldelser finder Port dyr, især fordi enheden er nødvendig for at tilføje analoge kilder til et eksisterende Sonos-system.",
     "simpleTitle": "Høj pris for en nødvendig Sonos-bro",
     "bias": "negative",
     "key": "value",
     "groupId": "526a8a74-9e1d-4514-bd8b-8ab3aa442806"
    }
   },
