  "displayBookDemo": true,
  "reviews": {
   "summary": "SONRAY leverer en varm, klar og fyldig lyd, som er en markant opgradering i forhold til indbyggede TV-højttalere, især til film og almindeligt TV. Det kompakte design, den nemme opsætning og den attraktive pris gør soundbaren til et oplagt valg til soveværelser, mindre rum og enkel forbedring af TV-lyden. Bas, stereobredde, musikgengivelse og kompatibilitet med TV-fjernbetjeninger kan være begrænset, mens multiroom- og surroundudvidelser giver et langt mere omsluttende lydbillede.",
   "headlines": {
    "clear, immersive sound and a major TV upgrade": {
     "sentimentAnalysis": "Lyden roses bredt som klar, detaljeret og markant bedre end indbyggede TV-højttalere, hvilket giver en engagerende film- og TV-oplevelse.",
     "simpleTitle": "Klar og omsluttende lyd samt en markant TV-opgradering",
     "bias": "positive",
     "key": "sound",
     "groupId": "1cfe2dae-2bdd-44f4-91d4-4dbb7ed8dffd"
    },
    "easy installation and convenient everyday use": {
     "sentimentAnalysis": "De fleste anmeldelser om opsætning beskriver installation, tilslutning og daglig betjening som enkel og ukompliceret.",
     "simpleTitle": "Nem opsætning og bekvem daglig brug",
     "bias": "positive",
     "key": "setup",
     "groupId": "699b4923-2a47-482a-bff2-bbf216f91f12"
    },
    "good sound at an attractive price": {
     "sentimentAnalysis": "Værdi for pengene er et stærkt salgsargument, og soundbaren beskrives gentagne gange som overkommelig, prisvenlig og imponerende til prisen.",
     "simpleTitle": "God lyd til en attraktiv pris",
     "bias": "positive",
     "key": "value",
     "groupId": "59ab5e92-de18-40c5-af1c-7d0805970037"
    },
    "surround extensions add immersive impact": {
     "sentimentAnalysis": "Kompatibilitet med Sonos One, Sub og andre højttalere roses for at give mere dybde, surroundfornemmelse og en stærkere samlet lydoplevelse.",
     "simpleTitle": "Surroundudvidelser giver en mere omsluttende oplevelse",
     "bias": "positive",
     "key": "multiroom",
     "groupId": "8ddbfb3d-c5ce-4364-b6cf-6a808e62d7b4"
    },
    "remote-control and app compatibility can be frustrating": {
     "sentimentAnalysis": "Parring med TV-fjernbetjeningen, manglende optisk lydstyrkevisning og appens stabilitet giver gentagne gange frustrationer, og nogle TV kræver en ekstra fjernbetjening.",
     "simpleTitle": "Kompatibilitet med fjernbetjening og app kan være frustrerende",
     "bias": "negative",
     "key": "tvcontrol",
     "groupId": "08989021-eb4d-4a84-87b0-6699b5f2c883"
    },
    "compact design fits small spaces": {
     "sentimentAnalysis": "Soundbaren roses gentagne gange for et flot design og et kompakt format, der passer godt til soveværelser, nicher og mindre rum.",
     "simpleTitle": "Kompakt design passer til små rum",
     "bias": "positive",
     "key": "design",
     "groupId": "15589d52-e695-4e42-817d-f314bd5cc7aa"
    },
    "strong bass and dialogue, but limited width and music performance": {
     "sentimentAnalysis": "Flere anmeldelser roser bas og dialoggengivelse, men bemærker et smalt, hult eller ubalanceret lydbillede samt for lidt bas i nogle opsætninger.",
     "simpleTitle": "Kraftig bas og tydelige dialoger, men begrænset bredde og musikgengivelse",
     "bias": "negative",
     "key": "sound",
     "groupId": "1cfe2dae-2bdd-44f4-91d4-4dbb7ed8dffd"
    }
   },
