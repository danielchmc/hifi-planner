  "displayBookDemo": true,
  "reviews": {
   "summary": "SONOSUBG4 leverer varm, dyb og kontant bas, som giver tv, film og musik større biografstemning og en mere omsluttende lyd. Den nemme trådløse integration med Sonos-soundbars og højttalere gør opsætningen enkel, mens appen giver præcis justering fra diskret til rumrystende. Det stilfulde og diskrete design samt den rene, kontrollerede gengivelse får stor ros, selv om nogle synes, at bassen er mindre kraftig end forventet, produktet er dyrt, eller app og kompatibilitet har begrænsninger.",
   "headlines": {
    "deep, powerful and clean bass": {
     "sentimentAnalysis": "Anmeldelserne roser Sub 4 for dyb og kraftfuld bas med stor effekt, klarhed og kontrol uden uønsket raslen eller forvrængning.",
     "simpleTitle": "Dyb, kraftfuld og ren bas",
     "bias": "positive",
     "key": "sound",
     "groupId": "94e59c58-bee4-4ef1-a62b-b646e4787516"
    },
    "a major upgrade for TV, films and music": {
     "sentimentAnalysis": "Sub 4 beskrives gentagne gange som en kilde til større dybde, omsluttende lyd og et fyldigere lydbillede i Sonos-hjemmebiografer, især sammen med Arc Ultra og Era-højttalere.",
     "simpleTitle": "En stor opgradering til tv, film og musik",
     "bias": "positive",
     "key": "sound",
     "groupId": "94e59c58-bee4-4ef1-a62b-b646e4787516"
    },
    "easy setup and seamless Sonos integration": {
     "sentimentAnalysis": "Opsætningen opleves generelt som hurtig, enkel og brugervenlig med særligt godt samspil i Arc Ultra-, Beam- og Era-systemer.",
     "simpleTitle": "Nem opsætning og problemfri Sonos-integration",
     "bias": "positive",
     "key": "setup",
     "groupId": "ef1936c0-d0a7-42cd-8515-9b906f312710"
    },
    "some listeners expected deeper or stronger bass": {
     "sentimentAnalysis": "Et mindretal oplever mindre output end forventet, utilstrækkelig dybde eller begrænset effekt ved høj lydstyrke, mens en anden anmeldelse kritiserer den høje pris.",
     "simpleTitle": "Nogle lyttere forventede dybere eller kraftigere bas",
     "bias": "negative",
     "key": "sound",
     "groupId": "94e59c58-bee4-4ef1-a62b-b646e4787516"
    },
    "flexible bass control through the app": {
     "sentimentAnalysis": "Appstyringen værdsættes, fordi bassen kan tilpasses forskellige rum, indspilninger, lydstyrker og personlige præferencer.",
     "simpleTitle": "Fleksibel basstyring via appen",
     "bias": "positive",
     "key": "adjustment",
     "groupId": "96639528-0cc2-48af-a8bc-aab31453cd79"
    }
   },
