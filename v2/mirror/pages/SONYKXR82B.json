  "reviews": {
   "summary": "SonyKXR82B leverer en fremragende OLED-oplevelse med varme, naturlige farver, dyb sort, skarpe detaljer og et medrivende billede, der næsten kan give biograffornemmelse. Menuer og opsætning er generelt ligetil, med stærk Smart TV-ydeevne, nyttige apps og gode tilslutningsmuligheder, selv om enkelte begrænsninger i kompatibilitet og opsætning forekommer. Den indbyggede lyd er udmærket for et TV, mens en soundbar eller surround-anlæg giver et fyldigere, mere slagkraftigt og mere biograflignende resultat.",
   "headlines": {
    "sharp, natural and immersive picture": {
     "sentimentAnalysis": "Anmeldelserne roser det usædvanligt skarpe, klare og naturlige billede med levende farver og en stærk helhedsoplevelse.",
     "simpleTitle": "Skarpt, naturligt og medrivende billede",
     "bias": "positive",
     "key": "sharp_natural_picture",
     "groupId": "c5ff5617-b109-4a7a-a76f-17c33d53afab"
    },
    "simple menus and setup": {
     "sentimentAnalysis": "De fleste kommentarer beskriver opsætning, menuer og daglig betjening som enkel og logisk.",
     "simpleTitle": "Enkle menuer og opsætning",
     "bias": "positive",
     "key": "simple_operation",
     "groupId": "89fa4f7a-f39e-49a9-b414-95e8127c7731"
    },
    "built-in sound is good, but external audio is better": {
     "sentimentAnalysis": "Flere anmeldelser oplever TV-lyden som overraskende god, men anbefaler en soundbar, et surround-anlæg eller en ekstern løsning for en mere kraftfuld filmoplevelse.",
     "simpleTitle": "Den indbyggede lyd er god, men ekstern lyd er bedre",
     "bias": "positive",
     "key": "external_audio_better",
     "groupId": "6e400199-5976-40fb-bc80-421ae9b0f2d7"
    },
    "deep blacks and strong HDR performance": {
     "sentimentAnalysis": "OLED-panelet fremhæves for stor dybde, overbevisende sort og fremragende SDR- og HDR-gengivelse efter mindre justeringer.",
     "simpleTitle": "Dyb sort og stærk HDR-ydeevne",
     "bias": "positive",
     "key": "deep_blacks_hdr",
     "groupId": "c5ff5617-b109-4a7a-a76f-17c33d53afab"
