  "displayBookDemo": true,
  "reviews": {
   "summary": "Sony WF-1000XM6 leverer en varm, fyldig og omsluttende lyd med særligt imponerende støjreduktion og en kompetent app. Batteritid, pris og lejlighedsvise pålidelighedsproblemer trækker ned i en ellers meget tilfredsstillende oplevelse, mens vindreduktionen under cykling fortsat er en tydelig svaghed. Samlet set tilbyder øretelefonerne en gennemført premium-pakke med rig lyd og fremragende støjisolering i hverdagen.",
   "headlines": {
    "rich, balanced and highly enjoyable sound": {
     "sentimentAnalysis": "Lyden roses gentagne gange som fremragende, balanceret, organisk og behagelig; en detaljeret vurdering fremhæver desuden den stærke bas.",
     "simpleTitle": "Fyldig, balanceret og meget behagelig lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "28bc7709-ac51-4574-9f93-9b2b8dfe303d"
    },
    "outstanding noise cancellation in everyday use": {
     "sentimentAnalysis": "Støjreduktionen beskrives som usædvanligt effektiv, meget imponerende og behagelig sammenlignet med konkurrerende øretelefoner.",
     "simpleTitle": "Fremragende støjreduktion i hverdagen",
     "bias": "positive",
     "key": "anc",
     "groupId": "5d090d62-16a2-4359-8267-bd4619bbb444"
    },
    "wind reduction remains weak while cycling": {
     "sentimentAnalysis": "Flere anmeldelser kritiserer specifikt håndteringen af vindstøj under cykling trods den generelt stærke støjreduktion.",
     "simpleTitle": "Vindreduktionen er fortsat svag under cykling",
     "bias": "negative",
     "key": "anc",
     "groupId": "5d090d62-16a2-4359-8267-bd4619bbb444"
    },
    "premium pricing feels hard to justify": {
     "sentimentAnalysis": "Prisen kaldes gentagne gange høj, og værdien vurderes som acceptabel, men ikke ekstraordinær nok til ubetinget begejstring.",
     "simpleTitle": "Premiumprisen er svær at retfærdiggøre",
     "bias": "negative",
     "key": "price",
     "groupId": "44e98046-d32e-43bd-84cc-fec1bd0dc596"
    },
    "some listeners miss bass, depth and dynamics": {
     "sentimentAnalysis": "To anmeldelser bemærker manglende bas, dybde eller dynamik, hvilket står i kontrast til de overvejende positive lydindtryk.",
     "simpleTitle": "Nogle savner bas, dybde og dynamik",
     "bias": "negative",
     "key": "sound",
     "groupId": "28bc7709-ac51-4574-9f93-9b2b8dfe303d"
    },
    "occasional charging and connection failures": {
     "sentimentAnalysis": "To anmeldelser rapporterer lejlighedsvise problemer med at tænde eller bevare forbindelsen, herunder en tilbagevendende fejl i ét tilfælde.",
     "simpleTitle": "Lejlighedsvise opladnings- og forbindelsesproblemer",
     "bias": "negative",
     "key": "reliability",
     "groupId": "864853e7-8703-458e-b2d8-aec389856117"
