     "simpleTitle": "Fremragende støjreduktion",
     "bias": "positive",
     "key": "anc",
     "groupId": "529840cc-8831-4d80-98f8-7e4c9998c70b"
    },
    "wind noise weakens cycling performance": {
     "sentimentAnalysis": "Trods stærk generel støjreduktion vurderes håndteringen af vind under cykling gentagne gange skuffende.",
     "simpleTitle": "Vindstøj svækker brug under cykling",
     "bias": "negative",
     "key": "anc",
     "groupId": "529840cc-8831-4d80-98f8-7e4c9998c70b"
    },
    "app customization is a strong advantage": {
