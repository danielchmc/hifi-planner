     "parentProductCode": "SONYWH1000XM6",
     "reviews": {
      "summary": "Sony WH-1000XM6 leverer en immersiv, varm og slagkraftig lydoplevelse med enestående støjreduktion. Komfort, batteritid og alsidighed i hverdagen roses bredt, hvilket gør hovedtelefonerne attraktive til pendling, kontor og rejser. Lydsignatur, trykket mod hovedet, varmeudvikling og den høje pris er dog væsentlige ulemper for nogle lyttere.",
      "headlines": {
       "exceptional noise cancellation": {
        "sentimentAnalysis": "Støjreduktionen beskrives gentagne gange som fremragende, førende i klassen og særdeles effektiv i offentlig transport, på kontorer og under rejser.",
        "simpleTitle": "Enestående støjreduktion",
        "bias": "positive",
        "key": "noise_cancellation",
        "groupId": "f0cf1c64-4884-4883-9119-c27594dab694"
       },
       "clear, rich and immersive sound": {
        "sentimentAnalysis": "De fleste kommentarer om lyden roser klarhed, fylde, kraftig bas og en omsluttende gengivelse til musik, podcasts og streaming.",
        "simpleTitle": "Klar, fyldig og omsluttende lyd",
        "bias": "positive",
        "key": "sound_quality",
        "groupId": "5cfeb208-30b3-4235-85e3-338bc07fc08b"
       },
       "comfortable for extended wear": {
        "sentimentAnalysis": "Komfort, bløde ørepuder og en sikker pasform roses ofte, også af brugere med briller.",
        "simpleTitle": "Behagelige ved længere tids brug",
        "bias": "positive",
        "key": "comfort",
        "groupId": "88347ed3-4875-496d-a362-92cde172613b"
       },
       "sound can lack detail and balance": {
        "sentimentAnalysis": "Nogle lyttere oplever lyden som mudret eller bastung og savner diskant, detaljer og finesse i forhold til prisen.",
        "simpleTitle": "Lyden kan mangle detaljer og balance",
        "bias": "negative",
        "key": "sound_quality",
        "groupId": "5cfeb208-30b3-4235-85e3-338bc07fc08b"
       },
       "pressure and heat can limit comfort": {
        "sentimentAnalysis": "Andre oplevelser nævner varme ørepuder eller for kraftigt tryk, især ved længere tids lytning.",
        "simpleTitle": "Tryk og varme kan begrænse komforten",
        "bias": "negative",
        "key": "comfort",
        "groupId": "88347ed3-4875-496d-a362-92cde172613b"
       },
       "long battery life and fast charging": {
        "sentimentAnalysis": "Batteritiden vurderes konsekvent som meget god, og den hurtige opladning fremhæves også positivt.",
        "simpleTitle": "Lang batteritid og hurtig opladning",
        "bias": "positive",
        "key": "battery_life",
        "groupId": "fd2466b2-d795-4697-bfee-324fdafd48c3"
       }
      },
