       },
       "robust and effective outdoors": {
        "sentimentAnalysis": "Anmeldelserne værdsætter højttalerens robusthed, mobilitet og særligt stærke præstation udendørs.",
        "simpleTitle": "Robust og stærk udendørs",
        "bias": "positive",
        "key": "portability_durability",
