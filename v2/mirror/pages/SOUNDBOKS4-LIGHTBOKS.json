     "reviews": {
      "summary": "SOUNDBOKS4BB4 leverer en varm, slagkraftig og medrivende lyd med imponerende volumen, tydelig dynamik og stærk ydeevne udendørs. Den lange batteritid, robuste konstruktion og bærbarhed gør højttaleren særligt velegnet til fester, festivaler og arrangementer. Opsætning og app-styring er generelt enkel, men basbalancen, Bluetooth-rækkevidden samt enkelte hardware- og tilbehørsproblemer kritiseres.",
      "headlines": {
       "powerful, clear and dynamic sound": {
        "sentimentAnalysis": "Anmeldelserne roser den høje volumen, klare gengivelse, markante bas og overraskende stærke dynamik.",
        "simpleTitle": "Kraftfuld, klar og dynamisk lyd",
        "bias": "positive",
        "key": "sound",
        "groupId": "3c08a25d-1ff7-4978-99e0-608deebde8e9"
       },
       "long-lasting batteries support full-day events": {
        "sentimentAnalysis": "Batteritiden beskrives gentagne gange som fremragende, også til weekender og festivaler.",
        "simpleTitle": "Lang batteritid til hele dage",
        "bias": "positive",
        "key": "battery",
        "groupId": "61a93e48-54ce-40db-ad9d-fee84ae61918"
       },
       "rugged and highly portable for outdoor use": {
        "sentimentAnalysis": "Anmeldelserne værdsætter den robuste konstruktion, bærbarheden og egnetheden til udendørs fester, festivaler og aktiv brug.",
        "simpleTitle": "Robust og meget bærbar til udendørs brug",
        "bias": "positive",
        "key": "portability",
        "groupId": "416f036b-0261-4791-9915-7da1de26fce4"
       },
       "easy setup and app control": {
