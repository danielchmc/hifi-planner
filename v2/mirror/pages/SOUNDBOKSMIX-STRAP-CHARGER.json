       },
       "strong bass for a compact speaker": {
        "sentimentAnalysis": "Det kompakte kabinet leverer overraskende kraftig og fyldig bas, især med basforstærkede indstillinger.",
        "simpleTitle": "Kraftig bas i en kompakt højttaler",
        "bias": "positive",
        "key": "compact-bass",
        "groupId": "6b109e01-b417-4212-ba28-298f2cf94a92"
