  "reviews": {
   "summary": "SOUNDBOKS MIX leverer varm, punchy og imponerende kraftfuld lyd for en kompakt festhøjttaler med klare højder, mellemtoner og basser samt nyttige genreindstillinger. Det bærbare design, den lange batteritid og den nemme betjening gør højttaleren særdeles velegnet til fester, strandture og udendørs brug. Den samlede modtagelse er begejstret, selv om manglen på WiFi og de mere begrænsede dybeste basser sammenlignet med større Soundboks-modeller stadig er nævneværdige ulemper.",
   "headlines": {
    "powerful, balanced sound": {
     "sentimentAnalysis": "Højttaleren roses gentagne gange for høj, klar og velafbalanceret lyd på tværs af højder, mellemtoner og basser.",
     "simpleTitle": "Kraftfuld, afbalanceret lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "41d9c05f-186e-4b6e-9709-effa0c0e773d"
    },
    "surprisingly deep bass for its size": {
     "sentimentAnalysis": "De kompakte mål kombineres efter anmeldelserne med kraftig, overraskende dyb bas, især med den basforstærkede indstilling.",
     "simpleTitle": "Overraskende dyb bas i forhold til størrelsen",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "41d9c05f-186e-4b6e-9709-effa0c0e773d"
    },
    "easy to carry": {
     "sentimentAnalysis": "Det mindre og lettere format værdsættes, fordi det gør transporten nemmere end med større Soundboks-modeller.",
     "simpleTitle": "Nem at bære",
     "bias": "positive",
     "key": "portability",
     "groupId": "3188d3f5-ba3a-47f4-9d51-d05ba2b3f526"
    },
    "long battery life": {
     "sentimentAnalysis": "Batteritiden roses som lang og velegnet til længere tids lytning.",
     "simpleTitle": "Lang batteritid",
     "bias": "positive",
     "key": "battery-life",
