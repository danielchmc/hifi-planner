  "reviews": {
   "summary": "Et smukt designet mediemøbel i høj kvalitet med gennemtænkt kabelstyring og en for det meste enkel opsætning. Det varme, elegante udseende og den solide konstruktion gør et stærkt indtryk, selv om den høje pris, den overflade der hurtigt får ridser, og den vanskelige justering af lågen dæmper begejstringen. Det raffinerede møbeldesign skaber en ren og omsluttende hjemmebiografoplevelse til punchy lydudstyr.",
   "headlines": {
    "thoughtful design and solid quality": {
     "sentimentAnalysis": "Gennemtænkte detaljer og generelt høj byggekvalitet bliver rost.",
     "simpleTitle": "Gennemtænkt design og solid kvalitet",
     "bias": "positive",
     "key": "quality",
     "groupId": "73bc97c6-4c47-46df-84ea-f1d7eb2c5c6a"
    },
    "surface marks too easily": {
     "sentimentAnalysis": "Premiumprisen skaber høje forventninger, mens overfladens holdbarhed kritiseres.",
     "simpleTitle": "Overfladen får for let ridser",
     "bias": "negative",
     "key": "quality",
     "groupId": "73bc97c6-4c47-46df-84ea-f1d7eb2c5c6a"
    },
    "elegant walnut appearance": {
     "sentimentAnalysis": "Møblet opfattes gennemgående som flot, især på grund af den dybe valnøddefinish.",
     "simpleTitle": "Elegant valnøddeudseende",
     "bias": "positive",
     "key": "appearance",
