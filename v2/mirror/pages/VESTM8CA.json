  "reviews": {
   "summary": "VESTM8CA leverer en varm, slagkraftig og meget underholdende lyd med imponerende bas, høj lydstyrke og fremragende værdi for pengene. Højttalerne egner sig især godt til vinyl, pop, elektronisk musik, rock og daglig lytning, mens det klassiske design også ser godt ud. Opløsning og stereoperspektiv er mindre overbevisende ved komplekse klassiske optagelser, men den enkle opsætning og livlige gengivelse gør helheden særdeles attraktiv.",
   "headlines": {
    "lively, powerful sound at an attractive price": {
     "sentimentAnalysis": "Højttalerne roses gentagne gange for en klar, behagelig og energisk lyd med usædvanligt god værdi for pengene.",
     "simpleTitle": "Livlig og kraftfuld lyd til en attraktiv pris",
     "bias": "positive",
     "key": "lively-powerful-sound",
     "groupId": "448bb457-76eb-4059-84ee-68cd3c848a35"
    },
    "deep, satisfying bass": {
     "sentimentAnalysis": "Den kraftige bas er et gennemgående højdepunkt og beskrives som sjov og stærk nok til at erstatte en subwoofer.",
     "simpleTitle": "Dyb og fyldig bas",
     "bias": "positive",
     "key": "deep-bass",
     "groupId": "448bb457-76eb-4059-84ee-68cd3c848a35"
    },
    "limited resolution with complex recordings": {
     "sentimentAnalysis": "Den livlige gengivelse sker på bekostning af raffinement, med svagere detaljegengivelse og stereoperspektiv ved komplekst materiale.",
     "simpleTitle": "Begrænset opløsning ved komplekse optagelser",
     "bias": "negative",
     "key": "complex-recording-limitations",
     "groupId": "448bb457-76eb-4059-84ee-68cd3c848a35"
    },
    "classic, attractive styling": {
     "sentimentAnalysis": "Højttalerne værdsættes for et markant retrolook, store kabinetter og et klassisk udtryk, der passer til produktets karakter.",
     "simpleTitle": "Klassisk og attraktivt design",
     "bias": "positive",
     "key": "classic-design",
     "groupId": "0a251e6f-0713-4293-91ba-6ba30b696fe3"
    }
