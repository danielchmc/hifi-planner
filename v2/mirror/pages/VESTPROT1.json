  "reviews": {
   "summary": "VESTPROT1 leverer varm, ren og engagerende vinylafspilning med et imponerende pris-kvalitetsforhold. Solide funktioner, et attraktivt klassisk design og understøttelse af forskellige pladetyper gør pladespilleren til en overbevisende opgradering. Små irritationer er den løse plademåtte, den manglende automatiske retur og de ufuldstændige kabler, men helhedsindtrykket er stadig særdeles anbefalelsesværdigt.",
   "headlines": {
    "excellent value for money": {
     "sentimentAnalysis": "Pladespilleren roses gentagne gange for at give usædvanligt meget for pengene og være en værdifuld opgradering.",
     "simpleTitle": "Fremragende pris-kvalitetsforhold",
     "bias": "positive",
     "key": "value",
     "groupId": "4574116f-50a6-45ae-8f1a-287f41dcc9e8"
    },
    "attractive, well-made design": {
     "sentimentAnalysis": "Anmeldelserne fremhæver det klassiske udseende, den pæne finish, de dæmpende fødder og den generelt solide kvalitet.",
     "simpleTitle": "Attraktivt design i god kvalitet",
     "bias": "positive",
     "key": "design",
     "groupId": "9c4635ee-7f6f-4877-8988-1a67d3fe07be"
    },
    "clean, accurate sound": {
     "sentimentAnalysis": "De tilgængelige lytteindtryk beskriver en præcis, ren og behagelig gengivelse.",
     "simpleTitle": "Ren og præcis lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "926847a3-4323-4b03-9c1f-1fc99b04b493"
    },
    "loose platter mat is irritating": {
     "sentimentAnalysis": "Måtten kan hænge fast i pladerne og løfte sig fra pladetallerkenen under håndtering.",
     "simpleTitle": "Løs plademåtte er irriterende",
     "bias": "negative",
     "key": "platter_mat",
     "groupId": "4721c3ea-c304-48a6-9a63-60c9e3e11893"
    },
    "no automatic tonearm return": {
     "sentimentAnalysis": "Manglen på automatisk retur ved pladens slutning er en tydelig brugsmæssig ulempe.",
     "simpleTitle": "Ingen automatisk retur af tonearmen",
     "bias": "negative",
     "key": "automatic_return",
