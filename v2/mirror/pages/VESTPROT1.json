  "reviews": {
   "summary": "VESTPROT1 betragtes bredt som en fremragende, attraktiv og fornøjelig pladespiller til prisen med klar, ren og varm lyd, jævn direct drive og nyttige funktioner som understøttelse af 78 omdrejninger. Byggekvalitet, udseende og brugervenlighed får generelt ros, hvilket gør den til en stærk opgradering fra ældre pladespillere. De største ulemper er den løse måtte, manglen på automatisk tilbageføring eller afslag samt visse problemer med tilbehør og antiskating-mekanismen.",
   "headlines": {
    "excellent value for money": {
     "sentimentAnalysis": "Pladespilleren roses gentagne gange som et særdeles godt køb og en værdifuld opgradering.",
     "simpleTitle": "Fremragende værdi for pengene",
     "bias": "positive",
     "key": "value-quality",
     "groupId": "40cfde86-7e6b-47b1-8694-eb3bc8adecdf"
    },
    "clear, clean and enjoyable sound": {
     "sentimentAnalysis": "Gengivelsen beskrives som præcis, ren og imponerende med en behageligt varm og musikalsk karakter.",
     "simpleTitle": "Klar, ren og behagelig lyd",
     "bias": "positive",
     "key": "sound-quality",
     "groupId": "5fe4c663-9d47-42fa-8143-efef67445fb9"
    },
