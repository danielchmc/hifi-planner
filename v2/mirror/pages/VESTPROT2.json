  "reviews": {
   "summary": "VESTPROT2 får stor ros som en robust og stilfuld pladespiller med varm, dynamisk og omsluttende lyd. Den solide konstruktion, hurtige opstart og indbyggede RIAA-forstærker gør vinylafspilning ekstra bekvem. Den største begrænsning er manglen på automatisk løft eller slukning, mens værdi og musikalsk ydelse fortsat er meget overbevisende.",
   "headlines": {
    "solid construction and premium styling": {
     "sentimentAnalysis": "Anmeldelserne fremhæver konsekvent den robuste konstruktion, den gode finish og det attraktive, eksklusive udseende.",
     "simpleTitle": "Solid konstruktion og eksklusivt design",
     "bias": "positive",
     "key": "build",
     "groupId": "33bf0055-77df-4164-861c-112c70b4b1f2"
    },
    "warm, detailed and powerful sound": {
     "sentimentAnalysis": "Lyden roses som meget god, engagerende og kraftfuld og håndterer høj lydstyrke uden resonans.",
     "simpleTitle": "Varm, detaljeret og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "27c82636-213c-46c9-b0bc-fb189fc41da6"
    },
    "convenient built-in RIAA amplification": {
     "sentimentAnalysis": "Den indbyggede RIAA-forstærker værdsættes som en nyttig funktion, der gør opsætningen enklere.",
     "simpleTitle": "Praktisk indbygget RIAA-forstærkning",
     "bias": "positive",
     "key": "riaa",
     "groupId": "06087377-a8c1-4701-9c93-40a8f047b8ad"
    },
    "simple, stable playback and quick start": {
     "sentimentAnalysis": "Stabil drift, nem betjening og hurtig opstart fremhæves som praktiske styrker.",
     "simpleTitle": "Enkel, stabil afspilning og hurtig opstart",
