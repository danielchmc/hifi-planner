  "reviews": {
   "summary": "VESTPROT2 roses bredt som en robust, attraktiv og fornøjelig pladespiller med varm, slagkraftig lyd og en god medfølgende pickup. Den indbyggede RIAA-forstærker giver ekstra bekvemmelighed, mens hurtig opstart, stabil drift og modstandsdygtighed over for resonans forbedrer lytteoplevelsen. De største ulemper er følsomhed over for akustisk feedback og manglen på automatiske funktioner, hvilket gør pladespilleren bedre egnet til hjemmebrug end krævende klubbrug.",
   "headlines": {
    "warm, powerful sound from the included cartridge": {
     "sentimentAnalysis": "Pladespilleren leverer detaljeret, fornøjelig og slagkraftig gengivelse, hvor den medfølgende pickup bidrager markant til den gode lyd.",
     "simpleTitle": "Varm og kraftfuld lyd fra den medfølgende pickup",
     "bias": "positive",
     "key": "sound",
     "groupId": "fc368960-fc67-4245-a8e5-f24bcdc5642f"
    },
    "solid construction and attractive styling": {
     "sentimentAnalysis": "Anmeldelserne fremhæver konsekvent den robuste konstruktion, den pålidelige stabilitet og det eksklusive udseende.",
     "simpleTitle": "Solid konstruktion og flot design",
     "bias": "positive",
     "key": "build",
     "groupId": "11884933-59a2-4869-aac4-865d18d754c3"
    },
    "built-in RIAA stage adds convenience": {
     "sentimentAnalysis": "Den integrerede RIAA-forstærker ses som en nyttig funktion, der gør opsætningen enklere.",
     "simpleTitle": "Indbygget RIAA-forstærker giver ekstra bekvemmelighed",
     "bias": "positive",
     "key": "riaa",
     "groupId": "6df3c755-c49b-4e38-88a8-2fad362ca277"
    },
    "no automatic stop or pickup operation": {
     "sentimentAnalysis": "Manglen på automatisk stop ved pladens slutning er den tydeligste kritik af betjeningen, selv om en anmeldelse bemærker, at det er let at vænne sig til.",
     "simpleTitle": "Ingen automatisk afbrydelse eller pickup-betjening",
     "bias": "negative",
     "key": "operation",
     "groupId": "8ab6bb20-0a86-4593-8d79-d9299c82bbd3"
    },
    "fast, stable and resonance-resistant operation": {
     "sentimentAnalysis": "Hurtig opstart, stabil sporing og god modstandsdygtighed over for resonans giver sikker afspilning i hverdagen.",
     "simpleTitle": "Hurtig, stabil og resonansfri drift",
     "bias": "positive",
