  "reviews": {
   "summary": "VESTSTAGEA4 leverer varm, slagkraftig og imponerende fyldig lyd fra et kompakt monokabinet med klare stemmer, dyb bas og høj lydstyrke. Lang batteritid, mobilitet og det karakteristiske guitarforstærkerdesign gør højttaleren alsidig både inde, ude og på farten. Bassen kan være for kraftig for nogle, Bluetooth fungerer lejlighedsvis ustabilt, og bærestroppen kunne være mere robust, men den samlede værdi og musikglæde er fremragende.",
   "headlines": {
    "portable with distinctive styling": {
     "sentimentAnalysis": "Anmeldelserne værdsætter den nemme mobilitet, den solide konstruktion og det nostalgiske, guitarforstærkerinspirerede udseende.",
     "simpleTitle": "Bærbar med karakteristisk design",
     "bias": "positive",
     "key": "portability",
     "groupId": "7e9a13a4-a973-43fb-9794-438aa0292229"
    },
    "warm, full and powerful sound": {
     "sentimentAnalysis": "Anmeldelserne roser gennemgående den varme, fyldige og kraftfulde gengivelse, især basgengivelsen i det kompakte monoformat.",
     "simpleTitle": "Varm, fyldig og kraftfuld lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "83aff369-5983-42df-8ef3-7843505d7622"
    },
    "long-lasting battery": {
     "sentimentAnalysis": "Batteritiden roses gentagne gange, blandt andet med flere dages afspilning ved lav lydstyrke og pålidelig brug over lange sessioner.",
     "simpleTitle": "Lang batteritid",
     "bias": "positive",
     "key": "battery",
     "groupId": "834fbfd5-187b-4c7f-8983-fa1823dd9cdf"
    },
    "clear detail and controlled volume": {
     "sentimentAnalysis": "Flere anmeldelser fremhæver klare mellemtoner, detaljeret diskant, troværdige stemmer og evnen til at spille højt uden at miste kontrollen.",
     "simpleTitle": "Klar detaljering og kontrolleret lydstyrke",
     "bias": "positive",
     "key": "sound",
     "groupId": "83aff369-5983-42df-8ef3-7843505d7622"
    },
    "bass can be too prominent": {
     "sentimentAnalysis": "Nogle lyttere oplever bassen som for kraftig eller den samlede lyd som for mørk; justeringsområdet er begrænset, og der mangler separat diskantkontrol.",
     "simpleTitle": "Bassen kan blive for dominerende",
     "bias": "negative",
     "key": "sound",
     "groupId": "83aff369-5983-42df-8ef3-7843505d7622"
    },
    "carrying strap needs reinforcement": {
     "sentimentAnalysis": "To anmeldelser peger på bæreløsningen som et svagt punkt med for meget eftergivenhed eller tendens til, at stroppen løsner sig.",
     "simpleTitle": "Bærestroppen bør være mere robust",
     "bias": "negative",
     "key": "portability",
     "groupId": "7e9a13a4-a973-43fb-9794-438aa0292229"
    },
    "bluetooth is generally convenient": {
     "sentimentAnalysis": "Flere anmeldelser beskriver Bluetooth-forbindelsen som god eller nem.",
     "simpleTitle": "Bluetooth er generelt nemt",
     "bias": "positive",
     "key": "bluetooth",
     "groupId": "d528a9bc-e353-4f2d-82f3-43dd8489963d"
    },
    "bluetooth compatibility can be inconsistent": {
     "sentimentAnalysis": "Nogle brugere rapporterer forbindelsesproblemer, blandt andet vanskeligheder med en computer og lejlighedsvise parringsproblemer.",
     "simpleTitle": "Bluetooth-kompatibiliteten kan være ustabil",
     "bias": "negative",
     "key": "bluetooth",
     "groupId": "d528a9bc-e353-4f2d-82f3-43dd8489963d"
    }
   },
