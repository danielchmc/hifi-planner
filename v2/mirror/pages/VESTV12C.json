  "displayBookDemo": true,
  "reviews": {
   "summary": "VESTV12C leverer en begejstrende, varm og meget dynamisk lyd med dyb, kontant bas, høj lydstyrke og en medrivende koncertfornemmelse. Højttalerne fungerer både ved lav og høj volumen, giver imponerende detaljer og stor værdi og passer til musik, fester og mange rumstørrelser. De store mål, lejlighedsvis for kraftige bas eller tilbagetrukne øvre mellemtoner samt behovet for passende forstærkning eller stativer er de største forbehold, mens retrodesignet får stor ros.",
   "headlines": {
    "warm, full and engaging sound": {
     "sentimentAnalysis": "Anmelderne roser den varme, fyldige og levende gengivelse, især til afslappet lytning og energisk musik.",
     "simpleTitle": "Varm, fyldig og medrivende lyd",
     "bias": "positive",
     "key": "sound",
     "groupId": "64e627b8-51ec-48bd-ab1a-7eb206fdb2cd"
    },
    "powerful, clean bass and live-concert impact": {
     "sentimentAnalysis": "Anmeldelserne fremhæver den dybe, kontante og kontrollerede bas, den meget høje rene lydstyrke og den spændende koncertoplevelse.",
     "simpleTitle": "Kraftig, ren bas og koncertfornemmelse",
     "bias": "positive",
     "key": "bass-impact",
     "groupId": "64e627b8-51ec-48bd-ab1a-7eb206fdb2cd"
    },
    "detailed and spacious presentation": {
     "sentimentAnalysis": "Anmelderne oplever god detaljegengivelse, instrumentadskillelse, stort lydbillede og høj opløsning på tværs af musikgenrer.",
     "simpleTitle": "Detaljeret og rummelig gengivelse",
     "bias": "positive",
     "key": "sound-detail",
     "groupId": "64e627b8-51ec-48bd-ab1a-7eb206fdb2cd"
    },
    "distinctive retro styling with substantial proportions": {
     "sentimentAnalysis": "Retrodesignet bliver bredt rost, selv om kabinettets størrelse er markant og lejlighedsvis opfattes som for voldsom.",
     "simpleTitle": "Markant retrodesign med store dimensioner",
     "bias": "positive",
     "key": "design",
     "groupId": "d4fbc9d3-dba6-4eb2-b7a1-79fd02229e37"
    },
    "upper mids and treble can sound subdued": {
     "sentimentAnalysis": "Nogle lyttere oplever mindre detalje og en lidt dæmpet lyd i de øvre mellemtoner og diskanten, især ved lav lydstyrke.",
     "simpleTitle": "Øvre mellemtoner og diskant kan virke tilbagetrukne",
     "bias": "negative",
     "key": "sound-detail",
     "groupId": "64e627b8-51ec-48bd-ab1a-7eb206fdb2cd"
    },
    "requires suitable amplification for full potential": {
     "sentimentAnalysis": "Anmeldelserne tyder på, at kraftig forstærkning giver de højeste niveauer, mens andre opnår gode resultater med mindre eller rørforstærkere.",
     "simpleTitle": "Kræver passende forstærkning for fuldt udbytte",
     "bias": "meh",
     "key": "power",
     "groupId": "3bb2d5d0-7c18-4b29-a747-052bf85ccc43"
    }
   },
