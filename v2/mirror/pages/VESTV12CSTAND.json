  "reviews": {
   "summary": "VESTV12CSTAND roses bredt som en stabil og attraktiv løsning til at placere store højttalere i den rigtige lyttehøjde og vinkel. Standene kan give en mere fokuseret, slagkraftig og omsluttende lyd samt reducere uønskede gulvvibrationer, og de passer også til flere andre store højttalere. Pris-kvalitetsforholdet vurderes generelt positivt, men nogle anmeldelser nævner en høj pris, ujævn udførelse, besværlig justering under samling, mindre finishproblemer og en mindre ideel tape-fastgørelse.",
   "headlines": {
    "sturdy, stable construction": {
     "sentimentAnalysis": "De fleste kommentarer beskriver standene som robuste, tunge, stabile og sikre til store højttalere.",
     "simpleTitle": "Solid og stabil konstruktion",
     "bias": "positive",
     "key": "stability-build",
     "groupId": "94ee5791-c649-4c05-92b7-357ebc2d4d3e"
    },
    "stylish upgrade for large speakers": {
     "sentimentAnalysis": "Standene får store højttalere til at se mere raffinerede, afbalancerede og gennemførte ud og passer godt ind i rummet.",
     "simpleTitle": "Stilfuld opgradering af store højttalere",
     "bias": "positive",
     "key": "design-appearance",
     "groupId": "156beb89-bea6-4ce2-8915-c007b4f64e2a"
    },
    "broad compatibility with large speakers": {
     "sentimentAnalysis": "Platformen passer til Vestlyd-modeller og flere højttalere fra andre producenter, herunder store og relativt tunge kabinetter.",
     "simpleTitle": "Bred kompatibilitet med store højttalere",
     "bias": "positive",
     "key": "fit-compatibility",
     "groupId": "9ae02cd8-08b5-4b01-b43a-88972e45b42d"
    },
    "a more focused, immersive listening position": {
     "sentimentAnalysis": "Standene hæver og vinkler højttalerne effektivt og forbedrer basoverførsel, diskantretning og det centrale lydbillede.",
     "simpleTitle": "En mere fokuseret og omsluttende lytteposition",
     "bias": "positive",
     "key": "sound-positioning",
     "groupId": "b8ad976c-1dcf-4cd3-bf13-2785e7f1d4d7"
    },
    "some construction details fall short": {
     "sentimentAnalysis": "Et mindretal nævner ujævne eller beskadigede dele, bevægelse under justering ved samling samt et ønske om en længere anlægsflade eller tværbjælke foran.",
     "simpleTitle": "Nogle konstruktionsdetaljer skuffer",
     "bias": "negative",
     "key": "stability-build",
     "groupId": "94ee5791-c649-4c05-92b7-357ebc2d4d3e"
    },
    "price is not universally convincing": {
     "sentimentAnalysis": "Flere kommentarer synes, at standene er lidt dyre, især set i forhold til konstruktionsdetaljerne og tape-fastgørelsen af højttalerne.",
     "simpleTitle": "Prisen overbeviser ikke alle",
     "bias": "negative",
     "key": "price-value",
     "groupId": "fee8e128-0705-4c66-bce6-b1ae12fa8d43"
    }
   },
