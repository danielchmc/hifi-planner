  "displayBookDemo": true,
  "reviews": {
   "summary": "VESTV15C leverer en varm, slagkraftig og meget dynamisk lyd med en medrivende livekoncert-karakter. Kraftfuld bas, klare detaljer og ubesværet lydtryk gør højttalerne særligt spændende til rock, elektronisk musik og fester, mens mange også roser lyden ved lav volumen. De store kabinetter, omhyggelig placering og til tider kraftig forstærkning skal tages i betragtning, og enkelte lyttere finder gengivelsen mindre raffineret eller mindre egnet til akustisk musik.",
   "headlines": {
    "powerful, punchy sound with a live-concert feel": {
     "sentimentAnalysis": "Anmeldelserne roser den dynamiske, engagerende og liveagtige lyd med kraftig fysisk gennemslagskraft.",
     "simpleTitle": "Kraftfuld, slagkraftig lyd med livekoncertfølelse",
     "bias": "positive",
     "key": "sound_power",
     "groupId": "6633b32e-c7e8-4964-a5a2-00320714b1f7"
    },
    "clear, detailed and controlled presentation": {
     "sentimentAnalysis": "Anmeldelserne fremhæver klare vokaler og diskant, detaljeret gengivelse, afbalanceret bas og forvrængningsfri afspilning ved høj lydstyrke.",
     "simpleTitle": "Klar, detaljeret og kontrolleret gengivelse",
     "bias": "positive",
     "key": "sound_clarity",
     "groupId": "6633b32e-c7e8-4964-a5a2-00320714b1f7"
    },
    "full, satisfying sound at low volume": {
     "sentimentAnalysis": "Anmeldelserne beskriver gennemgående en fyldig, varm og behagelig lyd selv ved stille lytning.",
     "simpleTitle": "Fyldig og tilfredsstillende lyd ved lav volumen",
     "bias": "positive",
     "key": "lowvolume_full",
     "groupId": "c157a252-3be0-4b4f-aad9-67905533a617"
    },
    "exceptional value for the money": {
     "sentimentAnalysis": "Anmeldelserne fremhæver gentagne gange, at ydelse og musikglæde overstiger forventningerne til prisen.",
     "simpleTitle": "Usædvanlig god værdi for pengene",
     "bias": "positive",
     "key": "value_exceptional",
     "groupId": "be15d612-6c9c-42bb-9f42-e7d84d9e6292"
    },
    "less refined for some acoustic and critical listening": {
     "sentimentAnalysis": "En mindre del af anmeldelserne bemærker, at den livlige klang kan være mindre raffineret, mindre lineær eller mindre overbevisende med bestemte musikgenrer.",
     "simpleTitle": "Mindre raffineret til noget akustisk og kritisk lytning",
     "bias": "negative",
     "key": "sound_limits",
     "groupId": "6633b32e-c7e8-4964-a5a2-00320714b1f7"
    }
   },
